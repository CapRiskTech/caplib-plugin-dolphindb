// ============================================================
// DolphinDB 建库 / 建表脚本（可直接在 DolphinDB 中执行）
// 数据库：dfs://caplib-bond
// 引擎：TSDB；分区：RANGE 按年（2000~2040）
// ============================================================

if (existsDatabase("dfs://caplib-bond")) {
    dropDatabase("dfs://caplib-bond")
}
dbh = database(directory="dfs://caplib-bond", partitionType=RANGE,
               partitionScheme=[2000.01.01, 2001.01.01, 2002.01.01, 2003.01.01, 2004.01.01, 2005.01.01, 2006.01.01, 2007.01.01, 2008.01.01, 2009.01.01, 2010.01.01, 2011.01.01, 2012.01.01, 2013.01.01, 2014.01.01, 2015.01.01, 2016.01.01, 2017.01.01, 2018.01.01, 2019.01.01, 2020.01.01, 2021.01.01, 2022.01.01, 2023.01.01, 2024.01.01, 2025.01.01, 2026.01.01, 2027.01.01, 2028.01.01, 2029.01.01, 2030.01.01, 2031.01.01, 2032.01.01, 2033.01.01, 2034.01.01, 2035.01.01, 2036.01.01, 2037.01.01, 2038.01.01, 2039.01.01, 2040.01.01], engine="TSDB")

// ---- t_calendar（DIMENSION）----
t = table(1:0, ["calendar_code", "type", "date"], [STRING, STRING, DATE])
createTable(dbh, t, "t_calendar", , ["calendar_code", "date"], LAST)

// ---- t_bond_yield_curve_def（DIMENSION）----
t = table(1:0, ["curve_code", "curve_name_cn", "curve_name_en", "curve_class", "currency", "day_count_convention", "curve_type", "interp_type", "extrap_method", "compounding_type", "frequency", "quote_type", "build_method", "jacobian", "term"], [STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, STRING, BOOL, STRING])
createTable(dbh, t, "t_bond_yield_curve_def", , ["curve_code"], ALL)

// ---- t_bond_info（DIMENSION）----
t = table(1:0, ["inst_code", "inst_name", "bond_type", "issue_date", "settlement_days", "start_date", "maturity", "maturity_date", "rate", "currency", "issue_price", "day_count", "calendar", "frequency", "interest_day_convention", "stub_policy", "broken_period_type", "pay_day_offset", "pay_day_convention", "ref_index", "fixing_calendars", "fixing_freq", "fixing_day_convention", "fixing_mode", "fixing_day_offset", "ex_cpn_period", "ex_cpn_calendar", "ex_cpn_day_convention", "ex_cpn_eom", "notional_type", "recovery_rate", "std_flag"], [STRING, STRING, STRING, DATE, INT, DATE, STRING, DATE, DOUBLE, STRING, DOUBLE, STRING, STRING, STRING, STRING, STRING, STRING, INT, STRING, STRING, STRING, STRING, STRING, STRING, INT, STRING, STRING, STRING, BOOL, STRING, DOUBLE, BOOL])
createTable(dbh, t, "t_bond_info", , ["inst_code"], ALL)

// ---- t_bond_day_kline（PARTITIONED）----
t = table(1:0, ["inst_code", "date_time", "open", "high", "low", "close", "volume"], [STRING, DATE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE])
createPartitionedTable(dbh, t, "t_bond_day_kline", ["date_time"], , ["inst_code", "date_time"], LAST)

// ---- t_bond_yield_curve（PARTITIONED）----
t = table(1:0, ["curve_code", "curve_time", "par_curve", "yield_curve"], [STRING, NANOTIMESTAMP, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_yield_curve", ["curve_time"], , ["curve_code", "curve_time"], LAST)

// ---- t_bond_pricing（PARTITIONED）----
t = table(1:0, ["code", "date", "currency", "pricing"], [STRING, NANOTIMESTAMP, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_pricing", ["date"], , ["code", "date"], LAST)

// ---- t_bond_valuation（PARTITIONED）----
t = table(1:0, ["code", "date", "currency", "valuation"], [STRING, NANOTIMESTAMP, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_valuation", ["date"], , ["code", "date"], LAST)

// ---- t_bond_yield_sim_curve（PARTITIONED）----
t = table(1:0, ["code", "date", "sim_date", "start_date", "end_date", "par_curve", "curve"], [STRING, TIMESTAMP, TIMESTAMP, TIMESTAMP, TIMESTAMP, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_yield_sim_curve", ["sim_date"], , ["code", "sim_date", "date", "start_date", "end_date"], LAST)

// ---- t_bond_sim_valuation（PARTITIONED）----
t = table(1:0, ["code", "date", "sim_date", "start_date", "end_date", "currency", "valuation"], [STRING, TIMESTAMP, TIMESTAMP, TIMESTAMP, TIMESTAMP, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_sim_valuation", ["sim_date"], , ["code", "sim_date", "date", "start_date", "end_date"], LAST)

// ---- t_bond_var（PARTITIONED）----
t = table(1:0, ["code", "currency", "date", "sim_date", "pnl", "risk_value95", "risk_value99"], [STRING, STRING, TIMESTAMP, TIMESTAMP, STRING, STRING, STRING])
createPartitionedTable(dbh, t, "t_bond_var", ["date"], , ["code", "sim_date", "date"], LAST)
