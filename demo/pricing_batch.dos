/**
 * pricing_batch.dos
 *
 * 批量计算指定日期区间内每个 CFETS 交易日的「定价 + 估值」。
 *
 * 单日流程（对齐 Java 侧：市场曲线 -> 标准债定价 -> 基准曲线 -> 非标债定价 -> 估值）：
 *   1) buildBondYieldCurveFromLix(d, periods)  CN_TREAS_MKT 市场曲线（基于 t_bond_day_kline 选债 + YTM）
 *   2) priceStdBonds(d)                        标准债定价 -> t_bond_pricing
 *   3) buildStdYieldCurve(d)                   CN_TREAS_STD 基准曲线（pillar = 标准债定价的 YTM）
 *   4) priceNonStdBonds(d)                     非标债定价 -> t_bond_pricing
 *   5) valuationStdBonds(d)                    标准债估值 -> t_bond_valuation
 *   6) valuationNonStdBonds(d)                 非标债估值 -> t_bond_valuation
 *
 * 前置脚本必须【先按序 run】（DolphinDB 解析期即校验函数名，顺序不能颠倒）：
 *   run "/data/ddb/server/scripts/create_calendar.dos"        // CFETS 日历（插件内存，容器重启后需重建）
 *   run "/data/ddb/server/scripts/create_bond_templates.dos"  // 非标债模板（同上）
 *   run "/data/ddb/server/scripts/build_yield_curve.dos"      // 曲线构建
 *   run "/data/ddb/server/scripts/bond_pricing.dos"           // 定价/估值
 *   run "/data/ddb/server/scripts/pricing_batch.dos"          // 本文件
 *
 * 幂等：每天写入前先删除该日期的 t_bond_pricing / t_bond_valuation 行（date 即分区列）。
 */

/**
 * 计算单日定价与估值
 * asOfDate DATE 基准日（需为 CFETS 交易日）
 * periods INT  LIX 流动性窗口的交易日数（默认 20）
 * 返回 TABLE：date, mkt_curve_ok, std_price, nonstd_price, std_curve_ok,
 *             std_val, nonstd_val, elapsed_s
 * 各步骤严格按依赖短路：MKT 失败则后续全部 -1 直接返回；STD 曲线失败则跳过两种估值。
 * 计数列为成功只数，-1 表示该步骤失败或因前置失败而未执行。
 */
def computeOneDay(asOfDate, periods=20) {
    ts = nanotimestamp(asOfDate)
    prT = loadTable("dfs://caplib-bond", "t_bond_pricing")
    vaT = loadTable("dfs://caplib-bond", "t_bond_valuation")
    // 幂等：先清掉该日已有结果
    delete from prT where date = ts
    delete from vaT where date = ts

    t0 = now()

    // 结果行（失败/未执行的步骤记 -1）
    row = dict(STRING, INT)
    row["mkt_curve_ok"] = -1; row["std_price"] = -1; row["std_curve_ok"] = -1
    row["nonstd_price"] = -1;  row["std_val"] = -1;   row["nonstd_val"] = -1

    // 1) 市场曲线：整条链路的根，建不出来则后续全部无意义，直接返回
    try {
        buildBondYieldCurveFromLix(asOfDate, periods)
        row["mkt_curve_ok"] = 1
    } catch (ex) {
        return table([asOfDate] as date, [row["mkt_curve_ok"]] as mkt_curve_ok,
                     [row["std_price"]] as std_price, [row["nonstd_price"]] as nonstd_price,
                     [row["std_curve_ok"]] as std_curve_ok,
                     [row["std_val"]] as std_val, [row["nonstd_val"]] as nonstd_val,
                     [(now() - t0) \ 1000] as elapsed_s)
    }

    // 2) 标准债定价（依赖 MKT）-> 3) 基准曲线（依赖标准债定价）
    row["std_price"] = priceStdBonds(asOfDate)["ok"]
    try {
        buildStdYieldCurve(asOfDate)
        row["std_curve_ok"] = 1
    } catch (ex) { row["std_curve_ok"] = -1 }

    // 4) 非标债定价：只依赖 MKT，STD 曲线失败仍可执行
    row["nonstd_price"] = priceNonStdBonds(asOfDate)["ok"]

    // 5) 6) 估值：依赖 STD 曲线，建不出来则无意义，跳过
    if (row["std_curve_ok"] == 1) {
        row["std_val"] = valuationStdBonds(asOfDate)["ok"]
        row["nonstd_val"] = valuationNonStdBonds(asOfDate)["ok"]
    }

    return table([asOfDate] as date, [row["mkt_curve_ok"]] as mkt_curve_ok,
                 [row["std_price"]] as std_price, [row["nonstd_price"]] as nonstd_price,
                 [row["std_curve_ok"]] as std_curve_ok,
                 [row["std_val"]] as std_val, [row["nonstd_val"]] as nonstd_val,
                 [(now() - t0) \ 1000] as elapsed_s)
}

/**
 * 批量：对显式给定的日期列表逐日执行 computeOneDay
 *
 * 用于「只重刷库里已有日期」——computeRange 会把区间内所有交易日都算上，
 * 而库里 2025.02.28 与 2025.12.31 之间本无数据，不能被补算。
 * dates DATE[] 基准日列表
 * 返回 TABLE：逐日结果
 */
def computeByDates(dates, periods=20) {
    print("待处理日期数=" + dates.size())
    res = table(1:0, ["date","mkt_curve_ok","std_price","nonstd_price",
                      "std_curve_ok","std_val","nonstd_val","elapsed_s"],
                [DATE, INT, INT, INT, INT, INT, INT, INT])
    failed = array(DATE, 0, 0)
    for (date in dates) {
        // 逐日容错：单日异常（含插件 std::exception）不中断整批，记入 failed 后继续
        try {
            r = computeOneDay(date, periods)
            res.append!(r)
            print(r)
        } catch (ex) {
            failed.append!(date)
            print("!! " + date + " FAILED: " + ex)
        }
    }
    print("完成 " + res.size() + " 天，失败 " + failed.size() + " 天")
    if (failed.size() > 0) print("失败日期: " + string(failed))
    return res
}

/**
 * 批量：区间 [startDate, endDate] 内每个 CFETS 交易日执行 computeOneDay
 * 返回 TABLE：逐日结果
 */
def computeRange(startDate, endDate, periods=20) {
    // 回溯数量取区间日历天数上界（每个日历日最多一个交易日），
    // 不能硬编码固定值，否则跨度大的区间会静默丢掉早期交易日
    lookback = int(endDate - startDate) + 1
    days = getCFETSTradeDays(endDate, lookback)
    days = days[days >= startDate]
    print("区间 " + startDate + " ~ " + endDate + " 共 " + days.size() + " 个交易日")
    return computeByDates(days, periods)
}
