/**
 * create_lix.dos
 *
 * 债券流动性 LIx + 按期限选债 + 构建/存储收益率曲线（基于 t_bond_day_kline 行情）。
 * 公式（weight=1 默认，仅市场冲击项）：
 *   lix = log10(volume * close / (high - low))   当 range>0 且 volume>0，否则 0
 *
 * 依赖 create_calendar.dos（提供 getCFETSTradeDays），需先加载：
 *   run "/data/ddb/server/scripts/create_calendar.dos"
 *   run "/data/ddb/server/scripts/create_lix.dos"
 *
 * 主流程（一天）：
 *   getBondLix(asOfDate, periods)            // 已发行未到期非标债的流动性 inst_code/close/lix
 *   selectMaxLixBonds(asOfDate, periods)     // 为每个标准期限在容差内选 lix 最大的一只债
 *   buildBondYieldCurveFromLix(...)          // 平价曲线+设置+收益率曲线，并存入 t_bond_yield_curve
 */

// 标量公式
def lix(high, low, close, volume) {
    if (isNull(high) || isNull(low) || isNull(close) || isNull(volume)) return NULL
    range = high - low
    if (range > 0.0 && volume > 0.0) {
        return log10(volume * close / range)
    }
    return 0.0
}

/**
 * 批量计算流动性：日期 + 天数必传
 * - 编码取自 t_bond_info 中「已发行未到期」非标债（start_date<=asOfDate 且 maturity_date>asOfDate）
 * - 用 CFETS 日历生成 asOfDate 往前 periods 个交易日窗口 [startD, endD]
 * - volume 均量 = 窗口内成交量和 / periods（缺记录日按 0 计入，分母固定）
 * - high/low/close 取窗口末日（基准日）值
 * 返回 TABLE：inst_code, close, lix（仅 lix>0）
 */
def getBondLix(asOfDate, periods) {
    t = loadTable("dfs://caplib-bond", "t_bond_day_kline")
    codes = getAliveNonStdBonds(asOfDate)
    if (size(codes) == 0) {
        return table(1:0, ["inst_code", "close", "lix"], [STRING, DOUBLE, DOUBLE])
    }
    win = getCFETSTradeDays(asOfDate, periods)      // 升序交易日窗口
    periodN = win.size()
    startD = win[0]
    endD = win[periodN - 1]
    // 一次性取窗口内目标债行情（编码+日期倒序），内存逐债计算
    all = select inst_code, high, low, close, volume from t
          where inst_code in codes, date_time >= startD, date_time <= endD
          order by inst_code, date_time desc
    res = table(1:0, ["inst_code", "close", "lix"], [STRING, DOUBLE, DOUBLE])
    for (c in all["inst_code"].distinct()) {
        sub = all[all["inst_code"] == c]
        if (sub.size() == 0) continue
        li = lix(sub["high"][0], sub["low"][0], sub["close"][0],
                 sum(sub["volume"]) / periodN)
        if (isNull(li) || li <= 0.0) continue       // 只返回 lix>0
        insert into res values(c, sub["close"][0], li)
    }
    return res
}

// —— 期限工具 ——

// 从曲线定义 term JSON 提取期限数组（如 ["1M","2M",...,"50Y"]）
def extractCurveTerms(curveCode) {
    c = first exec term from loadTable("dfs://caplib-bond", "t_bond_yield_curve_def")
        where curve_code = curveCode
    parts = split(c, '"term":"')
    termStrs = []
    for (i in 1..(size(parts) - 1)) {
        // parts[i] 形如 `1M"},...`，去掉 `}` 和引号得到纯期限 `1M`
        termStrs.append!(split(split(parts[i], '}')[0], '"')[0])
    }
    return termStrs
}

// 期限字符串 -> 年（参考 Python _term_annualized）
def termAnnualized(s) {
    // 注意：函数参数为常量不可赋值，用局部变量承接
    t = s
    // 特殊期限：隔夜/次隔夜/当日
    if (t == "ON") t = "1D"
    if (t == "TN") t = "2D"
    if (t == "SN") t = "3D"
    // 正则提取数值（数字部分）与单位（字母部分）
    v = int(regexReplace(t, "[A-Za-z]", ""))       // 数字
    u = upper(regexReplace(t, "[0-9]", ""))        // 单位（大写）
    if (u == "Y") return double(v)
    if (u == "M" or u == "MONTHS") return round(double(v) / 12.0, 3)
    if (u == "W") return round(double(v) * 7.0 / 365.0, 3)
    if (u == "D" or u == "DAYS") return round(double(v) / 365.0, 3)
    throw "termAnnualized: 无法解析期限 " + s
}

/**
 * 计算每个标准期限的容差（对齐 Python _get_tolerance）：
 *
 *   half_gap = min(与左邻间距, 与右邻间距) / 2     // 首/末期限只有一侧邻居
 *   容差 = min(half_gap, cap)，cap 按期限分档：
 *     term < 1Y  -> 0.083（约 1 个月）
 *     term < 10Y -> 0.5（约 6 个月）
 *     term >= 10Y-> 3（约 3 年）
 *
 * 容差由相邻期限间距决定：间距小自然窄、间距大自然宽，且相邻期限的匹配窗口
 * 不会重叠（间距不对称时宁可留出空档，也不允许一只债跨两个期限）。
 *
 * 例（CN_TREAS_MKT：1M/2M/3M/6M/9M/1Y/2Y...）：
 *   1M=0.083  -> 右侧间距 0.084，half_gap 0.042，cap 0.083 -> 容差 0.042
 *   6M=0.5    -> half_gap 0.125，cap 0.083 -> 容差 0.083
 *   9M=0.75   -> half_gap 0.125，cap 0.083 -> 容差 0.083
 *   1Y=1      -> half_gap 0.125，cap 0.5 -> 容差 0.125
 *   2Y=2      -> half_gap 0.5，cap 0.5 -> 容差 0.5
 *
 * 返回 TABLE：term_str, term(年化), tolerance
 */
def getTermTolerances(curveCode) {
    termStrs = extractCurveTerms(curveCode)
    termsRaw = each(termAnnualized, termStrs)
    strs = array(STRING, 0, 0); te = array(DOUBLE, 0, 0)
    for (i in 0..(termStrs.size() - 1)) {
        if (!isNull(termsRaw[i])) {
            strs.append!(termStrs[i]); te.append!(termsRaw[i])
        }
    }
    n = strs.size()
    tol = array(DOUBLE, 0, 0)
    for (i in 0..(n - 1)) {
        if (n == 1) {
            halfGap = 0.0
        } else if (i == 0) {
            halfGap = (te[1] - te[0]) / 2.0
        } else if (i == n - 1) {
            halfGap = (te[n - 1] - te[n - 2]) / 2.0
        } else {
            halfGap = min(te[i] - te[i - 1], te[i + 1] - te[i]) / 2.0
        }
        if (te[i] < 1.0) {
            cap = 0.083
        } else if (te[i] < 10.0) {
            cap = 0.5
        } else {
            cap = 3.0
        }
        tol.append!(min(halfGap, cap))
    }
    return table(strs as term_str, te as term, tol as tolerance)
}

// —— 选债 ——

/**
 * 按期限选债：曲线定义（curveCode，默认 CN_TREAS_MKT）的每个标准期限，
 * 在「剩余期限偏离 <= 该期限容差（getTermTolerances，对齐 Python _get_tolerance）」
 * 的候选中选 lix 最大的一只债。容差窗口互不重叠，选出的债不跨期限。
 * 剩余期限 = (maturity_date - asOfDate) / 365。
 * 返回 TABLE：inst_code, maturity_date, ptmyear, lix, term, term_str, quote，按到期日升序
 */
def selectMaxLixBonds(asOfDate, periods, curveCode="CN_TREAS_MKT") {
    // getBondLix 已保证「存活非标债 + lix>0」；这里补到期日、算剩余期限
    joined = select l.inst_code as code, l.close as close, l.lix as lix, m.maturity_date as mat
             from getBondLix(asOfDate, periods) l
             left join (select inst_code, maturity_date from loadTable("dfs://caplib-bond", "t_bond_info")) m
             on l.inst_code = m.inst_code
    joined = joined[joined["mat"] != NULL]
    if (joined.size() == 0) {
        return table(1:0, ["inst_code","maturity_date","ptmyear","lix","term","term_str","quote"],
                     [STRING, DATE, DOUBLE, DOUBLE, DOUBLE, STRING, DOUBLE])
    }
    joined = select *, double(mat - asOfDate) / 365.0 as ptmyear from joined

    tt = getTermTolerances(curveCode)
    m = joined.size()
    idxAll = 0..(m - 1)
    ptm = joined["ptmyear"]
    res = table(1:0, ["inst_code","maturity_date","ptmyear","lix","term","term_str","quote"],
                [STRING, DATE, DOUBLE, DOUBLE, DOUBLE, STRING, DOUBLE])
    for (j in 0..(tt.size() - 1)) {
        te = tt["term"][j]
        tlim = tt["tolerance"][j]
        candIdx = idxAll[abs(ptm - te) <= tlim]
        if (candIdx.size() == 0) continue
        lixv = joined["lix"][candIdx]
        pickIdx = candIdx[lixv == max(lixv)][0]
        sel = joined[pickIdx]
        insert into res values(sel["code"], sel["mat"], sel["ptmyear"], sel["lix"],
                               te, tt["term_str"][j], sel["close"])
    }
    return select * from res order by maturity_date
}

// —— 曲线定义 ——

// 取曲线定义行（t_bond_yield_curve_def）
def getCurveDef(curveCode) {
    return first exec * from loadTable("dfs://caplib-bond", "t_bond_yield_curve_def")
           where curve_code = curveCode
}


/**
 * 构建收益率曲线（对齐 Java：价格报价转成收益率，再用曲线定义的构建方法构建）
 * 1. selectMaxLixBonds 选债（lix>0，按到期日升序，quote=close）
 * 2. 每只债 buildVanillaBond 后 calcYieldToMaturity 把收盘价转成 YTM
 * 3. 以 YTM 为 quote 建 par curve（createBondParCurve, quoteType=YTM）
 * 4. buildBondYieldCurve 用曲线定义的构建方法（BOOTSTRAPPING_METHOD）构建收益率曲线
 * 5. 结果存 t_bond_yield_curve（par_curve=选债+YTM JSON，yield_curve=IrYieldCurve JSON）
 * 返回字典：parCurveHandle, yieldCurveHandle, yieldJson, yields
 */
def buildBondYieldCurveFromLix(asOfDate, periods, curveCode="CN_TREAS_MKT", nominal=100.0) {
    c = getCurveDef(curveCode)
    cc = c.curve_code[0]
    ts = nanotimestamp(asOfDate)
    bonds = selectMaxLixBonds(asOfDate, periods)
    j = select l.inst_code as code, l.quote as quote, m.maturity_date as mat, m.frequency as freq,
               m.start_date as sd
        from bonds l left join (select inst_code, maturity_date, frequency, start_date from loadTable("dfs://caplib-bond", "t_bond_info")) m
        on l.inst_code = m.inst_code order by mat
    n = j.size()
    // 无可用债（如调休日无行情：全市场 high==low 且 volume==0 -> lix 全为 0）直接返回 NULL。
    // 注意：不能省这一步——n=0 时 `0..(n-1)` 在 DolphinDB 里是 [0,-1] 而非空向量，
    // 循环会索引空数组并抛插件级 std::exception。
    if (n == 0) return NULL
    codes = array(STRING, 0, 0); yArr = array(DOUBLE, 0, 0)
    for (i in 0..(n - 1)) {
        code = j["code"][i]
        close = j["quote"][i]
        mat = j["mat"][i]
        freq = j["freq"][i]
        // startDate 传债券真实起息日（对齐官方 FiAnalytics.dos）：传估值日会让插件把债
        // 重建成「估值日新发行、完整原始期限」的债，价格反推出的是原始期限的收益率。
        // 实测 200013.IB（5Y 债、剩 273 天、收盘 101.4205）：传估值日得 2.71%（5Y 收益率），
        // 传真实起息日 2020.10.22 得 1.09%（与现金流手算一致）
        sd = j["sd"][i]
        if (isNull(sd)) sd = asOfDate
        bond = caplib::buildVanillaBond(nominal, code, "", sd, "BY_" + code, false)
        // 价格 -> 收益率（YTM，按各债付息频率）
        ytm = caplib::calcYieldToMaturity(asOfDate, "DISCRETE_COMPOUNDING", bond, "",
             close, "CLEAN_PRICE", freq)
        codes.append!(code); yArr.append!(ytm)
    }
    if (size(codes) == 0) return NULL
    // YTM 为 quote 的 par curve
    par = caplib::createBondParCurve(asOfDate, "CNY", codes, yArr, "YTM", cc + "_PAR", true)
    // 构建设置（curveType/interp/extrap 取自曲线定义）
    bs = caplib::createBondYieldCurveBuildSettings(cc, c.curve_type[0],
         c.interp_type[0], c.extrap_method[0], cc + "_BS", false)
    // 用构建方法（BOOTSTRAPPING_METHOD）构建收益率曲线
    yc = caplib::buildBondYieldCurve(asOfDate, bs, cc, par[0],
         c.day_count_convention[0], c.compounding_type[0], c.frequency[0],
         c.build_method[0], 0, "", cc, true)
    tbl = loadTable("dfs://caplib-bond", "t_bond_yield_curve")
    delete from tbl where curve_code = cc, curve_time = ts
    // par_curve 存 BondParCurve JSON（YTM quote 的平价曲线），yield_curve 存 IrYieldCurve JSON
    tbl.tableInsert(table(take(cc, 1) as curve_code, [ts] as curve_time,
                          [par[1]] as par_curve, [yc[1]] as yield_curve))
    res = dict(STRING, ANY)
    res["parCurveHandle"] = par[0]
    res["yieldCurveHandle"] = yc[0]
    res["yieldJson"] = yc[1]
    res["yields"] = yArr
    res["yield_len"] = strlen(yc[1])
    return res
}

/**
 * 构建基准曲线（curveCode 默认 CN_TREAS_STD）
 * 基准曲线期限结构中每个 term 绑定一只标准债（bondCode）；
 * pillar 报价 = 该标准债【定价数据】中的到期收益率 specific_pricing_results.data[0]，
 * pillar 日期 = 该标准债的到期日（t_bond_info.maturity_date）。
 * 再以这些 YTM 为 quote 建 par curve，并用曲线定义的构建方法（BOOTSTRAPPING）构建收益率曲线，
 * 结果存 t_bond_yield_curve。
 *
 * asOfDate  DATE  定价/曲线基准日（需已对标准债完成定价并写入 t_bond_pricing）
 * curveCode STRING 曲线编码，默认 CN_TREAS_STD
 * 返回字典：yieldCurveHandle, yieldJson, yields
 */
/**
 * 从债券定价结果 JSON 提取到期收益率 specific_pricing_results.data[0]
 * 独立成函数是为了避开 DolphinDB 函数循环内对嵌套 JSON 数组索引的兼容性问题。
 */
def extractYtm(prVal) {
    sp = fromStdJson(jsonExtract(prVal, "specific_pricing_results", "string"))
    d = sp[0][`data]
    return d[0]
}

def buildStdYieldCurve(asOfDate, curveCode="CN_TREAS_STD") {
    c = getCurveDef(curveCode)
    cc = c.curve_code[0]
    ts = nanotimestamp(asOfDate)
    // 期限结构 JSON 转表：[{"bondCode":..,"term":..}, ...] -> bondCode | term
    defs = parseJsonTable(c.term[0])
    codes = defs["bondCode"]
    n = size(codes)
    prT = loadTable("dfs://caplib-bond", "t_bond_pricing")
    yArr = array(DOUBLE, 0, 0)
    keptCodes = array(STRING, 0, 0)
    for (i in 0..(n - 1)) {
        bondCode = codes[i]
        if (bondCode == "null" or size(bondCode) == 0) continue
        // 定价结果 -> specific_pricing_results.data[0] = YTM
        prVal = exec pricing from prT where code = bondCode, date = ts
        if (size(prVal) == 0) continue
        ytm = extractYtm(prVal)
        keptCodes.append!(bondCode); yArr.append!(ytm)
    }
    codes = keptCodes
    if (size(codes) == 0) return NULL
    // YTM 为 quote 的 par curve
    par = caplib::createBondParCurve(asOfDate, "CNY", codes, yArr, "YTM", cc + "_PAR", true)
    bs = caplib::createBondYieldCurveBuildSettings(cc, c.curve_type[0],
         c.interp_type[0], c.extrap_method[0], cc + "_BS", false)
    yc = caplib::buildBondYieldCurve(asOfDate, bs, cc, par[0],
         c.day_count_convention[0], c.compounding_type[0], c.frequency[0],
         c.build_method[0], 0, "", cc, true)
    tbl = loadTable("dfs://caplib-bond", "t_bond_yield_curve")
    delete from tbl where curve_code = cc, curve_time = ts
    tbl.tableInsert(table(take(cc, 1) as curve_code, [ts] as curve_time,
                          [par[1]] as par_curve, [yc[1]] as yield_curve))
    res = dict(STRING, ANY)
    res["yieldCurveHandle"] = yc[0]
    res["yieldJson"] = yc[1]
    res["yields"] = yArr
    res["yield_len"] = strlen(yc[1])
    return res
}
