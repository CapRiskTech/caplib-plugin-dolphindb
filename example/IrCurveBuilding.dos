// =============================================================================
// DolphinDB Caplib Plugin Example: IR Curve Creation and Query
// =============================================================================

loadPlugin("PluginCaplib")

asOfDate = 2024.01.15
curve = caplib::createIrYieldCurve(
    asOfDate,
    [2024.07.15, 2025.01.15, 2026.01.15, 2029.01.15],
    [0.0530, 0.0500, 0.0450, 0.0410],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_SOFR", "USD_SOFR_CURVE", false)

zeroRate = caplib::getZeroRate(curve, 2025.07.15)
discountFactor = caplib::getDiscountFactor(curve, 2025.07.15)
forwardRate = caplib::getFwdRate(curve, 2025.01.15, 2025.07.15)

print("Curve handle: " + curve)
print("Zero rate: " + string(zeroRate))
print("Discount factor: " + string(discountFactor))
print("Forward rate: " + string(forwardRate))
