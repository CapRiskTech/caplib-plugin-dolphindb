// =============================================================================
// DolphinDB caplib Plugin Example: Market Risk
// =============================================================================
// This script demonstrates the four MarketRisk service interfaces:
//   1. buildHistSimFxSpotRate    - historical-simulation FX spot scenario
//   2. buildHistSimFxVolSurface  - historical-simulation FX vol surface scenario
//   3. calcVaR                   - value-at-risk from P&L samples
//   4. calcExpectedShortfall     - expected shortfall from P&L samples
// Stripped from test/risk/*.dos and kept as an executable usage example.


caplib::createCalendar("CAL_CFETS");

simDate = 2020.02.21;

// -----------------------------------------------------------------------------
// 1. buildHistSimFxSpotRate
//    Signature: (simDate DATE, referenceSpot H, histStart H, histEnd H,
//                useTemplate BOOL, fxSpotTemplate H ('' ok),
//                handle STRING) -> handle STRING
// -----------------------------------------------------------------------------
refSpot   = caplib::createFxSpotRate(7.00, "USD", "CNY", simDate, simDate, "MR_EX_SPOT_REF");
startSpot = caplib::createFxSpotRate(6.99, "USD", "CNY", simDate, simDate, "MR_EX_SPOT_START");
endSpot   = caplib::createFxSpotRate(7.01, "USD", "CNY", simDate, simDate, "MR_EX_SPOT_END");

fxResultHandle = caplib::buildHistSimFxSpotRate(
    simDate, refSpot, startSpot, endSpot,
    false, "", "MR_EX_SPOT_RESULT");
print(fxResultHandle);
print(caplib::getObjectCacheJson("FxSpotRate", "MR_EX_SPOT_RESULT"));

// -----------------------------------------------------------------------------
// 2. buildHistSimFxVolSurface
//    Signature: (simDate DATE, referenceVolSurf H, histStart H, histEnd H,
//                volSurfaceDates DATE[], volSurfaceStrikes (vector of DOUBLE[]),
//                spot H, domCurve H, forCurve H, settings H ('' ok),
//                handle STRING) -> handle STRING
//    NOTE: on current dqlibc server builds the FX vol-surface scenario
//    generator may not converge and raises an error; the call is wrapped in
//    try/catch so the example stays executable end to end.
// -----------------------------------------------------------------------------
volSimDate = 2021.03.30;

// The historical-simulation builder interpolates surfaces, so each surface
// must carry at least TWO term points.
surfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABSOLUTE_STRIKE",
    1.0e-4, 1.0e4, "MR_EX_SURF_DEF", true);
fxMktConventions = caplib::createFxMktConventions(
    "EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA",
    "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "MR_EX_SURF_CONV", true);

termDates = [2021.06.30, 2021.09.30];
strikes2 = matrix([1.00, 1.00], [1.1761, 1.1761], [1.35, 1.35]);
volsRef   = matrix([0.06, 0.06], [0.06, 0.06], [0.06, 0.06]);
volsStart = matrix([0.05, 0.05], [0.05, 0.05], [0.05, 0.05]);
volsEnd   = matrix([0.07, 0.07], [0.07, 0.07], [0.07, 0.07]);

refSurf   = caplib::createFxVolatilitySurface(volSimDate, "EUR", "USD", termDates, strikes2, volsRef,   surfDefinition[0], fxMktConventions[0], "MR_EX_SURF_REF");
startSurf = caplib::createFxVolatilitySurface(volSimDate, "EUR", "USD", termDates, strikes2, volsStart, surfDefinition[0], fxMktConventions[0], "MR_EX_SURF_START");
endSurf   = caplib::createFxVolatilitySurface(volSimDate, "EUR", "USD", termDates, strikes2, volsEnd,   surfDefinition[0], fxMktConventions[0], "MR_EX_SURF_END");

spotRate = caplib::createFxSpotRate(1.1761, "EUR", "USD", volSimDate, volSimDate, "MR_EX_SURF_SPOT");
domCurve = caplib::createFlatIrYieldCurve(volSimDate, "EUR", 0.020, "MR_EX_SURF_DOM");
forCurve = caplib::createFlatIrYieldCurve(volSimDate, "USD", 0.010, "MR_EX_SURF_FOR");

volDates = termDates;
volStrikes = [[1.00, 1.1761, 1.35], [1.00, 1.1761, 1.35]];

try {
    volResultHandle = caplib::buildHistSimFxVolSurface(
        volSimDate, refSurf, startSurf, endSurf,
        volDates, volStrikes, spotRate, domCurve,
        forCurve, "", "MR_EX_SURF_RESULT");
    print(volResultHandle);
    print(caplib::getObjectCacheJson("FxVolatilitySurface", "MR_EX_SURF_RESULT"));
} catch(ex) {
    writeLog("buildHistSimFxVolSurface not supported by current server: " + ex);
}

// -----------------------------------------------------------------------------
// 3. calcVaR
//    Signature: (profitLossSamples DOUBLE[], probability DOUBLE (0..1),
//                antithetic BOOL) -> DICTIONARY {value_at_risk, value_at_risk_mirrored}
//    Positive output = loss at the given confidence level.
// -----------------------------------------------------------------------------
profitLossSamples = [-100.0, -50.0, 0.0, 50.0, 100.0];

var95 = caplib::calcVaR(profitLossSamples, 0.95, false);   // v.value_at_risk frozen reference: 90
var50 = caplib::calcVaR(profitLossSamples, 0.50, false);   // v.value_at_risk frozen reference: 0
print(var95.value_at_risk);
print(var95.value_at_risk_mirrored);
print(var50.value_at_risk);

// antithetic=true runs the symmetric-sample path.
print(caplib::calcVaR(profitLossSamples, 0.95, true).value_at_risk_mirrored);

// -----------------------------------------------------------------------------
// 4. calcExpectedShortfall
//    Signature: (profitLossSamples DOUBLE[], probability DOUBLE (0..1),
//                antithetic BOOL) -> DICTIONARY {expected_shortfall, expected_shortfall_mirrored}
//    Average loss beyond the VaR threshold (conditional tail expectation).
// -----------------------------------------------------------------------------
es95 = caplib::calcExpectedShortfall(profitLossSamples, 0.95, false);  // frozen reference: 0
es50 = caplib::calcExpectedShortfall(profitLossSamples, 0.50, false);  // frozen reference: -50
print(es95.expected_shortfall);
print(es95.expected_shortfall_mirrored);
print(es50.expected_shortfall);
print(caplib::calcExpectedShortfall(profitLossSamples, 0.95, true).expected_shortfall_mirrored);
