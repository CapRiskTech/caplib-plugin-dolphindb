// ============================================================================
// test_createFlatIrYieldCurve.dos
// Per-function test suite for caplib::createFlatIrYieldCurve (ir).
// Signature: caplib::createFlatIrYieldCurve(referenceDate DATE, currency STRING, rate DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createFlatIrYieldCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFlatIrYieldCurve -> handle"
result = caplib::createFlatIrYieldCurve(irAsOfDate, "CNY", 0.02, "TF_FIR", false)
assert 1, result == "TF_FIR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFlatIrYieldCurve rejects missing argument", syntaxError=1
caplib::createFlatIrYieldCurve(2024.01.01, "X", 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFlatIrYieldCurve rejects extra argument", syntaxError=1
caplib::createFlatIrYieldCurve(2024.01.01, "X", 0.02, "TF_createFlatIrYieldCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatIrYieldCurve("bad", "X", 0.02, "TF_createFlatIrYieldCurve_H", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects wrong type for currency", exception=1
caplib::createFlatIrYieldCurve(2024.01.01, 1, 0.02, "TF_createFlatIrYieldCurve_H", false)

// 用例目的：参数 rate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects wrong type for rate", exception=1
caplib::createFlatIrYieldCurve(2024.01.01, "X", "bad", "TF_createFlatIrYieldCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects null referenceDate", exception=1
caplib::createFlatIrYieldCurve(date(), "X", 0.02, "TF_createFlatIrYieldCurve_H", false)

// 用例目的：参数 rate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects null rate", exception=1
caplib::createFlatIrYieldCurve(2024.01.01, "X", double(), "TF_createFlatIrYieldCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFlatIrYieldCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatIrYieldCurve([2024.01.01], "X", 0.02, "TF_createFlatIrYieldCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFlatIrYieldCurve rejects keyword arguments", syntaxError=1
caplib::createFlatIrYieldCurve(referenceDate=2024.01.01, currency="X", rate=0.02, handle="TF_createFlatIrYieldCurve_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFlatIrYieldCurve optional returnJson null uses default"
result = caplib::createFlatIrYieldCurve(irAsOfDate, "CNY", 0.02, "TF_FIR", bool())
assert 1, typestr(result) != "VOID"
