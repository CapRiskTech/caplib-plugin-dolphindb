// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createFlatIrYieldCurve valid call"
result = caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_CURVE", false)
assert 1, result == "TF_FLAT_IR_CURVE"

@testing:case="createFlatIrYieldCurve omitted returnJson uses default"
assert 1, caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_OMIT") == "TF_FLAT_IR_OMIT"

@testing:case="createFlatIrYieldCurve null returnJson uses default"
assert 1, caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_NULL", bool()) == "TF_FLAT_IR_NULL"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createFlatIrYieldCurve rejects missing argument", syntaxError=1
caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02)

@testing:case="createFlatIrYieldCurve rejects extra argument", syntaxError=1
caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_CURVE", false, 1)

@testing:case="createFlatIrYieldCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatIrYieldCurve("bad", "CNY", 0.02, "TF_FLAT_IR_CURVE", false)

@testing:case="createFlatIrYieldCurve rejects wrong type for currency", exception=1
caplib::createFlatIrYieldCurve(asOfDate, 1, 0.02, "TF_FLAT_IR_CURVE", false)

@testing:case="createFlatIrYieldCurve rejects wrong type for rate", exception=1
caplib::createFlatIrYieldCurve(asOfDate, "CNY", "bad", "TF_FLAT_IR_CURVE", false)

@testing:case="createFlatIrYieldCurve rejects null referenceDate", exception=1
caplib::createFlatIrYieldCurve(date(), "CNY", 0.02, "TF_FLAT_IR_CURVE", false)

@testing:case="createFlatIrYieldCurve rejects null rate", exception=1
caplib::createFlatIrYieldCurve(asOfDate, "CNY", double(), "TF_FLAT_IR_CURVE", false)

@testing:case="createFlatIrYieldCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatIrYieldCurve([2024.01.01], "CNY", 0.02, "TF_FLAT_IR_CURVE", false)
