// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

flatIrCurve = caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_CURVE", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getDiscountFactor -> flat 2% curve reference values"
discountFactors = caplib::getDiscountFactor(flatIrCurve, curveDates);
assert 1, isDoubleVector(discountFactors) &&
    abs(discountFactors[0] - 0.9999452069806444) < 1.0e-9 &&
    abs(discountFactors[1] - 0.9416613321670505) < 1.0e-9

@testing:case="getDiscountFactor rejects wrong curve handle type", exception=1
caplib::getDiscountFactor("TF_HANDLE_DOES_NOT_EXIST", curveDates)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getDiscountFactor rejects missing argument", syntaxError=1
caplib::getDiscountFactor(flatIrCurve)

@testing:case="getDiscountFactor rejects extra argument", syntaxError=1
caplib::getDiscountFactor(flatIrCurve, curveDates, 1)

@testing:case="getDiscountFactor rejects partially-null vector dates", exception=1
caplib::getDiscountFactor(flatIrCurve, [2024.01.01, date()])

@testing:case="getDiscountFactor rejects empty vector dates", exception=1
caplib::getDiscountFactor(flatIrCurve, take(date, 0))

@testing:case="getDiscountFactor rejects nonexistent handle irCurveHandle", exception=1
caplib::getDiscountFactor("TF_HANDLE_DOES_NOT_EXIST", curveDates)

@testing:case="getDiscountFactor rejects keyword arguments", syntaxError=1
caplib::getDiscountFactor(irCurveHandle=flatIrCurve, dates=curveDates)
