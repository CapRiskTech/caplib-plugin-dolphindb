// ============================================================================
// test_createIrCrossCcyMktDataSet.dos
// Per-function test suite for caplib::createIrCrossCcyMktDataSet (ir).
// Signature: caplib::createIrCrossCcyMktDataSet(asOfDate DATE, baseDiscountCurveHandle STRING, underlyingInterestRates STRING[], forwardCurveHandles STRING[], crossCcyDiscountCurveHandle STRING, fxSpotHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrCrossCcyMktDataSet.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

usdCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.03, 0.035],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_SOFR", "TF_USD_CURVE", false);
fxSpot = caplib::createFxSpotRate(6.9, "USD", "CNY", irAsOfDate, 2022.03.16, "TF_FXSPOT", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrCrossCcyMktDataSet -> handle + json"
xmd = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", true);
assert 1, isHandleJson(xmd, "TF_IR_XMKT")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrCrossCcyMktDataSet rejects missing argument", syntaxError=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X"], ["X"], "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrCrossCcyMktDataSet rejects extra argument", syntaxError=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 asOfDate。
@testing:case="createIrCrossCcyMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createIrCrossCcyMktDataSet("bad", irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_NEG", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 asOfDate。
@testing:case="createIrCrossCcyMktDataSet rejects null asOfDate", exception=1
caplib::createIrCrossCcyMktDataSet(date(), irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_NEG", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 asOfDate。
// 用例目的：createIrCrossCcyMktDataSet rejects vector for scalar asOfDate —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts vector for scalar asOfDate (no validation)"
rT_arasOfDate = caplib::createIrCrossCcyMktDataSet([2024.01.01], irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_NEG", false)
assert 1, typestr(rT_arasOfDate) != "VOID"

// 用例目的：向量参数 underlyingInterestRates 传入标量，验证数据形式校验。
// 前置句柄参数改用 setup 合法值；标量句柄被宽松接受（requireVector 不限制标量形式），固定断言返回句柄。
@testing:case="accepts createIrCrossCcyMktDataSet scalar for vector underlyingInterestRates (no form validation)"
rUnderScalar = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, irCurve, [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_UNDER_SCALAR", false)
assert 1, typestr(rUnderScalar) != "VOID"

// 用例目的：向量参数 underlyingInterestRates 传入部分空值的向量，验证向量空值校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 underlyingInterestRates。
@testing:case="createIrCrossCcyMktDataSet rejects partially-null vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [string(), "X"], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_NEG", false)

// 用例目的：向量参数 underlyingInterestRates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 underlyingInterestRates。
@testing:case="createIrCrossCcyMktDataSet rejects empty vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, take(string, 0), [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_NEG", false)

// 用例目的：句柄参数 baseDiscountCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 baseDiscountCurveHandle。
@testing:case="createIrCrossCcyMktDataSet rejects nonexistent handle baseDiscountCurveHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, "TF_NO_SUCH_HANDLE_createIrCrossCcyMktDataSet", [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：句柄参数 crossCcyDiscountCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 crossCcyDiscountCurveHandle。
@testing:case="createIrCrossCcyMktDataSet rejects nonexistent handle crossCcyDiscountCurveHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_NO_SUCH_XC_DISCOUNT", fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：句柄参数 fxSpotHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）。
// 前置句柄参数改用 setup 合法值，确保校验命中目标参数 fxSpotHandle。
@testing:case="createIrCrossCcyMktDataSet rejects nonexistent handle fxSpotHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, "TF_NO_SUCH_FXSPOT", "TF_IR_XMKT", false)

// 用例目的：句柄参数 baseDiscountCurveHandle 传入类型不符的 FxSpotRate 句柄，验证句柄对象类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong object type for baseDiscountCurveHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, fxSpot[0], [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrCrossCcyMktDataSet rejects keyword arguments", syntaxError=1
caplib::createIrCrossCcyMktDataSet(asOfDate=2024.01.01, baseDiscountCurveHandle="X", underlyingInterestRates=["X"], forwardCurveHandles=["X"], crossCcyDiscountCurveHandle="X", fxSpotHandle="X", handle="TF_createIrCrossCcyMktDataSet_H", returnJson=false)
// 用例目的：向量参数 underlyingInterestRates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects all-null vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [string(), string(), string()], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrCrossCcyMktDataSet optional returnJson null uses default"
result = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 forwardCurveHandles 传标量句柄 irCurve（而非向量），requireVector 要求向量形式（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects scalar for vector forwardCurveHandles", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], irCurve, usdCurve, fxSpot[0], "TF_IR_XMKT_FWD_SCALAR", false)

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（forwardCurveHandles 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects forwardCurveHandles length mismatch", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve, "EXTRA"], usdCurve, fxSpot[0], "TF_IR_XMKT", true);

// 用例目的：可选参数 returnJson 传入 STRING 而非 BOOL，验证 BOOL 类型校验（预期：抛异常）。
// 前置句柄参数全部用 setup 合法值，确保校验命中目标参数 returnJson。
@testing:case="createIrCrossCcyMktDataSet rejects wrong type for returnJson", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_RJ", "bad")

// 用例目的：asOfDate 传入晚于曲线到期日的日期（2030.01.01），文档注明「包装器不检查此关系」，固定断言返回句柄
@testing:case="createIrCrossCcyMktDataSet accepts late asOfDate (wrapper does not check relationship)"
rLateXmkt = caplib::createIrCrossCcyMktDataSet(2030.01.01, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT_LATE", false)
assert 1, typestr(rLateXmkt) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill (round 2 续)： forwardCurveHandles / 句柄类型 / 输出句柄类型
// ----------------------------------------------------------------------------

// 用例目的：句柄向量参数 forwardCurveHandles 内传入不存在的句柄字符串，验证句柄存在性校验
// （源码逐元素从 IrYieldCurve ObjectCache Retrieve，未命中抛异常）（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects nonexistent handle in forwardCurveHandles", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], ["TF_NO_SUCH_HANDLE_createIrCrossCcyMktDataSet_forwardCurveHandles"], usdCurve, fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：句柄向量参数 forwardCurveHandles 内传入类型不符的真实句柄（FxSpotRate 而非
// IrYieldCurve），验证句柄对象类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong object type in forwardCurveHandles", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [fxSpot[0]], usdCurve, fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：句柄参数 crossCcyDiscountCurveHandle 传入类型不符的真实句柄（FxSpotRate 而非
// IrYieldCurve），验证句柄对象类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong object type for crossCcyDiscountCurveHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], fxSpot[0], fxSpot[0], "TF_IR_XMKT", false)

// 用例目的：句柄参数 fxSpotHandle 传入类型不符的真实句柄（IrYieldCurve 而非 FxSpotRate），
// 验证句柄对象类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong object type for fxSpotHandle", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, irCurve, "TF_IR_XMKT", false)

// 用例目的：输出句柄参数 handle 传入非 STRING（INT 123）—— 源码对 args[6] 仅做 bare
// getString() 无类型校验，实测宽松接受，记录实际行为
@testing:case="accepts createIrCrossCcyMktDataSet wrong type for handle (no validation)"
r2_xmkt_handle = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], 123, false)
assert 1, typestr(r2_xmkt_handle) != "VOID"
