// ============================================================================
// test_createIrCrossCcyMktDataSet.dos
// Per-function test suite for caplib::createIrCrossCcyMktDataSet (ir).
// Signature: caplib::createIrCrossCcyMktDataSet(asOfDate DATE, baseDiscountCurveHandle STRING, underlyingInterestRates STRING[], forwardCurveHandles STRING[], crossCcyDiscountCurveHandle STRING, fxSpotHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrCrossCcyMktDataSet.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

usdCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.03, 0.035],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_SOFR", "TF_USD_CURVE", false);
fxSpot = caplib::createFxSpotRate(6.9, "USD", "CNY", irAsOfDate, 2022.03.16, "TF_FXSPOT", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrCrossCcyMktDataSet -> handle + json"
xmd = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", true);
assert 1, isHandleJson(xmd, "TF_IR_XMKT")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrCrossCcyMktDataSet rejects missing argument", syntaxError=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X"], ["X"], "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrCrossCcyMktDataSet rejects extra argument", syntaxError=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createIrCrossCcyMktDataSet("bad", "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects null asOfDate", exception=1
caplib::createIrCrossCcyMktDataSet(date(), "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects vector for scalar asOfDate", exception=1
caplib::createIrCrossCcyMktDataSet([2024.01.01], "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：向量参数 underlyingInterestRates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects scalar for vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：向量参数 underlyingInterestRates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects partially-null vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", ["X", string()], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：向量参数 underlyingInterestRates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects empty vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "X", take(string, 0), ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：句柄参数 baseDiscountCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects nonexistent handle baseDiscountCurveHandle", exception=1
caplib::createIrCrossCcyMktDataSet(2024.01.01, "TF_NO_SUCH_HANDLE_createIrCrossCcyMktDataSet", ["X"], ["X"], "X", "X", "TF_createIrCrossCcyMktDataSet_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrCrossCcyMktDataSet rejects keyword arguments", syntaxError=1
caplib::createIrCrossCcyMktDataSet(asOfDate=2024.01.01, baseDiscountCurveHandle="X", underlyingInterestRates=["X"], forwardCurveHandles=["X"], crossCcyDiscountCurveHandle="X", fxSpotHandle="X", handle="TF_createIrCrossCcyMktDataSet_H", returnJson=false)
// 用例目的：向量参数 underlyingInterestRates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects all-null vector underlyingInterestRates", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [string(), string(), string()], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrCrossCcyMktDataSet optional returnJson null uses default"
result = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpot[0], "TF_IR_XMKT", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createIrCrossCcyMktDataSet accepts rejects wrong object type for forwardCurveHandles", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], irCurve, usdCurve, fxSpot[0], "TF_IR_XMKT", true)
// 用例目的：句柄参数 forwardCurveHandles 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects wrong object type for forwardCurveHandles", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], irCurve, usdCurve, fxSpot[0], "TF_IR_XMKT", true)

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（forwardCurveHandles 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createIrCrossCcyMktDataSet rejects forwardCurveHandles length mismatch", exception=1
caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve, "EXTRA"], usdCurve, fxSpot[0], "TF_IR_XMKT", true);
