@testing:case="createInterestCalcScheduleDefinition accepts invalid enum stubPolicy (maps to invalid sentinel)"
result = caplib::createInterestCalcScheduleDefinition("X", "X", "X", "NOT_A_VALID_ENUM_LABEL", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)
assert 1, typestr(result) != "VOID"


