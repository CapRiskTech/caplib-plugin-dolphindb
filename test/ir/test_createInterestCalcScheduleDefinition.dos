// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createInterestCalcScheduleDefinition valid call"
result = caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)
assert 1, result == "TF_createInterestCalcScheduleDefinition_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createInterestCalcScheduleDefinition rejects missing argument", syntaxError=1
caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X")

@testing:case="createInterestCalcScheduleDefinition rejects extra argument", syntaxError=1
caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false, 1)

@testing:case="createInterestCalcScheduleDefinition rejects wrong type for calendars", exception=1
caplib::createInterestCalcScheduleDefinition(1, "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

@testing:case="createInterestCalcScheduleDefinition rejects wrong type for frequency", exception=1
caplib::createInterestCalcScheduleDefinition("X", 1, "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

@testing:case="createInterestCalcScheduleDefinition rejects wrong type for interestDayConvention", exception=1
caplib::createInterestCalcScheduleDefinition("X", "X", 1, "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

@testing:case="createInterestCalcScheduleDefinition rejects vector for scalar calendars", exception=1
caplib::createInterestCalcScheduleDefinition(["X"], "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

@testing:case="createInterestCalcScheduleDefinition rejects keyword arguments", syntaxError=1
caplib::createInterestCalcScheduleDefinition(calendars="X", frequency="X", interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", dateRollConvention="X", tag="TF_createInterestCalcScheduleDefinition_H", returnJson=false)



