// ============================================================================
// test_createInterestCalcScheduleDefinition.dos
// Per-function test suite for caplib::createInterestCalcScheduleDefinition (ir).
// Signature: caplib::createInterestCalcScheduleDefinition(calendars STRING, frequency STRING, interestDayConvention STRING, stubPolicy STRING, brokenPeriodType STRING, dateRollConvention STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createInterestCalcScheduleDefinition.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createInterestCalcScheduleDefinition valid call"
result = caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)
assert 1, result == "TF_createInterestCalcScheduleDefinition_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createInterestCalcScheduleDefinition rejects missing argument", syntaxError=1
caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createInterestCalcScheduleDefinition rejects extra argument", syntaxError=1
caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false, 1)

// 用例目的：参数 calendars 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestCalcScheduleDefinition rejects wrong type for calendars", exception=1
caplib::createInterestCalcScheduleDefinition(1, "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

// 用例目的：参数 frequency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestCalcScheduleDefinition rejects wrong type for frequency", exception=1
caplib::createInterestCalcScheduleDefinition("X", 1, "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

// 用例目的：参数 interestDayConvention 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestCalcScheduleDefinition rejects wrong type for interestDayConvention", exception=1
caplib::createInterestCalcScheduleDefinition("X", "X", 1, "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

// 用例目的：标量参数 calendars 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createInterestCalcScheduleDefinition rejects vector for scalar calendars", exception=1
caplib::createInterestCalcScheduleDefinition(["X"], "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createInterestCalcScheduleDefinition rejects keyword arguments", syntaxError=1
caplib::createInterestCalcScheduleDefinition(calendars="X", frequency="X", interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", dateRollConvention="X", tag="TF_createInterestCalcScheduleDefinition_H", returnJson=false)
// 用例目的：accepts invalid enum stubPolicy (maps to invalid sentinel)（预期：插件按文档行为执行）
@testing:case="createInterestCalcScheduleDefinition accepts invalid enum stubPolicy (maps to invalid sentinel)"
result = caplib::createInterestCalcScheduleDefinition("X", "X", "X", "NOT_A_VALID_ENUM_LABEL", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)
assert 1, typestr(result) != "VOID"
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createInterestCalcScheduleDefinition optional returnJson null uses default"
result = caplib::createInterestCalcScheduleDefinition("X", "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 stubPolicy 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createInterestCalcScheduleDefinition supports all stubPolicy enums"
labelEnum = ["INITIAL", "FINAL", "INITIAL_FINAL_FORWARD", "INITIAL_FINAL_BACKWARD"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createInterestCalcScheduleDefinition("X", "X", "X", labelEnum[i], "X", "X", "TF_createInterestCalcScheduleDefinition_H", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createInterestCalcScheduleDefinition rejects null calendars", exception=1
caplib::createInterestCalcScheduleDefinition(string(), "X", "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)

// 用例目的：参数传入错误类型/空值（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createInterestCalcScheduleDefinition rejects null frequency", exception=1
caplib::createInterestCalcScheduleDefinition("X", string(), "X", "X", "X", "X", "TF_createInterestCalcScheduleDefinition_H", false)
