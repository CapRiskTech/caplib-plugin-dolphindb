// ============================================================================
// test_createIrVanillaInstrumentTemplate.dos
// Per-function test suite for caplib::createIrVanillaInstrumentTemplate (ir).
// Signature: caplib::createIrVanillaInstrumentTemplate(instType STRING, instName STRING, startConvention STRING, startDelay INT, legDefinitions STRING[], tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrVanillaInstrumentTemplate.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(irCurrency, "ANALYTICAL", 1, 1, take(0, 0), irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrVanillaInstrumentTemplate swap -> [handle, json]"
r = caplib::createIrVanillaInstrumentTemplate("IR_VANILLA_SWAP", "TF_IR_VIT", "SPOTSTART", 1, [irFixedLeg[0], irFloatingLeg[0]], "TF_IR_VIT", true);
assert 1, isHandleJson(r, "TF_IR_VIT")

@testing:case="createIrVanillaInstrumentTemplate capfloor variant"
r2 = caplib::createIrVanillaInstrumentTemplate("IR_CAP_FLOOR", "TF_IR_VIT_CF", "SPOTSTART", 1, [irFloatingLeg[0]], "TF_IR_VIT_CF", true);
assert 1, isHandleJson(r2, "TF_IR_VIT_CF")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createIrVanillaInstrumentTemplate rejects missing argument", syntaxError=1
caplib::createIrVanillaInstrumentTemplate("X", "X", "X", 1, ["X"])

@testing:case="createIrVanillaInstrumentTemplate rejects extra argument", syntaxError=1
caplib::createIrVanillaInstrumentTemplate("X", "X", "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false, 1)

@testing:case="createIrVanillaInstrumentTemplate rejects wrong type for instType", exception=1
caplib::createIrVanillaInstrumentTemplate(1, "X", "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects wrong type for instName", exception=1
caplib::createIrVanillaInstrumentTemplate("X", 1, "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects wrong type for startConvention", exception=1
caplib::createIrVanillaInstrumentTemplate("X", "X", 1, 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects null instType", exception=1
caplib::createIrVanillaInstrumentTemplate(string(), "X", "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects null instName", exception=1
caplib::createIrVanillaInstrumentTemplate("X", string(), "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects vector for scalar instType", exception=1
caplib::createIrVanillaInstrumentTemplate(["X"], "X", "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects scalar for vector legDefinitions", exception=1
caplib::createIrVanillaInstrumentTemplate("X", "X", "X", 1, ["X"], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects partially-null vector legDefinitions", exception=1
caplib::createIrVanillaInstrumentTemplate("X", "X", "X", 1, ["X", string()], "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects empty vector legDefinitions", exception=1
caplib::createIrVanillaInstrumentTemplate("X", "X", "X", 1, take(string, 0), "TF_createIrVanillaInstrumentTemplate_H", false)

@testing:case="createIrVanillaInstrumentTemplate rejects keyword arguments", syntaxError=1
caplib::createIrVanillaInstrumentTemplate(instType="X", instName="X", startConvention="X", startDelay=1, legDefinitions=["X"], tag="TF_createIrVanillaInstrumentTemplate_H", returnJson=false)
@testing:case="createIrVanillaInstrumentTemplate rejects all-null vector legDefinitions", exception=1
caplib::createIrVanillaInstrumentTemplate("IR_VANILLA_SWAP", "TF_IR_VIT", "SPOTSTART", 1, [string(), string(), string()], "TF_IR_VIT", true)


@testing:case="createIrVanillaInstrumentTemplate rejects invalid enum for instType", exception=1
caplib::createIrVanillaInstrumentTemplate("NOT_A_VALID_ENUM_LABEL", "TF_IR_VIT", "SPOTSTART", 1, [irFixedLeg[0], irFloatingLeg[0]], "TF_IR_VIT", true)
@testing:case="createIrVanillaInstrumentTemplate optional returnJson null uses default"
result = caplib::createIrVanillaInstrumentTemplate("IR_VANILLA_SWAP", "TF_IR_VIT", "SPOTSTART", 1, [irFixedLeg[0], irFloatingLeg[0]], "TF_IR_VIT", bool())
assert 1, typestr(result) != "VOID"
@testing:case="createIrVanillaInstrumentTemplate rejects negative startDelay", exception=1
caplib::createIrVanillaInstrumentTemplate("IR_VANILLA_SWAP", "TF_IR_VIT", "SPOTSTART", -1.0, [irFixedLeg[0], irFloatingLeg[0]], "TF_IR_VIT", true)

