// ============================================================================
// test_createXccyIrRiskSettings.dos
// Per-function test suite for caplib::createXccyIrRiskSettings (ir).
// Signature: caplib::createXccyIrRiskSettings(irCurveRiskSettingsHandle STRING, fxRiskSettingsHandle STRING, thetaRiskSettingsHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createXccyIrRiskSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createXccyIrRiskSettings -> handle"
result = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_XCCY", false)
assert 1, result == "TF_XCCY"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createXccyIrRiskSettings rejects missing argument", syntaxError=1
caplib::createXccyIrRiskSettings("X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createXccyIrRiskSettings rejects extra argument", syntaxError=1
caplib::createXccyIrRiskSettings("X", "X", "X", "TF_createXccyIrRiskSettings_H", false, 1)

// 用例目的：句柄参数 irCurveRiskSettingsHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects nonexistent handle irCurveRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings("TF_NO_SUCH_HANDLE_createXccyIrRiskSettings", "X", "X", "TF_createXccyIrRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createXccyIrRiskSettings rejects keyword arguments", syntaxError=1
caplib::createXccyIrRiskSettings(irCurveRiskSettingsHandle="X", fxRiskSettingsHandle="X", thetaRiskSettingsHandle="X", handle="TF_createXccyIrRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createXccyIrRiskSettings optional returnJson null uses default"
result = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_XCCY", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 fxRiskSettingsHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects wrong object type for fxRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(irCurveRisk, irCurveRisk, irThetaRisk, "TF_XCCY", false)

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects wrong type for irCurveRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(1, irPriceRisk, irThetaRisk, "TF_XCCY", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects null irCurveRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(string(), irPriceRisk, irThetaRisk, "TF_XCCY", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects wrong type for fxRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(irCurveRisk, 1, irThetaRisk, "TF_XCCY", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects null fxRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(irCurveRisk, string(), irThetaRisk, "TF_XCCY", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 irCurveRiskSettingsHandle 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createXccyIrRiskSettings rejects vector for scalar irCurveRiskSettingsHandle", exception=1
caplib::createXccyIrRiskSettings(["X"], irPriceRisk, irThetaRisk, "TF_XCCY", false);
