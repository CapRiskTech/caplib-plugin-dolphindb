// ============================================================================
// test_getZeroRate.dos
// Per-function test suite for caplib::getZeroRate (ir).
// Signature: caplib::getZeroRate(irCurveHandle STRING, dates DATE[])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_getZeroRate.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回向量的形态与数值
@testing:case="getZeroRate -> vector"
r = caplib::getZeroRate(irCurve, [2025.03.10])
assert 1, isDoubleVector(r) && size(r) >= 1

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="getZeroRate rejects missing argument", syntaxError=1
caplib::getZeroRate("X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="getZeroRate rejects extra argument", syntaxError=1
caplib::getZeroRate("X", [2024.01.01], 1)

// 用例目的：向量参数 dates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="getZeroRate rejects scalar for vector dates", exception=1
caplib::getZeroRate("X", [2024.01.01])

// 用例目的：向量参数 dates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="getZeroRate rejects partially-null vector dates", exception=1
caplib::getZeroRate("X", [2024.01.01, date()])

// 用例目的：向量参数 dates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="getZeroRate rejects empty vector dates", exception=1
caplib::getZeroRate("X", take(date, 0))

// 用例目的：句柄参数 irCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="getZeroRate rejects nonexistent handle irCurveHandle", exception=1
caplib::getZeroRate("TF_NO_SUCH_HANDLE_getZeroRate", [2024.01.01])
// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="getZeroRate rejects keyword arguments", syntaxError=1
caplib::getZeroRate(irCurveHandle="X", dates=[2024.01.01])
// 用例目的：向量参数 dates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="getZeroRate rejects all-null vector dates", exception=1
caplib::getZeroRate(irCurve, [date(), date(), date()])
// 用例目的：正常调用，与独立解析公式（闭式解）计算的参考值对比，验证计算正确性
@testing:case="getZeroRate -> analytic flat-curve reference"
// The zero rate of a flat curve equals the flat rate at any t.
flatIrRef = caplib::createFlatIrYieldCurve(irAsOfDate, "CNY", 0.02, "TF_REF_FIR", false);
zrr = caplib::getZeroRate(flatIrRef, [2023.03.09]);
assert 1, abs(zrr[0] - 0.02) < 1.0e-12
// 用例目的：大向量边界——分别用 1024 和 65536 个日期查询，验证规模与数值正确
@testing:case="getZeroRate supports 1024/65536-date query vectors"
flatBig = caplib::createFlatIrYieldCurve(irAsOfDate, "CNY", 0.02, "TF_BIG_FIR", false);
datesBig = 2023.03.09 + 0..1023;
zbig = caplib::getZeroRate(flatBig, datesBig);
assert 1, size(zbig) == 1024 && abs(zbig[0] - 0.02) < 1.0e-12 && abs(zbig[1023] - 0.02) < 1.0e-12
// 65536 elements within the valid date range (cycled)
datesHuge = 2023.03.09 + ((0..65535) % 50000);
zhuge = caplib::getZeroRate(flatBig, datesHuge);
assert 1, size(zhuge) == 65536 && abs(zhuge[0] - 0.02) < 1.0e-12 && abs(zhuge[65535] - 0.02) < 1.0e-12

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="getZeroRate rejects wrong type for irCurveHandle", exception=1
caplib::getZeroRate(1, [2025.03.10])

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="getZeroRate rejects null irCurveHandle", exception=1
caplib::getZeroRate(string(), [2025.03.10])

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="getZeroRate rejects wrong type for dates", exception=1
caplib::getZeroRate(irCurve, "bad")

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="getZeroRate rejects null dates", exception=1
caplib::getZeroRate(irCurve, date())

// 用例目的：相同输入连续调用两次，验证两次返回结果完全一致（计算确定性）
@testing:case="getZeroRate deterministic repeat -> identical result"
r1 = caplib::getZeroRate(irCurve, [2025.03.10]);
r2 = caplib::getZeroRate(irCurve, [2025.03.10]);
assert 1, max(abs(r1 - r2)) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：以加倍的利率/波动率参数重建同一曲线后再查询，验证查询结果随输入变化
@testing:case="getZeroRate rebuilt curve (2x rate) -> result changes"
r1 = caplib::getZeroRate(irCurve, [2025.03.10]);
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.04, 0.05],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);
r2 = caplib::getZeroRate(irCurve, [2025.03.10]);
assert 1, max(abs(r1 - r2)) > 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：句柄参数 irCurveHandle 传入类型不符的对象句柄（createCalendar），验证句柄类型校验（预期：抛异常）
@testing:case="getZeroRate rejects wrong object type for irCurveHandle", exception=1
caplib::getZeroRate(calendarCreated[0], [2025.03.10]);
