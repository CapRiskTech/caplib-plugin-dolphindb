// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createInterestPaymentScheduleDefinition valid call"
result = caplib::createInterestPaymentScheduleDefinition("X", "X", "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)
assert 1, result == "TF_createInterestPaymentScheduleDefinition_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createInterestPaymentScheduleDefinition rejects missing argument", syntaxError=1
caplib::createInterestPaymentScheduleDefinition("X", "X", "X", 1, "X")

@testing:case="createInterestPaymentScheduleDefinition rejects extra argument", syntaxError=1
caplib::createInterestPaymentScheduleDefinition("X", "X", "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false, 1)

@testing:case="createInterestPaymentScheduleDefinition rejects wrong type for calendars", exception=1
caplib::createInterestPaymentScheduleDefinition(1, "X", "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)

@testing:case="createInterestPaymentScheduleDefinition rejects wrong type for frequency", exception=1
caplib::createInterestPaymentScheduleDefinition("X", 1, "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)

@testing:case="createInterestPaymentScheduleDefinition rejects wrong type for payDayMode", exception=1
caplib::createInterestPaymentScheduleDefinition("X", "X", 1, 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)

@testing:case="createInterestPaymentScheduleDefinition rejects null payDayOffset", exception=1
caplib::createInterestPaymentScheduleDefinition("X", "X", "X", int(), "X", "TF_createInterestPaymentScheduleDefinition_H", false)

@testing:case="createInterestPaymentScheduleDefinition rejects vector for scalar calendars", exception=1
caplib::createInterestPaymentScheduleDefinition(["X"], "X", "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)

@testing:case="createInterestPaymentScheduleDefinition rejects keyword arguments", syntaxError=1
caplib::createInterestPaymentScheduleDefinition(calendars="X", frequency="X", payDayMode="X", payDayOffset=1, payDayConvention="X", tag="TF_createInterestPaymentScheduleDefinition_H", returnJson=false)



// ----------------------------------------------------------------------------
// Review wave-1 additions (wiki test-case review)
// ----------------------------------------------------------------------------

@testing:case="createInterestPaymentScheduleDefinition accepts invalid enum payDayMode (maps to invalid sentinel)"
result = caplib::createInterestPaymentScheduleDefinition("X", "X", "NOT_A_VALID_ENUM_LABEL", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false)
assert 1, typestr(result) != "VOID"


// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createInterestPaymentScheduleDefinition optional returnJson null uses default"
result = caplib::createInterestPaymentScheduleDefinition("X", "X", "X", 1, "X", "TF_createInterestPaymentScheduleDefinition_H", bool())
assert 1, typestr(result) != "VOID"



// ----------------------------------------------------------------------------
// Review wave-5b additions (enum sweeps)
// ----------------------------------------------------------------------------

@testing:case="createInterestPaymentScheduleDefinition supports all payDayMode enums"
labelEnum = ["IN_ADVANCE", "IN_ARREAR"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createInterestPaymentScheduleDefinition("X", "X", labelEnum[i], 1, "X", "TF_createInterestPaymentScheduleDefinition_H", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum



