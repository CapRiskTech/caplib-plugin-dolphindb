// ============================================================================
// test_createIrParRateCurve.dos
// Per-function test suite for caplib::createIrParRateCurve (ir).
// Signature: caplib::createIrParRateCurve(asOfDate DATE, currency STRING, curveName STRING, instNames STRING[], instTypes STRING[], instTerms STRING[], factors DOUBLE[], quotes DOUBLE[], handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrParRateCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrParRateCurve -> [handle, json]"
prc = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", true);
assert 1, isHandleJson(prc, "TF_IR_PAR")

// 用例目的：rejects lengths mismatch（预期：插件按文档行为执行）
@testing:case="createIrParRateCurve rejects lengths mismatch", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName], ["DEPOSIT"], ["3M"], [100.0], [0.023], "TF_IR_PAR_BAD", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrParRateCurve rejects missing argument", syntaxError=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrParRateCurve rejects extra argument", syntaxError=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for asOfDate", exception=1
caplib::createIrParRateCurve("bad", "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for currency", exception=1
caplib::createIrParRateCurve(2024.01.01, 1, "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for curveName", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", 1, ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects null asOfDate", exception=1
caplib::createIrParRateCurve(date(), "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 currency 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects null currency", exception=1
caplib::createIrParRateCurve(2024.01.01, string(), "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects vector for scalar asOfDate", exception=1
caplib::createIrParRateCurve([2024.01.01], "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：向量参数 instNames 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects scalar for vector instNames", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：向量参数 instNames 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects partially-null vector instNames", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X", string()], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：向量参数 instNames 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects empty vector instNames", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", take(string, 0), ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrParRateCurve rejects keyword arguments", syntaxError=1
caplib::createIrParRateCurve(asOfDate=2024.01.01, currency="X", curveName="X", instNames=["X"], instTypes=["X"], instTerms=["X"], factors=[0.02], quotes=[0.02], handle="TF_createIrParRateCurve_H", returnJson=false)
// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createIrParRateCurve accepts all-null vector instNames", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [string(), string(), string()], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrParRateCurve optional returnJson null uses default"
result = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", bool())
assert 1, typestr(result) != "VOID"
