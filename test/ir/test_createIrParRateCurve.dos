// ============================================================================
// test_createIrParRateCurve.dos
// Per-function test suite for caplib::createIrParRateCurve (ir).
// Signature: caplib::createIrParRateCurve(asOfDate DATE, currency STRING, curveName STRING, instNames STRING[], instTypes STRING[], instTerms STRING[], factors DOUBLE[], quotes DOUBLE[], handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrParRateCurve.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrParRateCurve -> [handle, json]"
prc = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", true);
assert 1, isHandleJson(prc, "TF_IR_PAR")

// 用例目的：rejects lengths mismatch（预期：插件按文档行为执行）
@testing:case="createIrParRateCurve rejects lengths mismatch", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName], ["DEPOSIT"], ["3M"], [100.0], [0.023], "TF_IR_PAR_BAD", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrParRateCurve rejects missing argument", syntaxError=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrParRateCurve rejects extra argument", syntaxError=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for asOfDate", exception=1
caplib::createIrParRateCurve("bad", "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for currency", exception=1
caplib::createIrParRateCurve(2024.01.01, 1, "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for curveName", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", 1, ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects null asOfDate", exception=1
caplib::createIrParRateCurve(date(), "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：参数 currency 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects null currency", exception=1
caplib::createIrParRateCurve(2024.01.01, string(), "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects vector for scalar asOfDate", exception=1
caplib::createIrParRateCurve([2024.01.01], "X", "X", ["X"], ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：向量参数 instNames 传入标量（其余参数用 setup 合法值），验证数据形式校验（预期：抛异常）
// 用例目的：createIrParRateCurve rejects scalar for vector instNames —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts scalar for vector instNames (no validation)"
rT_rinstNames = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, "X", ["DEPOSIT"], ["3M"], [100.0], [0.023], "TF_IR_PAR_BAD", true)
assert 1, typestr(rT_rinstNames) != "VOID"

// 用例目的：instNames 与其他四组向量保持等长但包含空元素，验证空元素校验（预期：抛异常；此前各向量长度同时不一致，无法证明空元素命中）
@testing:case="createIrParRateCurve rejects partially-null vector instNames", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], string()], ["DEPOSIT", "IR_VANILLA_SWAP"], ["3M", "6M"], [100.0, 100.0], [0.023, 0.024], "TF_IR_PAR_BAD", false)

// 用例目的：向量参数 instNames 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects empty vector instNames", exception=1
caplib::createIrParRateCurve(2024.01.01, "X", "X", take(string, 0), ["X"], ["X"], [0.02], [0.02], "TF_createIrParRateCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrParRateCurve rejects keyword arguments", syntaxError=1
caplib::createIrParRateCurve(asOfDate=2024.01.01, currency="X", curveName="X", instNames=["X"], instTypes=["X"], instTerms=["X"], factors=[0.02], quotes=[0.02], handle="TF_createIrParRateCurve_H", returnJson=false)
// 用例目的：instNames 五组向量等长但全部为空值 —— requireNoNullElements 校验命中（预期：抛异常；此前用例名与预期矛盾，按实测统一）
@testing:case="createIrParRateCurve rejects all-null vector instNames (no-null-elements check)", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [string(), string(), string()], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrParRateCurve optional returnJson null uses default"
result = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill-2: 枚举 instTypes + returnJson 类型 + 日期场景
// ----------------------------------------------------------------------------

// 用例目的：枚举参数 instTypes 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects invalid enum for instTypes", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], ["NOT_A_VALID_ENUM_LABEL"], ["3M"], [100.0], [0.023], "TF_IR_PAR_BAD", true)

// 用例目的：遍历 instTypes 文档 IR 域已知合法子集，逐一调用验证均被接受（只放已知可通过的标签）
@testing:case="createIrParRateCurve supports known instTypes enums"
labelEnum = ["DEPOSIT", "FORWARD_RATE_AGREEMENT", "IR_VANILLA_SWAP"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], [labelEnum[i]], ["3M"], [100.0], [0.023], "TF_IR_PAR_ENUM", true); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：可选参数 returnJson 传入非 BOOL（字符串），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for returnJson", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR", "bad")

// 用例目的：asOfDate 取晚于工具到期/结束日，文档说明包装器不检查此关系，记录实际行为
@testing:case="createIrParRateCurve asOfDate later than maturity (wrapper does not check)"
resLatePRC = caplib::createIrParRateCurve(2099.12.31, "CNY", irCurveName, [iborIndex[0]], ["DEPOSIT"], ["3M"], [100.0], [0.023], "TF_IR_PAR_LATE", true)
assert 1, resLatePRC[0] == "TF_IR_PAR_LATE"

// ----------------------------------------------------------------------------
// Review gap-fill (round 2 续): 输出名 handle 错型
// 判据：createIrParRateCurve 的 handle 走 args[8]->getString()，无 requireStringScalar 严格判型，
//   传 INT 123 被字符串化接受（同 buildIr* outputHandle 先例），记录实际行为（不抛异常）。
// ----------------------------------------------------------------------------

// 用例目的：输出名参数 handle 传入 INT 123 —— 源码仅 getString、无 requireStringScalar，宽松接受，记录实际行为
@testing:case="accepts createIrParRateCurve wrong type for handle (no validation)"
r2_irPRC_handle = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], 123, true)
assert 1, typestr(r2_irPRC_handle) != "VOID"

// ----------------------------------------------------------------------------
// 第三轮 review gap-fill：配对向量长度独立校验 + instTypes 逐值覆盖
// ----------------------------------------------------------------------------

// 用例目的：仅缩短 instTerms，其余四组向量保持原长度，验证配对长度校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects instTerms length mismatch", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M"], [100.0, 100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR_BAD", false)

// 用例目的：仅缩短 factors，其余四组向量保持原长度，验证配对长度校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects factors length mismatch", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0], [0.023, 0.024, 0.026], "TF_IR_PAR_BAD", false)

// 用例目的：仅缩短 quotes，其余四组向量保持原长度，验证配对长度校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects quotes length mismatch", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0], irCurveName, irCurveName], ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"], ["3M", "6M", "1Y"], [100.0, 100.0, 100.0], [0.023, 0.024], "TF_IR_PAR_BAD", false)

// 用例目的：instTerms 传入错误类型向量（数值而非字符串），验证向量类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for instTerms", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], ["DEPOSIT"], [1], [100.0], [0.023], "TF_IR_PAR_BAD", false)

// 用例目的：factors 传入错误类型向量（字符串而非 DOUBLE），验证向量类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for factors", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], ["DEPOSIT"], ["3M"], ["bad"], [0.023], "TF_IR_PAR_BAD", false)

// 用例目的：quotes 传入错误类型向量（字符串而非 DOUBLE），验证向量类型校验（预期：抛异常）
@testing:case="createIrParRateCurve rejects wrong type for quotes", exception=1
caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], ["DEPOSIT"], ["3M"], [100.0], ["bad"], "TF_IR_PAR_BAD", false)

// ----------------------------------------------------------------------------
// 第三轮 review：instTypes 文档 59 个标签逐值验证（接受 / 预期拒绝均按实测）
// 实测：服务层支持 IR 曲线/利率工具、FX 现金类、CM 现货期货/CM_SWAP、PM_SWAP、
// CREDIT_DEFAULT_SWAP 及通用 SPOT/FUTURE/FORWARD/SWAP/EUROPEAN/AMERICAN_OPTION；
// 期权/策略/指数期货等输入会由服务层拒绝（expect exception）。
// ----------------------------------------------------------------------------

@testing:case="createIrParRateCurve accepts instTypes value OVERNIGHT_INDEX_SWAP"
rParEnum = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName, [iborIndex[0]], ["OVERNIGHT_INDEX_SWAP"], ["3M"], [100.0], [0.023], "TF_IR_PAR_ENUM", false)
assert 1, typestr(rParEnum) != "VOID"
@testing:case="createIrParRateCurve accepts instTypes value CROSS_CURRENCY_SWAP"
