rFraIdc = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, false)
