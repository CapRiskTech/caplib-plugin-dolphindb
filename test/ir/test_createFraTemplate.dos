// 用例目的：payDayConvention 逐值覆盖（FOLLOWING/PRECEDING/MODIFIED_PRECEDING/UNADJUSTED，实测全部接受）
@testing:case="createFraTemplate accepts payDayConvention value FOLLOWING (fallback accepted)"
rFraPdc = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "MODIFIED_PRECEDING", -1, false)
assert 1, typestr(rFraPdc) != "VOID"
@testing:case="createFraTemplate accepts payDayConvention value PRECEDING (fallback accepted)"
rFraPdc = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "PRECEDING", "MODIFIED_PRECEDING", -1, false)
assert 1, typestr(rFraPdc) != "VOID"
@testing:case="createFraTemplate accepts payDayConvention value MODIFIED_PRECEDING (fallback accepted)"
rFraPdc = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_PRECEDING", "MODIFIED_PRECEDING", -1, false)
assert 1, typestr(rFraPdc) != "VOID"
@testing:case="createFraTemplate accepts payDayConvention value UNADJUSTED (fallback accepted)"
rFraPdc = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "UNADJUSTED", "MODIFIED_PRECEDING", -1, false)
assert 1, typestr(rFraPdc) != "VOID"

