// ============================================================================
// test_createIrYieldCurve.dos
// Per-function test suite for caplib::createIrYieldCurve (ir).
// Signature: caplib::createIrYieldCurve(referenceDate DATE, pillarDates DATE[], pillarValues DOUBLE[], curveType STRING, dcc STRING, interp STRING, extrap STRING, compounding STRING, currency STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrYieldCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================



// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(irCurrency, "ANALYTICAL", 1, 1, take(0, 0), irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrYieldCurve valid call"
result = caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE", false)
assert 1, result == "TF_IR_CURVE"

@testing:case="createIrYieldCurve supports all curveType enums"
for (curveType in ["ZERO_RATE", "LOG_DISCOUNT", "FORWARD_RATE"]) {
    handle = "TF_IR_ENUM_" + curveType;
    result = caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, curveType, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", handle, handle, false);
    assert 1, result == handle
}

@testing:case="createIrYieldCurve supports all dcc enums"
for (dcc in ["ACT_360", "ACTUAL_360", "ACT/360", "ACT_365", "ACT_365_FIXED", "ACTUAL_365_FIXED", "ACT/365", "ACT_ACT", "ACT_ACT_ISDA", "ACTUAL_ACTUAL_ISDA", "ACT_ACT_ICMA", "ACTUAL_ACTUAL_ICMA", "THIRTY_360", "30_360", "30/360", "BOND_BASIS"]) {
    handle = "TF_IR_DCC_" + dcc;
    result = caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", dcc, "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", handle, handle, false);
    assert 1, result == handle
}

@testing:case="createIrYieldCurve rejects dates/values length mismatch", exception=1
caplib::createIrYieldCurve(asOfDate, curveDates, [0.02], "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "X", "TF_IR_BAD", false)

@testing:case="createIrYieldCurve rejects duplicate pillar dates", exception=1
caplib::createIrYieldCurve(asOfDate, [2022.03.10, 2022.03.10], curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "X", "TF_IR_BAD", false)

@testing:case="createIrYieldCurve rejects partially-null values", exception=1
caplib::createIrYieldCurve(asOfDate, curveDates, [0.02, double()], "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "X", "TF_IR_BAD", false)

@testing:case="createIrYieldCurve supports boundary vector lengths"
for (n in [1, 1024, 65536]) {
    datesN = 2022.03.10 + 0..(n - 1);
    ratesN = take(0.02, n);
    handleN = "TF_IR_SIZE_" + string(n);
    resultN = caplib::createIrYieldCurve(asOfDate, datesN, ratesN, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", handleN, handleN, false);
    assert 1, resultN == handleN
}

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createIrYieldCurve rejects missing argument", syntaxError=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H")

@testing:case="createIrYieldCurve rejects extra argument", syntaxError=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false, 1)

@testing:case="createIrYieldCurve rejects wrong type for referenceDate", exception=1
caplib::createIrYieldCurve("bad", [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects wrong type for curveType", exception=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], 1, "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects wrong type for dcc", exception=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], "X", 1, "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects null referenceDate", exception=1
caplib::createIrYieldCurve(date(), [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects null curveType", exception=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], string(), "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects vector for scalar referenceDate", exception=1
caplib::createIrYieldCurve([2024.01.01], [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects scalar for vector pillarDates", exception=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects partially-null vector pillarDates", exception=1
caplib::createIrYieldCurve(2024.01.01, [2024.01.01, date()], [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects empty vector pillarDates", exception=1
caplib::createIrYieldCurve(2024.01.01, take(date, 0), [0.02], "X", "X", "X", "X", "X", "X", "TF_createIrYieldCurve_H", "TF_createIrYieldCurve_H", false)

@testing:case="createIrYieldCurve rejects keyword arguments", syntaxError=1
caplib::createIrYieldCurve(referenceDate=2024.01.01, pillarDates=[2024.01.01], pillarValues=[0.02], curveType="X", dcc="X", interp="X", extrap="X", compounding="X", currency="X", name="TF_createIrYieldCurve_H", handle="TF_createIrYieldCurve_H", returnJson=false)
@testing:case="createIrYieldCurve rejects all-null vector pillarDates", exception=1
caplib::createIrYieldCurve(asOfDate, [date(), date(), date()], curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE", false)
@testing:case="createIrYieldCurve optional returnJson null uses default"
result = caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE", bool())
assert 1, typestr(result) != "VOID"
