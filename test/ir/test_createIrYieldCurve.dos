// 用例目的：pillarDates 非升序但无重复（2025 年在前、2022 年在后），插值器要求横坐标升序（预期：抛异常）
@testing:case="createIrYieldCurve rejects non-increasing pillar dates", exception=1
caplib::createIrYieldCurve(asOfDate, [2025.03.10, 2022.03.10], curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE", false)