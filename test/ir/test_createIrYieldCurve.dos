// 用例目的：创建且输出句柄传空值 —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createIrYieldCurve null handle (no validation)"
resNullH = caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", string(), false)
assert 1, typestr(resNullH) != "VOID"

// 用例目的：pillarValues 含 0 与负值（均为有限数值），包装器不拒绝，固定断言返回句柄
@testing:case="createIrYieldCurve accepts zero/negative pillarValues"
resNegV = caplib::createIrYieldCurve(asOfDate, curveDates, [0.0, -0.01], "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE_NEGV", false)
assert 1, typestr(resNegV) != "VOID" && resNegV == "TF_IR_CURVE_NEGV"

// 用例目的：asOfDate 晚于最后一个 pillar date，文档注明包装器不检查此关系，固定断言返回句柄
@testing:case="createIrYieldCurve accepts asOfDate after pillarDates (wrapper does not check)"
resLateYC = caplib::createIrYieldCurve(2030.01.01, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR_CURVE_LATE", false)
assert 1, typestr(resLateYC) != "VOID" && resLateYC == "TF_IR_CURVE_LATE"

