rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "30/360", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value BOND_BASIS (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "BOND_BASIS", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"

