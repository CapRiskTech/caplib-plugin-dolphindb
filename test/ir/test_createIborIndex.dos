assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value ACTUAL_365_FIXED (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "ACTUAL_365_FIXED", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value ACT/365 (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "ACT/365", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value THIRTY_360 (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "THIRTY_360", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
