// 用例目的：dayCountConvention 逐值覆盖（文档 11 个标签，实测全部接受）
@testing:case="createIborIndex accepts dayCountConvention value ACTUAL_360 (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "ACTUAL_360", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value ACT/360 (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "ACT/360", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
assert 1, typestr(rDcc) != "VOID"
@testing:case="createIborIndex accepts dayCountConvention value ACT_365 (fallback accepted)"
rDcc = caplib::createIborIndex("TF_IBOR", "3M", "CNY", ["CAL_CFETS"], 1, "ACT_365", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", false)
