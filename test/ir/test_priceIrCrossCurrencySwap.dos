// ============================================================================
// test_priceIrCrossCurrencySwap.dos
// Per-function test suite for caplib::priceIrCrossCurrencySwap (ir).
// Signature: caplib::priceIrCrossCurrencySwap(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_priceIrCrossCurrencySwap.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(irCurrency, "ANALYTICAL", 1, 1, take(0, 0), irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

// ============================================================================
// Tests
// ============================================================================

@testing:case="priceIrCrossCurrencySwap -> [handle, PricingResults] (python parity)"
// The cross-currency swap needs legs in two currencies; the market data set is
// createIrCrossCcyMktDataSet with both currency curves and the USDCNY spot
// (protobuf baseCurrency=CNY, targetCurrency=USD, see buildIrCrossCurrencyCurve).
usdFixedLeg = caplib::createFixedLegDefinition("USD", "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING",
    "INVALID_NOTIONAL_EXCHANGE", "TF_USD_LEG", true);
xtpl = caplib::createIrVanillaInstrumentTemplate("CROSS_CURRENCY_SWAP", "TF_XTPL", "SPOTSTART", 1,
    [irFixedLeg[0], usdFixedLeg[0]], "TF_XTPL", true);
xinst = caplib::buildIrVanillaInstrument("PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    xtpl[0], 1000000.0, "", "TF_XINST", false);
fxSpotP = caplib::createFxSpotRate(6.6916, "CNY", "USD", irAsOfDate, irAsOfDate, "TF_XCCY_FXSPOT_P", false);
usdCurve = caplib::createIrYieldCurve(irAsOfDate, [2022.03.10, 2025.03.10], [0.03, 0.035],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_SOFR", "TF_USD_CURVE_P", false);
xmkt = caplib::createIrCrossCcyMktDataSet(irAsOfDate, irCurve, [iborIndex[0]], [irCurve], usdCurve, fxSpotP, "TF_IR_XMKT_P", true);
r = caplib::priceIrCrossCurrencySwap(xinst, irAsOfDate, xmkt[0], irPricingSettings, irXccyRisk[0], "", "", true);
assert 1, isPricingResultsJson(r, "TF_XINST_results")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="priceIrCrossCurrencySwap rejects missing argument", syntaxError=1
caplib::priceIrCrossCurrencySwap("X", 2024.01.01, "X", "X", "X", "X")

@testing:case="priceIrCrossCurrencySwap rejects extra argument", syntaxError=1
caplib::priceIrCrossCurrencySwap("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

@testing:case="priceIrCrossCurrencySwap rejects wrong type for pricingDate", exception=1
caplib::priceIrCrossCurrencySwap("X", "bad", "X", "X", "X", "X", "X", false)

@testing:case="priceIrCrossCurrencySwap rejects wrong type for mode", exception=1
caplib::priceIrCrossCurrencySwap("X", 2024.01.01, "X", "X", "X", "X", 1, false)

@testing:case="priceIrCrossCurrencySwap rejects null pricingDate", exception=1
caplib::priceIrCrossCurrencySwap("X", date(), "X", "X", "X", "X", "X", false)

@testing:case="priceIrCrossCurrencySwap rejects null mode", exception=1
caplib::priceIrCrossCurrencySwap("X", 2024.01.01, "X", "X", "X", "X", string(), false)

@testing:case="priceIrCrossCurrencySwap rejects vector for scalar pricingDate", exception=1
caplib::priceIrCrossCurrencySwap("X", [2024.01.01], "X", "X", "X", "X", "X", false)

@testing:case="priceIrCrossCurrencySwap rejects nonexistent handle instrumentHandle", exception=1
caplib::priceIrCrossCurrencySwap("TF_NO_SUCH_HANDLE_priceIrCrossCurrencySwap", 2024.01.01, "X", "X", "X", "X", "X", false)

@testing:case="priceIrCrossCurrencySwap rejects keyword arguments", syntaxError=1
caplib::priceIrCrossCurrencySwap(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
@testing:case="priceIrCrossCurrencySwap optional returnJson null uses default"
result = caplib::priceIrCrossCurrencySwap(xinst, irAsOfDate, xmkt[0], irPricingSettings, irXccyRisk[0], "", "", bool())
assert 1, typestr(result) != "VOID"
@testing:case="priceIrCrossCurrencySwap rejects wrong object type for mktDataHandle", exception=1
caplib::priceIrCrossCurrencySwap(xinst, irAsOfDate, xinst, irPricingSettings, irXccyRisk[0], "", "", true)
