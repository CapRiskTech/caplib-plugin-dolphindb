// 用例目的：枚举参数 dayCountConvention 传入非法值 —— parseDayCountConventionOrDefault 回退默认值（不抛异常），记录实际行为
@testing:case="accepts createIrLegDefinition invalid enum for dayCountConvention (falls back to default)"
r2_irleg_dcc = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "NOT_A_REAL_ENUM", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", false)
assert 1, typestr(r2_irleg_dcc) != "VOID"

// 用例目的：枚举参数 freq 传入非法值 —— parseFrequencyOrDefault 回退默认值（不抛异常），记录实际行为
@testing:case="accepts createIrLegDefinition invalid enum for freq (falls back to default)"
r2_irleg_freq = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "NOT_A_REAL_ENUM", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", false)
