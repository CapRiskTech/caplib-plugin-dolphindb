// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrLegDefinition -> [handle, json]"
r = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", true);
assert 1, isHandleJson(r, "TF_IR_LEG")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createIrLegDefinition rejects null legType", exception=1
caplib::createIrLegDefinition(string(), "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createIrLegDefinition rejects null currency", exception=1
caplib::createIrLegDefinition("X", string(), "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createIrLegDefinition rejects vector for scalar legType", exception=1
caplib::createIrLegDefinition(["X"], "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "X", false)
