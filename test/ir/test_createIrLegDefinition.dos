// ============================================================================
// test_createIrLegDefinition.dos
// Per-function test suite for caplib::createIrLegDefinition (ir).
// Signature: caplib::createIrLegDefinition(legType STRING, currency STRING, dayCount STRING, refIndex STRING, paymentDiscountMethod STRING, rateCalcMethod STRING, notionalExchange STRING, spread BOOL, fxConvert BOOL, fxReset BOOL, calendar STRING or STRING[], freq STRING, interestDayConvention STRING, stubPolicy STRING, brokenPeriodType STRING, payDayOffset INT, payDayConvention STRING, fixingCalendars STRING or STRING[], fixingFreq STRING, fixingDayConvention STRING, fixingMode STRING, fixingDayOffset INT, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrLegDefinition.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

calendarCreated = caplib::createCalendar("CAL_CFETS");

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrLegDefinition -> [handle, json]"
r = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", true);
assert 1, isHandleJson(r, "TF_IR_LEG")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createIrLegDefinition rejects missing argument", syntaxError=1
caplib::createIrLegDefinition("X", "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X")

@testing:case="createIrLegDefinition rejects extra argument", syntaxError=1
caplib::createIrLegDefinition("X", "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false, 1)

@testing:case="createIrLegDefinition rejects wrong type for legType", exception=1
caplib::createIrLegDefinition(1, "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects wrong type for currency", exception=1
caplib::createIrLegDefinition("X", 1, "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects wrong type for dayCount", exception=1
caplib::createIrLegDefinition("X", "X", 1, "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects null legType", exception=1
caplib::createIrLegDefinition(string(), "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects null currency", exception=1
caplib::createIrLegDefinition("X", string(), "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects vector for scalar legType", exception=1
caplib::createIrLegDefinition(["X"], "X", "X", "X", "X", "X", "X", false, false, false, "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", 1, "TF_createIrLegDefinition_H", false)

@testing:case="createIrLegDefinition rejects keyword arguments", syntaxError=1
caplib::createIrLegDefinition(legType="X", currency="X", dayCount="X", refIndex="X", paymentDiscountMethod="X", rateCalcMethod="X", notionalExchange="X", spread=false, fxConvert=false, fxReset=false, calendar="X", freq="X", interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", payDayOffset=1, payDayConvention="X", fixingCalendars="X", fixingFreq="X", fixingDayConvention="X", fixingMode="X", fixingDayOffset=1, tag="TF_createIrLegDefinition_H", returnJson=false)



