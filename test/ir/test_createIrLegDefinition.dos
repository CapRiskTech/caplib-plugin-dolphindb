// 用例目的：枚举参数 payDayConvention 传入非法值 —— parseBusinessDayConventionOrDefault 回退默认值（不抛异常），记录实际行为
@testing:case="accepts createIrLegDefinition invalid enum for payDayConvention (falls back to default)"
r2_irleg_pdc = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "NOT_A_REAL_ENUM", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", false)
assert 1, typestr(r2_irleg_pdc) != "VOID"

// 用例目的：枚举参数 fixingFreq 传入非法值 —— parseFrequencyOrDefault 回退默认值（不抛异常），记录实际行为
@testing:case="accepts createIrLegDefinition invalid enum for fixingFreq (falls back to default)"
r2_irleg_ffreq = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "NOT_A_REAL_ENUM", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", false)
assert 1, typestr(r2_irleg_ffreq) != "VOID"

// 用例目的：枚举参数 fixingDayConvention 传入非法值 —— parseBusinessDayConventionOrDefault 回退默认值（不抛异常），记录实际行为
@testing:case="accepts createIrLegDefinition invalid enum for fixingDayConvention (falls back to default)"
r2_irleg_fdc = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "NOT_A_REAL_ENUM", "IN_ADVANCE", 0, "TF_IR_LEG", false)
assert 1, typestr(r2_irleg_fdc) != "VOID"