caplib::createIrLegDefinition("NOT_A_VALID_ENUM_LABEL", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "CAL_CFETS", "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", true)



// ----------------------------------------------------------------------------
// Review wave-2 additions (parameter relationships / boundaries)
// ----------------------------------------------------------------------------

@testing:case="createIrLegDefinition accepts calendar scalar with longer fixingCalendars vector (lenient validation, does not raise)"
result = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, "CAL_CFETS", "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", ["CAL_CFETS", "CAL_CFETS"], "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", true)
assert 1, typestr(result) != "VOID"
@testing:case="createIrLegDefinition accepts calendars and fixingCalendars of unequal length (lenient validation, does not raise)"
result = caplib::createIrLegDefinition("FIXED_LEG", "CNY", "ACT_365_FIXED", "", "NO_DISCOUNT", "STANDARD", "INVALID_NOTIONAL_EXCHANGE", false, false, false, ["CAL_CFETS", "CAL_CFETS"], "QUARTERLY", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", ["CAL_CFETS"], "QUARTERLY", "MODIFIED_PRECEDING", "IN_ADVANCE", 0, "TF_IR_LEG", true)
assert 1, typestr(result) != "VOID"


