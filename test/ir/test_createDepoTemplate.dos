// ============================================================================
// test_createDepoTemplate.dos
// Per-function test suite for caplib::createDepoTemplate (fi).
// Signature: caplib::createDepoTemplate(instName STRING, currency STRING, calendar STRING or STRING[][, startDelay INT[, dayCountConvention STRING[, interestDayConvention STRING[, payDayOffset INT[, payDayConvention STRING[, startConvention STRING]]]]]][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createDepoTemplate.dos   // single file

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createDepoTemplate -> handle"
result = caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)
assert 1, result == "TF_DEPO"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createDepoTemplate rejects missing argument", syntaxError=1
caplib::createDepoTemplate("X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createDepoTemplate rejects extra argument", syntaxError=1
caplib::createDepoTemplate("X", "X", "X", 1, "X", "X", 1, "X", "X", false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for instName", exception=1
caplib::createDepoTemplate(1, "X", "X", 1, "X", "X", 1, "X", "X", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for currency", exception=1
caplib::createDepoTemplate("X", 1, "X", 1, "X", "X", 1, "X", "X", false)

// 用例目的：参数 calendar 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for calendar", exception=1
caplib::createDepoTemplate("X", "X", 1, 1, "X", "X", 1, "X", "X", false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDepoTemplate rejects null instName", exception=1
caplib::createDepoTemplate(string(), "X", "X", 1, "X", "X", 1, "X", "X", false)

// 用例目的：参数 currency 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDepoTemplate rejects null currency", exception=1
caplib::createDepoTemplate("X", string(), "X", 1, "X", "X", 1, "X", "X", false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createDepoTemplate rejects vector for scalar instName", exception=1
caplib::createDepoTemplate(["X"], "X", "X", 1, "X", "X", 1, "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createDepoTemplate rejects keyword arguments", syntaxError=1
caplib::createDepoTemplate(instName="X", currency="X", calendar="X", startDelay=1, dayCountConvention="X", interestDayConvention="X", payDayOffset=1, payDayConvention="X", startConvention="X", returnJson=false)
// 用例目的：枚举参数 startConvention 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createDepoTemplate rejects invalid enum for startConvention", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "NOT_A_VALID_ENUM_LABEL", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createDepoTemplate optional returnJson null uses default"
result = caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createDepoTemplate rejects all-null vector calendar", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", [string(), string(), string()], 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createDepoTemplate rejects empty vector calendar", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", take(string, 0), 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)

// ----------------------------------------------------------------------------
// 用例目的：参数 startDelay 传入零值，验证数值边界校验。
// 前置 currency 由错误的数值 0 修正为合法 "CNY"，使校验命中 startDelay（预期：抛异常）
// 用例目的：createDepoTemplate rejects zero startDelay —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts zero startDelay (no validation)"
rT_startDelay = caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false);
assert 1, typestr(rT_startDelay) != "VOID"

// 用例目的：参数 startDelay 传入负值，验证数值边界校验。
// 前置 currency 由错误的数值 -1 修正为合法 "CNY"，startDelay 由 0 修正为目标负值 -1，使校验命中 startDelay（预期：抛异常）
// 用例目的：createDepoTemplate rejects negative startDelay —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts negative startDelay (no validation)"
rT_startDelay = caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", -1, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false);
assert 1, typestr(rT_startDelay) != "VOID"

// ----------------------------------------------------------------------------
// 用例目的：遍历参数 startConvention 的全部文档枚举取值，逐一调用验证均被接受
// 注：标签 `INVALID` 在本上下文中被插件拒绝，未纳入遍历（与文档标签集不一致，实测为准）
@testing:case="createDepoTemplate supports all startConvention enums"
labelEnum = ["INVALID_INSTRUMENT_START_CONVENTION", "SPOTSTART", "TODAYSTART", "TOMORROWSTART"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", labelEnum[i], false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// ----------------------------------------------------------------------------
// 第二轮 DDB review 修正：returnJson BOOL 类型校验
// ----------------------------------------------------------------------------

// 用例目的：returnJson 传入非 BOOL（STRING），验证 BOOL 类型校验。（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for returnJson", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", "bad")

// ----------------------------------------------------------------------------
// Review gap-fill (round 3): startDelay/payDayOffset 自身校验 + 枚举逐值覆盖
// ----------------------------------------------------------------------------

// 用例目的：参数 startDelay 传入错误类型（字符串而非 INT），验证类型校验（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for startDelay", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", "1", "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)

// 用例目的：参数 startDelay 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDepoTemplate rejects null startDelay", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", int(), "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)

// 用例目的：参数 payDayOffset 传入错误类型（字符串而非 INT），验证类型校验（预期：抛异常）
@testing:case="createDepoTemplate rejects wrong type for payDayOffset", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", "1", "FOLLOWING", "SPOTSTART", false)

// 用例目的：参数 payDayOffset 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDepoTemplate rejects null payDayOffset", exception=1
caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", int(), "FOLLOWING", "SPOTSTART", false)

// 用例目的：dayCountConvention 枚举逐值验证 —— 文档 15+ 合法取值逐一调用，均断言非空（预期：接受）
