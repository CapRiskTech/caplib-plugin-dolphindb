@testing:case="buildIrCrossCurrencyCurve rejects wrong object type for fxSpotHandle", exception=1
caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], irCurve, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT", true)

// 用例目的：数值参数 shift 传 0，文档允许 0/负/正；实测插件宽松接受（calcJacobian=false 时
// shift 不参与计算），固定回归预期为接受
@testing:case="buildIrCrossCurrencyCurve accepts zero shift"
rzs = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 0.0, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT_Z", true)
assert 1, typestr(rzs) != "VOID"

// 用例目的：asOfDate 晚于平价曲线最后期限（2026.01.01 晚于 3Y 支柱），文档注明包装器不检查此关系；
// 实测插件宽松接受，固定回归预期为接受
@testing:case="buildIrCrossCurrencyCurve accepts late asOfDate (wrapper does not check)"
rr = caplib::buildIrCrossCurrencyCurve(2026.01.01, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT_LATE", true)
assert 1, typestr(rr) != "VOID"

// ----------------------------------------------------------------------------
