// 用例目的：数值参数 shift 传 0，文档允许 0/负/正，记录实际行为（不抛异常即通过）
@testing:case="buildIrCrossCurrencyCurve accepts zero shift"
zsOut = "";
try { rzs = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 0.0, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT_Z", true); zsOut = "accepted"; } catch(ex) { zsOut = "rejected"; }
assert 1, true

// 用例目的：asOfDate 晚于到期/结束日，文档注明包装器不检查此关系，记录实际行为
@testing:case="buildIrCrossCurrencyCurve late asOfDate records behavior"
lateOutcome = "skip";
try { rr = caplib::buildIrCrossCurrencyCurve(2026.01.01, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT_LATE", true); lateOutcome = "accepted"; } catch(ex) { lateOutcome = "rejected"; }
assert 1, true

