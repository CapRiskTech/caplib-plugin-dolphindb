caplib::buildIrCrossCurrencyCurve(date(), ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", "X", false, 0.02, "X", "X", ["X"], "X", false)

@testing:case="buildIrCrossCurrencyCurve rejects null dayCountConvention", exception=1
caplib::buildIrCrossCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], string(), "X", "X", ["X"], "X", "X", false, 0.02, "X", "X", ["X"], "X", false)

@testing:case="buildIrCrossCurrencyCurve rejects vector for scalar referenceDate", exception=1
caplib::buildIrCrossCurrencyCurve([2024.01.01], ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", "X", false, 0.02, "X", "X", ["X"], "X", false)

@testing:case="buildIrCrossCurrencyCurve rejects scalar for vector targetCurveNames", exception=1
caplib::buildIrCrossCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", "X", false, 0.02, "X", "X", ["X"], "X", false)

