r2_xc_tch_type = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", [bpcFx[0]], "TF_XCCY_OUT_TCH2", true)
assert 1, typestr(r2_xc_tch_type) != "VOID"

// 用例目的：参数 outputHandle 传入错误类型（该传字符串的传整数）。包装层对该参数仅 getString、
// 无 requireStringScalar（区别于 buildCmVolatilitySurface 的 handle 参数），实测宽松接受，记录实际行为
@testing:case="buildIrCrossCurrencyCurve accepts wrong type for outputHandle (no validation)"
r2_xc_outh = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], 123, true)
assert 1, typestr(r2_xc_outh) != "VOID"

// 用例目的：枚举参数 compoundingType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="buildIrCrossCurrencyCurve rejects invalid enum for compoundingType", exception=1
caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "NOT_A_REAL_ENUM", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_XCCY_CURVE"], "TF_XCCY_OUT", true)

