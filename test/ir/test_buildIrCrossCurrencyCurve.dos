// ----------------------------------------------------------------------------

// 用例目的：句柄参数 targetCurveHandles 传入不存在的句柄字符串。源码层面该参数是构建输出的
// 目标曲线名（storeIrTargetCurves 仅据此注册新曲线、不做存在性校验），实测宽松接受，记录实际行为
@testing:case="buildIrCrossCurrencyCurve accepts nonexistent targetCurveHandles (output-name semantics)"
r2_xc_tch_fresh = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_NO_SUCH_HANDLE_buildIrCrossCurrencyCurve_targetCurveHandles"], "TF_XCCY_OUT_TCH1", true)
assert 1, typestr(r2_xc_tch_fresh) != "VOID"

// 用例目的：句柄参数 targetCurveHandles 传入已存在的其他类型对象句柄（平价曲线句柄）。
// 同为输出名参数、包装层不校验其类型，实测宽松接受，记录实际行为
@testing:case="buildIrCrossCurrencyCurve accepts cross-type handle in targetCurveHandles (output-name semantics)"
r2_xc_tch_type = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX, "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", [bpcFx[0]], "TF_XCCY_OUT_TCH2", true)
assert 1, typestr(r2_xc_tch_type) != "VOID"

// 用例目的：参数 outputHandle 传入错误类型（该传字符串的传整数）。包装层对该参数仅 getString、
// 无 requireStringScalar（区别于 buildCmVolatilitySurface 的 handle 参数），实测宽松接受，记录实际行为
@testing:case="buildIrCrossCurrencyCurve accepts wrong type for outputHandle (no validation)"
