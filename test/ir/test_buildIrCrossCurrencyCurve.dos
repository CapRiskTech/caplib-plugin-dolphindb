// ============================================================================
// test_buildIrCrossCurrencyCurve.dos
// Per-function test suite for caplib::buildIrCrossCurrencyCurve (ir).
// Signature: caplib::buildIrCrossCurrencyCurve(referenceDate DATE, targetCurveNames STRING[], buildSettingsHandles STRING[], parCurveHandles STRING[], dayCountConvention STRING, compoundingType STRING, frequency STRING, otherCurveHandles STRING[], fxSpotHandle STRING, buildingMethod STRING, calcJacobian BOOL, shift DOUBLE, finiteDifferenceMethod STRING, threadingMode STRING, targetCurveHandles STRING[], outputHandle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_buildIrCrossCurrencyCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(
    irCurrency, "ANALYTICAL", 1, 1, irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

usdCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.03, 0.035],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_SOFR", "TF_USD_CURVE", false);
fxSpot = caplib::createFxSpotRate(6.9, "USD", "CNY", irAsOfDate, 2022.03.16, "TF_FXSPOT", true);

// ============================================================================
// Tests
// ============================================================================

@testing:case="buildIrCrossCurrencyCurve -> [handle, json] (python parity)"
// Mirror python test_iranalytics.test_ir_cross_ccy_curve_builder: the target
// curve is an USD curve bootstrapped from FX_SWAP points (factor 10000), with
// the CNY curve as the other curve. createFxSpotTemplate/createFxSwapTemplate
// register the FX_SPOT/FX_SWAP static-data keys the build resolves; the spot
// rate is created with (baseCurrency=CNY, targetCurrency=USD) so its protobuf
// matches python create_foreign_exchange_rate(6.6916, "USD", "CNY").
bpcFx = caplib::createIrParRateCurve(irAsOfDate, "USD", "USD_USDCNY_FX",
    take("USDCNY", 11), take("FX_SWAP", 11),
    ["ON", "TN", "1W", "1M", "2M", "3M", "6M", "9M", "12M", "2Y", "3Y"],
    take(10000, 11), [2.01, 3.91, 5.93, 22.5, 44.25, 63.25, 130.75, 194.75, 268.25, 1017.0, 2075.0],
    "TF_USD_FX_PAR", true);
cbsFx = caplib::createIrYieldCurveBuildSettings("USD_USDCNY_FX", true,
    ["USD", "CNY"], ["USD_USDCNY_FX", irCurveName], [], [], "TF_XCBS", true);
fxSpotTplX = caplib::createFxSpotTemplate("USDCNY_SPOT_TPL", "USDCNY", "FOLLOWING", ["CAL_CFETS"], "2d", false);
fxSwapTplX = caplib::createFxSwapTemplate("USDCNY_SWP_TPL", "SPOTSTART", "USDCNY", ["CAL_CFETS"],
    "FOLLOWING", "FOLLOWING", "-2d", "PRECEDING", false);
fxSpotX = caplib::createFxSpotRate(6.6916, "CNY", "USD", irAsOfDate, irAsOfDate, "TF_XCCY_FXSPOT", false);
xc = caplib::buildIrCrossCurrencyCurve(irAsOfDate, ["USD_USDCNY_FX"], [cbsFx[0]], [bpcFx[0]],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [irCurve], fxSpotX,
    "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE",
    ["TF_XCCY_CURVE"], "TF_XCCY_OUT", true);
assert 1, isHandleJson(xc, "TF_XCCY_OUT") && hasJsonField(xc[1], "target_curves")

