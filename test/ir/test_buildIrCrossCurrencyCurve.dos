caplib::buildIrCrossCurrencyCurve(2024.01.01, ["X"], "TF_NO_SUCH_HANDLE_buildIrCrossCurrencyCurve", ["X"], "X", "X", "X", ["X"], "X", "X", false, 0.02, "X", "X", ["X"], "X", false)

@testing:case="buildIrCrossCurrencyCurve rejects keyword arguments", syntaxError=1
