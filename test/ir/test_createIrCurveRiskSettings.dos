// ============================================================================
// test_createIrCurveRiskSettings.dos
// Per-function test suite for caplib::createIrCurveRiskSettings (ir).
// Signature: caplib::createIrCurveRiskSettings(delta BOOL, gamma BOOL, curvature BOOL, shift DOUBLE, curvatureShift DOUBLE, method INT, granularity INT, scaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrCurveRiskSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrCurveRiskSettings -> handle"
result = caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IRCR", false)
assert 1, result == "TF_IRCR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrCurveRiskSettings rejects missing argument", syntaxError=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, 0.02, 1, 1, 0.02, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrCurveRiskSettings rejects extra argument", syntaxError=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, 0.02, 1, 1, 0.02, 1, "TF_createIrCurveRiskSettings_H", false, 1)

// 用例目的：参数 shift 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects wrong type for shift", exception=1
caplib::createIrCurveRiskSettings(false, false, false, "bad", 0.02, 1, 1, 0.02, 1, "TF_createIrCurveRiskSettings_H", false)

// 用例目的：参数 curvatureShift 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects wrong type for curvatureShift", exception=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, "bad", 1, 1, 0.02, 1, "TF_createIrCurveRiskSettings_H", false)

// 用例目的：参数 method 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects wrong type for method", exception=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, 0.02, "1", 1, 0.02, 1, "TF_createIrCurveRiskSettings_H", false)

// 用例目的：参数 method 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects null method", exception=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, 0.02, int(), 1, 0.02, 1, "TF_createIrCurveRiskSettings_H", false)

// 用例目的：参数 granularity 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects null granularity", exception=1
caplib::createIrCurveRiskSettings(false, false, false, 0.02, 0.02, 1, int(), 0.02, 1, "TF_createIrCurveRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrCurveRiskSettings rejects keyword arguments", syntaxError=1
caplib::createIrCurveRiskSettings(delta=false, gamma=false, curvature=false, shift=0.02, curvatureShift=0.02, method=1, granularity=1, scaling=0.02, threading=1, handle="TF_createIrCurveRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrCurveRiskSettings optional returnJson null uses default"
result = caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IRCR", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 scaling 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects zero scaling", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 0.0, 0, "TF_IRCR", false)

// 用例目的：参数 scaling 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createIrCurveRiskSettings rejects negative scaling", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, -1.0, 0, "TF_IRCR", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 delta 传入单元素向量，实测插件宽松接受——记录实际行为
@testing:case="createIrCurveRiskSettings vector for scalar delta", exception=1
caplib::createIrCurveRiskSettings([true], 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IRCR", false);
