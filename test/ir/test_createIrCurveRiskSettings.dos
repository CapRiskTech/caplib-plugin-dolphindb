// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrCurveRiskSettings valid call"
result = caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false)
assert 1, result == "TF_IR_CURVE_RISK"

@testing:case="createIrCurveRiskSettings rejects STRING method", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, "1", 1, 1.0e-4, 0, "TF_IR_RISK_BAD")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createIrCurveRiskSettings rejects missing argument", syntaxError=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0)

@testing:case="createIrCurveRiskSettings rejects extra argument", syntaxError=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false, 1)

@testing:case="createIrCurveRiskSettings rejects wrong type for shift", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, "bad", 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false)

@testing:case="createIrCurveRiskSettings rejects wrong type for curvatureShift", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, "bad", 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false)

@testing:case="createIrCurveRiskSettings rejects wrong type for method", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, "1", 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false)

@testing:case="createIrCurveRiskSettings rejects null method", exception=1
caplib::createIrCurveRiskSettings(1, 1, 1, 1.0e-4, 5.0e-3, int(), 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false)
