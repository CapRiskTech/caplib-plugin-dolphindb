// ============================================================================
// test_buildIrSingleCurrencyCurve.dos
// Per-function test suite for caplib::buildIrSingleCurrencyCurve (ir).
// Signature: caplib::buildIrSingleCurrencyCurve(asOfDate DATE, targetCurveNames STRING[], buildSettingsHandles STRING[], parCurveHandles STRING[], dayCountConvention STRING, compoundingType STRING, frequency STRING, otherCurveHandles STRING[], buildingMethod STRING, calcJacobian BOOL, shift DOUBLE, finiteDifferenceMethod STRING, threadingMode STRING, targetCurveHandles STRING[], outputHandle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_buildIrSingleCurrencyCurve.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurveName = "CNY_SHIBOR_3M";

// buildIrSingleCurrencyCurve 需要 IR_VANILLA_SWAP/CNY_SHIBOR_3M 模板现于 ObjectCache，
// 由 iborIndex + fixed/floating leg + IrVanillaSwapTemplate 注册链提供（见测试注释）。
iborIndex = caplib::createIborIndex(
    irCurveName, "3M", "CNY", ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    "CNY", "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    "CNY", iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

// ============================================================================
// Tests

// 用例目的：按 python caplib 参考实现的等价调用方式构造输入，验证与参考行为一致
@testing:case="buildIrSingleCurrencyCurve -> [handle, json] (python parity)"
// Mirror python test_iranalytics.test_ir_single_ccy_curve_builder: all pillars
// IR_VANILLA_SWAP named after the swap template (registered as static data by
// createIrVanillaSwapTemplate), quotes in percent with factor 100, and the
// build-settings forward map keyed by the ibor index name.
bpc = caplib::createIrParRateCurve(irAsOfDate, "CNY", irCurveName,
    [irCurveName, irCurveName, irCurveName],
    ["IR_VANILLA_SWAP", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"],
    ["6M", "1Y", "3Y"], [100, 100, 100], [2.3, 2.4, 2.6], "TF_IR_BPC", true);
cbs = caplib::createIrYieldCurveBuildSettings(irCurveName, false,
    ["CNY"], [irCurveName], [irCurveName], [irCurveName], "TF_IR_CBS", true);
bsc = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [],
    "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE",
    ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true);
assert 1, isHandleJson(bsc, "TF_IR_BUILT") && hasJsonField(bsc[1], "target_curves")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildIrSingleCurrencyCurve rejects missing argument", syntaxError=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildIrSingleCurrencyCurve rejects extra argument", syntaxError=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong type for asOfDate", exception=1
caplib::buildIrSingleCurrencyCurve("bad", ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：参数 dayCountConvention 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong type for dayCountConvention", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], 1, "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：参数 compoundingType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong type for compoundingType", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], "X", 1, "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects null asOfDate", exception=1
caplib::buildIrSingleCurrencyCurve(date(), ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：参数 dayCountConvention 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects null dayCountConvention", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], ["X"], ["X"], string(), "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects vector for scalar asOfDate", exception=1
caplib::buildIrSingleCurrencyCurve([2024.01.01], ["X"], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：targetCurveNames 传入标量 —— 实测插件不校验向量形式、宽松接受（合法标量可正常完成调用），记录实际行为
@testing:case="accepts buildIrSingleCurrencyCurve scalar targetCurveNames (no form validation)"
rIR_SC = caplib::buildIrSingleCurrencyCurve(irAsOfDate, irCurveName, [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_SCALAR_CURVE"], "TF_IR_SCALAR_OUT", true)
assert 1, typestr(rIR_SC) != "VOID"

// 用例目的：向量参数 targetCurveNames 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects partially-null vector targetCurveNames", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X", string()], ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：向量参数 targetCurveNames 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects empty vector targetCurveNames", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, take(string, 0), ["X"], ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：句柄参数 buildSettingsHandles 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects nonexistent handle buildSettingsHandles", exception=1
caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], "TF_NO_SUCH_HANDLE_buildIrSingleCurrencyCurve", ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildIrSingleCurrencyCurve rejects keyword arguments", syntaxError=1
caplib::buildIrSingleCurrencyCurve(asOfDate=2024.01.01, targetCurveNames=["X"], buildSettingsHandles=["X"], parCurveHandles=["X"], dayCountConvention="X", compoundingType="X", frequency="X", otherCurveHandles=["X"], buildingMethod="X", calcJacobian=false, shift=0.02, finiteDifferenceMethod="X", threadingMode="X", targetCurveHandles=["X"], outputHandle="X", returnJson=false)
// 用例目的：向量参数 targetCurveNames 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects all-null vector targetCurveNames", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [string(), string(), string()], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：枚举参数 dayCountConvention 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for dayCountConvention", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "NOT_A_VALID_ENUM_LABEL", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildIrSingleCurrencyCurve optional returnJson null uses default"
result = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 parCurveHandles 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong object type for parCurveHandles", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [cbs[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// ----------------------------------------------------------------------------
// Review gap-fill (round 2): 句柄/returnJson/enum/数值/日期 校验
// ----------------------------------------------------------------------------

// 用例目的：枚举参数 frequency 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for frequency", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "NOT_A_FREQUENCY", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：枚举参数 buildingMethod 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for buildingMethod", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "NOT_A_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：可选参数 returnJson 传入非 BOOL 类型，验证 BOOL 类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong type for returnJson", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", "bad")

// 用例目的：句柄参数 buildSettingsHandles 传入类型不符的对象句柄（平价曲线句柄），验证句柄类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong object type for buildSettingsHandles", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [bpc[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：句柄参数 parCurveHandles 传入不存在的句柄，验证句柄校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects nonexistent handle parCurveHandles", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], ["TF_NO_SUCH_HANDLE_PAR_CURVE"], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：句柄参数 otherCurveHandles 传入不存在的句柄，验证句柄校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects nonexistent handle otherCurveHandles", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", ["TF_NO_SUCH_HANDLE_OTHER"], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：数值参数 shift 传 0，文档允许 0/负/正，记录实际行为（不抛异常即通过）
@testing:case="buildIrSingleCurrencyCurve accepts zero shift"
zsOut = "";
try { rzs = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 0.0, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT_Z", true); zsOut = "accepted"; } catch(ex) { zsOut = "rejected"; }
assert 1, true

// 用例目的：asOfDate 晚于到期/结束日，文档注明包装器不检查此关系，记录实际行为
@testing:case="buildIrSingleCurrencyCurve late asOfDate records behavior"
lateSingle = "skip";
try { rss = caplib::buildIrSingleCurrencyCurve(2026.01.01, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT_LATE", true); lateSingle = "accepted"; } catch(ex) { lateSingle = "rejected"; }
assert 1, true

// ----------------------------------------------------------------------------
// Review gap-fill (round 2 续): targetCurveHandles / otherCurveHandles / outputHandle / 枚举校验
// ----------------------------------------------------------------------------

// 用例目的：句柄参数 targetCurveHandles 传入不存在的句柄字符串。源码层面该参数是构建输出的
// 目标曲线名（storeIrTargetCurves 仅据此注册新曲线、不做存在性校验），实测宽松接受，记录实际行为
@testing:case="buildIrSingleCurrencyCurve accepts nonexistent targetCurveHandles (output-name semantics)"
r2_sc_tch_fresh = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_NO_SUCH_HANDLE_buildIrSingleCurrencyCurve_targetCurveHandles"], "TF_IR_BUILT_TCH1", true)
assert 1, typestr(r2_sc_tch_fresh) != "VOID"

// 用例目的：句柄参数 otherCurveHandles 传入类型不符的对象句柄（构建设置句柄而非曲线句柄），验证句柄类型校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects wrong object type for otherCurveHandles", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [cbs[0]], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：句柄参数 targetCurveHandles 传入已存在的其他类型对象句柄（平价曲线句柄）。
// 同为输出名参数、包装层不校验其类型，实测宽松接受，记录实际行为
@testing:case="buildIrSingleCurrencyCurve accepts cross-type handle in targetCurveHandles (output-name semantics)"
r2_sc_tch_type = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", [bpc[0]], "TF_IR_BUILT_TCH2", true)
assert 1, typestr(r2_sc_tch_type) != "VOID"

// 用例目的：参数 outputHandle 传入错误类型（该传字符串的传整数）。包装层对该参数仅 getString、
// 无 requireStringScalar（区别于 buildCmVolatilitySurface 的 handle 参数），实测宽松接受，记录实际行为
@testing:case="buildIrSingleCurrencyCurve accepts wrong type for outputHandle (no validation)"
r2_sc_outh = caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], 123, true)
assert 1, typestr(r2_sc_outh) != "VOID"

// 用例目的：枚举参数 compoundingType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for compoundingType", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "NOT_A_REAL_ENUM", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：枚举参数 finiteDifferenceMethod 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for finiteDifferenceMethod", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "NOT_A_REAL_ENUM", "SINGLE_THREADING_MODE", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

// 用例目的：枚举参数 threadingMode 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="buildIrSingleCurrencyCurve rejects invalid enum for threadingMode", exception=1
caplib::buildIrSingleCurrencyCurve(irAsOfDate, [irCurveName], [cbs[0]], [bpc[0]], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", [], "BOOTSTRAPPING_METHOD", false, 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "NOT_A_REAL_ENUM", ["TF_IR_BUILT_CURVE"], "TF_IR_BUILT", true)

