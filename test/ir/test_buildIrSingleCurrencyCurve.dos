caplib::buildIrSingleCurrencyCurve(2024.01.01, ["X"], "TF_HANDLE_DOES_NOT_EXIST", ["X"], "X", "X", "X", ["X"], "X", false, 0.02, "X", "X", ["X"], "X", false)
