@testing:case="priceIrVanillaInstrument repeat calls return identical results"
rs1 = caplib::priceIrVanillaInstrument(irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);
rs2 = caplib::priceIrVanillaInstrument(irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);
assert 1, rs1 == rs2



