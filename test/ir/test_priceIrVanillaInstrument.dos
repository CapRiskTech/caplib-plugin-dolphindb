// ============================================================================
// test_priceIrVanillaInstrument.dos
// Per-function test suite for caplib::priceIrVanillaInstrument (ir).
// Signature: caplib::priceIrVanillaInstrument(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_priceIrVanillaInstrument.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(
    irCurrency, "ANALYTICAL", 1, 1, irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

// ============================================================================
// Tests
// ============================================================================

@testing:case="priceIrVanillaInstrument -> [handle, present_value reference]"
assert 1, isPricingResultsJson(irSwapPricingResult, "TF_IR_SWAP_results")
assert 2, abs(presentValue(irSwapPricingResult) - -33063.77790012206) < abs(-33063.77790012206) * 1.0e-9 + 1.0e-6

@testing:case="getObjectCacheJson(PricingResults) -> cached result readable"
cached = caplib::getObjectCacheJson("PricingResults", "TF_IR_SWAP_results");
assert 1, isPricingResultsJson(cached, "TF_IR_SWAP_results") &&
    abs(presentValue(cached) - -33063.77790012206) < abs(-33063.77790012206) * 1.0e-9 + 1.0e-6

@testing:case="priceIrVanillaInstrument repeated calls produce identical present_value"
p2 = caplib::priceIrVanillaInstrument(irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);
p3 = caplib::priceIrVanillaInstrument(irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);
assert 1, presentValue(p2) == presentValue(p3) && presentValue(p2) == presentValue(irSwapPricingResult)

@testing:case="four concurrent priceIrVanillaInstrument jobs -> identical present_value"
def irPriceJob() {
    return caplib::priceIrVanillaInstrument("TF_IR_SWAP", 2022.03.09, "TF_IR_MKT", "TF_IR_PRICING", "TF_IR_RISK", "", "", true);
}
jobSuffix = string(rand(1000000000, 1)[0]);
j1 = submitJob("caplib_ir_" + jobSuffix + "_1", "ir 1", irPriceJob);
j2 = submitJob("caplib_ir_" + jobSuffix + "_2", "ir 2", irPriceJob);
j3 = submitJob("caplib_ir_" + jobSuffix + "_3", "ir 3", irPriceJob);
j4 = submitJob("caplib_ir_" + jobSuffix + "_4", "ir 4", irPriceJob);
rj1 = getJobReturn(j1, true);
rj2 = getJobReturn(j2, true);
rj3 = getJobReturn(j3, true);
rj4 = getJobReturn(j4, true);
assert 1, presentValue(rj1) == presentValue(rj2) && presentValue(rj2) == presentValue(rj3) &&
    presentValue(rj3) == presentValue(rj4) &&
    abs(presentValue(rj1) - -33063.77790012206) < abs(-33063.77790012206) * 1.0e-9 + 1.0e-6

@testing:case="priceIrVanillaInstrument rejects wrong mktData handle", exception=1
caplib::priceIrVanillaInstrument(irSwap, irAsOfDate, irCurve, irPricingSettings, irRisk[0], "", "", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="priceIrVanillaInstrument rejects missing argument", syntaxError=1
caplib::priceIrVanillaInstrument("X", 2024.01.01, "X", "X", "X", "X")

@testing:case="priceIrVanillaInstrument rejects extra argument", syntaxError=1
caplib::priceIrVanillaInstrument("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

@testing:case="priceIrVanillaInstrument rejects null pricingDate", exception=1
caplib::priceIrVanillaInstrument("X", date(), "X", "X", "X", "X", "X", false)

@testing:case="priceIrVanillaInstrument rejects null mode", exception=1
caplib::priceIrVanillaInstrument("X", 2024.01.01, "X", "X", "X", "X", string(), false)

@testing:case="priceIrVanillaInstrument rejects vector for scalar pricingDate", exception=1
caplib::priceIrVanillaInstrument("X", [2024.01.01], "X", "X", "X", "X", "X", false)

@testing:case="priceIrVanillaInstrument rejects nonexistent handle instrumentHandle", exception=1
caplib::priceIrVanillaInstrument("TF_HANDLE_DOES_NOT_EXIST", 2024.01.01, "X", "X", "X", "X", "X", false)

@testing:case="priceIrVanillaInstrument rejects keyword arguments", syntaxError=1
caplib::priceIrVanillaInstrument(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
