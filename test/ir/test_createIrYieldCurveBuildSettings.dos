// 用例目的：forwardCurveNames 多一个元素、与 forwardIndexNames 长度不一致，验证参数间关系校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects forwardCurveNames length mismatch", exception=1
caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X"], ["X"], ["X", "EXTRA"], "TF_createIrYieldCurveBuildSettings_H", false)
