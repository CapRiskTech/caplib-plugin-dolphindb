// ============================================================================
// test_createIrYieldCurveBuildSettings.dos
// Per-function test suite for caplib::createIrYieldCurveBuildSettings (ir).
// Signature: caplib::createIrYieldCurveBuildSettings(curveName STRING, useOnTnFxSwap BOOL, discountCurrencyNames STRING[], discountCurveNames STRING[], forwardIndexNames STRING[], forwardCurveNames STRING[], handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrYieldCurveBuildSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createIrYieldCurveBuildSettings valid call"
result = caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)
assert 1, result == "TF_createIrYieldCurveBuildSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrYieldCurveBuildSettings rejects missing argument", syntaxError=1
caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X"], ["X"], ["X"])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrYieldCurveBuildSettings rejects extra argument", syntaxError=1
caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false, 1)

// 用例目的：向量参数 discountCurrencyNames 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects partially-null vector discountCurrencyNames", exception=1
caplib::createIrYieldCurveBuildSettings("X", false, ["X", string()], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// 用例目的：向量参数 discountCurrencyNames 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects empty vector discountCurrencyNames", exception=1
caplib::createIrYieldCurveBuildSettings("X", false, take(string, 0), ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrYieldCurveBuildSettings rejects keyword arguments", syntaxError=1
caplib::createIrYieldCurveBuildSettings(curveName="X", useOnTnFxSwap=false, discountCurrencyNames=["X"], discountCurveNames=["X"], forwardIndexNames=["X"], forwardCurveNames=["X"], handle="TF_createIrYieldCurveBuildSettings_H", returnJson=false)
// 用例目的：向量参数 discountCurrencyNames 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects all-null vector discountCurrencyNames", exception=1
caplib::createIrYieldCurveBuildSettings("X", false, [string(), string(), string()], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrYieldCurveBuildSettings optional returnJson null uses default"
result = caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createIrYieldCurveBuildSettings rejects wrong type for curveName", exception=1
caplib::createIrYieldCurveBuildSettings(1, false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// 用例目的：参数传入错误类型/空值（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createIrYieldCurveBuildSettings rejects null curveName", exception=1
caplib::createIrYieldCurveBuildSettings(string(), false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects wrong type for useOnTnFxSwap", exception=1
caplib::createIrYieldCurveBuildSettings("X", "bad", ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects null useOnTnFxSwap", exception=1
caplib::createIrYieldCurveBuildSettings("X", bool(), ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false)

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（discountCurveNames 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createIrYieldCurveBuildSettings rejects discountCurveNames length mismatch", exception=1
caplib::createIrYieldCurveBuildSettings("X", false, ["X"], ["X", "EXTRA"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false);

// ----------------------------------------------------------------------------
// 用例目的：标量参数 curveName 传入单元素向量，实测插件宽松接受——记录实际行为
@testing:case="createIrYieldCurveBuildSettings vector for scalar curveName", exception=1
caplib::createIrYieldCurveBuildSettings(["X"], false, ["X"], ["X"], ["X"], ["X"], "TF_createIrYieldCurveBuildSettings_H", false);
