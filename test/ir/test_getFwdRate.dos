// ============================================================================
// test_getFwdRate.dos
// Per-function test suite for caplib::getFwdRate (ir).
// Signature: caplib::getFwdRate(irCurveHandle STRING, dates DATE[], tenor DOUBLE)
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_getFwdRate.dos   // single file

// ============================================================================
// Helper predicates

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回向量的形态与数值
@testing:case="getFwdRate -> vector"
r = caplib::getFwdRate(irCurve, [2025.03.10], 0.25)
assert 1, isDoubleVector(r) && size(r) >= 1

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="getFwdRate rejects missing argument", syntaxError=1
caplib::getFwdRate("X", [2024.01.01])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="getFwdRate rejects extra argument", syntaxError=1
caplib::getFwdRate("X", [2024.01.01], 0.02, 1)

// 用例目的：参数 tenor 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="getFwdRate rejects wrong type for tenor", exception=1
caplib::getFwdRate("X", [2024.01.01], "bad")

// 用例目的：参数 tenor 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="getFwdRate rejects null tenor", exception=1
caplib::getFwdRate("X", [2024.01.01], double())

// 用例目的：标量参数 tenor 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="getFwdRate rejects vector for scalar tenor", exception=1
caplib::getFwdRate("X", [2024.01.01], [0.02])

// 用例目的：向量参数 dates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="getFwdRate rejects scalar for vector dates", exception=1
caplib::getFwdRate("X", [2024.01.01], 0.02)

// 用例目的：向量参数 dates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="getFwdRate rejects partially-null vector dates", exception=1
caplib::getFwdRate("X", [2024.01.01, date()], 0.02)

// 用例目的：向量参数 dates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="getFwdRate rejects empty vector dates", exception=1
caplib::getFwdRate("X", take(date, 0), 0.02)

// 用例目的：句柄参数 irCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="getFwdRate rejects nonexistent handle irCurveHandle", exception=1
caplib::getFwdRate("TF_HANDLE_DOES_NOT_EXIST", [2024.01.01], 0.02)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="getFwdRate rejects keyword arguments", syntaxError=1
caplib::getFwdRate(irCurveHandle="X", dates=[2024.01.01], tenor=0.02)
// 用例目的：向量参数 dates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="getFwdRate rejects all-null vector dates", exception=1
caplib::getFwdRate(irCurve, [date(), date(), date()], 0.25)
// 用例目的：正常调用，与独立解析公式（闭式解）计算的参考值对比，验证计算正确性
@testing:case="getFwdRate -> analytic flat-curve reference"
// Every forward rate of a flat curve equals the flat rate.
flatIrRef = caplib::createFlatIrYieldCurve(irAsOfDate, "CNY", 0.02, "TF_REF_FIR", false);
frr = caplib::getFwdRate(flatIrRef, [2023.03.09, 2024.03.09], 1.0);
assert 1, abs(frr[0] - 0.02) < 1.0e-12
// 用例目的：参数 tenor 传入0，验证数值边界校验（预期：抛异常）
@testing:case="getFwdRate rejects zero tenor", exception=1
caplib::getFwdRate(irCurve, [2025.03.10], 0.0)

// 用例目的：参数 tenor 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="getFwdRate rejects negative tenor", exception=1
caplib::getFwdRate(irCurve, [2025.03.10], -1.0)

// 用例目的：相同输入连续调用两次，验证两次返回结果完全一致（计算确定性）
@testing:case="getFwdRate deterministic repeat -> identical result"
r1 = caplib::getFwdRate(irCurve, [2025.03.10], 0.25);
r2 = caplib::getFwdRate(irCurve, [2025.03.10], 0.25);
assert 1, max(abs(r1 - r2)) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：以加倍的利率/波动率参数重建同一曲线后再查询，验证查询结果随输入变化
@testing:case="getFwdRate rebuilt curve (2x rate) -> result changes"
r1 = caplib::getFwdRate(irCurve, [2025.03.10], 0.25);
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.04, 0.05],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);
r2 = caplib::getFwdRate(irCurve, [2025.03.10], 0.25);
assert 1, max(abs(r1 - r2)) > 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：句柄参数 irCurveHandle 传入类型不符的对象句柄（createCalendar），验证句柄类型校验（预期：抛异常）
@testing:case="getFwdRate rejects wrong object type for irCurveHandle", exception=1
caplib::getFwdRate(calendarCreated[0], [2025.03.10], 0.25);
