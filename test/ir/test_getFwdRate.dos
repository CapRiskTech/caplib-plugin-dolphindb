// ============================================================================
// test_getFwdRate.dos
// Per-function test suite for caplib::getFwdRate (ir).
// Signature: caplib::getFwdRate(irCurveHandle STRING, dates DATE[], tenor DOUBLE)
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_getFwdRate.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

flatIrCurve = caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FLAT_IR_CURVE", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getFwdRate -> flat 2% curve reference values"
fwdRates = caplib::getFwdRate(flatIrCurve, curveDates, 0.25);
assert 1, isDoubleVector(fwdRates) &&
    abs(fwdRates[0] - 0.02) < 1.0e-9 && abs(fwdRates[1] - 0.02) < 1.0e-9

@testing:case="getFwdRate rejects unknown handle", exception=1
caplib::getFwdRate("TF_HANDLE_DOES_NOT_EXIST", curveDates, 0.25)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getFwdRate rejects missing argument", syntaxError=1
caplib::getFwdRate(flatIrCurve, curveDates)

@testing:case="getFwdRate rejects extra argument", syntaxError=1
caplib::getFwdRate(flatIrCurve, curveDates, 0.25, 1)

@testing:case="getFwdRate rejects null tenor", exception=1
caplib::getFwdRate(flatIrCurve, curveDates, double())

@testing:case="getFwdRate rejects vector for scalar tenor", exception=1
caplib::getFwdRate(flatIrCurve, curveDates, [0.02])

@testing:case="getFwdRate rejects partially-null vector dates", exception=1
caplib::getFwdRate(flatIrCurve, [2024.01.01, date()], 0.25)

@testing:case="getFwdRate rejects empty vector dates", exception=1
caplib::getFwdRate(flatIrCurve, take(date, 0), 0.25)

@testing:case="getFwdRate rejects nonexistent handle irCurveHandle", exception=1
caplib::getFwdRate("TF_HANDLE_DOES_NOT_EXIST", curveDates, 0.25)

@testing:case="getFwdRate rejects keyword arguments", syntaxError=1
caplib::getFwdRate(irCurveHandle=flatIrCurve, dates=curveDates, tenor=0.25)
