// ============================================================================
// test_createIrRiskSettings.dos
// Per-function test suite for caplib::createIrRiskSettings (ir).
// Signature: caplib::createIrRiskSettings(irCurveRiskSettingsHandle STRING, thetaRiskSettingsHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrRiskSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irAsOfDate = 2022.03.09;
irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";
irCurve = caplib::createIrYieldCurve(
    irAsOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", irCurrency, irCurveName, "TF_IR_CHAIN_CURVE", false);

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

irSwapTemplate = caplib::createIrVanillaSwapTemplate(
    irCurveName, 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", true);

irSwap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    irSwapTemplate[0], 1000000.0, "", "TF_IR_SWAP", false);

irPricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_IR_MODEL", false);
irPricingSettings = caplib::createPricingSettings(irCurrency, "ANALYTICAL", 1, 1, take(0, 0), irPricingModel, "", "", "TF_IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "TF_IR_CURVE_RISK", false);
irPriceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "TF_IR_PRICE_RISK", false);
irThetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IR_RISK", true);
irXccyRisk = caplib::createXccyIrRiskSettings(irCurveRisk, irPriceRisk, irThetaRisk, "TF_IR_XCCY_RISK", true);

irMktData = caplib::createIrMktDataSet(
    irAsOfDate, irCurve, [iborIndex[0]], [irCurve], "TF_IR_MKT", true);

irSwapPricingResult = caplib::priceIrVanillaInstrument(
    irSwap, irAsOfDate, irMktData[0], irPricingSettings, irRisk[0], "", "", true);

// ============================================================================
// Tests
// ============================================================================

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrRiskSettings -> handle"
result = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IRRISK", false)
assert 1, result == "TF_IRRISK"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrRiskSettings rejects missing argument", syntaxError=1
caplib::createIrRiskSettings("X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrRiskSettings rejects extra argument", syntaxError=1
caplib::createIrRiskSettings("X", "X", "TF_createIrRiskSettings_H", false, 1)

// 用例目的：句柄参数 irCurveRiskSettingsHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects nonexistent handle irCurveRiskSettingsHandle", exception=1
caplib::createIrRiskSettings("TF_NO_SUCH_HANDLE_createIrRiskSettings", "X", "TF_createIrRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrRiskSettings rejects keyword arguments", syntaxError=1
caplib::createIrRiskSettings(irCurveRiskSettingsHandle="X", thetaRiskSettingsHandle="X", handle="TF_createIrRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrRiskSettings optional returnJson null uses default"
result = caplib::createIrRiskSettings(irCurveRisk, irThetaRisk, "TF_IRRISK", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 thetaRiskSettingsHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects wrong object type for thetaRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(irCurveRisk, irCurveRisk, "TF_IRRISK", false)

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects wrong type for irCurveRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(1, irThetaRisk, "TF_IRRISK", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects null irCurveRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(string(), irThetaRisk, "TF_IRRISK", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects wrong type for thetaRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(irCurveRisk, 1, "TF_IRRISK", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects null thetaRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(irCurveRisk, string(), "TF_IRRISK", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 irCurveRiskSettingsHandle 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createIrRiskSettings rejects vector for scalar irCurveRiskSettingsHandle", exception=1
caplib::createIrRiskSettings(["X"], irThetaRisk, "TF_IRRISK", false);
