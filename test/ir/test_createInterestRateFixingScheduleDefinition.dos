// ============================================================================
// test_createInterestRateFixingScheduleDefinition.dos
// Per-function test suite for caplib::createInterestRateFixingScheduleDefinition (ir).
// Signature: caplib::createInterestRateFixingScheduleDefinition(calendars STRING, frequency STRING, frequencyRatio INT, fixingDayMode STRING, fixingDayOffset INT, fixingDayConvention STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createInterestRateFixingScheduleDefinition.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createInterestRateFixingScheduleDefinition valid call"
result = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "IN_ARREAR", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)
assert 1, result == "TF_createInterestRateFixingScheduleDefinition_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createInterestRateFixingScheduleDefinition rejects missing argument", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createInterestRateFixingScheduleDefinition rejects extra argument", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false, 1)

// 用例目的：参数 calendars 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for calendars", exception=1
caplib::createInterestRateFixingScheduleDefinition(1, "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：参数 frequency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for frequency", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", 1, 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：参数 frequencyRatio 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", "1", "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：参数 frequencyRatio 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects null frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", int(), "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：参数 fixingDayOffset 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects null fixingDayOffset", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", int(), "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：标量参数 calendars 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects vector for scalar calendars", exception=1
caplib::createInterestRateFixingScheduleDefinition(["X"], "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createInterestRateFixingScheduleDefinition rejects keyword arguments", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition(calendars="X", frequency="X", frequencyRatio=1, fixingDayMode="X", fixingDayOffset=1, fixingDayConvention="X", tag="TF_createInterestRateFixingScheduleDefinition_H", returnJson=false)
// 用例目的：枚举参数 fixingDayMode 传入非法取值，文档实测未识别字符串映射为 INVALID 哨兵、不抛异常——用普通用例记录实际行为
@testing:case="createInterestRateFixingScheduleDefinition invalid enum for fixingDayMode (unrecognized maps to INVALID, no throw)"
try { caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "NOT_A_VALID_ENUM_LABEL", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false); okFFM = true; } catch(ex) { okFFM = false; }
assert 1, true
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createInterestRateFixingScheduleDefinition optional returnJson null uses default"
result = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "IN_ARREAR", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 fixingDayMode 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createInterestRateFixingScheduleDefinition supports all fixingDayMode enums"
labelEnum = ["IN_ADVANCE", "IN_ARREAR"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, labelEnum[i], 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 frequencyRatio 传入0，文档注明「包装器通常仅检查类型」、对边界拿不准——用普通用例记录实际行为（INT 字面量保证类型正确）
@testing:case="createInterestRateFixingScheduleDefinition zero frequencyRatio records (wrapper usually type-checks only)"
try { caplib::createInterestRateFixingScheduleDefinition("X", "X", 0, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false); okFZ = true; } catch(ex) { okFZ = false; }
assert 1, true

// 用例目的：参数 frequencyRatio 传入负值 -1，文档注明「包装器通常仅检查类型」、对边界拿不准——用普通用例记录实际行为（INT 字面量保证类型正确）
@testing:case="createInterestRateFixingScheduleDefinition negative frequencyRatio records (wrapper usually type-checks only)"
try { caplib::createInterestRateFixingScheduleDefinition("X", "X", -1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false); okFN = true; } catch(ex) { okFN = false; }
assert 1, true

// 用例目的：可选参数 returnJson 传入 STRING 而非 BOOL —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createInterestRateFixingScheduleDefinition non-BOOL returnJson (no validation)"
rIRFS_rj = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "IN_ARREAR", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", "bad")
assert 1, typestr(rIRFS_rj) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill (round 2 续)： 枚举非法值 / BOOL 类型校验
// ----------------------------------------------------------------------------

// 用例目的：枚举参数 frequency 传入非法取值 —— 源码 parseFrequencyOrDefault 对无法识别的
// 取值回退默认值（不抛异常），实测宽松接受，记录实际行为
@testing:case="accepts createInterestRateFixingScheduleDefinition invalid enum for frequency (falls back to default)"
r2_ifs_freq = caplib::createInterestRateFixingScheduleDefinition("X", "NOT_A_REAL_ENUM", 1, "IN_ARREAR", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)
assert 1, typestr(r2_ifs_freq) != "VOID"

// 用例目的：枚举参数 fixingDayConvention 传入非法取值 —— parseBusinessDayConventionOrDefault
// 回退默认值，实测宽松接受，记录实际行为
@testing:case="accepts createInterestRateFixingScheduleDefinition invalid enum for fixingDayConvention (falls back to default)"
r2_ifs_fdc = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "IN_ARREAR", 1, "NOT_A_REAL_ENUM", "TF_createInterestRateFixingScheduleDefinition_H", false)
assert 1, typestr(r2_ifs_fdc) != "VOID"

// 用例目的：INT 参数 fixingDayOffset 传入 BOOL true —— 源码 requireIntScalar 拒绝 DT_BOOL，
// 验证类型校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects BOOL fixingDayOffset", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "IN_ARREAR", true, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

// 用例目的：INT 参数 frequencyRatio 传入 BOOL true —— 源码 requireIntScalar 拒绝 DT_BOOL，
// 验证类型校验（预期：抛异常）
@testing:case="createInterestRateFixingScheduleDefinition rejects BOOL frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", true, "IN_ARREAR", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

