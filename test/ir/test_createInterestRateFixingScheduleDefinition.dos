@testing:case="createInterestRateFixingScheduleDefinition accepts invalid enum for fixingDayMode (lenient validation, does not raise)"
result = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "NOT_A_VALID_ENUM_LABEL", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createInterestRateFixingScheduleDefinition optional returnJson null uses default"
result = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", bool())
assert 1, typestr(result) != "VOID"



// ----------------------------------------------------------------------------
// Review wave-5 additions (wrong-type handles, enum sweeps, boundary values)
// ----------------------------------------------------------------------------

@testing:case="createInterestRateFixingScheduleDefinition supports all fixingDayMode enums"
labelEnum = ["IN_ADVANCE", "IN_ARREAR"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, labelEnum[i], 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum


@testing:case="createInterestRateFixingScheduleDefinition rejects zero frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 0.0, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)


@testing:case="createInterestRateFixingScheduleDefinition rejects negative frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", -1.0, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

