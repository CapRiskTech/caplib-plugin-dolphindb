// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createInterestRateFixingScheduleDefinition valid call"
result = caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)
assert 1, result == "TF_createInterestRateFixingScheduleDefinition_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createInterestRateFixingScheduleDefinition rejects missing argument", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X")

@testing:case="createInterestRateFixingScheduleDefinition rejects extra argument", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false, 1)

@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for calendars", exception=1
caplib::createInterestRateFixingScheduleDefinition(1, "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for frequency", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", 1, 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects wrong type for frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", "1", "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects null frequencyRatio", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", int(), "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects null fixingDayOffset", exception=1
caplib::createInterestRateFixingScheduleDefinition("X", "X", 1, "X", int(), "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects vector for scalar calendars", exception=1
caplib::createInterestRateFixingScheduleDefinition(["X"], "X", 1, "X", 1, "X", "TF_createInterestRateFixingScheduleDefinition_H", false)

@testing:case="createInterestRateFixingScheduleDefinition rejects keyword arguments", syntaxError=1
caplib::createInterestRateFixingScheduleDefinition(calendars="X", frequency="X", frequencyRatio=1, fixingDayMode="X", fixingDayOffset=1, fixingDayConvention="X", tag="TF_createInterestRateFixingScheduleDefinition_H", returnJson=false)



