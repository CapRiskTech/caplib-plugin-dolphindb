// ============================================================================
// test_createIrVanillaSwapTemplate.dos
// Per-function test suite for caplib::createIrVanillaSwapTemplate (ir).
// Signature: caplib::createIrVanillaSwapTemplate(instName STRING, startDelay INT or STRING, leg1Definition STRING, leg2Definition STRING, startConvention STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrVanillaSwapTemplate.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// Precondition: register the CNY calendar used by indices, legs and schedules
calendarCreated = caplib::createCalendar("CAL_CFETS");
assert 1, calendarCreated;

irCurrency = "CNY";
irCurveName = "CNY_SHIBOR_3M";

iborIndex = caplib::createIborIndex(
    irCurveName, "3M", irCurrency, ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

irFixedLeg = caplib::createFixedLegDefinition(
    irCurrency, "CAL_CFETS", "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FIXED_LEG", true);

irFloatingLeg = caplib::createFloatingLegDefinition(
    irCurrency, iborIndex[0], "CAL_CFETS", ["CAL_CFETS"],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createIrVanillaSwapTemplate -> handle"
result = caplib::createIrVanillaSwapTemplate("TF_SWTPL", 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", false)
assert 1, result == "TF_SWTPL"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createIrVanillaSwapTemplate rejects missing argument", syntaxError=1
caplib::createIrVanillaSwapTemplate("X", 1, "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createIrVanillaSwapTemplate rejects extra argument", syntaxError=1
caplib::createIrVanillaSwapTemplate("X", 1, "X", "X", "X", false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects wrong type for instName", exception=1
caplib::createIrVanillaSwapTemplate(1, 1, "X", "X", "X", false)

// 用例目的：参数 startDelay 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects wrong type for startDelay", exception=1
caplib::createIrVanillaSwapTemplate("X", "1", "X", "X", "X", false)

// 用例目的：参数 leg1Definition 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects wrong type for leg1Definition", exception=1
caplib::createIrVanillaSwapTemplate("X", 1, 1, "X", "X", false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects null instName", exception=1
caplib::createIrVanillaSwapTemplate(string(), 1, "X", "X", "X", false)

// 用例目的：参数 startDelay 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects null startDelay", exception=1
caplib::createIrVanillaSwapTemplate("X", int(), "X", "X", "X", false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects vector for scalar instName", exception=1
caplib::createIrVanillaSwapTemplate(["X"], 1, "X", "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createIrVanillaSwapTemplate rejects keyword arguments", syntaxError=1
caplib::createIrVanillaSwapTemplate(instName="X", startDelay=1, leg1Definition="X", leg2Definition="X", startConvention="X", returnJson=false)
// 用例目的：枚举参数 startConvention 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects invalid enum for startConvention", exception=1
caplib::createIrVanillaSwapTemplate("TF_SWTPL", 1, irFixedLeg[0], irFloatingLeg[0], "NOT_A_VALID_ENUM_LABEL", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createIrVanillaSwapTemplate optional returnJson null uses default"
result = caplib::createIrVanillaSwapTemplate("TF_SWTPL", 1, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 startConvention 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createIrVanillaSwapTemplate supports all startConvention enums"
labelEnum = ["SPOTSTART", "TODAYSTART", "TOMORROWSTART"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createIrVanillaSwapTemplate("TF_SWTPL", 1, irFixedLeg[0], irFloatingLeg[0], labelEnum[i], false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 startDelay 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createIrVanillaSwapTemplate rejects negative startDelay", exception=1
caplib::createIrVanillaSwapTemplate("TF_SWTPL", -1.0, irFixedLeg[0], irFloatingLeg[0], "SPOTSTART", false)

