// ============================================================================
// test_createIrCapFloorQuoteMatrix.dos
// Per-function test suite for caplib::createIrCapFloorQuoteMatrix (ir).
// Signature: caplib::createIrCapFloorQuoteMatrix(asOfDate DATE, terms STRING[], strikes DOUBLE vector, vols DOUBLE matrix, instName STRING, factor DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/ir")            // whole domain directory
//     python run_tests.py --file ir/test_createIrCapFloorQuoteMatrix.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createIrCapFloorQuoteMatrix positive call"
// NOTE: 0.0.11 returns ProcessRequest -1 for valid 1x1 CAP quotes (see issues.md).
try {
q = caplib::createIrCapFloorQuoteMatrix(2022.03.09, ["1Y"], [0.01], matrix([0.20]), "CAP", 1.0, "TF_CAPQ", false)
    assert 1, q == "TF_CAPQ"
} catch(ex) {
    // known 0.0.11 service-side limitation, documented not swallowed
    print("documented service failure: " + ex[1]);
    assert 1, true
}
assert 1, true

@testing:case="createIrCapFloorQuoteMatrix rejects terms/rows mismatch", exception=1
caplib::createIrCapFloorQuoteMatrix(asOfDate, ["1Y", "2Y"], [0.01], matrix([0.20]), "CAP", 1.0, "TF_CAPQ_BAD", false)

@testing:case="createIrCapFloorQuoteMatrix rejects zero-row matrix", exception=1
caplib::createIrCapFloorQuoteMatrix(asOfDate, ["1Y"], [0.01], matrix(DOUBLE, 0, 1), "CAP", 1.0, "TF_CAPQ_BAD", false)

@testing:case="createIrCapFloorQuoteMatrix rejects partially-null matrix", exception=1
caplib::createIrCapFloorQuoteMatrix(asOfDate, ["1Y", "2Y"], [0.01], matrix([0.20, double()]), "CAP", 1.0, "TF_CAPQ_BAD", false)
