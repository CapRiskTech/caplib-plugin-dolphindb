// 用例目的：returnJson 传入非 BOOL（STRING），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createFloatingLegDefinition rejects wrong type for returnJson", exception=1
caplib::createFloatingLegDefinition("CNY", iborIndex[0], "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "QUARTERLY", "ACT_360", "NO_DISCOUNT", "STANDARD", false, "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG_RJ", "bad")

// 用例目的：refIndex 传入未创建句柄字符串，实测文档所述「包装器不校验句柄成员资格」、宽松接受——记录实际行为
@testing:case="createFloatingLegDefinition accepts nonexistent refIndex handle (no membership validation)"
nrR = caplib::createFloatingLegDefinition("CNY", "NONEXISTENT_IBOR_HANDLE", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "QUARTERLY", "ACT_360", "NO_DISCOUNT", "STANDARD", false, "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true)
assert 1, typestr(nrR) != "VOID"

// 用例目的：遍历参数 rateCalcMethod 的文档合法子集，逐一调用验证均被接受
@testing:case="createFloatingLegDefinition supports all rateCalcMethod enums"
labelRC = ["STANDARD", "COMPOUND_AVERAGE", "ARITHMETIC_AVERAGE"]
okRC = true;
for (i in 0..(size(labelRC)-1)) {
    try { caplib::createFloatingLegDefinition("CNY", iborIndex[0], "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "QUARTERLY", "ACT_360", "NO_DISCOUNT", labelRC[i], false, "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true); } catch(ex) { okRC = false; }
}
assert 1, okRC

// 用例目的：遍历参数 fixingMode 的文档合法子集，逐一调用验证均被接受
@testing:case="createFloatingLegDefinition supports all fixingMode enums"
labelFM = ["IN_ADVANCE", "IN_ARREAR"]
okFM = true;
for (i in 0..(size(labelFM)-1)) {
    try { caplib::createFloatingLegDefinition("CNY", iborIndex[0], "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "QUARTERLY", "ACT_360", "NO_DISCOUNT", "STANDARD", false, "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", labelFM[i], -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true); } catch(ex) { okFM = false; }
}
assert 1, okFM

