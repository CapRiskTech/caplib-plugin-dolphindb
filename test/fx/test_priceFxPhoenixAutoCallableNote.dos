            -0.00753, -0.00765, -0.00758, -0.00754,
            -0.00759, -0.00828, -0.00814, -0.00801,
            -0.00801, -0.00777, -0.00735, -0.0068,
            -0.00612, -0.00547, -0.00355];
eurCurve = caplib::createIrYieldCurve(
    asOfDate, eurDates, eurRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "EUR", "EUR_EURUSD_FX", "EUR_EURUSD_FX", false);

eurusdSpotRate = caplib::createFxSpotRate(
    eurusdSpot, "EUR", "USD", asOfDate, 2021.04.01, "EURUSD_SPOT_RATE", true);

modelParams = [0.0];

mcSettings = caplib::createMonteCarloSettings(8096, 1, 1023, 1, 1, 0, 365, "FX_MC_SETTINGS", false);
bsmMcModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", underlying, 0, modelParams, "FX_BSM_MC_MODEL", false);
bsmMcSettings = caplib::createPricingSettings(currency, "MONTE_CARLO", 0, 0, take(0, 0), bsmMcModel, "", mcSettings, "FX_BSM_MC", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 0, 1.0e-4, 5.0e-1, 0, 0, 1.0e-4, 0, "FX_IR_CURVE_RISK", false);
priceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0e-2, 0, "FX_PRICE_RISK", false);
fxOptionRisk = caplib::createFxRiskSettings(
    irCurveRisk, priceRisk, "", "", "", "", "FX_OPTION_RISK", true);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-4, 1.0e-4, "FX_VOL_SURF_DEF", true);
fxMktConventions = caplib::createFxMktConventions(
    underlying, "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA",
    "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "EURUSD_MKT_CONV", true);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

quoteNames = ["ATM", "D25_RR", "D25_BF", "D10_RR", "D10_BF"];
quoteTerms = ["ON", "1W", "2W", "3W", "1M", "2M", "3M", "4M", "6M",
              "9M", "1Y", "18M", "2Y", "3Y", "4Y", "5Y", "7Y", "10Y"];
quoteValues = matrix(
    [0.06035, 0.05515, 0.05730, 0.05870, 0.06115, 0.06105,
     0.06135, 0.06210, 0.06250, 0.06315, 0.06330, 0.06635,
     0.06780, 0.07125, 0.07338, 0.07533, 0.07825, 0.08190],
    [-0.00310, -0.00290, -0.00285, -0.00230, -0.00248, -0.00213,
     -0.00180, -0.00160, -0.00135, -0.00105, -0.00100, -0.00182,
     -0.00248, -0.00165, -0.00138, -0.00120, -0.00168, -0.00197],
    [0.00115, 0.00135, 0.00135, 0.00140, 0.00147, 0.00177,
     0.00205, 0.00220, 0.00250, 0.00295, 0.00325, 0.00330,
     0.00333, 0.00345, 0.00350, 0.00350, 0.00322, 0.00307],
    [-0.00565, -0.00520, -0.00520, -0.00415, -0.00450, -0.00380,
     -0.00330, -0.00290, -0.00240, -0.00195, -0.00185, -0.00360,
     -0.00480, -0.00330, -0.00275, -0.00245, -0.00373, -0.00410],
    [0.00310, 0.00385, 0.00415, 0.00405, 0.00450, 0.00530,
     0.00625, 0.00678, 0.00815, 0.00995, 0.01120, 0.01100,
     0.01150, 0.01205, 0.01225, 0.01240, 0.01058, 0.01035]);
optionQuotes = caplib::createFxOptionQuoteMatrix(
    "EUR", "USD", asOfDate, quoteTerms, quoteNames, quoteValues, "EURUSD_OPTION_QUOTES", true);

volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "FX_VOL_BUILD_SETTINGS", true);
builtVolSurface = caplib::buildFxVolatilitySurface(
    asOfDate, "EUR", "USD", fxMktConventions[0], optionQuotes[0],
    eurusdSpot, asOfDate, 2021.04.01, usdCurve, eurCurve,
    volSurfDefinition[0], volSurfBuildSettings[0], "EURUSD_BUILT_VOL_SURF", true);

eurusdMktData = caplib::createFxMktDataSet(
    asOfDate, usdCurve, eurCurve, eurusdSpotRate[0], builtVolSurface[0], "", "EURUSD_MKT", true);

dailyObsDates = 2021.03.31..2021.09.26;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));
couponObsValues = take(0.0, 2);
couponObsWeights = take(1.0, 2);

tphoenixautocallablenote = caplib::createPhoenixAutoCallableNote("CALL", eurusdSpot, 0.12, "ACT_365_FIXED", 2021.04.01, [2021.06.30, 2021.09.26], "UP_OUT", eurusdSpot*1.1, "DOWN_IN", eurusdSpot*0.9, "SELL", "PUT", eurusdSpot*0.85, 2021.09.26, 2021.09.27, 1, 1000000.0, currency, "SPOT", currency, "EURUSD", "tPhx", [2021.06.30, 2021.09.26], couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回 PricingResults（含 present_value/cash_value/currency）
@testing:case="priceFxPhoenixAutoCallableNote -> PricingResults"
result = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", true)
assert 1, isPricingResultsJson(result, "tPhx_results")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="priceFxPhoenixAutoCallableNote rejects missing argument", syntaxError=1
caplib::priceFxPhoenixAutoCallableNote("X", 2024.01.01, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="priceFxPhoenixAutoCallableNote rejects extra argument", syntaxError=1
caplib::priceFxPhoenixAutoCallableNote("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

// 用例目的：参数 pricingDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects wrong type for pricingDate", exception=1
caplib::priceFxPhoenixAutoCallableNote("X", "bad", "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects wrong type for mode", exception=1
caplib::priceFxPhoenixAutoCallableNote("X", 2024.01.01, "X", "X", "X", "X", 1, false)

// 用例目的：参数 pricingDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects null pricingDate", exception=1
caplib::priceFxPhoenixAutoCallableNote("X", date(), "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects null mode", exception=1
caplib::priceFxPhoenixAutoCallableNote("X", 2024.01.01, "X", "X", "X", "X", string(), false)

// 用例目的：标量参数 pricingDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects vector for scalar pricingDate", exception=1
caplib::priceFxPhoenixAutoCallableNote("X", [2024.01.01], "X", "X", "X", "X", "X", false)

// 用例目的：句柄参数 instrumentHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects nonexistent handle instrumentHandle", exception=1
caplib::priceFxPhoenixAutoCallableNote("TF_NO_SUCH_HANDLE_priceFxPhoenixAutoCallableNote", 2024.01.01, "X", "X", "X", "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="priceFxPhoenixAutoCallableNote rejects keyword arguments", syntaxError=1
caplib::priceFxPhoenixAutoCallableNote(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="priceFxPhoenixAutoCallableNote optional returnJson null uses default"
result = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 mktDataHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="priceFxPhoenixAutoCallableNote rejects wrong object type for mktDataHandle", exception=1
caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, tphoenixautocallablenote, bsmMcSettings, fxOptionRisk[0], "", "", true)
// 用例目的：同一合约名义金额放大 2 倍，验证现值精确翻倍（现值对名义的线性性质）
@testing:case="priceFxPhoenixAutoCallableNote notional scaling -> 2x notional, 2x present value"
tphoenixautocallablenote_2X = caplib::createPhoenixAutoCallableNote("CALL", eurusdSpot, 0.12, "ACT_365_FIXED", 2021.04.01, [2021.06.30, 2021.09.26], "UP_OUT", eurusdSpot*1.1, "DOWN_IN", eurusdSpot*0.9, "SELL", "PUT", eurusdSpot*0.85, 2021.09.26, 2021.09.27, 1, (1000000.0) * 2, currency, "SPOT", currency, "EURUSD", "tPhx_2X", [2021.06.30, 2021.09.26], couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false);
p1 = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", true);
p2 = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote_2X, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", true);
assert 1, abs(presentValue(p2) - 2.0 * presentValue(p1)) <= abs(presentValue(p1)) * 1.0e-9 + 1.0e-6

// 用例目的：相同输入连续定价两次，验证两次现值完全一致（定价确定性）
@testing:case="priceFxPhoenixAutoCallableNote deterministic repeat -> identical result"
r1 = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", true);
r2 = caplib::priceFxPhoenixAutoCallableNote(tphoenixautocallablenote, asOfDate, eurusdMktData[0], bsmMcSettings, fxOptionRisk[0], "", "", true);
assert 1, abs(presentValue(r1) - presentValue(r2)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)
