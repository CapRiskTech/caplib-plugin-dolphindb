// ============================================================================
// test_createFlatFxVolatilitySurface.dos
// Per-function test suite for caplib::createFlatFxVolatilitySurface (fx).
// Signature: caplib::createFlatFxVolatilitySurface(referenceDate DATE, currencyPair STRING, vol DOUBLE, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFlatFxVolatilitySurface.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFlatFxVolatilitySurface -> handle"
result = caplib::createFlatFxVolatilitySurface(asOfDate, "USDCNH", 0.06, "TF_FLATFV", false)
assert 1, result == "TF_FLATFV"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFlatFxVolatilitySurface rejects missing argument", syntaxError=1
caplib::createFlatFxVolatilitySurface(2024.01.01, "X", 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFlatFxVolatilitySurface rejects extra argument", syntaxError=1
caplib::createFlatFxVolatilitySurface(2024.01.01, "X", 0.02, "TF_createFlatFxVolatilitySurface_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects wrong type for referenceDate", exception=1
caplib::createFlatFxVolatilitySurface("bad", "X", 0.02, "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：参数 currencyPair 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects wrong type for currencyPair", exception=1
caplib::createFlatFxVolatilitySurface(2024.01.01, 1, 0.02, "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：参数 vol 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects wrong type for vol", exception=1
caplib::createFlatFxVolatilitySurface(2024.01.01, "X", "bad", "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects null referenceDate", exception=1
caplib::createFlatFxVolatilitySurface(date(), "X", 0.02, "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：参数 vol 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects null vol", exception=1
caplib::createFlatFxVolatilitySurface(2024.01.01, "X", double(), "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects vector for scalar referenceDate", exception=1
caplib::createFlatFxVolatilitySurface([2024.01.01], "X", 0.02, "TF_createFlatFxVolatilitySurface_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFlatFxVolatilitySurface rejects keyword arguments", syntaxError=1
caplib::createFlatFxVolatilitySurface(referenceDate=2024.01.01, currencyPair="X", vol=0.02, tag="TF_createFlatFxVolatilitySurface_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFlatFxVolatilitySurface optional returnJson null uses default"
result = caplib::createFlatFxVolatilitySurface(asOfDate, "USDCNH", 0.06, "TF_FLATFV", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 vol 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createFlatFxVolatilitySurface rejects negative vol", exception=1
caplib::createFlatFxVolatilitySurface(asOfDate, "USDCNH", -1.0, "TF_FLATFV", false)

