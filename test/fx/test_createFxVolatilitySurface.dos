// ============================================================================
// test_createFxVolatilitySurface.dos
// Per-function test suite for caplib::createFxVolatilitySurface (fx).
// Signature: caplib::createFxVolatilitySurface(referenceDate DATE, leftCcy STRING, rightCcy STRING, termDates DATE[], strikes DOUBLE matrix/vector, volatilities DOUBLE matrix/vector, definitionHandle STRING, marketConventionsHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxVolatilitySurface.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;
underlying = "EURUSD";
eurusdSpot = 1.1761;

linearVolSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE",
    1.0e-4, 1.0e4, "FX_LINEAR_VOL_SURF_DEF", true);
fxMktConventions = caplib::createFxMktConventions(
    underlying, "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA",
    "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "EURUSD_MKT_CONV", true);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.
formStrikesVector = [1.00, eurusdSpot, 1.35];
formVolsVector = [0.06, 0.06, 0.06];

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxVolatilitySurface -> handle"
result = caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], formStrikesVector, formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)
assert 1, result == "TF_FXVS"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxVolatilitySurface rejects missing argument", syntaxError=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxVolatilitySurface rejects extra argument", syntaxError=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects wrong type for referenceDate", exception=1
caplib::createFxVolatilitySurface("bad", "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：参数 leftCcy 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects wrong type for leftCcy", exception=1
caplib::createFxVolatilitySurface(2024.01.01, 1, "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：参数 rightCcy 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects wrong type for rightCcy", exception=1
caplib::createFxVolatilitySurface(2024.01.01, "X", 1, [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects null referenceDate", exception=1
caplib::createFxVolatilitySurface(date(), "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：参数 leftCcy 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects null leftCcy", exception=1
caplib::createFxVolatilitySurface(2024.01.01, string(), "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects vector for scalar referenceDate", exception=1
caplib::createFxVolatilitySurface([2024.01.01], "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects scalar for vector termDates", exception=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects partially-null vector termDates", exception=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", [2024.01.01, date()], matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects empty vector termDates", exception=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", take(date, 0), matrix([0.2]), matrix([0.2]), "X", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：句柄参数 definitionHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects nonexistent handle definitionHandle", exception=1
caplib::createFxVolatilitySurface(2024.01.01, "X", "X", [2024.01.01], matrix([0.2]), matrix([0.2]), "TF_HANDLE_DOES_NOT_EXIST", "X", "TF_createFxVolatilitySurface_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxVolatilitySurface rejects keyword arguments", syntaxError=1
caplib::createFxVolatilitySurface(referenceDate=2024.01.01, leftCcy="X", rightCcy="X", termDates=[2024.01.01], strikes=matrix([0.2]), volatilities=matrix([0.2]), definitionHandle="X", marketConventionsHandle="X", handle="TF_createFxVolatilitySurface_H", returnJson=false)
// 用例目的：向量参数 termDates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects all-null vector termDates", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [date(), date(), date()], formStrikesVector, formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)

// 用例目的：矩阵参数 strikes 传入0 行矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects zero-row matrix strikes", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], matrix(DOUBLE, 0, 3), formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)

// 用例目的：矩阵参数 strikes 传入全部空值矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects all-null matrix strikes", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], matrix([double(), double()], [double(), double()]), formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)

// 用例目的：矩阵参数 strikes 传入部分空值矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects partially-null matrix strikes", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], matrix([0.2, double()], [double(), 0.2]), formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxVolatilitySurface optional returnJson null uses default"
result = caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], formStrikesVector, formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：accepts matrix strikes with vector vols（预期：插件按文档行为执行）
@testing:case="createFxVolatilitySurface accepts matrix strikes with vector vols"
rMV = caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30],
    matrix([1.00], [1.1761], [1.35]), [0.06, 0.06, 0.06],
    linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS_MV", false)
assert 1, rMV == "TF_FXVS_MV"

// 用例目的：accepts vector strikes with matrix vols（预期：插件按文档行为执行）
@testing:case="createFxVolatilitySurface accepts vector strikes with matrix vols"
rVM = caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30],
    [1.00, 1.1761, 1.35], matrix([0.06], [0.06], [0.06]),
    linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS_VM", false)
assert 1, rVM == "TF_FXVS_VM"

// 用例目的：accepts matrix strikes with matrix vols（预期：插件按文档行为执行）
@testing:case="createFxVolatilitySurface accepts matrix strikes with matrix vols"
rMM = caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30],
    matrix([1.00], [1.1761], [1.35]), matrix([0.06], [0.06], [0.06]),
    linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS_MM", false)
assert 1, rMM == "TF_FXVS_MM"
// 用例目的：句柄参数 marketConventionsHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects wrong object type for marketConventionsHandle", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], formStrikesVector, formVolsVector, linearVolSurfDefinition[0], linearVolSurfDefinition[0], "TF_FXVS", false)

// 用例目的：矩阵参数 strikes 传入0 列矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects zero-col matrix strikes", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30], matrix(DOUBLE, 3, 0), formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false)

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（termDates 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createFxVolatilitySurface rejects termDates length mismatch", exception=1
caplib::createFxVolatilitySurface(asOfDate, "EUR", "USD", [2021.06.30, 2021.08.20], formStrikesVector, formVolsVector, linearVolSurfDefinition[0], fxMktConventions[0], "TF_FXVS", false);
