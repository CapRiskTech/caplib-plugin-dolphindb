// ============================================================================
// test_createFxNonDeliverableForward.dos
// Per-function test suite for caplib::createFxNonDeliverableForward (fx).
// Signature: caplib::createFxNonDeliverableForward(buyCurrency STRING, buyAmount DOUBLE, sellCurrency STRING, sellAmount DOUBLE, settlementCurrency STRING, deliveryDate DATE, expiryDate DATE, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxNonDeliverableForward.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createFxNonDeliverableForward valid call"
result = caplib::createFxNonDeliverableForward("X", 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)
assert 1, result == "TF_createFxNonDeliverableForward_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxNonDeliverableForward rejects missing argument", syntaxError=1
caplib::createFxNonDeliverableForward("X", 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxNonDeliverableForward rejects extra argument", syntaxError=1
caplib::createFxNonDeliverableForward("X", 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false, 1)

// 用例目的：参数 buyCurrency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects wrong type for buyCurrency", exception=1
caplib::createFxNonDeliverableForward(1, 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：参数 buyAmount 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects wrong type for buyAmount", exception=1
caplib::createFxNonDeliverableForward("X", "bad", "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：参数 sellCurrency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects wrong type for sellCurrency", exception=1
caplib::createFxNonDeliverableForward("X", 0.02, 1, 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：参数 buyAmount 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects null buyAmount", exception=1
caplib::createFxNonDeliverableForward("X", double(), "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：参数 sellAmount 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects null sellAmount", exception=1
caplib::createFxNonDeliverableForward("X", 0.02, "X", double(), "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：标量参数 buyCurrency 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects vector for scalar buyCurrency", exception=1
caplib::createFxNonDeliverableForward(["X"], 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxNonDeliverableForward rejects keyword arguments", syntaxError=1
caplib::createFxNonDeliverableForward(buyCurrency="X", buyAmount=0.02, sellCurrency="X", sellAmount=0.02, settlementCurrency="X", deliveryDate=2024.01.01, expiryDate=2024.01.01, tag="TF_createFxNonDeliverableForward_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxNonDeliverableForward optional returnJson null uses default"
result = caplib::createFxNonDeliverableForward("X", 0.02, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 buyAmount 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects zero buyAmount", exception=1
caplib::createFxNonDeliverableForward("X", 0.0, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

// 用例目的：参数 buyAmount 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createFxNonDeliverableForward rejects negative buyAmount", exception=1
caplib::createFxNonDeliverableForward("X", -1.0, "X", 0.02, "X", 2024.01.01, 2024.01.01, "TF_createFxNonDeliverableForward_H", false)

