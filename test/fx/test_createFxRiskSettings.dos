// ============================================================================
// test_createFxRiskSettings.dos
// Per-function test suite for caplib::createFxRiskSettings (fx).
// Signature: caplib::createFxRiskSettings(irCurveSettings STRING, priceSettings STRING, volSettings STRING, priceVolSettings STRING, thetaSettings STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 0, 1.0e-4, 5.0e-1, 0, 0, 1.0e-4, 0, "FX_IR_CURVE_RISK", false);
priceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0e-2, 0, "FX_PRICE_RISK", false);
volRisk = caplib::createVolRiskSettings(
    1, 1, 1.0e-2, 0, 0, 1.0e-2, 0, "FX_VOL_RISK", false);
priceVolRisk = caplib::createPriceVolRiskSettings(
    1, 1.0e-2, 1.0e-2, 0, 0, 1.0e-2, 1.0e-2, 0, "FX_PRICE_VOL_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FX_THETA_RISK", false);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxRiskSettings -> handle"
result = caplib::createFxRiskSettings(irCurveRisk, priceRisk, volRisk, priceVolRisk, thetaRisk, "", "TF_FXR", false)
assert 1, result == "TF_FXR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxRiskSettings rejects missing argument", syntaxError=1
caplib::createFxRiskSettings("X", "X", "X", "X", "X", "TF_createFxRiskSettings_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxRiskSettings rejects extra argument", syntaxError=1
caplib::createFxRiskSettings("X", "X", "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false, 1)

// 用例目的：参数 irCurveSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects wrong type for irCurveSettings", exception=1
caplib::createFxRiskSettings(1, "X", "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：参数 priceSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects wrong type for priceSettings", exception=1
caplib::createFxRiskSettings("X", 1, "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：参数 volSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects wrong type for volSettings", exception=1
caplib::createFxRiskSettings("X", "X", 1, "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：参数 irCurveSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects null irCurveSettings", exception=1
caplib::createFxRiskSettings(string(), "X", "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：参数 priceSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects null priceSettings", exception=1
caplib::createFxRiskSettings("X", string(), "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：标量参数 irCurveSettings 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxRiskSettings rejects vector for scalar irCurveSettings", exception=1
caplib::createFxRiskSettings(["X"], "X", "X", "X", "X", "TF_createFxRiskSettings_H", "TF_createFxRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxRiskSettings rejects keyword arguments", syntaxError=1
caplib::createFxRiskSettings(irCurveSettings="X", priceSettings="X", volSettings="X", priceVolSettings="X", thetaSettings="X", name="TF_createFxRiskSettings_H", tag="TF_createFxRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxRiskSettings optional returnJson null uses default"
result = caplib::createFxRiskSettings(irCurveRisk, priceRisk, volRisk, priceVolRisk, thetaRisk, "", "TF_FXR", bool())
assert 1, typestr(result) != "VOID"
