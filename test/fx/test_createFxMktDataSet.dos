// ============================================================================
// test_createFxMktDataSet.dos
// Per-function test suite for caplib::createFxMktDataSet (fx).
// Signature: caplib::createFxMktDataSet(asOfDate DATE, domDiscountCurve STRING, forDiscountCurve STRING, spot STRING, volSurface STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxMktDataSet.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;
underlying = "EURUSD";
eurusdSpot = 1.1761;

usdDates = [2021.04.06, 2021.04.13, 2021.04.20, 2021.04.30,
            2021.06.01, 2021.06.30, 2021.07.30, 2021.08.30,
            2021.09.30, 2021.12.30, 2022.03.30, 2022.09.30,
            2023.03.30, 2024.04.01, 2025.03.31, 2026.03.30,
            2027.03.30, 2028.03.30, 2031.03.31];
usdRates = [0.00016, 0.00016, 0.00016, 0.00017,
            0.00016, 0.00019, 0.00023, 0.00026,
            0.00028, 0.00034, 0.00042, 0.00063,
            0.00108, 0.00292, 0.00546, 0.00798,
            0.01025, 0.01217, 0.01624];
usdCurve = caplib::createIrYieldCurve(
    asOfDate, usdDates, usdRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_DEPO", "USD_DEPO", false);

eurDates = [2021.04.06, 2021.04.13, 2021.04.20, 2021.04.30,
            2021.05.31, 2021.06.30, 2021.07.30, 2021.08.30,
            2021.09.30, 2021.12.30, 2022.03.30, 2022.09.30,
            2023.03.30, 2024.04.02, 2025.03.31, 2026.03.30,
            2027.03.30, 2028.03.30, 2031.03.31];
eurRates = [-0.00814, -0.00766, -0.00761, -0.00764,
            -0.00753, -0.00765, -0.00758, -0.00754,
            -0.00759, -0.00828, -0.00814, -0.00801,
            -0.00801, -0.00777, -0.00735, -0.0068,
            -0.00612, -0.00547, -0.00355];
eurCurve = caplib::createIrYieldCurve(
    asOfDate, eurDates, eurRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "EUR", "EUR_EURUSD_FX", "EUR_EURUSD_FX", false);

eurusdSpotRate = caplib::createFxSpotRate(
    eurusdSpot, "EUR", "USD", asOfDate, 2021.04.01, "EURUSD_SPOT_RATE", true);

linearVolSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE",
    1.0e-4, 1.0e4, "FX_LINEAR_VOL_SURF_DEF", true);
fxMktConventions = caplib::createFxMktConventions(
    underlying, "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA",
    "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "EURUSD_MKT_CONV", true);

volTermDates = [2021.06.30, 2021.09.30, 2021.12.30];
volStrikes = matrix(take(1.00, 3), take(eurusdSpot, 3), take(1.35, 3));
volValues = matrix(take(0.06, 3), take(0.06, 3), take(0.06, 3));
volSurface = caplib::createFxVolatilitySurface(
    asOfDate, "EUR", "USD", volTermDates, volStrikes, volValues,
    linearVolSurfDefinition[0], fxMktConventions[0], "EURUSD_VOL_SURF", true);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

flatFxVolSurface = caplib::createFlatFxVolatilitySurface(
    asOfDate, "USDCNH", 0.0, "USDCNH_FLAT_FX_VOL_SURF", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxMktDataSet -> handle"
result = caplib::createFxMktDataSet(asOfDate, usdCurve, eurCurve, eurusdSpotRate[0], flatFxVolSurface[0], "", "TF_FXMKT", false)
assert 1, result == "TF_FXMKT"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktDataSet rejects missing argument", syntaxError=1
caplib::createFxMktDataSet(2024.01.01, "X", "X", "X", "X", "TF_createFxMktDataSet_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktDataSet rejects extra argument", syntaxError=1
caplib::createFxMktDataSet(2024.01.01, "X", "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createFxMktDataSet("bad", "X", "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：参数 domDiscountCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects wrong type for domDiscountCurve", exception=1
caplib::createFxMktDataSet(2024.01.01, 1, "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：参数 forDiscountCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects wrong type for forDiscountCurve", exception=1
caplib::createFxMktDataSet(2024.01.01, "X", 1, "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects null asOfDate", exception=1
caplib::createFxMktDataSet(date(), "X", "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：参数 domDiscountCurve 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects null domDiscountCurve", exception=1
caplib::createFxMktDataSet(2024.01.01, string(), "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxMktDataSet rejects vector for scalar asOfDate", exception=1
caplib::createFxMktDataSet([2024.01.01], "X", "X", "X", "X", "TF_createFxMktDataSet_H", "TF_createFxMktDataSet_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxMktDataSet rejects keyword arguments", syntaxError=1
caplib::createFxMktDataSet(asOfDate=2024.01.01, domDiscountCurve="X", forDiscountCurve="X", spot="X", volSurface="X", name="TF_createFxMktDataSet_H", tag="TF_createFxMktDataSet_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxMktDataSet optional returnJson null uses default"
result = caplib::createFxMktDataSet(asOfDate, usdCurve, eurCurve, eurusdSpotRate[0], flatFxVolSurface[0], "", "TF_FXMKT", bool())
assert 1, typestr(result) != "VOID"
