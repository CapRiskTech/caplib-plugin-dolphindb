// ============================================================================
// test_createFxSpotRate.dos
// Per-function test suite for caplib::createFxSpotRate (fx).
// Signature: caplib::createFxSpotRate(value DOUBLE, baseCurrency STRING, targetCurrency STRING, refDate DATE, spotDate DATE, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxSpotRate.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxSpotRate -> handle"
result = caplib::createFxSpotRate(1.1761, "EUR", "USD", asOfDate, 2021.04.01, "TF_FXSPOT", false)
assert 1, result == "TF_FXSPOT"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxSpotRate rejects missing argument", syntaxError=1
caplib::createFxSpotRate(0.02, "X", "X", 2024.01.01, 2024.01.01)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxSpotRate rejects extra argument", syntaxError=1
caplib::createFxSpotRate(0.02, "X", "X", 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false, 1)

// 用例目的：参数 value 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotRate rejects wrong type for value", exception=1
caplib::createFxSpotRate("bad", "X", "X", 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：参数 baseCurrency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotRate rejects wrong type for baseCurrency", exception=1
caplib::createFxSpotRate(0.02, 1, "X", 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：参数 targetCurrency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotRate rejects wrong type for targetCurrency", exception=1
caplib::createFxSpotRate(0.02, "X", 1, 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：参数 value 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxSpotRate rejects null value", exception=1
caplib::createFxSpotRate(double(), "X", "X", 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：参数 refDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxSpotRate rejects null refDate", exception=1
caplib::createFxSpotRate(0.02, "X", "X", date(), 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：标量参数 value 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxSpotRate rejects vector for scalar value", exception=1
caplib::createFxSpotRate([0.02], "X", "X", 2024.01.01, 2024.01.01, "TF_createFxSpotRate_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxSpotRate rejects keyword arguments", syntaxError=1
caplib::createFxSpotRate(value=0.02, baseCurrency="X", targetCurrency="X", refDate=2024.01.01, spotDate=2024.01.01, tag="TF_createFxSpotRate_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxSpotRate optional returnJson null uses default"
result = caplib::createFxSpotRate(1.1761, "EUR", "USD", asOfDate, 2021.04.01, "TF_FXSPOT", bool())
assert 1, typestr(result) != "VOID"
