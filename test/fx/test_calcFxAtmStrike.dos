// ============================================================================
// test_calcFxAtmStrike.dos
// Per-function test suite for caplib::calcFxAtmStrike (fx).
// Signature: caplib::calcFxAtmStrike(atmType STRING, expiryDate DATE, volSurfaceHandle STRING, fxSpotRateHandle STRING, domesticDiscountCurveHandle STRING, foreignDiscountCurveHandle STRING)
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_calcFxAtmStrike.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;
underlying = "EURUSD";
eurusdSpot = 1.1761;

usdDates = [2021.04.06, 2021.04.13, 2021.04.20, 2021.04.30,
            2021.06.01, 2021.06.30, 2021.07.30, 2021.08.30,
            2021.09.30, 2021.12.30, 2022.03.30, 2022.09.30,
            2023.03.30, 2024.04.01, 2025.03.31, 2026.03.30,
            2027.03.30, 2028.03.30, 2031.03.31];
usdRates = [0.00016, 0.00016, 0.00016, 0.00017,
            0.00016, 0.00019, 0.00023, 0.00026,
            0.00028, 0.00034, 0.00042, 0.00063,
            0.00108, 0.00292, 0.00546, 0.00798,
            0.01025, 0.01217, 0.01624];
usdCurve = caplib::createIrYieldCurve(
    asOfDate, usdDates, usdRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_DEPO", "USD_DEPO", false);

eurDates = [2021.04.06, 2021.04.13, 2021.04.20, 2021.04.30,
            2021.05.31, 2021.06.30, 2021.07.30, 2021.08.30,
            2021.09.30, 2021.12.30, 2022.03.30, 2022.09.30,
            2023.03.30, 2024.04.02, 2025.03.31, 2026.03.30,
            2027.03.30, 2028.03.30, 2031.03.31];
eurRates = [-0.00814, -0.00766, -0.00761, -0.00764,
            -0.00753, -0.00765, -0.00758, -0.00754,
            -0.00759, -0.00828, -0.00814, -0.00801,
            -0.00801, -0.00777, -0.00735, -0.0068,
            -0.00612, -0.00547, -0.00355];
eurCurve = caplib::createIrYieldCurve(
    asOfDate, eurDates, eurRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "EUR", "EUR_EURUSD_FX", "EUR_EURUSD_FX", false);

eurusdSpotRate = caplib::createFxSpotRate(
    eurusdSpot, "EUR", "USD", asOfDate, 2021.04.01, "EURUSD_SPOT_RATE", true);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-4, 1.0e-4, "FX_VOL_SURF_DEF", true);
fxMktConventions = caplib::createFxMktConventions(
    underlying, "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA",
    "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "EURUSD_MKT_CONV", true);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

quoteNames = ["ATM", "D25_RR", "D25_BF", "D10_RR", "D10_BF"];
quoteTerms = ["ON", "1W", "2W", "3W", "1M", "2M", "3M", "4M", "6M",
              "9M", "1Y", "18M", "2Y", "3Y", "4Y", "5Y", "7Y", "10Y"];
quoteValues = matrix(
    [0.06035, 0.05515, 0.05730, 0.05870, 0.06115, 0.06105,
     0.06135, 0.06210, 0.06250, 0.06315, 0.06330, 0.06635,
     0.06780, 0.07125, 0.07338, 0.07533, 0.07825, 0.08190],
    [-0.00310, -0.00290, -0.00285, -0.00230, -0.00248, -0.00213,
     -0.00180, -0.00160, -0.00135, -0.00105, -0.00100, -0.00182,
     -0.00248, -0.00165, -0.00138, -0.00120, -0.00168, -0.00197],
    [0.00115, 0.00135, 0.00135, 0.00140, 0.00147, 0.00177,
     0.00205, 0.00220, 0.00250, 0.00295, 0.00325, 0.00330,
     0.00333, 0.00345, 0.00350, 0.00350, 0.00322, 0.00307],
    [-0.00565, -0.00520, -0.00520, -0.00415, -0.00450, -0.00380,
     -0.00330, -0.00290, -0.00240, -0.00195, -0.00185, -0.00360,
     -0.00480, -0.00330, -0.00275, -0.00245, -0.00373, -0.00410],
    [0.00310, 0.00385, 0.00415, 0.00405, 0.00450, 0.00530,
     0.00625, 0.00678, 0.00815, 0.00995, 0.01120, 0.01100,
     0.01150, 0.01205, 0.01225, 0.01240, 0.01058, 0.01035]);
optionQuotes = caplib::createFxOptionQuoteMatrix(
    "EUR", "USD", asOfDate, quoteTerms, quoteNames, quoteValues, "EURUSD_OPTION_QUOTES", true);

volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "FX_VOL_BUILD_SETTINGS", true);
builtVolSurface = caplib::buildFxVolatilitySurface(
    asOfDate, "EUR", "USD", fxMktConventions[0], optionQuotes[0],
    eurusdSpot, asOfDate, 2021.04.01, usdCurve, eurCurve,
    volSurfDefinition[0], volSurfBuildSettings[0], "EURUSD_BUILT_VOL_SURF", true);

// ============================================================================
// Tests

// 用例目的：-> numeric（预期：插件按文档行为执行）
@testing:case="calcFxAtmStrike -> numeric"
r = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve)
assert 1, r > 0.0

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="calcFxAtmStrike rejects missing argument", syntaxError=1
caplib::calcFxAtmStrike("X", 2024.01.01, "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="calcFxAtmStrike rejects extra argument", syntaxError=1
caplib::calcFxAtmStrike("X", 2024.01.01, "X", "X", "X", "X", 1)

// 用例目的：参数 atmType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects wrong type for atmType", exception=1
caplib::calcFxAtmStrike(1, 2024.01.01, "X", "X", "X", "X")

// 用例目的：参数 expiryDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects wrong type for expiryDate", exception=1
caplib::calcFxAtmStrike("X", "bad", "X", "X", "X", "X")

// 用例目的：参数 atmType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects null atmType", exception=1
caplib::calcFxAtmStrike(string(), 2024.01.01, "X", "X", "X", "X")

// 用例目的：参数 expiryDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects null expiryDate", exception=1
caplib::calcFxAtmStrike("X", date(), "X", "X", "X", "X")

// 用例目的：标量参数 atmType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects vector for scalar atmType", exception=1
caplib::calcFxAtmStrike(["X"], 2024.01.01, "X", "X", "X", "X")

// 用例目的：句柄参数 volSurfaceHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects nonexistent handle volSurfaceHandle", exception=1
caplib::calcFxAtmStrike("X", 2024.01.01, "TF_NO_SUCH_HANDLE_calcFxAtmStrike", "X", "X", "X")

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="calcFxAtmStrike rejects keyword arguments", syntaxError=1
caplib::calcFxAtmStrike(atmType="X", expiryDate=2024.01.01, volSurfaceHandle="X", fxSpotRateHandle="X", domesticDiscountCurveHandle="X", foreignDiscountCurveHandle="X")
// 用例目的：枚举参数 atmType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects invalid enum for atmType", exception=1
caplib::calcFxAtmStrike("NOT_A_VALID_ENUM_LABEL", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve)
// 用例目的：正常调用，与独立解析公式（闭式解）计算的参考值对比，验证计算正确性
@testing:case="calcFxAtmStrike -> analytic flat-fixture reference"
// Garman-Kohlhagen with S=1.1761, rd=2%, rf=1%, sigma=10%, T=1.0 (365d):
// F = S*exp((rd-rf)*T) = 1.1879200015076898; ATM DNS strike = F*exp(sigma^2*T/2).
domCurveRef = caplib::createFlatIrYieldCurve(2021.03.30, "USD", 0.02, "TF_REF_DOM", false);
forCurveRef = caplib::createFlatIrYieldCurve(2021.03.30, "EUR", 0.01, "TF_REF_FOR", false);
spotRef = caplib::createFxSpotRate(1.1761, "EUR", "USD", 2021.03.30, 2021.03.30, "TF_REF_SPOT", false);
fvolRef = caplib::createFlatFxVolatilitySurface(2021.03.30, "EURUSD", 0.10, "TF_REF_FVOL", false);
atmr = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2022.03.30, fvolRef, spotRef, domCurveRef, forCurveRef);
assert 1, abs(atmr - 1.193874475744343) < 1.0e-8
// 用例目的：同样输入重复调用多次，验证结果完全一致（确定性）
@testing:case="calcFxAtmStrike repeat calls return identical results"
a1 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
a2 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
assert 1, a1 == a2
// 用例目的：句柄参数 fxSpotRateHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="calcFxAtmStrike rejects wrong object type for fxSpotRateHandle", exception=1
caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], builtVolSurface[0], usdCurve, eurCurve)
// 用例目的：遍历参数 atmType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="calcFxAtmStrike supports all atmType enums"
labelEnum = ["ATM_FORWARD", "ATM_DNS_PIPS", "ATM_DNS_PERCENTAGE", "ATM_SPOT"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::calcFxAtmStrike(labelEnum[i], 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：相同输入连续调用两次，验证两次返回结果完全一致（计算确定性）
@testing:case="calcFxAtmStrike deterministic repeat -> identical result"
r1 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
r2 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
assert 1, max(abs(r1 - r2)) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：估值日期平移 7 天后再次计算，验证 ATM 行权价随输入变化（输入影响输出）
@testing:case="calcFxAtmStrike second input (+7d) -> result changes"
r1 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.09.26, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
r2 = caplib::calcFxAtmStrike("ATM_DNS_PIPS", (2021.09.26 + 7), builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve);
assert 1, abs(r1 - r2) > 0.0
