// ============================================================================
// test_createFxOptionQuoteMatrix.dos
// Per-function test suite for caplib::createFxOptionQuoteMatrix (fx).
// Signature: caplib::createFxOptionQuoteMatrix(leftCcy STRING, rightCcy STRING, asOfDate DATE, terms STRING[], quoteNames STRING[], quotes DOUBLE matrix, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxOptionQuoteMatrix.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

quoteNames = ["ATM", "D25_RR", "D25_BF", "D10_RR", "D10_BF"];

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxOptionQuoteMatrix -> [handle, json]"
r = caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix([0.06, 0.061], [0.062, 0.063]), "TF_FX_OQ", true);
assert 1, isHandleJson(r, "TF_FX_OQ") && hasJsonField(r[1], "quote_smiles")

// 用例目的：rejects zero-row quotes matrix（预期：插件按文档行为执行）
@testing:case="createFxOptionQuoteMatrix rejects zero-row quotes matrix", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix(DOUBLE, 0, 2), "TF_FX_OQ_BAD", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxOptionQuoteMatrix rejects missing argument", syntaxError=1
caplib::createFxOptionQuoteMatrix("X", "X", 2024.01.01, ["X"], ["X"], matrix([0.2]))

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxOptionQuoteMatrix rejects extra argument", syntaxError=1
caplib::createFxOptionQuoteMatrix("X", "X", 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false, 1)

// 用例目的：参数 leftCcy 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects wrong type for leftCcy", exception=1
caplib::createFxOptionQuoteMatrix(1, "X", 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：参数 rightCcy 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects wrong type for rightCcy", exception=1
caplib::createFxOptionQuoteMatrix("X", 1, 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects wrong type for asOfDate", exception=1
caplib::createFxOptionQuoteMatrix("X", "X", "bad", ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：参数 leftCcy 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects null leftCcy", exception=1
caplib::createFxOptionQuoteMatrix(string(), "X", 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：参数 rightCcy 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects null rightCcy", exception=1
caplib::createFxOptionQuoteMatrix("X", string(), 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：标量参数 leftCcy 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects vector for scalar leftCcy", exception=1
caplib::createFxOptionQuoteMatrix(["X"], "X", 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：向量参数 terms 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects scalar for vector terms", exception=1
caplib::createFxOptionQuoteMatrix("X", "X", 2024.01.01, ["X"], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：向量参数 terms 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects partially-null vector terms", exception=1
caplib::createFxOptionQuoteMatrix("X", "X", 2024.01.01, ["X", string()], ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：向量参数 terms 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects empty vector terms", exception=1
caplib::createFxOptionQuoteMatrix("X", "X", 2024.01.01, take(string, 0), ["X"], matrix([0.2]), "TF_createFxOptionQuoteMatrix_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxOptionQuoteMatrix rejects keyword arguments", syntaxError=1
caplib::createFxOptionQuoteMatrix(leftCcy="X", rightCcy="X", asOfDate=2024.01.01, terms=["X"], quoteNames=["X"], quotes=matrix([0.2]), handle="TF_createFxOptionQuoteMatrix_H", returnJson=false)
// 用例目的：向量参数 terms 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects all-null vector terms", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, [string(), string(), string()], ["ATM", "ATM"], matrix([0.06, 0.061], [0.062, 0.063]), "TF_FX_OQ", true)

// 用例目的：矩阵参数 quotes 传入0 行矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects zero-row matrix quotes", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix(DOUBLE, 0, 3), "TF_FX_OQ", true)

// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createFxOptionQuoteMatrix accepts all-null matrix quotes", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix([double(), double()], [double(), double()]), "TF_FX_OQ", true)

// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createFxOptionQuoteMatrix accepts partially-null matrix quotes", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix([0.2, double()], [double(), 0.2]), "TF_FX_OQ", true)
// 用例目的：terms 数量与报价矩阵行数不一致，验证参数间关系校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects terms size mismatch with quote matrix rows", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M"], ["ATM", "ATM"], matrix([0.06, 0.061], [0.062, 0.063]), "TF_FX_OQ", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxOptionQuoteMatrix optional returnJson null uses default"
result = caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix([0.06, 0.061], [0.062, 0.063]), "TF_FX_OQ", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：矩阵参数 quotes 传入0 列矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createFxOptionQuoteMatrix rejects zero-col matrix quotes", exception=1
caplib::createFxOptionQuoteMatrix("EUR", "USD", asOfDate, ["1M", "3M"], ["ATM", "ATM"], matrix(DOUBLE, 3, 0), "TF_FX_OQ", true)

