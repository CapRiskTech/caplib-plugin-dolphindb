// ============================================================================
// test_priceFxNonDeliverableForward.dos
// Per-function test suite for caplib::priceFxNonDeliverableForward (fx).
// Signature: caplib::priceFxNonDeliverableForward(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_priceFxNonDeliverableForward.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.03.30;
currency = "USD";
usdcnhSpot = 6.7;

usdDates = [2021.04.06, 2021.04.13, 2021.04.20, 2021.04.30,
            2021.06.01, 2021.06.30, 2021.07.30, 2021.08.30,
            2021.09.30, 2021.12.30, 2022.03.30, 2022.09.30,
            2023.03.30, 2024.04.01, 2025.03.31, 2026.03.30,
            2027.03.30, 2028.03.30, 2031.03.31];
usdRates = [0.00016, 0.00016, 0.00016, 0.00017,
            0.00016, 0.00019, 0.00023, 0.00026,
            0.00028, 0.00034, 0.00042, 0.00063,
            0.00108, 0.00292, 0.00546, 0.00798,
            0.01025, 0.01217, 0.01624];
usdCurve = caplib::createIrYieldCurve(
    asOfDate, usdDates, usdRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_DEPO", "USD_DEPO", false);

cnhDates = [2021.04.01, 2021.04.07, 2021.04.14, 2021.04.30,
            2021.06.30, 2021.09.30, 2021.12.31, 2022.03.31,
            2023.03.31, 2024.04.01, 2025.03.31, 2026.03.31,
            2028.03.31, 2031.03.31];
cnhRates = [0.01825, 0.02184, 0.02375, 0.02515,
            0.02622, 0.02770, 0.02851, 0.02958,
            0.03150, 0.03289, 0.03400, 0.03497,
            0.03659, 0.03814];
cnhCurve = caplib::createIrYieldCurve(
    asOfDate, cnhDates, cnhRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "CNH", "CNH_USDCNH_FX", "CNH_USDCNH_FX", false);

usdcnhSpotRate = caplib::createFxSpotRate(
    usdcnhSpot, "USD", "CNH", asOfDate, 2021.04.01, "USDCNH_SPOT_RATE", true);

cashAnalyticalSettings = caplib::createPricingSettings(currency, "ANALYTICAL", 0, 0, take(0, 0), "", "", "", "FX_CASH_ANALYTICAL", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 0, 1.0e-4, 5.0e-1, 0, 0, 1.0e-4, 0, "FX_IR_CURVE_RISK", false);
priceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0e-2, 0, "FX_PRICE_RISK", false);
volRisk = caplib::createVolRiskSettings(
    1, 1, 1.0e-2, 0, 0, 1.0e-2, 0, "FX_VOL_RISK", false);
priceVolRisk = caplib::createPriceVolRiskSettings(
    1, 1.0e-2, 1.0e-2, 0, 0, 1.0e-2, 1.0e-2, 0, "FX_PRICE_VOL_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FX_THETA_RISK", false);
fxRisk = caplib::createFxRiskSettings(
    irCurveRisk, priceRisk, volRisk, priceVolRisk, thetaRisk, "", "FX_RISK", true);

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

flatFxVolSurface = caplib::createFlatFxVolatilitySurface(
    asOfDate, "USDCNH", 0.0, "USDCNH_FLAT_FX_VOL_SURF", true);

usdcnhMktData = caplib::createFxMktDataSet(
    asOfDate, cnhCurve, usdCurve, usdcnhSpotRate[0], flatFxVolSurface[0], "", "USDCNH_MKT", true);

tndf = caplib::createFxNonDeliverableForward("USD", 10000.0, "CNH", 66916.0, "USD", 2021.07.01, 2021.06.30, "TF_PNDF", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回 PricingResults（含 present_value/cash_value/currency）
@testing:case="priceFxNonDeliverableForward -> PricingResults"
result = caplib::priceFxNonDeliverableForward(tndf, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true)
assert 1, isPricingResultsJson(result, "TF_PNDF_results")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="priceFxNonDeliverableForward rejects missing argument", syntaxError=1
caplib::priceFxNonDeliverableForward("X", 2024.01.01, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="priceFxNonDeliverableForward rejects extra argument", syntaxError=1
caplib::priceFxNonDeliverableForward("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

// 用例目的：参数 pricingDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects wrong type for pricingDate", exception=1
caplib::priceFxNonDeliverableForward("X", "bad", "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects wrong type for mode", exception=1
caplib::priceFxNonDeliverableForward("X", 2024.01.01, "X", "X", "X", "X", 1, false)

// 用例目的：参数 pricingDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects null pricingDate", exception=1
caplib::priceFxNonDeliverableForward("X", date(), "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects null mode", exception=1
caplib::priceFxNonDeliverableForward("X", 2024.01.01, "X", "X", "X", "X", string(), false)

// 用例目的：标量参数 pricingDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects vector for scalar pricingDate", exception=1
caplib::priceFxNonDeliverableForward("X", [2024.01.01], "X", "X", "X", "X", "X", false)

// 用例目的：句柄参数 instrumentHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects nonexistent handle instrumentHandle", exception=1
caplib::priceFxNonDeliverableForward("TF_NO_SUCH_HANDLE_priceFxNonDeliverableForward", 2024.01.01, "X", "X", "X", "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="priceFxNonDeliverableForward rejects keyword arguments", syntaxError=1
caplib::priceFxNonDeliverableForward(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="priceFxNonDeliverableForward optional returnJson null uses default"
result = caplib::priceFxNonDeliverableForward(tndf, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 mktDataHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="priceFxNonDeliverableForward rejects wrong object type for mktDataHandle", exception=1
caplib::priceFxNonDeliverableForward(tndf, asOfDate, tndf, cashAnalyticalSettings, fxRisk[0], "", "", true)
// 用例目的：同一合约名义金额放大 2 倍，验证现值精确翻倍（现值对名义的线性性质）
@testing:case="priceFxNonDeliverableForward notional scaling -> 2x notional, 2x present value"
tndf_2X = caplib::createFxNonDeliverableForward("USD", (10000.0) * 2, "CNH", (66916.0) * 2, "USD", 2021.07.01, 2021.06.30, "TF_PNDF_2X", false);
p1 = caplib::priceFxNonDeliverableForward(tndf, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true);
p2 = caplib::priceFxNonDeliverableForward(tndf_2X, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true);
assert 1, abs(presentValue(p2) - 2.0 * presentValue(p1)) <= abs(presentValue(p1)) * 1.0e-9 + 1.0e-6

// 用例目的：相同输入连续定价两次，验证两次现值完全一致（定价确定性）
@testing:case="priceFxNonDeliverableForward deterministic repeat -> identical result"
r1 = caplib::priceFxNonDeliverableForward(tndf, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true);
r2 = caplib::priceFxNonDeliverableForward(tndf, asOfDate, usdcnhMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true);
assert 1, abs(presentValue(r1) - presentValue(r2)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)
