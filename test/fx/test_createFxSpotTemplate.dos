// ============================================================================
// test_createFxSpotTemplate.dos
// Per-function test suite for caplib::createFxSpotTemplate (fx).
// Signature: caplib::createFxSpotTemplate(instName STRING, currencyPair STRING, spotDayConvention STRING, calendars STRING or STRING[], spotDelay STRING or INT[, handle STRING][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxSpotTemplate.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

calEuta = "CAL_EUTA";
calGblo = "CAL_GBLO";

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxSpotTemplate -> handle"
result = caplib::createFxSpotTemplate("TF_SPOTTPL", "EURUSD", "FOLLOWING", ["CAL_EUTA","CAL_GBLO"], "2d", false)
assert 1, result == "TF_SPOTTPL"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxSpotTemplate rejects missing argument", syntaxError=1
caplib::createFxSpotTemplate("X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxSpotTemplate rejects extra argument", syntaxError=1
caplib::createFxSpotTemplate("X", "X", "X", "X", "X", "TF_createFxSpotTemplate_H", false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects wrong type for instName", exception=1
caplib::createFxSpotTemplate(1, "X", "X", "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：参数 currencyPair 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects wrong type for currencyPair", exception=1
caplib::createFxSpotTemplate("X", 1, "X", "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：参数 spotDayConvention 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects wrong type for spotDayConvention", exception=1
caplib::createFxSpotTemplate("X", "X", 1, "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects null instName", exception=1
caplib::createFxSpotTemplate(string(), "X", "X", "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：参数 currencyPair 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects null currencyPair", exception=1
caplib::createFxSpotTemplate("X", string(), "X", "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects vector for scalar instName", exception=1
caplib::createFxSpotTemplate(["X"], "X", "X", "X", "X", "TF_createFxSpotTemplate_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxSpotTemplate rejects keyword arguments", syntaxError=1
caplib::createFxSpotTemplate(instName="X", currencyPair="X", spotDayConvention="X", calendars="X", spotDelay="X", handle="TF_createFxSpotTemplate_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxSpotTemplate optional returnJson null uses default"
result = caplib::createFxSpotTemplate("TF_SPOTTPL", "EURUSD", "FOLLOWING", ["CAL_EUTA","CAL_GBLO"], "2d", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 spotDayConvention 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createFxSpotTemplate supports all spotDayConvention enums"
labelEnum = ["FOLLOWING", "MODIFIED_FOLLOWING", "PRECEDING", "MODIFIED_PRECEDING", "UNADJUSTED"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxSpotTemplate("TF_SPOTTPL", "EURUSD", labelEnum[i], ["CAL_EUTA","CAL_GBLO"], "2d", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
// 用例目的：枚举参数 spotDayConvention 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects invalid enum for spotDayConvention", exception=1
caplib::createFxSpotTemplate("TF_SPOTTPL", "EURUSD", "NOT_A_VALID_ENUM_LABEL", ["CAL_EUTA","CAL_GBLO"], "2d", false)

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createFxSpotTemplate rejects all-null vector calendars", exception=1
caplib::createFxSpotTemplate("EURUSD_SPOT_TPL", "EURUSD", "FOLLOWING", [string(), string(), string()], "2d", true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects empty vector calendars", exception=1
caplib::createFxSpotTemplate("EURUSD_SPOT_TPL", "EURUSD", "FOLLOWING", take(string, 0), "2d", true)

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createFxSpotTemplate rejects partially-null vector calendars", exception=1
caplib::createFxSpotTemplate("EURUSD_SPOT_TPL", "EURUSD", "FOLLOWING", [calEuta, string(), calGblo], "2d", true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects zero spotDelay", exception=1
caplib::createFxSpotTemplate("EURUSD_SPOT_TPL", "EURUSD", "FOLLOWING", [calEuta, calGblo], 0.0, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFxSpotTemplate rejects negative spotDelay", exception=1
caplib::createFxSpotTemplate("EURUSD_SPOT_TPL", "EURUSD", "FOLLOWING", [calEuta, calGblo], -1.0, true)
