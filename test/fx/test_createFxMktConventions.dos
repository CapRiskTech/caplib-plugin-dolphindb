// ============================================================================
// test_createFxMktConventions.dos
// Per-function test suite for caplib::createFxMktConventions (fx).
// Signature: caplib::createFxMktConventions(ccyPair STRING, atmType STRING, shortDeltaType STRING, longDeltaType STRING, deltaCutoff STRING, riskReversal STRING, smileQuoteType STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxMktConventions.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxMktConventions -> handle"
result = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)
assert 1, result == "TF_FXMC"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktConventions rejects missing argument", syntaxError=1
caplib::createFxMktConventions("X", "X", "X", "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktConventions rejects extra argument", syntaxError=1
caplib::createFxMktConventions("X", "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false, 1)

// 用例目的：参数 ccyPair 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for ccyPair", exception=1
caplib::createFxMktConventions(1, "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 atmType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for atmType", exception=1
caplib::createFxMktConventions("X", 1, "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 shortDeltaType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for shortDeltaType", exception=1
caplib::createFxMktConventions("X", "X", 1, "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 ccyPair 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktConventions rejects null ccyPair", exception=1
caplib::createFxMktConventions(string(), "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 atmType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktConventions rejects null atmType", exception=1
caplib::createFxMktConventions("X", string(), "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：标量参数 ccyPair 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxMktConventions rejects vector for scalar ccyPair", exception=1
caplib::createFxMktConventions(["X"], "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxMktConventions rejects keyword arguments", syntaxError=1
caplib::createFxMktConventions(ccyPair="X", atmType="X", shortDeltaType="X", longDeltaType="X", deltaCutoff="X", riskReversal="X", smileQuoteType="X", tag="TF_createFxMktConventions_H", returnJson=false)
// 用例目的：枚举参数 atmType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createFxMktConventions rejects invalid enum for atmType", exception=1
caplib::createFxMktConventions("EURUSD", "NOT_A_VALID_ENUM_LABEL", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxMktConventions optional returnJson null uses default"
result = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 atmType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all atmType enums"
labelEnum = ["ATM_FORWARD", "ATM_DNS_PIPS", "ATM_DNS_PERCENTAGE", "ATM_SPOT"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", labelEnum[i], "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
