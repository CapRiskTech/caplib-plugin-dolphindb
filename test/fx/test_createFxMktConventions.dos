// ============================================================================
// test_createFxMktConventions.dos
// Per-function test suite for caplib::createFxMktConventions (fx).
// Signature: caplib::createFxMktConventions(ccyPair STRING, atmType STRING, shortDeltaType STRING, longDeltaType STRING, deltaCutoff STRING, riskReversal STRING, smileQuoteType STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fx")            // whole domain directory
//     python run_tests.py --file fx/test_createFxMktConventions.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// All documented vector/matrix combinations, using one term so that each
// vector or one-row matrix describes the same three-strike smile.

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFxMktConventions -> handle"
result = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)
assert 1, result == "TF_FXMC"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktConventions rejects missing argument", syntaxError=1
caplib::createFxMktConventions("X", "X", "X", "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFxMktConventions rejects extra argument", syntaxError=1
caplib::createFxMktConventions("X", "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false, 1)

// 用例目的：参数 ccyPair 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for ccyPair", exception=1
caplib::createFxMktConventions(1, "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 atmType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for atmType", exception=1
caplib::createFxMktConventions("X", 1, "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 shortDeltaType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFxMktConventions rejects wrong type for shortDeltaType", exception=1
caplib::createFxMktConventions("X", "X", 1, "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 ccyPair 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktConventions rejects null ccyPair", exception=1
caplib::createFxMktConventions(string(), "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：参数 atmType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFxMktConventions rejects null atmType", exception=1
caplib::createFxMktConventions("X", string(), "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：标量参数 ccyPair 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFxMktConventions rejects vector for scalar ccyPair", exception=1
caplib::createFxMktConventions(["X"], "X", "X", "X", "X", "X", "X", "TF_createFxMktConventions_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFxMktConventions rejects keyword arguments", syntaxError=1
caplib::createFxMktConventions(ccyPair="X", atmType="X", shortDeltaType="X", longDeltaType="X", deltaCutoff="X", riskReversal="X", smileQuoteType="X", tag="TF_createFxMktConventions_H", returnJson=false)
// 用例目的：枚举参数 atmType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createFxMktConventions rejects invalid enum for atmType", exception=1
caplib::createFxMktConventions("EURUSD", "NOT_A_VALID_ENUM_LABEL", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFxMktConventions optional returnJson null uses default"
result = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 atmType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all atmType enums"
labelEnum = ["ATM_FORWARD", "ATM_DNS_PIPS", "ATM_DNS_PERCENTAGE", "ATM_SPOT"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", labelEnum[i], "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// ----------------------------------------------------------------------------
// Review round-2: returnJson 非 BOOL + 其余枚举参数非法值/合法值遍历（gap-fill）
// ----------------------------------------------------------------------------

// 用例目的：可选参数 returnJson 传入非 BOOL 类型（STRING），实测插件宽松接受、记录实际行为
@testing:case="accepts createFxMktConventions non-BOOL returnJson (no validation)"
rMC_RJ = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", "yes")
assert 1, typestr(rMC_RJ) != "VOID"

// 用例目的：参数 shortDeltaType 传入非法枚举取值，验证枚举校验（实测插件校验并抛 Unknown shortDeltaType）
@testing:case="createFxMktConventions rejects invalid enum for shortDeltaType", exception=1
caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "NOT_A_VALID_DELTA", "PIPS_FORWARD_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)

// 用例目的：遍历参数 shortDeltaType 的全部文档合法枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all shortDeltaType enums"
labelEnum = ["PIPS_SPOT_DELTA", "PERCENTAGE_SPOT_DELTA", "PIPS_FORWARD_DELTA", "PERCENTAGE_FORWARD_DELTA", "SIMPLE_DELTA"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", labelEnum[i], "PIPS_FORWARD_DELTA", "SIMPLE_DELTA", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 longDeltaType 传入非法枚举取值，验证枚举校验（实测插件校验并抛 Unknown longDeltaType）
@testing:case="createFxMktConventions rejects invalid enum for longDeltaType", exception=1
caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "NOT_A_VALID_DELTA", "1Y", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)

// 用例目的：遍历参数 longDeltaType 的全部文档合法枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all longDeltaType enums"
labelEnum = ["PIPS_SPOT_DELTA", "PERCENTAGE_SPOT_DELTA", "PIPS_FORWARD_DELTA", "PERCENTAGE_FORWARD_DELTA", "SIMPLE_DELTA"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", labelEnum[i], "SIMPLE_DELTA", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：枚举参数 deltaCutoff 传入非法取值，验证枚举校验（前置参数合法）
// 用例目的：deltaCutoff 传非法枚举标签 —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createFxMktConventions invalid enum for deltaCutoff (no validation)"
rMC_DC = caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "NOT_A_VALID_ENUM", "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false)
assert 1, typestr(rMC_DC) != "VOID"

// 用例目的：遍历参数 deltaCutoff 的全部文档合法枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all deltaCutoff enums"
labelEnum = ["PIPS_SPOT_DELTA", "PERCENTAGE_SPOT_DELTA", "PIPS_FORWARD_DELTA", "PERCENTAGE_FORWARD_DELTA", "SIMPLE_DELTA"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", labelEnum[i], "RR_CALL_PUT", "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 riskReversal 传入非法枚举取值，验证枚举校验（实测插件校验并抛 Unknown riskReversal）
@testing:case="createFxMktConventions rejects invalid enum for riskReversal", exception=1
caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "SIMPLE_DELTA", "NOT_A_VALID_RR", "BUTTERFLY_QUOTE", "TF_FXMC", false)

// 用例目的：遍历参数 riskReversal 的全部文档合法枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all riskReversal enums"
labelEnum = ["RR_CALL_PUT", "RR_PUT_CALL"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "SIMPLE_DELTA", labelEnum[i], "BUTTERFLY_QUOTE", "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 smileQuoteType 传入非法枚举取值，验证枚举校验（实测插件校验并抛 Unknown smileQuoteType）
@testing:case="createFxMktConventions rejects invalid enum for smileQuoteType", exception=1
caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "SIMPLE_DELTA", "RR_CALL_PUT", "NOT_A_VALID_SMILE", "TF_FXMC", false)

// 用例目的：遍历参数 smileQuoteType 的全部文档合法枚举取值，逐一调用验证均被接受
@testing:case="createFxMktConventions supports all smileQuoteType enums"
labelEnum = ["BUTTERFLY_QUOTE", "MARKET_STRANGLE_QUOTE", "WINGS_RATIO_BF_QUOTE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFxMktConventions("EURUSD", "ATM_DNS_PIPS", "PIPS_SPOT_DELTA", "PIPS_FORWARD_DELTA", "SIMPLE_DELTA", "RR_CALL_PUT", labelEnum[i], "TF_FXMC", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
