// ============================================================================
// test_createCmOptionQuoteMatrix.dos
// Per-function test suite for caplib::createCmOptionQuoteMatrix (cm).
// Signature: caplib::createCmOptionQuoteMatrix(exerciseType STRING, underlyingType STRING, asOfDate DATE, termDates DATE[], payoffTypes STRING matrix/vector, strikes DOUBLE matrix/vector, prices DOUBLE matrix/vector, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cm")            // whole domain directory
//     python run_tests.py --file cm/test_createCmOptionQuoteMatrix.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

currency = "CNY";
underlying = "CU.SHFE";
asOfDate = 2020.02.21;
underlyingPrice = 66380.00;

irDates = [2020.02.26, 2020.03.02, 2020.03.09, 2020.03.24, 2020.05.24,
           2020.08.24, 2020.11.24, 2021.02.24, 2022.02.24, 2023.02.24,
           2024.02.24, 2025.02.24, 2027.02.24, 2030.02.24];
irRates = [0.0135486283791684, 0.0197762034605164, 0.0197686053073393,
           0.0224838821372655, 0.0241740300538751, 0.0256822601972516,
           0.0265096948143765, 0.0271330931714993, 0.0274314991366822,
           0.0284834397783798, 0.0297276346662025, 0.0308410887945891,
           0.032692683803743, 0.034410206396147];
irCurve = caplib::createIrYieldCurve(
    asOfDate, irDates, irRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", currency, "CNY_SHIBOR_3M", "CM_IR_CURVE", false);

fwdDates = [2020.02.22, 2030.02.24];
fwdValues = [0.0, 0.0];
fwdCurve = caplib::createDividendCurve(
    asOfDate, fwdDates, fwdValues, asOfDate,
    "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "CM_FLAT_FWD", "CM_FWD_CURVE", false);

termDates = [2020.03.12, 2020.04.13, 2020.05.12, 2020.06.12,
             2020.07.10, 2020.08.12, 2020.09.11];

// The Python helper iterates over prices and ignores any extra payoff/strike
// entries. Keep row lengths equal here because the native plugin validates
// quote, strike, and payoff matrix shapes.
payoffTypes = [
    take("PUT", 13) join take("CALL", 14),
    take("PUT", 13) join take("CALL", 14),
    take("PUT", 13) join take("CALL", 14),
    take("PUT", 11) join take("CALL", 15),
    take("PUT", 10) join take("CALL", 11),
    take("PUT", 11) join take("CALL", 14),
    take("PUT", 10) join take("CALL", 10)
];
strikes = [
    [54000, 55000, 56000, 57000, 58000, 59000, 60000, 61000, 62000,
     63000, 64000, 65000, 66000, 67000, 68000, 69000, 70000, 71000,
     72000, 73000, 74000, 75000, 76000, 77000, 78000, 79000, 80000],
    [54000, 55000, 56000, 57000, 58000, 59000, 60000, 61000, 62000,
     63000, 64000, 65000, 66000, 67000, 68000, 69000, 70000, 71000,
     72000, 73000, 74000, 75000, 76000, 77000, 78000, 79000, 80000],
    [54000, 55000, 56000, 57000, 58000, 59000, 60000, 61000, 62000,
     63000, 64000, 65000, 66000, 67000, 68000, 69000, 70000, 71000,
     72000, 73000, 74000, 75000, 76000, 77000, 78000, 79000, 80000],
    [56000, 57000, 58000, 59000, 60000, 61000, 62000, 63000, 64000,
     65000, 66000, 67000, 68000, 69000, 70000, 71000, 72000, 73000,
     74000, 75000, 76000, 77000, 78000, 79000, 80000, 82000],
    [57000, 58000, 59000, 60000, 61000, 62000, 63000, 64000, 65000,
     66000, 67000, 68000, 69000, 70000, 71000, 72000, 73000, 74000,
     75000, 76000, 77000],
    [56000, 57000, 58000, 59000, 60000, 61000, 62000, 63000, 64000,
     65000, 66000, 67000, 68000, 69000, 70000, 71000, 72000, 73000,
     74000, 75000, 76000, 77000, 78000, 79000, 80000],
    [57000, 58000, 59000, 60000, 61000, 62000, 63000, 64000, 65000,
     66000, 67000, 68000, 69000, 70000, 71000, 72000, 73000, 74000,
     75000, 76000]
];
prices = [
    [14.00, 16.00, 20.00, 26.00, 38.00, 64.00, 86.00, 130.00, 198.00,
     282.00, 400.00, 600.00, 878.00, 1070.00, 660.00, 394.00, 236.00,
     142.00, 90.00, 52.00, 32.00, 22.00, 18.00, 14.00, 10.00, 6.00, 6.00],
    [126.00, 126.00, 160.00, 200.00, 250.00, 312.00, 396.00, 478.00,
     600.00, 776.00, 974.00, 1230.00, 1602.00, 1736.00, 1276.00, 910.00,
     642.00, 460.00, 312.00, 212.00, 150.00, 110.00, 80.00, 58.00,
     40.00, 28.00, 38.00],
    [172.00, 192.00, 236.00, 292.00, 426.00, 478.00, 574.00, 702.00,
     892.00, 1206.00, 1368.00, 1632.00, 2140.00, 2218.00, 1762.00,
     1350.00, 1026.00, 762.00, 562.00, 404.00, 294.00, 210.00, 128.00,
     102.00, 58.00, 56.00, 106.00],
    [414.00, 486.00, 584.00, 700.00, 958.00, 1186.00, 1308.00, 1634.00,
     2008.00, 2436.00, 2914.00, 2814.00, 2396.00, 2026.00, 1698.00,
     1412.00, 758.00, 964.00, 446.00, 346.00, 256.00, 188.00, 138.00,
     102.00, 82.00, 44.00],
    [676.00, 798.00, 936.00, 1064.00, 1354.00, 1780.00, 2138.00,
     2538.00, 2978.00, 3474.00, 3324.00, 2902.00, 2516.00, 1544.00,
     1256.00, 984.00, 806.00, 622.00, 488.00, 382.00, 282.00],
    [678.00, 802.00, 906.00, 1058.00, 1246.00, 1456.00, 2066.00,
     2446.00, 2862.00, 3314.00, 3814.00, 3590.00, 3168.00, 2784.00,
     2446.00, 2136.00, 1852.00, 1612.00, 1390.00, 630.00, 1026.00,
     448.00, 338.00, 278.00, 196.00],
    [1006.00, 1146.00, 1312.00, 1558.00, 1790.00, 2118.00, 2688.00,
     3118.00, 3578.00, 4078.00, 3828.00, 3408.00, 3024.00, 2680.00,
     2358.00, 2078.00, 1822.00, 1586.00, 1388.00, 666.00]
];
underlyingPrices = [66810.00, 66750.00, 66620.00, 66620.00, 66490.00, 66460.00, 66380.00];

// Explicit zero-rate quanto curves are supplied even with zero correlation.
quantoDates = [2020.02.22, 2030.02.24];
quantoValues = [0.0, 0.0];
quantoIr = caplib::createIrYieldCurve(
    asOfDate, quantoDates, quantoValues,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_FLAT_ZERO", "QUANTO_IR", false);
quantoFxVol = caplib::createVolatilityCurve(
    asOfDate, quantoDates, quantoValues,
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    underlying, "QUANTO_FX_VOL", false);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "CM_VOL_SURF_DEF", true)
assert 1, isHandleJson(volSurfDefinition, "CM_VOL_SURF_DEF")

volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "CM_VOL_BUILD_SETTINGS", true)
assert 1, isHandleJson(volSurfBuildSettings, "CM_VOL_BUILD_SETTINGS")

cmOptionQuotes = caplib::createCmOptionQuoteMatrix(
    "AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate,
    termDates, payoffTypes, strikes, prices, underlying, "CM_OPTION_QUOTES", true)
assert 1, isHandleJson(cmOptionQuotes, "CM_OPTION_QUOTES") &&
    hasJsonField(cmOptionQuotes[1], "quote_smiles")

volSurface = caplib::buildCmVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], cmOptionQuotes[0],
    underlyingPrices, irCurve, fwdCurve, volSurfBuildSettings[0], "CM_VOL_SURF", true)
assert 1, isHandleJson(volSurface, "CM_VOL_SURF") &&
    hasJsonField(volSurface[1], "vol_smiles")

mktData = caplib::createCmMktDataSet(
    asOfDate, underlying, underlyingPrice,
    irCurve, fwdCurve, volSurface[0],
    quantoIr, quantoFxVol, 0.0, "CM_MKT", true)
assert 1, isHandleJson(mktData, "CM_MKT")

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCmOptionQuoteMatrix -> [handle, json]"
r = caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, payoffTypes, strikes, prices, underlying, "TF_CM_OQ", true);
assert 1, isHandleJson(r, "TF_CM_OQ") && hasJsonField(r[1], "quote_smiles")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCmOptionQuoteMatrix rejects missing argument", syntaxError=1
caplib::createCmOptionQuoteMatrix("X", "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCmOptionQuoteMatrix rejects extra argument", syntaxError=1
caplib::createCmOptionQuoteMatrix("X", "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false, 1)

// 用例目的：参数 exerciseType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects wrong type for exerciseType", exception=1
caplib::createCmOptionQuoteMatrix(1, "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：参数 underlyingType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects wrong type for underlyingType", exception=1
caplib::createCmOptionQuoteMatrix("X", 1, 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects wrong type for asOfDate", exception=1
caplib::createCmOptionQuoteMatrix("X", "X", "bad", [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：参数 exerciseType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects null exerciseType", exception=1
caplib::createCmOptionQuoteMatrix(string(), "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：参数 underlyingType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects null underlyingType", exception=1
caplib::createCmOptionQuoteMatrix("X", string(), 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：标量参数 exerciseType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects vector for scalar exerciseType", exception=1
caplib::createCmOptionQuoteMatrix(["X"], "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：向量参数 termDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects scalar for vector termDates", exception=1
caplib::createCmOptionQuoteMatrix("X", "X", 2024.01.01, [2024.01.01], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：向量参数 termDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects partially-null vector termDates", exception=1
caplib::createCmOptionQuoteMatrix("X", "X", 2024.01.01, [2024.01.01, date()], matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：向量参数 termDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects empty vector termDates", exception=1
caplib::createCmOptionQuoteMatrix("X", "X", 2024.01.01, take(date, 0), matrix([0.2]), matrix([0.2]), matrix([0.2]), "X", "TF_createCmOptionQuoteMatrix_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCmOptionQuoteMatrix rejects keyword arguments", syntaxError=1
caplib::createCmOptionQuoteMatrix(exerciseType="X", underlyingType="X", asOfDate=2024.01.01, termDates=[2024.01.01], payoffTypes=matrix([0.2]), strikes=matrix([0.2]), prices=matrix([0.2]), underlying="X", handle="TF_createCmOptionQuoteMatrix_H", returnJson=false)
// 用例目的：向量参数 termDates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects all-null vector termDates", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, [date(), date(), date()], payoffTypes, strikes, prices, underlying, "TF_CM_OQ", true)

// 用例目的：矩阵参数 payoffTypes 传入0 行矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects zero-row matrix payoffTypes", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, matrix(STRING, 0, 3), strikes, prices, underlying, "TF_CM_OQ", true)

// 用例目的：矩阵参数 payoffTypes 传入全部空值矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects all-null matrix payoffTypes", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, matrix([string(), string()], [string(), string()]), strikes, prices, underlying, "TF_CM_OQ", true)

// 用例目的：矩阵参数 payoffTypes 传入部分空值矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects partially-null matrix payoffTypes", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, matrix(["A", string()], [string(), "A"]), strikes, prices, underlying, "TF_CM_OQ", true)

// 用例目的：枚举参数 exerciseType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects invalid enum for exerciseType", exception=1
caplib::createCmOptionQuoteMatrix("NOT_A_VALID_ENUM_LABEL", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, payoffTypes, strikes, prices, underlying, "TF_CM_OQ", true)
// 用例目的：terms 数量与报价矩阵行数不一致，验证参数间关系校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects terms size mismatch with quote matrix rows", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, [2020.03.12, 2020.04.13, 2020.05.12, 2020.06.12, 2020.07.10, 2020.08.12], payoffTypes, strikes, prices, underlying, "TF_CM_OQ", true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCmOptionQuoteMatrix optional returnJson null uses default"
result = caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, payoffTypes, strikes, prices, underlying, "TF_CM_OQ", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 exerciseType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createCmOptionQuoteMatrix supports all exerciseType enums"
labelEnum = ["EUROPEAN", "AMERICAN", "BERMUDAN"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createCmOptionQuoteMatrix(labelEnum[i], "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, payoffTypes, strikes, prices, underlying, "TF_CM_OQ", true); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：矩阵参数 payoffTypes 传入0 列矩阵，验证矩阵校验（预期：抛异常）
@testing:case="createCmOptionQuoteMatrix rejects zero-col matrix payoffTypes", exception=1
caplib::createCmOptionQuoteMatrix("AMERICAN", "FUTURE_UNDERLYING_TYPE", asOfDate, termDates, matrix(STRING, 3, 0), strikes, prices, underlying, "TF_CM_OQ", true)

