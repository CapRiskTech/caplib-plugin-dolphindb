// ----------------------------------------------------------------------------
// Review round-3 gap-fill: asOfDate 与曲线日期关系 + 枚举逐值预期异常
// ----------------------------------------------------------------------------

// 用例目的：asOfDate（2019.09.05）与 parCurveHandle / discountCurveHandle 所引用曲线的
// 参考日期（2019.09.04）不一致 —— 实测服务层不校验该日期关系、正常完成构建
//（宽松行为，记录实际行为，不抛异常）
@testing:case="buildPmYieldCurve accepts asOfDate inconsistent with curve as-of dates (no service-level validation)"
rMismatch = caplib::buildPmYieldCurve(2019.09.05, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_MISMATCH", false)
assert 1, typestr(rMismatch) != "VOID" && rMismatch == "TF_XAU_YIELD_MISMATCH"

// 用例目的：asOfDate（2022.01.01）晚于 parCurveHandle 所引用 par 曲线的最晚期限（2Y，约 2021.09）
// —— 实测服务层不校验该日期关系、正常完成构建（宽松行为，记录实际行为，不抛异常）
@testing:case="buildPmYieldCurve accepts asOfDate after par curve term dates (no service-level validation)"
rLate = caplib::buildPmYieldCurve(2022.01.01, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_LATE", false)
assert 1, typestr(rLate) != "VOID" && rLate == "TF_XAU_YIELD_LATE"

// 用例目的：asOfDate（2050.01.01）晚于 discountCurveHandle 所引用贴现曲线的
// 最晚期限日期（2049.09.06）—— 实测服务层不校验该日期关系、正常完成构建
//（宽松行为，记录实际行为，不抛异常）
@testing:case="buildPmYieldCurve accepts asOfDate after discount curve term dates (no service-level validation)"
rLateDiscount = caplib::buildPmYieldCurve(2050.01.01, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_LATE_DISCOUNT", false)
assert 1, typestr(rLateDiscount) != "VOID" && rLateDiscount == "TF_XAU_YIELD_LATE_DISCOUNT"

