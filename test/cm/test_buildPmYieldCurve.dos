// ============================================================================
// test_buildPmYieldCurve.dos
// Per-function test suite for caplib::buildPmYieldCurve (cm).
// Signature: buildPmYieldCurve(referenceDate, parCurveHandle, discountCurveHandle,
//     pmTemplateHandle, spotPrice, calcJacobian, dayCount, interpMethod,
//     extrapMethod, curveType, curveName, shift, method, mode, handle)
// Reference recipe: python caplib test_pmanalytics.py (XAU yield curve).
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: PM chain (calendar -> cash template -> USD depo curve -> 4-col par curve)
// ============================================================================

// Calendar
calendarCreated = caplib::createCalendar("CAL_GBLO", [44623]);
assert 1, calendarCreated;

// PM cash template (XAUUSD, start delay 2, FOLLOWING, ACT_360)
pmCashTemplate = caplib::createPmCashTemplate("XAUUSD", 2, "FOLLOWING", ["CAL_GBLO"], "ACT_360", false);

// USD discount curve (as_of_date 2019-09-04)
usdDepoCurve = caplib::createIrYieldCurve(
    2019.09.04,
    [2019.09.09, 2019.11.06, 2020.06.08, 2021.03.08, 2023.09.06,
     2026.09.07, 2034.09.06, 2049.09.06],
    [0.021594, 0.019103, 0.015248, 0.012617, 0.010018, 0.011028, 0.013473, 0.015525],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_DEPO", "TF_USD_DEPO", false);

// PM par rate curve (4-column pillars table, per 0.0.12)
pmParRateCurve = caplib::createPmParRateCurve(
    2019.09.04, "USD", "XAU_XAUUSD",
    table(
        ["XAUUSD","XAUUSD","XAUUSD","XAUUSD","XAUUSD","XAUUSD","XAUUSD","XAUUSD","XAUUSD"] as instrument_name,
        ["PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP","PM_SWAP"] as instrument_type,
        ["1W","2W","1M","2M","3M","6M","9M","12M","2Y"] as instrument_term,
        [0.025,0.025,0.0248,0.024,0.0235,0.0223,0.0203,0.0192,0.0152] as instrument_rate),
    "TF_PM_PAR", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="buildPmYieldCurve XAU yield curve -> handle"
result = caplib::buildPmYieldCurve(
    2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0,
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE",
    "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE",
    "TF_XAU_YIELD", false)
assert 1, result == "TF_XAU_YIELD"

// ----------------------------------------------------------------------------
// Negative / exception validation
// ----------------------------------------------------------------------------

@testing:case="buildPmYieldCurve rejects missing argument", syntaxError=1
caplib::buildPmYieldCurve(2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE")

@testing:case="buildPmYieldCurve rejects extra argument", syntaxError=1
caplib::buildPmYieldCurve(2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD", false, 1)

@testing:case="buildPmYieldCurve rejects wrong type for referenceDate", exception=1
caplib::buildPmYieldCurve("bad", pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects wrong type for spotPrice", exception=1
caplib::buildPmYieldCurve(2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, "bad", false, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects wrong type for dayCount", exception=1
caplib::buildPmYieldCurve(2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, 99, "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects null referenceDate", exception=1
caplib::buildPmYieldCurve(date(), pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects nonexistent parCurveHandle", exception=1
caplib::buildPmYieldCurve(2019.09.04, "TF_HANDLE_DOES_NOT_EXIST", usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects invalid interp method", exception=1
caplib::buildPmYieldCurve(2019.09.04, pmParRateCurve, usdDepoCurve, pmCashTemplate, 1544.06, 0, "ACT_365_FIXED", "NOT_AN_INTERP", "FLAT_EXTRAP", "ZERO_RATE", "XAU_XAUUSD", 1.0e-4, "CENTRAL_DIFFERENCE_METHOD", "SINGLE_THREADING_MODE", "TF_XAU_YIELD_BAD", false)

@testing:case="buildPmYieldCurve rejects keyword arguments", syntaxError=1
caplib::buildPmYieldCurve(referenceDate=2019.09.04, parCurveHandle=pmParRateCurve, discountCurveHandle=usdDepoCurve, pmTemplateHandle=pmCashTemplate, spotPrice=1544.06, calcJacobian=false, dayCount="ACT_365_FIXED", interpMethod="LINEAR_INTERP", extrapMethod="FLAT_EXTRAP", curveType="ZERO_RATE", curveName="XAU_XAUUSD", shift=1.0e-4, method="CENTRAL_DIFFERENCE_METHOD", mode="SINGLE_THREADING_MODE", handle="TF_XAU_YIELD", returnJson=false)