// 用例目的：枚举参数 shortDeltaType 传入非法值 —— 实测插件未抛异常，非法枚举标签映射为 INVALID 哨兵，记录实际行为
@testing:case="createPmMktConventions accepts invalid enum for shortDeltaType (mapped to INVALID sentinel)"
rMC_SD = caplib::createPmMktConventions("ATM_FORWARD", "NOT_A_REAL_ENUM", "PERCENTAGE_SPOT_DELTA", "SIMPLE_DELTA", "RR_CALL_PUT", "MARKET_STRANGLE_QUOTE", "AU.SHFE", "TF_PM_CONV", true)
assert 1, typestr(rMC_SD) != "VOID"

