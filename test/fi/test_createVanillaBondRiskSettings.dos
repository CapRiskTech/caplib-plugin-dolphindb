// ============================================================================
// test_createVanillaBondRiskSettings.dos
// Per-function test suite for caplib::createVanillaBondRiskSettings (fi).
// Signature: caplib::createVanillaBondRiskSettings(dv01 STRING, cs01 STRING, theta BOOL, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createVanillaBondRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createVanillaBondRiskSettings -> handle"
result = caplib::createVanillaBondRiskSettings("", "", 1, "TF_VBR", "TF_VBR", false)
assert 1, result == "TF_VBR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createVanillaBondRiskSettings rejects missing argument", syntaxError=1
caplib::createVanillaBondRiskSettings("X", "X", false, "TF_createVanillaBondRiskSettings_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createVanillaBondRiskSettings rejects extra argument", syntaxError=1
caplib::createVanillaBondRiskSettings("X", "X", false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false, 1)

// 用例目的：参数 dv01 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects wrong type for dv01", exception=1
caplib::createVanillaBondRiskSettings(1, "X", false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：参数 cs01 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects wrong type for cs01", exception=1
caplib::createVanillaBondRiskSettings("X", 1, false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：参数 name 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects wrong type for name", exception=1
caplib::createVanillaBondRiskSettings("X", "X", false, 1, "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：参数 dv01 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects null dv01", exception=1
caplib::createVanillaBondRiskSettings(string(), "X", false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：参数 cs01 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects null cs01", exception=1
caplib::createVanillaBondRiskSettings("X", string(), false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：标量参数 dv01 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createVanillaBondRiskSettings rejects vector for scalar dv01", exception=1
caplib::createVanillaBondRiskSettings(["X"], "X", false, "TF_createVanillaBondRiskSettings_H", "TF_createVanillaBondRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createVanillaBondRiskSettings rejects keyword arguments", syntaxError=1
caplib::createVanillaBondRiskSettings(dv01="X", cs01="X", theta=false, name="TF_createVanillaBondRiskSettings_H", tag="TF_createVanillaBondRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createVanillaBondRiskSettings optional returnJson null uses default"
result = caplib::createVanillaBondRiskSettings("", "", 1, "TF_VBR", "TF_VBR", bool())
assert 1, typestr(result) != "VOID"
