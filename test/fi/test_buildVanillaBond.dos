// ============================================================================
// test_buildVanillaBond.dos
// Per-function test suite for caplib::buildVanillaBond (fi).
// Signature: caplib::buildVanillaBond(nominal DOUBLE, instTemplate STRING, fixings STRING, startDate DATE, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_buildVanillaBond.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";
calCfets = "CAL_CFETS";

cnyTreasCpnBond200014Template = caplib::createVanillaBondTemplate(
    "cny_treas_cpn_bond_200014", "FIXED_COUPON_BOND",
    2020.10.09, 1, 2020.10.10, "5Y",
    2.15e-2, currency, 100.0,
    "ACT_365_FIXED", calCfets, "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="buildVanillaBond -> handle"
b = caplib::buildVanillaBond(1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "TF_FI_BOND", false);
assert 1, b == "TF_FI_BOND"

// 用例目的：rejects wrong template handle（预期：插件按文档行为执行）
@testing:case="buildVanillaBond rejects wrong template handle", exception=1
caplib::buildVanillaBond(1000000.0, cnyTreasStdCfets[0], "", 2020.10.10, "TF_FI_BOND_BAD", false)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildVanillaBond rejects missing argument", syntaxError=1
caplib::buildVanillaBond(0.02, "X", "X", 2024.01.01)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildVanillaBond rejects extra argument", syntaxError=1
caplib::buildVanillaBond(0.02, "X", "X", 2024.01.01, "TF_buildVanillaBond_H", false, 1)

// 用例目的：参数 nominal 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildVanillaBond rejects wrong type for nominal", exception=1
caplib::buildVanillaBond("bad", "X", "X", 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：参数 instTemplate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildVanillaBond rejects wrong type for instTemplate", exception=1
caplib::buildVanillaBond(0.02, 1, "X", 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：参数 fixings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildVanillaBond rejects wrong type for fixings", exception=1
caplib::buildVanillaBond(0.02, "X", 1, 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：参数 nominal 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildVanillaBond rejects null nominal", exception=1
caplib::buildVanillaBond(double(), "X", "X", 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：参数 instTemplate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildVanillaBond rejects null instTemplate", exception=1
caplib::buildVanillaBond(0.02, string(), "X", 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：标量参数 nominal 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildVanillaBond rejects vector for scalar nominal", exception=1
caplib::buildVanillaBond([0.02], "X", "X", 2024.01.01, "TF_buildVanillaBond_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildVanillaBond rejects keyword arguments", syntaxError=1
caplib::buildVanillaBond(nominal=0.02, instTemplate="X", fixings="X", startDate=2024.01.01, tag="TF_buildVanillaBond_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildVanillaBond optional returnJson null uses default"
result = caplib::buildVanillaBond(1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "TF_FI_BOND", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 nominal 传入0，验证数值边界校验（预期：抛异常）
@testing:case="buildVanillaBond rejects zero nominal", exception=1
caplib::buildVanillaBond(0.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "TF_FI_BOND", false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="buildVanillaBond rejects negative nominal", exception=1
caplib::buildVanillaBond(-1.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "TF_FI_BOND", false)

