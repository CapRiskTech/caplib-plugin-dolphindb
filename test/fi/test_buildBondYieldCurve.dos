// ============================================================================
// test_buildBondYieldCurve.dos
// Per-function test suite for caplib::buildBondYieldCurve (fi).
// Signature: caplib::buildBondYieldCurve(asOfDate DATE, buildSettingsHandle STRING, curveName STRING, parCurveHandle STRING, dayCountConvention STRING, compoundingType STRING, frequency STRING, buildingMethod STRING, calcJacobian INT, forwardCurveHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_buildBondYieldCurve.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def createStdFixedBondTemplate(instName, maturity, currency, calendarName, asOfDate) {
    return caplib::createVanillaBondTemplate(
        instName, "FIXED_COUPON_BOND",
        asOfDate, 1, asOfDate, maturity,
        0.0, currency, 100.0,
        "ACT_365_FIXED", calendarName, "ANNUAL",
        "MODIFIED_FOLLOWING", "INITIAL", "LONG",
        0, "MODIFIED_FOLLOWING", "",
        "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
        "INVALID_DATE_GENERATION_MODE", -1,
        "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
        "CONST_NOTIONAL", 0.0, true);
}

def createStdZeroBondTemplate(instName, maturity, currency, calendarName, asOfDate) {
    return caplib::createVanillaBondTemplate(
        instName, "ZERO_COUPON_BOND",
        asOfDate, 1, asOfDate, maturity,
        0.0, currency, 100.0,
        "ACT_365_FIXED", calendarName, "ANNUAL",
        "MODIFIED_FOLLOWING", "INITIAL", "LONG",
        0, "MODIFIED_FOLLOWING", "",
        "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
        "INVALID_DATE_GENERATION_MODE", -1,
        "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
        "CONST_NOTIONAL", 0.0, true);
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;

currency = "CNY";
calCfets = "CAL_CFETS";

calCfetsCreated = caplib::createCalendar(calCfets);

cnyTreasZero1m = createStdZeroBondTemplate("CNY_TREAS_ZERO_1M", "1M", currency, calCfets, asOfDate);
cnyTreasCpnA3m = createStdFixedBondTemplate("CNY_TREAS_CPN_A_3M", "3M", currency, calCfets, asOfDate);
cnyTreasCpnA6m = createStdFixedBondTemplate("CNY_TREAS_CPN_A_6M", "6M", currency, calCfets, asOfDate);
cnyTreasCpnA9m = createStdFixedBondTemplate("CNY_TREAS_CPN_A_9M", "9M", currency, calCfets, asOfDate);
cnyTreasCpnA1y = createStdFixedBondTemplate("CNY_TREAS_CPN_A_1Y", "1Y", currency, calCfets, asOfDate);
cnyTreasCpnA2y = createStdFixedBondTemplate("CNY_TREAS_CPN_A_2Y", "2Y", currency, calCfets, asOfDate);
cnyTreasCpnA3y = createStdFixedBondTemplate("CNY_TREAS_CPN_A_3Y", "3Y", currency, calCfets, asOfDate);
cnyTreasCpnA5y = createStdFixedBondTemplate("CNY_TREAS_CPN_A_5Y", "5Y", currency, calCfets, asOfDate);
cnyTreasCpnSa7y = createStdFixedBondTemplate("CNY_TREAS_CPN_SA_7Y", "7Y", currency, calCfets, asOfDate);
cnyTreasCpnSa10y = createStdFixedBondTemplate("CNY_TREAS_CPN_SA_10Y", "10Y", currency, calCfets, asOfDate);
cnyTreasCpnSa15y = createStdFixedBondTemplate("CNY_TREAS_CPN_SA_15Y", "15Y", currency, calCfets, asOfDate);
cnyTreasCpnSa20y = createStdFixedBondTemplate("CNY_TREAS_CPN_SA_20Y", "20Y", currency, calCfets, asOfDate);
cnyTreasCpnSa30y = createStdFixedBondTemplate("CNY_TREAS_CPN_SA_30Y", "30Y", currency, calCfets, asOfDate);

cnyTreasStdCfetsName = "cny_treas_std_cfets";

cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];

cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];

parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);

cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);
// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="buildBondYieldCurve -> [handle, json]"
r = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true);
assert 1, isHandleJson(r, "TF_FI_YC")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildBondYieldCurve rejects missing argument", syntaxError=1
caplib::buildBondYieldCurve(2024.01.01, "X", "X", "X", "X", "X", "X", "X", false, "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildBondYieldCurve rejects extra argument", syntaxError=1
caplib::buildBondYieldCurve(2024.01.01, "X", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for asOfDate", exception=1
caplib::buildBondYieldCurve("bad", cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for curveName", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], 1, parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：参数 dayCountConvention 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for dayCountConvention", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], 1, "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：参数 calcJacobian 传入错误类型（该传整数的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for calcJacobian", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", "bad", "", "TF_buildBondYieldCurve_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects null asOfDate", exception=1
caplib::buildBondYieldCurve(date(), cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：参数 curveName 传入对应类型的空值，验证空值校验（预期：抛异常）
// 用例目的：buildBondYieldCurve rejects null curveName —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts null curveName (no validation)"
rT_lcurveName = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], string(), parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)
assert 1, typestr(rT_lcurveName) != "VOID"

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects vector for scalar asOfDate", exception=1
caplib::buildBondYieldCurve([asOfDate], cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：句柄参数 buildSettingsHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects nonexistent handle buildSettingsHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, "TF_NO_SUCH_HANDLE_buildBondYieldCurve", "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：句柄参数 buildSettingsHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong object type for buildSettingsHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, parCnyTreasStdCfets[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：句柄参数 parCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects nonexistent handle parCurveHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", "TF_NO_SUCH_HANDLE_parCurveHandle", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", false)

// 用例目的：句柄参数 forwardCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects nonexistent handle forwardCurveHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "TF_NO_SUCH_HANDLE_forwardCurveHandle", "TF_buildBondYieldCurve_H", false)

// 用例目的：句柄参数 forwardCurveHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong object type for forwardCurveHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, parCnyTreasStdCfets[0], "TF_buildBondYieldCurve_H", false)

// 用例目的：可选参数 returnJson 传入错误类型（该传布尔值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for returnJson", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_buildBondYieldCurve_H", "bad")

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildBondYieldCurve rejects keyword arguments", syntaxError=1
caplib::buildBondYieldCurve(asOfDate=2024.01.01, buildSettingsHandle="X", curveName="X", parCurveHandle="X", dayCountConvention="X", compoundingType="X", frequency="X", buildingMethod="X", calcJacobian=false, forwardCurveHandle="X", handle="TF_buildBondYieldCurve_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildBondYieldCurve optional returnJson null uses default"
result = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 parCurveHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong object type for parCurveHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", cnyTreasBuildSettings[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true)
// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="buildBondYieldCurve -> frozen curve reference"
zrRef = caplib::getZeroRate(cnyTreasStdCfets[0], [2026.07.22]);
assert 1, abs(zrRef[0] - 0.027171736549228) < 1.0e-12

// 用例目的：相同输入连续构建两次，经 getter 取值对比，验证构建结果确定性
@testing:case="buildBondYieldCurve deterministic repeat -> identical result"
r1 = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true);
r2 = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true);
assert 1, max(abs(caplib::getZeroRate(r1[0], [2021.07.22]) - caplib::getZeroRate(r2[0], [2021.07.22]))) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：正常构建后经 getZeroRate 在固定查询点取值，与冻结参考值对比，验证构建到查询的数值正确性
@testing:case="buildBondYieldCurve -> frozen getZeroRate reference"
r = caplib::getZeroRate(cnyTreasStdCfets[0], [2021.07.22]);
assert 1, abs(r[0] - 0.016967238845753532) < 1.7967238845753534e-11

// ----------------------------------------------------------------------------
// 用例目的：将输入报价整体上浮 50% 后重建，验证 getZeroRate 查询结果随输入变化
@testing:case="buildBondYieldCurve perturbed input -> getZeroRate changes"
r1 = caplib::getZeroRate(cnyTreasStdCfets[0], [(asOfDate + 30)]);
cnyTreasBondQuotes = [
    0.025667999999999996, 0.0274755, 0.0291195, 0.029249999999999998, 0.0323445,
    0.0374775, 0.038307, 0.041325, 0.043762499999999996, 0.0438945,
    0.049476, 0.050193, 0.0525345];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);
r2 = caplib::getZeroRate(cnyTreasStdCfets[0], [(asOfDate + 30)]);
assert 1, max(abs(r1 - r2)) > 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：遍历 dayCountConvention / compoundingType / frequency / buildingMethod 已确认合法的枚举取值子集，逐一调用验证均被接受
// 注：这四个枚举参数在文档语义下均为「非法取值回退默认」而非拒绝；本用例仅覆盖 round-1 确认的子集，其余文档取值 round-3 已逐值单独覆盖（见文件末尾）
@testing:case="buildBondYieldCurve supports accepted enum subset"
enumDay = ["ACT_360", "ACT_365_FIXED", "THIRTY_360", "BOND_BASIS"]
enumComp = ["SIMPLE_COMPOUNDING", "CONTINUOUS_COMPOUNDING", "DISCRETE_COMPOUNDING"]
enumFreq = ["ANNUAL", "QUARTERLY"]
enumBuild = ["BOOTSTRAPPING_METHOD", "HYBRID_METHOD"]
okEnum = true;
for (d in enumDay) {
    for (c in enumComp) {
        for (f in enumFreq) {
            for (b in enumBuild) {
                try { caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC_ENUM", parCnyTreasStdCfets[0], d, c, f, b, 0, "", "TF_FI_YC_ENUM", true); } catch(ex) { okEnum = false; }
            }
        }
    }
}
assert 1, okEnum

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle 类型校验 / 枚举非法值回退 / calcJacobian BOOL
// ----------------------------------------------------------------------------

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="buildBondYieldCurve rejects wrong type for handle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", 123, true)

// 用例目的：枚举参数 dayCountConvention 传入非法取值 —— 文档：任何其他字符串均回退到函数指定的默认日计数，验证回退行为（预期：不抛异常）
@testing:case="buildBondYieldCurve accepts invalid enum for dayCountConvention (falls back to default)"
rBycDc = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "NOT_A_REAL_ENUM", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC_FB_DC", true)
assert 1, typestr(rBycDc) != "VOID"

// 用例目的：枚举参数 compoundingType 传入非法取值 —— 文档：空值或其他字符串回退为 CONTINUOUS_COMPOUNDING，验证回退行为（预期：不抛异常）
@testing:case="buildBondYieldCurve accepts invalid enum for compoundingType (falls back to default)"
rBycCt = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "NOT_A_REAL_ENUM", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC_FB_CT", true)
assert 1, typestr(rBycCt) != "VOID"

// 用例目的：枚举参数 frequency 传入非法取值 —— 文档：任何其他字符串均回退到函数指定的默认频率，验证回退行为（预期：不抛异常）
@testing:case="buildBondYieldCurve accepts invalid enum for frequency (falls back to default)"
rBycFq = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "NOT_A_REAL_ENUM", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC_FB_FQ", true)
assert 1, typestr(rBycFq) != "VOID"

// 用例目的：枚举参数 buildingMethod 传入非法取值 —— 文档：空值或其他字符串回退为 BOOTSTRAPPING_METHOD，验证回退行为（预期：不抛异常）
@testing:case="buildBondYieldCurve accepts invalid enum for buildingMethod (falls back to default)"
rBycBm = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "NOT_A_REAL_ENUM", 0, "", "TF_FI_YC_FB_BM", true)
assert 1, typestr(rBycBm) != "VOID"

