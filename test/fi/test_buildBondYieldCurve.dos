// ============================================================================
// test_buildBondYieldCurve.dos
// Per-function test suite for caplib::buildBondYieldCurve (fi).
// Signature: caplib::buildBondYieldCurve(referenceDate DATE, buildSettingsHandle STRING, curveName STRING, parCurveHandle STRING, dayCount STRING, compoundingType STRING, frequency STRING, buildingMethod STRING, calcJacobian INT, forwardCurveHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_buildBondYieldCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================



asOfDate = 2021.07.22;

currency = "CNY";

cnyTreasStdCfetsName = "cny_treas_std_cfets";

cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];

cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];

parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);

cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);
// ============================================================================
// Tests
// ============================================================================

@testing:case="buildBondYieldCurve -> [handle, json]"
r = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true);
assert 1, isHandleJson(r, "TF_FI_YC")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="buildBondYieldCurve rejects missing argument", syntaxError=1
caplib::buildBondYieldCurve(2024.01.01, "X", "X", "X", "X", "X", "X", "X", false, "X")

@testing:case="buildBondYieldCurve rejects extra argument", syntaxError=1
caplib::buildBondYieldCurve(2024.01.01, "X", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false, 1)

@testing:case="buildBondYieldCurve rejects wrong type for referenceDate", exception=1
caplib::buildBondYieldCurve("bad", "X", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects wrong type for curveName", exception=1
caplib::buildBondYieldCurve(2024.01.01, "X", 1, "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects wrong type for dayCount", exception=1
caplib::buildBondYieldCurve(2024.01.01, "X", "X", "X", 1, "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects null referenceDate", exception=1
caplib::buildBondYieldCurve(date(), "X", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects null curveName", exception=1
caplib::buildBondYieldCurve(2024.01.01, "X", string(), "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects vector for scalar referenceDate", exception=1
caplib::buildBondYieldCurve([2024.01.01], "X", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects nonexistent handle buildSettingsHandle", exception=1
caplib::buildBondYieldCurve(2024.01.01, "TF_NO_SUCH_HANDLE_buildBondYieldCurve", "X", "X", "X", "X", "X", "X", false, "X", "TF_buildBondYieldCurve_H", false)

@testing:case="buildBondYieldCurve rejects keyword arguments", syntaxError=1
caplib::buildBondYieldCurve(referenceDate=2024.01.01, buildSettingsHandle="X", curveName="X", parCurveHandle="X", dayCount="X", compoundingType="X", frequency="X", buildingMethod="X", calcJacobian=false, forwardCurveHandle="X", handle="TF_buildBondYieldCurve_H", returnJson=false)
@testing:case="buildBondYieldCurve optional returnJson null uses default"
result = caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", parCnyTreasStdCfets[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", bool())
assert 1, typestr(result) != "VOID"
@testing:case="buildBondYieldCurve rejects wrong object type for parCurveHandle", exception=1
caplib::buildBondYieldCurve(asOfDate, cnyTreasBuildSettings[0], "TF_FI_YC", cnyTreasBuildSettings[0], "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL", "BOOTSTRAPPING_METHOD", 0, "", "TF_FI_YC", true)
@testing:case="buildBondYieldCurve -> frozen curve reference"
zrRef = caplib::getZeroRate(cnyTreasStdCfets[0], [2026.07.22]);
assert 1, abs(zrRef[0] - 0.027171736549228) < 1.0e-12
