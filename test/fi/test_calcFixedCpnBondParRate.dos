// ============================================================================
// test_calcFixedCpnBondParRate.dos
// Per-function test suite for caplib::calcFixedCpnBondParRate (fi).
// Signature: caplib::calcFixedCpnBondParRate(calculationDate DATE, bondHandle STRING, discountCurveHandle STRING, spreadCurveHandle STRING)
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_calcFixedCpnBondParRate.dos   // single file
// Hand-maintained suite (reference: python caplib test_fianalytics.py,
// fixed_cpn_bond_par_rate_calculator). Edit this file directly.
// ============================================================================

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

def createStdFixedBondTemplate(instName, maturity, currency, calendarName, asOfDate) {
    return caplib::createVanillaBondTemplate(
        instName, "FIXED_COUPON_BOND",
        asOfDate, 1, asOfDate, maturity,
        0.0, currency, 100.0,
        "ACT_365_FIXED", calendarName, "ANNUAL",
        "MODIFIED_FOLLOWING", "INITIAL", "LONG",
        0, "MODIFIED_FOLLOWING", "",
        "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
        "INVALID_DATE_GENERATION_MODE", -1,
        "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
        "CONST_NOTIONAL", 0.0, true);
}

def createStdZeroBondTemplate(instName, maturity, currency, calendarName, asOfDate) {
    return caplib::createVanillaBondTemplate(
        instName, "ZERO_COUPON_BOND",
        asOfDate, 1, asOfDate, maturity,
        0.0, currency, 100.0,
        "ACT_365_FIXED", calendarName, "ANNUAL",
        "MODIFIED_FOLLOWING", "INITIAL", "LONG",
        0, "MODIFIED_FOLLOWING", "",
        "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
        "INVALID_DATE_GENERATION_MODE", -1,
        "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
        "CONST_NOTIONAL", 0.0, true);
}

asOfDate = 2021.07.22;
currency = "CNY";
calCfets = "CAL_CFETS";

holidays = [44654, 44954];
specialBusinessDays = [44655];
calCfetsCreated = caplib::createCalendar(calCfets, holidays, specialBusinessDays);

cnyTreasZero1m = createStdZeroBondTemplate("cny_treas_zero_1m", "1M", currency, calCfets, asOfDate);
cnyTreasCpnA3m = createStdFixedBondTemplate("cny_treas_cpn_a_3m", "3M", currency, calCfets, asOfDate);
cnyTreasCpnA6m = createStdFixedBondTemplate("cny_treas_cpn_a_6m", "6M", currency, calCfets, asOfDate);
cnyTreasCpnA9m = createStdFixedBondTemplate("cny_treas_cpn_a_9m", "9M", currency, calCfets, asOfDate);
cnyTreasCpnA1y = createStdFixedBondTemplate("cny_treas_cpn_a_1y", "1Y", currency, calCfets, asOfDate);
cnyTreasCpnA2y = createStdFixedBondTemplate("cny_treas_cpn_a_2y", "2Y", currency, calCfets, asOfDate);
cnyTreasCpnA3y = createStdFixedBondTemplate("cny_treas_cpn_a_3y", "3Y", currency, calCfets, asOfDate);
cnyTreasCpnA5y = createStdFixedBondTemplate("cny_treas_cpn_a_5y", "5Y", currency, calCfets, asOfDate);
cnyTreasCpnSa7y = createStdFixedBondTemplate("cny_treas_cpn_sa_7y", "7Y", currency, calCfets, asOfDate);
cnyTreasCpnSa10y = createStdFixedBondTemplate("cny_treas_cpn_sa_10y", "10Y", currency, calCfets, asOfDate);
cnyTreasCpnSa15y = createStdFixedBondTemplate("cny_treas_cpn_sa_15y", "15Y", currency, calCfets, asOfDate);
cnyTreasCpnSa20y = createStdFixedBondTemplate("cny_treas_cpn_sa_20y", "20Y", currency, calCfets, asOfDate);
cnyTreasCpnSa30y = createStdFixedBondTemplate("cny_treas_cpn_sa_30y", "30Y", currency, calCfets, asOfDate);

cnyMtnAaaCpnA1m = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_1m", "1M", currency, calCfets, asOfDate);
cnyMtnAaaCpnA3m = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_3m", "3M", currency, calCfets, asOfDate);
cnyMtnAaaCpnA6m = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_6m", "6M", currency, calCfets, asOfDate);
cnyMtnAaaCpnA9m = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_9m", "9M", currency, calCfets, asOfDate);
cnyMtnAaaCpnA1y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_1y", "1Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA2y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_2y", "2Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA3y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_3y", "3Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA4y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_4y", "4Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA5y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_5y", "5Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA7y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_7y", "7Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA8y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_8y", "8Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA9y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_9y", "9Y", currency, calCfets, asOfDate);

cnyTreasCpnBond200014Template = caplib::createVanillaBondTemplate(
    "cny_treas_cpn_bond_200014", "FIXED_COUPON_BOND",
    2020.10.09, 1, 2020.10.10, "5Y",
    2.15e-2, currency, 100.0,
    "ACT_365_FIXED", calCfets, "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyMtnAaaSprdStdCfetsName = "cny_mtn_aaa_sprd_std_cfets";
cnyMtnBondNames = [
    "CNY_MTN_AAA_CPN_A_1M",
    "CNY_MTN_AAA_CPN_A_3M",
    "CNY_MTN_AAA_CPN_A_6M",
    "CNY_MTN_AAA_CPN_A_9M",
    "CNY_MTN_AAA_CPN_A_1Y",
    "CNY_MTN_AAA_CPN_A_2Y",
    "CNY_MTN_AAA_CPN_A_3Y",
    "CNY_MTN_AAA_CPN_A_4Y",
    "CNY_MTN_AAA_CPN_A_5Y",
    "CNY_MTN_AAA_CPN_A_7Y",
    "CNY_MTN_AAA_CPN_A_8Y",
    "CNY_MTN_AAA_CPN_A_9Y"];
cnyMtnBondQuotes = [
    0.022916, 0.024213, 0.025822, 0.026675, 0.027216, 0.028916,
    0.031112, 0.032824, 0.033816, 0.036816, 0.037026, 0.037311];
parCnyMtnAaaSprdStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyMtnBondNames, cnyMtnBondQuotes,
    "YIELD_TO_MATURITY", cnyMtnAaaSprdStdCfetsName, true);
cnyMtnBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyMtnAaaSprdStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_MTN_AAA_SPRD_STD_CFETS_BUILD_SETTINGS", true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);

vanillaBond = caplib::buildVanillaBond(
    1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "FI_VANILLA_BOND", false);

fiMktData = caplib::createFiMktDataSet(
    asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], cnyTreasStdCfets[0], cnyTreasStdCfets[0],
    "FI_MKT_NAME", "FI_MKT", true);
bondMktData = caplib::createBondMktDataSet(
    asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "FI_BOND_MKT_NAME", "FI_BOND_MKT", true);

irRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "FI_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "FI_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FI_THETA_RISK", false);
fiRisk = caplib::createFiRiskSettings(
    irRisk, creditRisk, thetaRisk, "FI_RISK_NAME", "FI_RISK", true);
vanillaBondRisk = caplib::createVanillaBondRiskSettings(
    "", "", 1, "FI_VANILLA_BOND_RISK_NAME", "FI_VANILLA_BOND_RISK", true);

pricingSettings = caplib::createPricingSettings(currency, "ANALYTICAL", 1, 1, take(0, 0), "", "", "", "FI_PRICING", false);

vanillaBondPricingResult = caplib::priceVanillaBond(
    vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);


// ============================================================================
// Tests
// ============================================================================

// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="calcFixedCpnBondParRate -> frozen reference (credit spread curve)"
r = caplib::calcFixedCpnBondParRate(asOfDate, vanillaBond, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0]);
assert 1, abs(r - 0.02916137050665697) < 1.0e-12

// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="calcFixedCpnBondParRate -> frozen reference (empty spread curve)"
// python caplib reference (flat zero credit curve) yields 0.022305497802670465;
// the plugin's internal empty-spread default differs by ~2.4e-6, frozen as observed.
r2 = caplib::calcFixedCpnBondParRate(asOfDate, vanillaBond, cnyTreasStdCfets[0], "");
assert 1, abs(r2 - 0.022307896014995623) < 1.0e-9 && r2 < r

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="calcFixedCpnBondParRate rejects missing argument", syntaxError=1
caplib::calcFixedCpnBondParRate(2024.01.01, "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="calcFixedCpnBondParRate rejects extra argument", syntaxError=1
caplib::calcFixedCpnBondParRate(2024.01.01, "X", "X", "X", 1)

// 用例目的：参数 calculationDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects wrong type for calculationDate", exception=1
caplib::calcFixedCpnBondParRate("bad", "X", "X", "X")

// 用例目的：参数 bondHandle 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects wrong type for bondHandle", exception=1
caplib::calcFixedCpnBondParRate(2024.01.01, 1, "X", "X")

// 用例目的：参数 calculationDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects null calculationDate", exception=1
caplib::calcFixedCpnBondParRate(date(), "X", "X", "X")

// 用例目的：参数 bondHandle 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects null bondHandle", exception=1
caplib::calcFixedCpnBondParRate(2024.01.01, string(), "X", "X")

// 用例目的：标量参数 calculationDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects vector for scalar calculationDate", exception=1
caplib::calcFixedCpnBondParRate([2024.01.01], "X", "X", "X")

// 用例目的：句柄参数 bondHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects nonexistent handle bondHandle", exception=1
caplib::calcFixedCpnBondParRate(2024.01.01, "TF_NO_SUCH_HANDLE_calcFixedCpnBondParRate", "X", "X")

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="calcFixedCpnBondParRate rejects keyword arguments", syntaxError=1
caplib::calcFixedCpnBondParRate(calculationDate=2024.01.01, bondHandle="X", discountCurveHandle="X", spreadCurveHandle="X")
// 用例目的：句柄参数 discountCurveHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="calcFixedCpnBondParRate rejects wrong object type for discountCurveHandle", exception=1
caplib::calcFixedCpnBondParRate(asOfDate, vanillaBond, vanillaBond, cnyMtnAaaSprdStdCfets[0])

// 用例目的：相同输入连续调用两次，验证两次返回结果完全一致（计算确定性）
@testing:case="calcFixedCpnBondParRate deterministic repeat -> identical result"
r1 = caplib::calcFixedCpnBondParRate(asOfDate, vanillaBond, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0]);
r2 = caplib::calcFixedCpnBondParRate(asOfDate, vanillaBond, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0]);
assert 1, max(abs(r1 - r2)) < 1.0e-12
