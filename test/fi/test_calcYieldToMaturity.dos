// ============================================================================
// test_calcYieldToMaturity.dos
// Per-function test suite for caplib::calcYieldToMaturity (fi).
// Signature: caplib::calcYieldToMaturity(calculationDate DATE, compoundingType STRING, bondHandle STRING, forwardCurveHandle STRING, price DOUBLE, priceType STRING, frequency STRING)
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_calcYieldToMaturity.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";
calCfets = "CAL_CFETS";

cnyTreasCpnBond200014Template = caplib::createVanillaBondTemplate(
    "cny_treas_cpn_bond_200014", "FIXED_COUPON_BOND",
    2020.10.09, 1, 2020.10.10, "5Y",
    2.15e-2, currency, 100.0,
    "ACT_365_FIXED", calCfets, "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);

vanillaBond = caplib::buildVanillaBond(
    1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "FI_VANILLA_BOND", false);

// ============================================================================
// Tests

// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="calcYieldToMaturity -> frozen reference (price 99.5)"
r1 = caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", 99.5, "CLEAN_PRICE", "ANNUAL");
assert 1, abs(r1 - 0.022491085767160423) < 1.0e-12

// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="calcYieldToMaturity -> frozen reference (price 101.0, higher price lower yield)"
r2 = caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", 101.0, "CLEAN_PRICE", "ANNUAL");
assert 1, abs(r2 - 0.01882428726065859) < 1.0e-12 && r2 < r1

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="calcYieldToMaturity rejects missing argument", syntaxError=1
caplib::calcYieldToMaturity(2024.01.01, "X", "X", "X", 0.02, "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="calcYieldToMaturity rejects extra argument", syntaxError=1
caplib::calcYieldToMaturity(2024.01.01, "X", "X", "X", 0.02, "X", "X", 1)

// 用例目的：参数 calculationDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects wrong type for calculationDate", exception=1
caplib::calcYieldToMaturity("bad", "X", "X", "X", 0.02, "X", "X")

// 用例目的：参数 compoundingType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects wrong type for compoundingType", exception=1
caplib::calcYieldToMaturity(2024.01.01, 1, "X", "X", 0.02, "X", "X")

// 用例目的：参数 price 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects wrong type for price", exception=1
caplib::calcYieldToMaturity(2024.01.01, "X", "X", "X", "bad", "X", "X")

// 用例目的：参数 calculationDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects null calculationDate", exception=1
caplib::calcYieldToMaturity(date(), "X", "X", "X", 0.02, "X", "X")

// 用例目的：参数 compoundingType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects null compoundingType", exception=1
caplib::calcYieldToMaturity(2024.01.01, string(), "X", "X", 0.02, "X", "X")

// 用例目的：标量参数 calculationDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects vector for scalar calculationDate", exception=1
caplib::calcYieldToMaturity([2024.01.01], "X", "X", "X", 0.02, "X", "X")

// 用例目的：句柄参数 bondHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects nonexistent handle bondHandle", exception=1
caplib::calcYieldToMaturity(2024.01.01, "X", "TF_HANDLE_DOES_NOT_EXIST", "X", 0.02, "X", "X")

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="calcYieldToMaturity rejects keyword arguments", syntaxError=1
caplib::calcYieldToMaturity(calculationDate=2024.01.01, compoundingType="X", bondHandle="X", forwardCurveHandle="X", price=0.02, priceType="X", frequency="X")
// 用例目的：句柄参数 forwardCurveHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects wrong object type for forwardCurveHandle", exception=1
caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, vanillaBond, 99.5, "CLEAN_PRICE", "ANNUAL")

// 用例目的：参数 price 传入0，验证数值边界校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects zero price", exception=1
caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", 0.0, "CLEAN_PRICE", "ANNUAL")

// 用例目的：参数 price 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="calcYieldToMaturity rejects negative price", exception=1
caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", -1.0, "CLEAN_PRICE", "ANNUAL")

// 用例目的：相同输入连续调用两次，验证两次返回结果完全一致（计算确定性）
@testing:case="calcYieldToMaturity deterministic repeat -> identical result"
r1 = caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", 99.5, "CLEAN_PRICE", "ANNUAL");
r2 = caplib::calcYieldToMaturity(asOfDate, "CONTINUOUS_COMPOUNDING", vanillaBond, "", 99.5, "CLEAN_PRICE", "ANNUAL");
assert 1, max(abs(r1 - r2)) < 1.0e-12
