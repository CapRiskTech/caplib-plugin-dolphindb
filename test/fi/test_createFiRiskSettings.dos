// ============================================================================
// test_createFiRiskSettings.dos
// Per-function test suite for caplib::createFiRiskSettings (fi).
// Signature: caplib::createFiRiskSettings(irCurveSettings STRING, csCurveSettings STRING, thetaSettings STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createFiRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

irRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "FI_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "FI_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FI_THETA_RISK", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFiRiskSettings -> handle"
// needs irCurveRisk/creditCurveRisk/thetaRisk from fixture
result = caplib::createFiRiskSettings(irRisk, creditRisk, thetaRisk, "TF_FIRSK", "TF_FIRSK", false)
assert 1, result == "TF_FIRSK"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFiRiskSettings rejects missing argument", syntaxError=1
caplib::createFiRiskSettings("X", "X", "X", "TF_createFiRiskSettings_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFiRiskSettings rejects extra argument", syntaxError=1
caplib::createFiRiskSettings("X", "X", "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false, 1)

// 用例目的：参数 irCurveSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects wrong type for irCurveSettings", exception=1
caplib::createFiRiskSettings(1, "X", "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：参数 csCurveSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects wrong type for csCurveSettings", exception=1
caplib::createFiRiskSettings("X", 1, "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：参数 thetaSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects wrong type for thetaSettings", exception=1
caplib::createFiRiskSettings("X", "X", 1, "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：参数 irCurveSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects null irCurveSettings", exception=1
caplib::createFiRiskSettings(string(), "X", "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：参数 csCurveSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects null csCurveSettings", exception=1
caplib::createFiRiskSettings("X", string(), "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：标量参数 irCurveSettings 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFiRiskSettings rejects vector for scalar irCurveSettings", exception=1
caplib::createFiRiskSettings(["X"], "X", "X", "TF_createFiRiskSettings_H", "TF_createFiRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFiRiskSettings rejects keyword arguments", syntaxError=1
caplib::createFiRiskSettings(irCurveSettings="X", csCurveSettings="X", thetaSettings="X", name="TF_createFiRiskSettings_H", tag="TF_createFiRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFiRiskSettings optional returnJson null uses default"
result = caplib::createFiRiskSettings(irRisk, creditRisk, thetaRisk, "TF_FIRSK", "TF_FIRSK", bool())
assert 1, typestr(result) != "VOID"
