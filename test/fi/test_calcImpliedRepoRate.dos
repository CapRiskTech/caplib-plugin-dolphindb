// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="calcImpliedRepoRate -> DOUBLE"
r = caplib::calcImpliedRepoRate(100.5, 1.02, 99.8, 0.03, 2025.03.01, 2024.12.01, 2025.03.15, "ACT_360", 2025.06.01, "SEMIANNUAL");
assert 1, typestr(r) == "DOUBLE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="calcImpliedRepoRate rejects missing argument", syntaxError=1
caplib::calcImpliedRepoRate(0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 2024.01.01, "X", 2024.01.01)

@testing:case="calcImpliedRepoRate rejects extra argument", syntaxError=1
caplib::calcImpliedRepoRate(0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 2024.01.01, "X", 2024.01.01, "X", 1)

@testing:case="calcImpliedRepoRate rejects null futPrice", exception=1
caplib::calcImpliedRepoRate(double(), 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 2024.01.01, "X", 2024.01.01, "X")

@testing:case="calcImpliedRepoRate rejects null conversionFactor", exception=1
caplib::calcImpliedRepoRate(0.02, double(), 0.02, 0.02, 2024.01.01, 2024.01.01, 2024.01.01, "X", 2024.01.01, "X")

@testing:case="calcImpliedRepoRate rejects vector for scalar futPrice", exception=1
caplib::calcImpliedRepoRate([0.02], 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 2024.01.01, "X", 2024.01.01, "X")
