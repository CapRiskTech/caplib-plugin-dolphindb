// 用例目的：INT 参数 settlementDays 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createBondLegDefinition rejects BOOL settlementDays", exception=1
caplib::createBondLegDefinition("FIXED_COUPON_BOND", true, "CNY", "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "ANNUAL", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG", true)

