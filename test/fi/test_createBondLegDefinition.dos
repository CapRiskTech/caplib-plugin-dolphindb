// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createBondLegDefinition -> [handle, json]"
r = caplib::createBondLegDefinition(
    "FIXED_COUPON_BOND", 1, "CNY", "ACT_365_FIXED", "CAL_CFETS",
    "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "", "", "ANNUAL",
    "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG", true);
assert 1, isHandleJson(r, "TF_FI_LEG")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createBondLegDefinition rejects missing argument", syntaxError=1
caplib::createBondLegDefinition("X", 1, "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1)

@testing:case="createBondLegDefinition rejects extra argument", syntaxError=1
caplib::createBondLegDefinition("X", 1, "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false, 1)

@testing:case="createBondLegDefinition rejects wrong type for bondType", exception=1
caplib::createBondLegDefinition(1, 1, "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createBondLegDefinition rejects wrong type for settlementDays", exception=1
caplib::createBondLegDefinition("X", "1", "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createBondLegDefinition rejects wrong type for currency", exception=1
caplib::createBondLegDefinition("X", 1, 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createBondLegDefinition rejects null settlementDays", exception=1
caplib::createBondLegDefinition("X", int(), "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createBondLegDefinition rejects vector for scalar bondType", exception=1
caplib::createBondLegDefinition(["X"], 1, "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", false)

@testing:case="createBondLegDefinition rejects keyword arguments", syntaxError=1
caplib::createBondLegDefinition(bondType="X", settlementDays=1, currency="X", dayCount="X", calendar="X", frequency="X", interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", payDayOffset=1, payDayConvention="X", refIndex="X", fixingCalendars="X", fixingFreq="X", fixingDayConvention="X", fixingMode="X", fixingDayOffset=1, instName="X", returnJson=false)



// ----------------------------------------------------------------------------
// Review wave-1 additions (wiki test-case review)
// ----------------------------------------------------------------------------

@testing:case="createBondLegDefinition accepts invalid enum bondType (maps to invalid sentinel)"
result = caplib::createBondLegDefinition("NOT_A_VALID_ENUM_LABEL", 1, "CNY", "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "ANNUAL", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG", true)
assert 1, typestr(result) != "VOID"


// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createBondLegDefinition optional returnJson null uses default"
result = caplib::createBondLegDefinition("FIXED_COUPON_BOND", 1, "CNY", "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "ANNUAL", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG", bool())
assert 1, typestr(result) != "VOID"
