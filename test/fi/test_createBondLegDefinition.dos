// 用例目的：参数 calendar 传入错误类型（该传字符串的传整数），验证类型校验（实测抛异常）
@testing:case="createBondLegDefinition rejects wrong type for calendar", exception=1
caplib::createBondLegDefinition("FIXED_COUPON_BOND", 1, "CNY", "ACT_365_FIXED", 1, "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "ANNUAL", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG_R3", true)
// 用例目的：参数 calendar 传入对应类型的空值 —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="createBondLegDefinition accepts null calendar (no validation)"
rBldR3Nc = caplib::createBondLegDefinition("FIXED_COUPON_BOND", 1, "CNY", "ACT_365_FIXED", string(), "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "ANNUAL", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG_R3_NC", true)
assert 1, typestr(rBldR3Nc) != "VOID"
// 用例目的：参数 fixingCalendars 传入错误类型（该传字符串的传整数），验证类型校验（实测抛异常）
