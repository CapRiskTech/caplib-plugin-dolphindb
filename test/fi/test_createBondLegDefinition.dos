rBldR3Ff10 = caplib::createBondLegDefinition("FIXED_COUPON_BOND", 1, "CNY", "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "DAILY", "MODIFIED_FOLLOWING", "IN_ADVANCE", -1, "TF_FI_LEG_R3", true)
assert 1, typestr(rBldR3Ff10) != "VOID"
// 用例目的：fixingFreq 传入文档取值 ONCE，逐值验证被接受
