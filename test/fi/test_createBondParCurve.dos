cnyMtnAaaCpnA2y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_2y", "2Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA3y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_3y", "3Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA4y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_4y", "4Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA5y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_5y", "5Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA7y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_7y", "7Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA8y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_8y", "8Y", currency, calCfets, asOfDate);
cnyMtnAaaCpnA9y = createStdFixedBondTemplate("cny_mtn_aaa_cpn_a_9y", "9Y", currency, calCfets, asOfDate);

cnyTreasCpnBond200014Template = caplib::createVanillaBondTemplate(
    "cny_treas_cpn_bond_200014", "FIXED_COUPON_BOND",
    2020.10.09, 1, 2020.10.10, "5Y",
    2.15e-2, currency, 100.0,
    "ACT_365_FIXED", calCfets, "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
