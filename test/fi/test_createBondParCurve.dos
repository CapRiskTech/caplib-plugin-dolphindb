    "CNY_MTN_AAA_SPRD_STD_CFETS_BUILD_SETTINGS", true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);

vanillaBond = caplib::buildVanillaBond(
    1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "FI_VANILLA_BOND", false);

fiMktData = caplib::createFiMktDataSet(
    asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], cnyTreasStdCfets[0], cnyTreasStdCfets[0],
    "FI_MKT_NAME", "FI_MKT", true);
bondMktData = caplib::createBondMktDataSet(
    asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "FI_BOND_MKT_NAME", "FI_BOND_MKT", true);

irRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "FI_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "FI_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FI_THETA_RISK", false);
fiRisk = caplib::createFiRiskSettings(
    irRisk, creditRisk, thetaRisk, "FI_RISK_NAME", "FI_RISK", true);
vanillaBondRisk = caplib::createVanillaBondRiskSettings(
    "", "", 1, "FI_VANILLA_BOND_RISK_NAME", "FI_VANILLA_BOND_RISK", true);

pricingSettings = caplib::createPricingSettings(
    currency, "ANALYTICAL", 1, 1, "", "", "", "FI_PRICING", false);

vanillaBondPricingResult = caplib::priceVanillaBond(
    vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);

// ============================================================================
// Tests
// ============================================================================

@testing:case="createBondParCurve -> [handle, json]"
p = caplib::createBondParCurve(asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes, "YIELD_TO_MATURITY", "TF_FI_PAR", true);
assert 1, isHandleJson(p, "TF_FI_PAR")

@testing:case="createBondParCurve rejects names/quotes length mismatch", exception=1
caplib::createBondParCurve(asOfDate, currency, cnyTreasBondNames, take(0.02, 3), "YIELD_TO_MATURITY", "TF_FI_PAR_BAD", true)

@testing:case="createBondParCurve rejects invalid quoteType", exception=1
caplib::createBondParCurve(asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes, "NOT_A_QUOTE_TYPE", "TF_FI_PAR_BAD", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createBondParCurve rejects missing argument", syntaxError=1
caplib::createBondParCurve(2024.01.01, "X", ["X"], [0.02], "X")

@testing:case="createBondParCurve rejects extra argument", syntaxError=1
caplib::createBondParCurve(2024.01.01, "X", ["X"], [0.02], "X", "X", false, 1)

@testing:case="createBondParCurve rejects null referenceDate", exception=1
caplib::createBondParCurve(date(), "X", ["X"], [0.02], "X", "X", false)

@testing:case="createBondParCurve rejects null currency", exception=1
caplib::createBondParCurve(2024.01.01, string(), ["X"], [0.02], "X", "X", false)

@testing:case="createBondParCurve rejects vector for scalar referenceDate", exception=1
caplib::createBondParCurve([2024.01.01], "X", ["X"], [0.02], "X", "X", false)

@testing:case="createBondParCurve rejects scalar for vector instrumentNames", exception=1
caplib::createBondParCurve(2024.01.01, "X", ["X"], [0.02], "X", "X", false)

@testing:case="createBondParCurve rejects partially-null vector instrumentNames", exception=1
caplib::createBondParCurve(2024.01.01, "X", ["X", string()], [0.02], "X", "X", false)

@testing:case="createBondParCurve rejects empty vector instrumentNames", exception=1
caplib::createBondParCurve(2024.01.01, "X", take(string, 0), [0.02], "X", "X", false)
