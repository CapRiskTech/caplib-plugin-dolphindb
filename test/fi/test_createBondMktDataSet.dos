// ============================================================================
// test_createBondMktDataSet.dos
// Per-function test suite for caplib::createBondMktDataSet (fi).
// Signature: caplib::createBondMktDataSet(asOfDate DATE, discountCurve STRING, creditCurve STRING, forwardCurve STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createBondMktDataSet.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyMtnAaaSprdStdCfetsName = "cny_mtn_aaa_sprd_std_cfets";
cnyMtnBondNames = [
    "CNY_MTN_AAA_CPN_A_1M",
    "CNY_MTN_AAA_CPN_A_3M",
    "CNY_MTN_AAA_CPN_A_6M",
    "CNY_MTN_AAA_CPN_A_9M",
    "CNY_MTN_AAA_CPN_A_1Y",
    "CNY_MTN_AAA_CPN_A_2Y",
    "CNY_MTN_AAA_CPN_A_3Y",
    "CNY_MTN_AAA_CPN_A_4Y",
    "CNY_MTN_AAA_CPN_A_5Y",
    "CNY_MTN_AAA_CPN_A_7Y",
    "CNY_MTN_AAA_CPN_A_8Y",
    "CNY_MTN_AAA_CPN_A_9Y"];
cnyMtnBondQuotes = [
    0.022916, 0.024213, 0.025822, 0.026675, 0.027216, 0.028916,
    0.031112, 0.032824, 0.033816, 0.036816, 0.037026, 0.037311];
parCnyMtnAaaSprdStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyMtnBondNames, cnyMtnBondQuotes,
    "YIELD_TO_MATURITY", cnyMtnAaaSprdStdCfetsName, true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createBondMktDataSet -> [handle, json]"
r = caplib::createBondMktDataSet(asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0], cnyTreasStdCfets[0], "TF_FI_BOND_MKT_NAME", "TF_FI_BOND_MKT", true);
assert 1, isHandleJson(r, "TF_FI_BOND_MKT")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createBondMktDataSet rejects missing argument", syntaxError=1
caplib::createBondMktDataSet(2024.01.01, "X", "X", "X", "TF_createBondMktDataSet_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createBondMktDataSet rejects extra argument", syntaxError=1
caplib::createBondMktDataSet(2024.01.01, "X", "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createBondMktDataSet("bad", "X", "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：参数 discountCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects wrong type for discountCurve", exception=1
caplib::createBondMktDataSet(2024.01.01, 1, "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：参数 creditCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects wrong type for creditCurve", exception=1
caplib::createBondMktDataSet(2024.01.01, "X", 1, "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects null asOfDate", exception=1
caplib::createBondMktDataSet(date(), "X", "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：参数 discountCurve 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects null discountCurve", exception=1
caplib::createBondMktDataSet(2024.01.01, string(), "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createBondMktDataSet rejects vector for scalar asOfDate", exception=1
caplib::createBondMktDataSet([2024.01.01], "X", "X", "X", "TF_createBondMktDataSet_H", "TF_createBondMktDataSet_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createBondMktDataSet rejects keyword arguments", syntaxError=1
caplib::createBondMktDataSet(asOfDate=2024.01.01, discountCurve="X", creditCurve="X", forwardCurve="X", name="TF_createBondMktDataSet_H", tag="TF_createBondMktDataSet_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createBondMktDataSet optional returnJson null uses default"
result = caplib::createBondMktDataSet(asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0], cnyTreasStdCfets[0], "TF_FI_BOND_MKT_NAME", "TF_FI_BOND_MKT", bool())
assert 1, typestr(result) != "VOID"
