@testing:case="createFloatingLegDefinition rejects keyword arguments", syntaxError=1
caplib::createFloatingLegDefinition(currency="X", refIndex="X", calendar="X", fixingCalendars="X", freq="X", fixingFreq="X", dayCount="X", paymentDiscountMethod="X", rateCalcMethod="X", spread=false, interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", payDayOffset=1, payDayConvention="X", fixingDayConvention="X", fixingMode="X", fixingDayOffset=1, notionalExchange="X", tag="TF_createFloatingLegDefinition_H", returnJson=false)



