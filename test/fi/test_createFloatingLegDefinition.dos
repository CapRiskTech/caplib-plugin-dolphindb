@testing:case="createFloatingLegDefinition rejects null refIndex", exception=1
caplib::createFloatingLegDefinition("X", string(), "X", "X", "X", "X", "X", "X", "X", false, "X", "X", "X", 1, "X", "X", "X", 1, "X", "TF_createFloatingLegDefinition_H", false)

@testing:case="createFloatingLegDefinition rejects vector for scalar currency", exception=1
