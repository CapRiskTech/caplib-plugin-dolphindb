// ----------------------------------------------------------------------------
// Review wave-5b additions (enum sweeps)
// ----------------------------------------------------------------------------

@testing:case="createFloatingLegDefinition supports all paymentDiscountMethod enums"
labelEnum = ["NO_DISCOUNT", "DISCOUNT_AT_FLOATING_RATE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFloatingLegDefinition("CNY", iborIndex[0], "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "QUARTERLY", "ACT_360", labelEnum[i], "STANDARD", false, "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "TF_IR_FLOATING_LEG", true); } catch(ex) { okEnum = false; }
}
assert 1, okEnum



