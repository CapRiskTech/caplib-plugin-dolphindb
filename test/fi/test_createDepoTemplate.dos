// Signature: caplib::createDepoTemplate(instName STRING, currency STRING, calendar STRING or STRING[][, startDelay INT[, dayCount STRING[, interestDayConvention STRING[, payDayOffset INT[, payDayConvention STRING[, startConvention STRING]]]]]][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createDepoTemplate.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
