// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}


caplib::createCalendar("CAL_CFETS");

// ============================================================================
// Tests
// ============================================================================

@testing:case="createDepoTemplate -> handle"
result = caplib::createDepoTemplate("TF_DEPO", "CNY", "CAL_CFETS", 0, "ACT_360", "MODIFIED_FOLLOWING", 0, "FOLLOWING", "SPOTSTART", false)
assert 1, result == "TF_DEPO"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createDepoTemplate rejects missing argument", syntaxError=1
caplib::createDepoTemplate("X", "X")

@testing:case="createDepoTemplate rejects extra argument", syntaxError=1
caplib::createDepoTemplate("X", "X", "X", 1, "X", "X", 1, "X", "X", false, 1)

@testing:case="createDepoTemplate rejects wrong type for instName", exception=1
caplib::createDepoTemplate(1, "X", "X", 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects wrong type for currency", exception=1
caplib::createDepoTemplate("X", 1, "X", 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects wrong type for calendar", exception=1
caplib::createDepoTemplate("X", "X", 1, 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects null instName", exception=1
caplib::createDepoTemplate(string(), "X", "X", 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects null currency", exception=1
caplib::createDepoTemplate("X", string(), "X", 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects vector for scalar instName", exception=1
caplib::createDepoTemplate(["X"], "X", "X", 1, "X", "X", 1, "X", "X", false)

@testing:case="createDepoTemplate rejects keyword arguments", syntaxError=1
caplib::createDepoTemplate(instName="X", currency="X", calendar="X", startDelay=1, dayCount="X", interestDayConvention="X", payDayOffset=1, payDayConvention="X", startConvention="X", returnJson=false)
