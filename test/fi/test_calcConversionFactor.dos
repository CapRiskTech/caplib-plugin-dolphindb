// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="calcConversionFactor -> frozen reference (set 1)"
r1 = caplib::calcConversionFactor(0.03, "ANNUAL", 0.06, 2026.06.01, 2025.06.10, 2025.03.01);
assert 1, abs(r1 - 0.9941981132075471) < 1.0e-12

@testing:case="calcConversionFactor -> frozen reference (set 2, different inputs)"
r2 = caplib::calcConversionFactor(0.05, "SEMIANNUAL", 0.06, 2030.06.01, 2025.06.10, 2025.03.01);
assert 1, abs(r2 - 0.9896014640640274) < 1.0e-12

@testing:case="calcConversionFactor repeated calls are deterministic"
assert 1, caplib::calcConversionFactor(0.03, "ANNUAL", 0.06, 2026.06.01, 2025.06.10, 2025.03.01) == r1

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="calcConversionFactor rejects missing argument", syntaxError=1
caplib::calcConversionFactor(0.02, "X", 0.02, 2024.01.01, 2024.01.01)

@testing:case="calcConversionFactor rejects extra argument", syntaxError=1
caplib::calcConversionFactor(0.02, "X", 0.02, 2024.01.01, 2024.01.01, 2024.01.01, 1)

@testing:case="calcConversionFactor rejects null bondCouponRate", exception=1
caplib::calcConversionFactor(double(), "X", 0.02, 2024.01.01, 2024.01.01, 2024.01.01)

@testing:case="calcConversionFactor rejects null bondCpnFreq", exception=1
caplib::calcConversionFactor(0.02, string(), 0.02, 2024.01.01, 2024.01.01, 2024.01.01)

@testing:case="calcConversionFactor rejects vector for scalar bondCouponRate", exception=1
caplib::calcConversionFactor([0.02], "X", 0.02, 2024.01.01, 2024.01.01, 2024.01.01)

@testing:case="calcConversionFactor rejects keyword arguments", syntaxError=1
caplib::calcConversionFactor(bondCouponRate=0.02, bondCpnFreq="X", nominalCpnRate=0.02, bondMaturity=2024.01.01, settlementDate=2024.01.01, lastCpnDate=2024.01.01)
