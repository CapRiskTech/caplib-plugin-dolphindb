// ============================================================================
// test_createAssetYieldCurve.dos
// Per-function test suite for caplib::createAssetYieldCurve (fi).
// Signature: caplib::createAssetYieldCurve(referenceDate DATE, pillarDates DATE[], pillarValues DOUBLE[], interp STRING, extrap STRING, dcc STRING, compounding STRING, pillarNames STRING[], curveName STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createAssetYieldCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createAssetYieldCurve valid call"
result = caplib::createAssetYieldCurve(asOfDate, curveDates, curveValues, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC", "TF_ASSET_YC", false)
assert 1, result == "TF_ASSET_YC"

@testing:case="createAssetYieldCurve rejects scalar pillarValues", exception=1
caplib::createAssetYieldCurve(asOfDate, curveDates, 0.02, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC_BAD", "TF_ASSET_YC_BAD", false)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createAssetYieldCurve rejects missing argument", syntaxError=1
caplib::createAssetYieldCurve(asOfDate, curveDates, curveValues, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC")

@testing:case="createAssetYieldCurve rejects extra argument", syntaxError=1
caplib::createAssetYieldCurve(asOfDate, curveDates, curveValues, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC", "TF_ASSET_YC", false, 1)

@testing:case="createAssetYieldCurve rejects wrong type for referenceDate", exception=1
caplib::createAssetYieldCurve("bad", curveDates, curveValues, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC", "TF_ASSET_YC", false)

@testing:case="createAssetYieldCurve rejects wrong type for interp", exception=1
caplib::createAssetYieldCurve(asOfDate, curveDates, curveValues, 1, "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC", "TF_ASSET_YC", false)

@testing:case="createAssetYieldCurve rejects wrong type for extrap", exception=1
caplib::createAssetYieldCurve(asOfDate, curveDates, curveValues, "LINEAR_INTERP", 1, "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "TF_ASSET_YC", "TF_ASSET_YC", false)
