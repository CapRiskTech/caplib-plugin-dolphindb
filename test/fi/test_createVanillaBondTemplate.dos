// ============================================================================
// test_createVanillaBondTemplate.dos
// Per-function test suite for caplib::createVanillaBondTemplate (fi).
// Signature: caplib::createVanillaBondTemplate(instName STRING, vanillaBondType STRING, issueDate DATE, settlementDays INT, startDate DATE, maturity STRING, rate DOUBLE, currency STRING, issuePrice DOUBLE, dayCount STRING, calendar STRING, frequency STRING, interestDayConvention STRING, stubPolicy STRING, brokenPeriodType STRING, payDayOffset INT, payDayConvention STRING, refIndex STRING, fixingCalendars STRING or STRING[], fixingFreq STRING, fixingDayConvention STRING, fixingMode STRING, fixingDayOffset INT, exCouponPeriod STRING, exCouponCalendar STRING, exCouponDayConvention STRING, exCouponEndOfMonth BOOL[, notionalType STRING[, recoveryRate DOUBLE]][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createVanillaBondTemplate.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createVanillaBondTemplate fixed coupon -> [handle, json]"
r = caplib::createVanillaBondTemplate(
    "TF_FI_BOND_TPL", "FIXED_COUPON_BOND",
    asOfDate, 1, asOfDate, "1Y",
    0.0, currency, 100.0,
    "ACT_365_FIXED", "CAL_CFETS", "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);
assert 1, isHandleJson(r, "TF_FI_BOND_TPL")

// 用例目的：zero coupon variant（预期：插件按文档行为执行）
@testing:case="createVanillaBondTemplate zero coupon variant"
r2 = caplib::createVanillaBondTemplate(
    "TF_FI_ZCB_TPL", "ZERO_COUPON_BOND",
    asOfDate, 1, asOfDate, "6M",
    0.0, currency, 100.0,
    "ACT_365_FIXED", "CAL_CFETS", "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);
assert 1, isHandleJson(r2, "TF_FI_ZCB_TPL")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createVanillaBondTemplate rejects missing argument", syntaxError=1
caplib::createVanillaBondTemplate("X", "X", 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createVanillaBondTemplate rejects extra argument", syntaxError=1
caplib::createVanillaBondTemplate("X", "X", 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects wrong type for instName", exception=1
caplib::createVanillaBondTemplate(1, "X", 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：参数 vanillaBondType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects wrong type for vanillaBondType", exception=1
caplib::createVanillaBondTemplate("X", 1, 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：参数 issueDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects wrong type for issueDate", exception=1
caplib::createVanillaBondTemplate("X", "X", "bad", 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects null instName", exception=1
caplib::createVanillaBondTemplate(string(), "X", 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：参数 vanillaBondType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects null vanillaBondType", exception=1
caplib::createVanillaBondTemplate("X", string(), 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects vector for scalar instName", exception=1
caplib::createVanillaBondTemplate(["X"], "X", 2024.01.01, 1, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", "X", false, "X", 0.02, false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createVanillaBondTemplate rejects keyword arguments", syntaxError=1
caplib::createVanillaBondTemplate(instName="X", vanillaBondType="X", issueDate=2024.01.01, settlementDays=1, startDate=2024.01.01, maturity="X", rate=0.02, currency="X", issuePrice=0.02, dayCount="X", calendar="X", frequency="X", interestDayConvention="X", stubPolicy="X", brokenPeriodType="X", payDayOffset=1, payDayConvention="X", refIndex="X", fixingCalendars="X", fixingFreq="X", fixingDayConvention="X", fixingMode="X", fixingDayOffset=1, exCouponPeriod="X", exCouponCalendar="X", exCouponDayConvention="X", exCouponEndOfMonth=false, notionalType="X", recoveryRate=0.02, returnJson=false)
// 用例目的：枚举参数 vanillaBondType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects invalid enum for vanillaBondType", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "NOT_A_VALID_ENUM_LABEL", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createVanillaBondTemplate optional returnJson null uses default"
result = caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 vanillaBondType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createVanillaBondTemplate supports all vanillaBondType enums"
labelEnum = ["FIXED_COUPON_BOND", "FLOATING_COUPON_BOND", "ZERO_COUPON_BOND"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", labelEnum[i], asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 settlementDays 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects negative settlementDays", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, -1.0, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：参数 fixingCalendars 传入全部元素为空值的向量，实测插件宽松接受、不抛异常——记录实际行为
@testing:case="createVanillaBondTemplate rejects all-null vector fixingCalendars", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", [string(), string(), string()], "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)

// 用例目的：参数 fixingCalendars 传入长度为 0 的空向量，验证向量空值校验（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects empty vector fixingCalendars", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", take(string, 0), "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)
