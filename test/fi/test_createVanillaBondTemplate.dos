caplib::createVanillaBondTemplate("TF_FI_BOND_TPL_FN", "FIXED_COUPON_BOND", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", [string(), string(), string()], "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)

// 用例目的：参数 fixingCalendars 传入长度为 0 的空向量，验证向量空值校验（预期：抛异常）
