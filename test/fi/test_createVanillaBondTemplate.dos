// ----------------------------------------------------------------------------
// Review round-3 gap-fill: issueDate/startDate/maturity 日期关系 + 可选参数边界 + 各枚举参数文档取值逐值覆盖
// ----------------------------------------------------------------------------

// 用例目的：issueDate（2022.01.01）晚于 startDate（2021.07.22）—— 实测插件/包装器不校验该日期关系、宽松接受，记录实际行为
@testing:case="createVanillaBondTemplate accepts issueDate later than startDate (no validation)"
rVbtR3Is = caplib::createVanillaBondTemplate("TF_FI_BOND_TPL_R3_IS", "FIXED_COUPON_BOND", 2022.01.01, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)
assert 1, typestr(rVbtR3Is) != "VOID"
// 用例目的：startDate（2023.01.01）晚于模板正例对应的到期日（issueDate+1Y = 2022.07.22）—— 实测插件/包装器不校验该日期关系、宽松接受，记录实际行为
@testing:case="createVanillaBondTemplate accepts startDate later than maturity end (no validation)"
rVbtR3Sm = caplib::createVanillaBondTemplate("TF_FI_BOND_TPL_R3_SM", "FIXED_COUPON_BOND", asOfDate, 1, 2023.01.01, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)
assert 1, typestr(rVbtR3Sm) != "VOID"
// 用例目的：issueDate（2023.01.01）晚于模板对应到期日（startDate+1Y = 2022.07.22）—— 实测插件/包装器不校验该日期关系、宽松接受，记录实际行为
@testing:case="createVanillaBondTemplate accepts issueDate later than maturity end (no validation)"
