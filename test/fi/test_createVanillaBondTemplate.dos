assert 1, typestr(rVbtEdc) != "VOID"

// 用例目的：INT 参数 settlementDays 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects BOOL settlementDays", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, true, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)

// 用例目的：INT 参数 payDayOffset 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createVanillaBondTemplate rejects BOOL payDayOffset", exception=1
caplib::createVanillaBondTemplate("TF_FI_BOND_TPL", "FIXED_COUPON_BOND", asOfDate, 1, asOfDate, "1Y", 0.0, currency, 100.0, "ACT_365_FIXED", "CAL_CFETS", "ANNUAL", "MODIFIED_FOLLOWING", "INITIAL", "LONG", true, "MODIFIED_FOLLOWING", "", "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION", "INVALID_DATE_GENERATION_MODE", -1, "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false, "CONST_NOTIONAL", 0.0, true)

