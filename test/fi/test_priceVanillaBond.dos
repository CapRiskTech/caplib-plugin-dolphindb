@testing:case="priceVanillaBond rejects keyword arguments", syntaxError=1
caplib::priceVanillaBond(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="priceVanillaBond rejects wrong object type for instrumentHandle", exception=1
caplib::priceVanillaBond(asOfDate, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="priceVanillaBond rejects wrong object type for mktDataHandle", exception=1
caplib::priceVanillaBond(vanillaBond, asOfDate, vanillaBond, pricingSettings, fiRisk[0], "", "", true)

// 用例目的：相同输入连续定价两次，验证两次现值完全一致（定价确定性）
@testing:case="priceVanillaBond deterministic repeat -> identical result"
r1 = caplib::priceVanillaBond(vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);
r2 = caplib::priceVanillaBond(vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);
assert 1, abs(presentValue(r1) - presentValue(r2)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)

// ----------------------------------------------------------------------------
// 用例目的：以 2 倍名义重建同一债券并定价，验证现值随名义线性缩放（输入影响输出）
@testing:case="priceVanillaBond notional x2 -> 2x present value"
r1 = caplib::priceVanillaBond(vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);
vanillaBond2X = caplib::buildVanillaBond(
    2000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "FI_VANILLA_BOND", false);
r2 = caplib::priceVanillaBond(vanillaBond2X, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);
assert 1, abs(presentValue(r2) - 2.0 * presentValue(r1)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)
