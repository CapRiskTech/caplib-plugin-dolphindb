// ============================================================================
// test_priceVanillaBond.dos
// Per-function test suite for caplib::priceVanillaBond (fi).
// Signature: caplib::priceVanillaBond(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_priceVanillaBond.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";
calCfets = "CAL_CFETS";

cnyTreasCpnBond200014Template = caplib::createVanillaBondTemplate(
    "cny_treas_cpn_bond_200014", "FIXED_COUPON_BOND",
    2020.10.09, 1, 2020.10.10, "5Y",
    2.15e-2, currency, 100.0,
    "ACT_365_FIXED", calCfets, "ANNUAL",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "",
    "", "INVALID_FREQUENCY", "INVALID_BUSINESS_DAY_CONVENTION",
    "INVALID_DATE_GENERATION_MODE", -1,
    "0d", "", "INVALID_BUSINESS_DAY_CONVENTION", false,
    "CONST_NOTIONAL", 0.0, true);

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyMtnAaaSprdStdCfetsName = "cny_mtn_aaa_sprd_std_cfets";
cnyMtnBondNames = [
    "CNY_MTN_AAA_CPN_A_1M",
    "CNY_MTN_AAA_CPN_A_3M",
    "CNY_MTN_AAA_CPN_A_6M",
    "CNY_MTN_AAA_CPN_A_9M",
    "CNY_MTN_AAA_CPN_A_1Y",
    "CNY_MTN_AAA_CPN_A_2Y",
    "CNY_MTN_AAA_CPN_A_3Y",
    "CNY_MTN_AAA_CPN_A_4Y",
    "CNY_MTN_AAA_CPN_A_5Y",
    "CNY_MTN_AAA_CPN_A_7Y",
    "CNY_MTN_AAA_CPN_A_8Y",
    "CNY_MTN_AAA_CPN_A_9Y"];
cnyMtnBondQuotes = [
    0.022916, 0.024213, 0.025822, 0.026675, 0.027216, 0.028916,
    0.031112, 0.032824, 0.033816, 0.036816, 0.037026, 0.037311];
parCnyMtnAaaSprdStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyMtnBondNames, cnyMtnBondQuotes,
    "YIELD_TO_MATURITY", cnyMtnAaaSprdStdCfetsName, true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);

vanillaBond = caplib::buildVanillaBond(
    1000000.0, cnyTreasCpnBond200014Template[0], "", 2020.10.10, "FI_VANILLA_BOND", false);

fiMktData = caplib::createFiMktDataSet(
    asOfDate, cnyTreasStdCfets[0], cnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], cnyTreasStdCfets[0], cnyTreasStdCfets[0],
    "FI_MKT_NAME", "FI_MKT", true);

irRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "FI_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "FI_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "FI_THETA_RISK", false);
fiRisk = caplib::createFiRiskSettings(
    irRisk, creditRisk, thetaRisk, "FI_RISK_NAME", "FI_RISK", true);

pricingSettings = caplib::createPricingSettings(currency, "ANALYTICAL", 1, 1, take(0, 0), "", "", "", "FI_PRICING", false);

vanillaBondPricingResult = caplib::priceVanillaBond(
    vanillaBond, asOfDate, fiMktData[0], pricingSettings, fiRisk[0], "", "", true);

// ============================================================================
// Tests

// 用例目的：-> [handle, present_value reference]（预期：插件按文档行为执行）
@testing:case="priceVanillaBond -> [handle, present_value reference]"
assert 1, isPricingResultsJson(vanillaBondPricingResult, "FI_VANILLA_BOND_results")
assert 2, abs(presentValue(vanillaBondPricingResult) - 972284.4161978982) < abs(972284.4161978982) * 1.0e-9 + 1.0e-6

// 用例目的：rejects wrong mktData handle（预期：插件按文档行为执行）
@testing:case="priceVanillaBond rejects wrong mktData handle", exception=1
caplib::priceVanillaBond(vanillaBond, asOfDate, cnyTreasCpnBond200014Template[0], pricingSettings, fiRisk[0], "", "", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
