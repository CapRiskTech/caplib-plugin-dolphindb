@testing:case="priceVanillaBond rejects null pricingDate", exception=1
caplib::priceVanillaBond("X", date(), "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceVanillaBond rejects null mode", exception=1
caplib::priceVanillaBond("X", 2024.01.01, "X", "X", "X", "X", string(), false)

// 用例目的：标量参数 pricingDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="priceVanillaBond rejects vector for scalar pricingDate", exception=1
caplib::priceVanillaBond("X", [2024.01.01], "X", "X", "X", "X", "X", false)

// 用例目的：句柄参数 instrumentHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="priceVanillaBond rejects nonexistent handle instrumentHandle", exception=1
caplib::priceVanillaBond("TF_NO_SUCH_HANDLE_priceVanillaBond", 2024.01.01, "X", "X", "X", "X", "X", false)

