// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="priceVanillaBond rejects missing argument", syntaxError=1
caplib::priceVanillaBond("X", 2024.01.01, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="priceVanillaBond rejects extra argument", syntaxError=1
caplib::priceVanillaBond("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

// 用例目的：参数 pricingDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceVanillaBond rejects wrong type for pricingDate", exception=1
caplib::priceVanillaBond("X", "bad", "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceVanillaBond rejects wrong type for mode", exception=1
caplib::priceVanillaBond("X", 2024.01.01, "X", "X", "X", "X", 1, false)

