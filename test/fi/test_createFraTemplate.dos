// ============================================================================
// test_createFraTemplate.dos
// Per-function test suite for caplib::createFraTemplate (fi).
// Signature: caplib::createFraTemplate(instName STRING, refIndex STRING, currency STRING, calendar STRING or STRING[], fixingCalendars STRING or STRING[], freq STRING[, dayCount STRING[, paymentDiscountMethod STRING[, interestDayConvention STRING[, payDayOffset INT[, payDayConvention STRING[, fixingDayConvention STRING[, fixingDayOffset INT]]]]]]][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createFraTemplate.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

currency = "CNY";

iborIndex = caplib::createIborIndex(
    "CNY_SHIBOR_3M", "3M", "CNY", ["CAL_CFETS"], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFraTemplate -> [handle, json]"
r = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true);
assert 1, isHandleJson(r, "TF_FRA")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFraTemplate rejects missing argument", syntaxError=1
caplib::createFraTemplate("X", "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFraTemplate rejects extra argument", syntaxError=1
caplib::createFraTemplate("X", "X", "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFraTemplate rejects wrong type for instName", exception=1
caplib::createFraTemplate(1, "X", "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：参数 refIndex 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFraTemplate rejects wrong type for refIndex", exception=1
caplib::createFraTemplate("X", 1, "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFraTemplate rejects wrong type for currency", exception=1
caplib::createFraTemplate("X", "X", 1, "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFraTemplate rejects null instName", exception=1
caplib::createFraTemplate(string(), "X", "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：参数 refIndex 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFraTemplate rejects null refIndex", exception=1
caplib::createFraTemplate("X", string(), "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFraTemplate rejects vector for scalar instName", exception=1
caplib::createFraTemplate(["X"], "X", "X", "X", "X", "X", "X", "X", "X", 1, "X", "X", 1, false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFraTemplate rejects keyword arguments", syntaxError=1
caplib::createFraTemplate(instName="X", refIndex="X", currency="X", calendar="X", fixingCalendars="X", freq="X", dayCount="X", paymentDiscountMethod="X", interestDayConvention="X", payDayOffset=1, payDayConvention="X", fixingDayConvention="X", fixingDayOffset=1, returnJson=false)
// 用例目的：枚举参数 paymentDiscountMethod 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createFraTemplate rejects invalid enum for paymentDiscountMethod", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NOT_A_VALID_ENUM_LABEL", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFraTemplate optional returnJson null uses default"
result = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFraTemplate rejects all-null vector calendar", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", [string(), string(), string()], ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFraTemplate rejects empty vector calendar", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", take(string, 0), ["CAL_CFETS"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFraTemplate rejects all-null vector fixingCalendars", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", [string(), string(), string()], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFraTemplate rejects empty vector fixingCalendars", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", take(string, 0), "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createFraTemplate rejects partially-null vector fixingCalendars", exception=1
caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS", string()], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true)

// ----------------------------------------------------------------------------
// 用例目的：两个数组参数长度不一致（fixingCalendars 多一个元素），实测插件宽松接受——记录实际行为
@testing:case="createFraTemplate fixingCalendars length mismatch (lenient validation, does not raise)"
result = caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS", "EXTRA"], "QUARTERLY", "ACT_360", "NO_DISCOUNT", "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true);
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// 用例目的：遍历参数 paymentDiscountMethod 的全部文档枚举取值，逐一调用验证均被接受
// 注：标签 `INVALID` 在本上下文中被插件拒绝，未纳入遍历（与文档标签集不一致，实测为准）
@testing:case="createFraTemplate supports all paymentDiscountMethod enums"
labelEnum = ["INVALID_PAYMENT_DISCOUNT_METHOD", "NO_DISCOUNT", "DISCOUNT_AT_FLOATING_RATE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createFraTemplate("TF_FRA", iborIndex[0], "CNY", "CAL_CFETS", ["CAL_CFETS"], "QUARTERLY", "ACT_360", labelEnum[i], "MODIFIED_FOLLOWING", 0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING", -1, true); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
