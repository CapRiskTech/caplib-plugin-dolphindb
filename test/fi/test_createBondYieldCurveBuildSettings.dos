// ============================================================================
// test_createBondYieldCurveBuildSettings.dos
// Per-function test suite for caplib::createBondYieldCurveBuildSettings (fi).
// Signature: caplib::createBondYieldCurveBuildSettings(curveName STRING, curveType STRING, interpMethod STRING, extrapMethod STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createBondYieldCurveBuildSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================


// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// ============================================================================
// Tests
// ============================================================================

@testing:case="createBondYieldCurveBuildSettings -> handle"
result = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false)
assert 1, result == "TF_FI_BBS"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createBondYieldCurveBuildSettings rejects missing argument", syntaxError=1
caplib::createBondYieldCurveBuildSettings("X", "X", "X", "X")

@testing:case="createBondYieldCurveBuildSettings rejects extra argument", syntaxError=1
caplib::createBondYieldCurveBuildSettings("X", "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false, 1)

@testing:case="createBondYieldCurveBuildSettings rejects wrong type for curveName", exception=1
caplib::createBondYieldCurveBuildSettings(1, "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects wrong type for curveType", exception=1
caplib::createBondYieldCurveBuildSettings("X", 1, "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects wrong type for interpMethod", exception=1
caplib::createBondYieldCurveBuildSettings("X", "X", 1, "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects null curveName", exception=1
caplib::createBondYieldCurveBuildSettings(string(), "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects null curveType", exception=1
caplib::createBondYieldCurveBuildSettings("X", string(), "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects vector for scalar curveName", exception=1
caplib::createBondYieldCurveBuildSettings(["X"], "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

@testing:case="createBondYieldCurveBuildSettings rejects keyword arguments", syntaxError=1
caplib::createBondYieldCurveBuildSettings(curveName="X", curveType="X", interpMethod="X", extrapMethod="X", tag="TF_createBondYieldCurveBuildSettings_H", returnJson=false)
@testing:case="createBondYieldCurveBuildSettings rejects invalid enum for curveType", exception=1
caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "NOT_A_VALID_ENUM_LABEL", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false)
@testing:case="createBondYieldCurveBuildSettings optional returnJson null uses default"
result = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", bool())
assert 1, typestr(result) != "VOID"
@testing:case="createBondYieldCurveBuildSettings supports all curveType enums"
labelEnum = ["ZERO_RATE", "LOG_DISCOUNT", "FORWARD_RATE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", labelEnum[i], "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
