rR3I6 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "CUBIC_POLYNOMIAL_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
