// ============================================================================
// test_createBondYieldCurveBuildSettings.dos
// Per-function test suite for caplib::createBondYieldCurveBuildSettings (fi).
// Signature: caplib::createBondYieldCurveBuildSettings(curveName STRING, curveType STRING, interpMethod STRING, extrapMethod STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/fi")            // whole domain directory
//     python run_tests.py --file fi/test_createBondYieldCurveBuildSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createBondYieldCurveBuildSettings -> handle"
result = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false)
assert 1, result == "TF_FI_BBS"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createBondYieldCurveBuildSettings rejects missing argument", syntaxError=1
caplib::createBondYieldCurveBuildSettings("X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createBondYieldCurveBuildSettings rejects extra argument", syntaxError=1
caplib::createBondYieldCurveBuildSettings("X", "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false, 1)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects wrong type for curveName", exception=1
caplib::createBondYieldCurveBuildSettings(1, "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：参数 curveType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects wrong type for curveType", exception=1
caplib::createBondYieldCurveBuildSettings("X", 1, "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：参数 interpMethod 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects wrong type for interpMethod", exception=1
caplib::createBondYieldCurveBuildSettings("X", "X", 1, "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：参数 curveName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects null curveName", exception=1
caplib::createBondYieldCurveBuildSettings(string(), "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：参数 curveType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects null curveType", exception=1
caplib::createBondYieldCurveBuildSettings("X", string(), "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：标量参数 curveName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects vector for scalar curveName", exception=1
caplib::createBondYieldCurveBuildSettings(["X"], "X", "X", "X", "TF_createBondYieldCurveBuildSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createBondYieldCurveBuildSettings rejects keyword arguments", syntaxError=1
caplib::createBondYieldCurveBuildSettings(curveName="X", curveType="X", interpMethod="X", extrapMethod="X", tag="TF_createBondYieldCurveBuildSettings_H", returnJson=false)
// 用例目的：枚举参数 curveType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects invalid enum for curveType", exception=1
caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "NOT_A_VALID_ENUM_LABEL", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createBondYieldCurveBuildSettings optional returnJson null uses default"
result = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：遍历参数 curveType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createBondYieldCurveBuildSettings supports all curveType enums"
labelEnum = ["ZERO_RATE", "LOG_DISCOUNT", "FORWARD_RATE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", labelEnum[i], "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
// 用例目的：可选参数 returnJson 传入非 BOOL（STRING）—— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createBondYieldCurveBuildSettings non-BOOL returnJson (no validation)"
rBYCS_rj = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS", "bad")
assert 1, typestr(rBYCS_rj) != "VOID"
// 用例目的：枚举参数 interpMethod 传入非法取值 —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createBondYieldCurveBuildSettings invalid enum for interpMethod (no validation)"
rBYCS_interp = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "NOT_A_VALID_INTERP_METHOD", "FLAT_EXTRAP", "TF_FI_BBS", false)
assert 1, typestr(rBYCS_interp) != "VOID"
// 用例目的：枚举参数 extrapMethod 传入非法取值 —— 实测插件不校验、宽松接受，记录实际行为
@testing:case="accepts createBondYieldCurveBuildSettings invalid enum for extrapMethod (no validation)"
rBYCS_extrap = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "NOT_A_VALID_EXTRAP_METHOD", "TF_FI_BBS", false)
assert 1, typestr(rBYCS_extrap) != "VOID"
// 用例目的：遍历 interpMethod 已确认被接受的合法取值子集，逐一调用验证均被接受
// 注：该用例仅覆盖 round-1 确认的子集；其余文档标签（SABR/SVI 等）在 round-3 已逐值单独覆盖（见文件末尾）
@testing:case="createBondYieldCurveBuildSettings supports accepted interpMethod subset"
interpLabels = ["LINEAR_INTERP", "CUBIC_SPLINE_INTERP", "LEFT_CONTINUOUS_FLAT_INTERP"]
okInterpBS = true;
for (i in 0..(size(interpLabels)-1)) {
    try { caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", interpLabels[i], "FLAT_EXTRAP", "TF_FI_BBS", false); } catch(ex) { okInterpBS = false; }
}
assert 1, okInterpBS
// 用例目的：遍历 extrapMethod 已确认被接受的合法取值子集，逐一调用验证均被接受（NATURAL_EXTRAP 已在 round-3 单独覆盖）
@testing:case="createBondYieldCurveBuildSettings supports accepted extrapMethod subset"
extrapLabelsBS = ["FLAT_EXTRAP", "LINEAR_EXTRAP", "ADJ_FLAT_EXTRAP"]
okExtrapBS = true;
for (i in 0..(size(extrapLabelsBS)-1)) {
    try { caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", extrapLabelsBS[i], "TF_FI_BBS", false); } catch(ex) { okExtrapBS = false; }
}
assert 1, okExtrapBS

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: tag 类型校验 / interpMethod / extrapMethod 文档取值逐值覆盖
// ----------------------------------------------------------------------------

// 用例目的：参数 tag 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createBondYieldCurveBuildSettings rejects wrong type for tag", exception=1
caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP", 123, false)

// 用例目的：interpMethod 传入文档取值 SABR_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod SABR_INTERP"
rR3I1 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "SABR_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
assert 1, typestr(rR3I1) != "VOID"

// 用例目的：interpMethod 传入文档取值 SVI_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod SVI_INTERP"
rR3I2 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "SVI_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
assert 1, typestr(rR3I2) != "VOID"

// 用例目的：interpMethod 传入文档取值 LOG_MONEYNESS_CUBIC_SPLINE_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod LOG_MONEYNESS_CUBIC_SPLINE_INTERP"
rR3I3 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LOG_MONEYNESS_CUBIC_SPLINE_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
assert 1, typestr(rR3I3) != "VOID"

// 用例目的：interpMethod 传入文档取值 SABR_NORMAL_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod SABR_NORMAL_INTERP"
rR3I4 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "SABR_NORMAL_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
assert 1, typestr(rR3I4) != "VOID"

// 用例目的：interpMethod 传入文档取值 QUADRATIC_POLYNOMIAL_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod QUADRATIC_POLYNOMIAL_INTERP"
rR3I5 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "QUADRATIC_POLYNOMIAL_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
