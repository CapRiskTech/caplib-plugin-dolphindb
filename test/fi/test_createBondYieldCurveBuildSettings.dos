// 用例目的：interpMethod 传入文档取值 CUBIC_HERMITE_SPLINE_INTERP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports interpMethod CUBIC_HERMITE_SPLINE_INTERP"
rR3I7 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "CUBIC_HERMITE_SPLINE_INTERP", "FLAT_EXTRAP", "TF_FI_BBS_R3", false)
assert 1, typestr(rR3I7) != "VOID"

// 用例目的：extrapMethod 传入文档取值 NATURAL_EXTRAP —— 实测创建构建设置时被接受，验证逐值行为
@testing:case="createBondYieldCurveBuildSettings supports extrapMethod NATURAL_EXTRAP"
rR3E1 = caplib::createBondYieldCurveBuildSettings("TF_FI_CURVE", "ZERO_RATE", "LINEAR_INTERP", "NATURAL_EXTRAP", "TF_FI_BBS_R3", false)
