// ============================================================================
// test_analytics.dos
// Common Analytics tests through native DolphinDB plugin APIs.
// Uses the native DolphinDB testing framework:
//     test("test_analytics.dos")
// ============================================================================

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

// --- Pricing model, PDE, Monte Carlo, and pricing settings ---
modelParams = [0.0];
bsmModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, modelParams, "AN_BSM_MODEL", false);

pdeSettings = caplib::createPdeSettings(
    101, 201, -5.0, 5.0, 0,
    11, 0.0, 10.0, 1,
    3, -4.0, 4.0, 0,
    0.1, 0.1, 1.0,
    2, 1, 1,
    3, 1, 1,
    "AN_PDE_SETTINGS", false);

mcSettings = caplib::createMonteCarloSettings(
    3000, 1, -1,
    2, 1,
    1, 101, "AN_MC_SETTINGS", false);

pricingSettings = caplib::createPricingSettings(
    "CNY", "ANALYTICAL", 0, 0,
    bsmModel, pdeSettings, mcSettings, "AN_PRICING_SETTINGS", false);

pricingSettingsDefaultReturn = caplib::createPricingSettings(
    "CNY", "ANALYTICAL", 0, 0,
    bsmModel, pdeSettings, mcSettings, "AN_PRICING_SETTINGS_DEFAULT");

modelFreePricingSettings = caplib::createModelFreePricingSettings(
    "CNY", 1, 0, "AN_MODEL_FREE_PRICING_SETTINGS", false);

// --- Risk settings ---
irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 2.0e-4, 50.0e-4,
    0, 1,
    2.0e-4, 1, "AN_IR_RISK", false);

creditCurveRisk = caplib::createCreditCurveRiskSettings(
    1, 1, 2.0e-4,
    0, 0,
    2.0e-4, 0, "AN_CR_RISK", false);

dividendCurveRisk = caplib::createDividendCurveRiskSettings(
    1, 1, 2.0e-4,
    0, 0,
    2.0e-4, 0, "AN_DIV_RISK", false);

priceRisk = caplib::createPriceRiskSettings(
    1, 1, 1, 0.01, 0.5,
    0, 0.01,
    0, "AN_PRICE_RISK", false);

volRisk = caplib::createVolRiskSettings(
    1, 1, 0.01,
    0, 0,
    0.01, 0, "AN_VOL_RISK", false);

priceVolRisk = caplib::createPriceVolRiskSettings(
    1, 0.01, 0.01,
    0, 0,
    0.01, 0.01, 0, "AN_PRICE_VOL_RISK", false);

thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "AN_THETA_RISK", false);

priceScn = caplib::createScnSettings(-0.1, 0.1, 5, 0, "AN_PRICE_SCN", false);
volScn = caplib::createScnSettings(-0.2, 0.2, 5, 0, "AN_VOL_SCN", false);
scnSettings = caplib::createScnAnalysisSettings(
    "PRICE_VOL_SCN_ANALYSIS", priceScn, volScn,
    1, "AN_SCN_SETTINGS", false);

// --- Curves ---
asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

assetYieldCurve = caplib::createAssetYieldCurve(
    asOfDate, curveDates, curveValues,
    "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED",
    "CONTINUOUS_COMPOUNDING", ["1D", "3Y"],
    "AN_ASSET_YIELD_CURVE", "AN_ASSET_YIELD_CURVE", false);

irCurve = caplib::createIrYieldCurve(
    asOfDate, curveDates, curveValues,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "DISCRETE_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "AN_IR_CURVE", false);

flatIrCurve = caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "AN_FLAT_IR_CURVE", false);

creditCurve = caplib::createCreditCurve(
    asOfDate, curveDates, [0.002, 0.0025],
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "AN_CREDIT_CURVE", "AN_CREDIT_CURVE", false);

flatCreditCurve = caplib::createFlatCreditCurve(asOfDate, 0.002, "AN_FLAT_CREDIT_CURVE", false);

dividendCurve = caplib::createDividendCurve(
    asOfDate, curveDates, [0.01, 0.01], asOfDate,
    "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "AN_DIVIDEND_CURVE", "AN_DIVIDEND_CURVE", false);

flatDividendCurve = caplib::createFlatDividendCurve(
    asOfDate, 0.01, "AN_FLAT_DIVIDEND_CURVE", "AN_FLAT_DIVIDEND_CURVE", false);

volCurve = caplib::createVolatilityCurve(
    asOfDate, curveDates, [0.20, 0.21],
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "AN_UNDERLYING", "AN_VOL_CURVE", false);

flatVolCurve = caplib::createFlatVolCurve(asOfDate, 0.20, "AN_UNDERLYING", "AN_FLAT_VOL_CURVE", false);

emptyDoubles = array(DOUBLE, 0);
volSmile1d = caplib::createVolatilitySmile(
    "STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21],
    "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0 / 365.0,
    emptyDoubles, emptyDoubles, 90.0, 110.0, "AN_VOL_SMILE_1D", false);

volSmile3y = caplib::createVolatilitySmile(
    "STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.23, 0.21, 0.22],
    "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 3.0,
    emptyDoubles, emptyDoubles, 90.0, 110.0, "AN_VOL_SMILE_3Y", false);

flatVolSurface = caplib::createFlatVolatilitySurface(
    asOfDate, 0.20, "AN_UNDERLYING", "AN_FLAT_VOL_SURFACE", true);

volSurfaceDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD", "FLAT_EXTRAP",
    "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE",
    90.0, 110.0, "AN_VOL_SURFACE_DEFINITION", true);

volSurface = caplib::createVolatilitySurface(
    volSurfaceDefinition[0], asOfDate, [volSmile1d, volSmile3y], curveDates,
    "AN_UNDERLYING", "AN_VOL_SURFACE", false);

quoteTermDates = [2022.06.09, 2022.09.09];
quotePayoffTypes = matrix(["CALL", "PUT"], ["CALL", "PUT"]);
quoteValues = matrix([10.5, 8.5], [11.0, 9.0]);
quoteStrikes = matrix([95.0, 95.0], [105.0, 105.0]);
optionQuoteMatrix = caplib::createOptionQuoteMatrix(
    "OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE",
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    [], quoteTermDates, quotePayoffTypes, quoteValues, quoteStrikes,
    "AN_UNDERLYING", "AN_OPTION_QUOTES", true);

proxyOptionQuoteMatrix = caplib::createProxyOptionQuoteMatrix(
    "AN_UNDERLYING", flatVolSurface[0], 100.0, 101.0, "AN_PROXY_OPTION_QUOTES", true);

// --- Curve queries and calculators ---
discountFactors = caplib::getDiscountFactor(flatIrCurve, curveDates);
zeroRates = caplib::getZeroRate(flatIrCurve, curveDates);
fwdRates = caplib::getFwdRate(flatIrCurve, curveDates, 0.25);
survivalProbabilities = caplib::getSurvivalProbability(flatCreditCurve, curveDates);
creditSpreads = caplib::getCreditSpread(flatCreditCurve, curveDates);
volatilities = caplib::getVolatility(flatVolSurface[0], curveDates, [95.0, 105.0]);

impliedVol = caplib::impliedVolCalculator(
    asOfDate, 100.0, flatIrCurve, flatDividendCurve, pricingSettings,
    5.0, "CALL", "EUROPEAN", 2022.09.09, 100.0);

irJson = caplib::getObjectCacheJson("IrYieldCurve", irCurve);
pricingJson = caplib::getObjectCacheJson("PricingSettings", pricingSettings);
volSmileJson = caplib::getObjectCacheJson("VolatilitySmile", volSmile1d);
assetYieldCurveJson = caplib::getObjectCacheJson("AssetYieldCurve", assetYieldCurve);

// ============================================================================
// Helper predicates
// ============================================================================

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isHandleJson(value, expectedHandle) {
    return strpos(typestr(value), "STRING VECTOR") >= 0 &&
        size(value) == 2 &&
        value[0] == expectedHandle &&
        strlen(value[1]) > 2;
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createPricingModelSettings -> handle"
assert 1, bsmModel == "AN_BSM_MODEL"

@testing:case="createPdeSettings -> handle"
assert 1, pdeSettings == "AN_PDE_SETTINGS"

@testing:case="createMonteCarloSettings -> handle"
assert 1, mcSettings == "AN_MC_SETTINGS"

@testing:case="createPricingSettings -> handle"
assert 1, pricingSettings == "AN_PRICING_SETTINGS"

@testing:case="createPricingSettings omitted returnJson -> handle"
assert 1, pricingSettingsDefaultReturn == "AN_PRICING_SETTINGS_DEFAULT"

@testing:case="createModelFreePricingSettings -> handle"
assert 1, modelFreePricingSettings == "AN_MODEL_FREE_PRICING_SETTINGS"

@testing:case="createIrCurveRiskSettings -> handle"
assert 1, irCurveRisk == "AN_IR_RISK"

@testing:case="createCreditCurveRiskSettings -> handle"
assert 1, creditCurveRisk == "AN_CR_RISK"

@testing:case="createDividendCurveRiskSettings -> handle"
assert 1, dividendCurveRisk == "AN_DIV_RISK"

@testing:case="createPriceRiskSettings -> handle"
assert 1, priceRisk == "AN_PRICE_RISK"

@testing:case="createVolRiskSettings -> handle"
assert 1, volRisk == "AN_VOL_RISK"

@testing:case="createPriceVolRiskSettings -> handle"
assert 1, priceVolRisk == "AN_PRICE_VOL_RISK"

@testing:case="createThetaRiskSettings -> handle"
assert 1, thetaRisk == "AN_THETA_RISK"

@testing:case="createScnAnalysisSettings -> handle"
assert 1, scnSettings == "AN_SCN_SETTINGS"

@testing:case="createAssetYieldCurve -> handle"
assert 1, assetYieldCurve == "AN_ASSET_YIELD_CURVE"

@testing:case="createIrYieldCurve -> handle"
assert 1, irCurve == "AN_IR_CURVE"

@testing:case="createFlatIrYieldCurve -> handle"
assert 1, flatIrCurve == "AN_FLAT_IR_CURVE"

@testing:case="createCreditCurve -> handle"
assert 1, creditCurve == "AN_CREDIT_CURVE"

@testing:case="createFlatCreditCurve -> handle"
assert 1, flatCreditCurve == "AN_FLAT_CREDIT_CURVE"

@testing:case="createDividendCurve -> handle"
assert 1, dividendCurve == "AN_DIVIDEND_CURVE"

@testing:case="createFlatDividendCurve -> handle"
assert 1, flatDividendCurve == "AN_FLAT_DIVIDEND_CURVE"

@testing:case="createVolatilityCurve -> handle"
assert 1, volCurve == "AN_VOL_CURVE"

@testing:case="createFlatVolCurve -> handle"
assert 1, flatVolCurve == "AN_FLAT_VOL_CURVE"

@testing:case="createVolatilitySmile 1D -> handle"
assert 1, volSmile1d == "AN_VOL_SMILE_1D"

@testing:case="createVolatilitySmile 3Y -> handle"
assert 1, volSmile3y == "AN_VOL_SMILE_3Y"

@testing:case="createFlatVolatilitySurface -> [handle, json]"
assert 1, isHandleJson(flatVolSurface, "AN_FLAT_VOL_SURFACE") &&
    hasJsonField(flatVolSurface[1], "vol_smiles")

@testing:case="createVolatilitySurfaceDefinition -> [handle, json]"
assert 1, isHandleJson(volSurfaceDefinition, "AN_VOL_SURFACE_DEFINITION") &&
    hasJsonField(volSurfaceDefinition[1], "vol_smile_type")

@testing:case="createVolatilitySurface from definition/smiles -> handle"
assert 1, volSurface == "AN_VOL_SURFACE"

@testing:case="createOptionQuoteMatrix -> [handle, json]"
assert 1, isHandleJson(optionQuoteMatrix, "AN_OPTION_QUOTES") &&
    hasJsonField(optionQuoteMatrix[1], "quote_smiles")

@testing:case="createProxyOptionQuoteMatrix -> [handle, json]"
assert 1, isHandleJson(proxyOptionQuoteMatrix, "AN_PROXY_OPTION_QUOTES")

@testing:case="getDiscountFactor -> vector + reference values"
assert 1, isDoubleVector(discountFactors)
assert 2, abs(discountFactors[0] - 0.9999452069806444) < 1.0e-9 &&
    abs(discountFactors[1] - 0.9416613321670505) < 1.0e-9

@testing:case="getZeroRate -> vector + reference values"
assert 1, isDoubleVector(zeroRates)
assert 2, abs(zeroRates[0] - 0.02) < 1.0e-9 && abs(zeroRates[1] - 0.02) < 1.0e-9

@testing:case="getFwdRate -> vector + reference values"
assert 1, isDoubleVector(fwdRates)
assert 2, abs(fwdRates[0] - 0.02) < 1.0e-9 && abs(fwdRates[1] - 0.02) < 1.0e-9

@testing:case="getSurvivalProbability -> vector + reference values"
assert 1, isDoubleVector(survivalProbabilities)
assert 2, abs(survivalProbabilities[0] - 0.9999945205629573) < 1.0e-9 &&
    abs(survivalProbabilities[1] - 0.9940070707660733) < 1.0e-9

@testing:case="getCreditSpread -> vector + reference values"
assert 1, isDoubleVector(creditSpreads)
assert 2, abs(creditSpreads[0] - 0.002) < 1.0e-9 && abs(creditSpreads[1] - 0.002) < 1.0e-9

@testing:case="getVolatility -> matrix + reference values"
assert 1, isMatrix(volatilities)
assert 2, abs(volatilities[0,0] - 0.2) < 1.0e-9 && abs(volatilities[0,1] - 0.2) < 1.0e-9 &&
    abs(volatilities[1,0] - 0.2) < 1.0e-9 && abs(volatilities[1,1] - 0.2) < 1.0e-9

@testing:case="impliedVolCalculator -> scalar"
assert 1, typestr(impliedVol) == "DOUBLE"

@testing:case="getObjectCacheJson IrYieldCurve -> [handle, json]"
assert 1, isHandleJson(irJson, irCurve) && hasJsonField(irJson[1], "currency")

@testing:case="getObjectCacheJson PricingSettings -> [handle, json]"
assert 1, isHandleJson(pricingJson, pricingSettings) && hasJsonField(pricingJson[1], "pricing_method")

@testing:case="getObjectCacheJson VolatilitySmile -> [handle, json]"
assert 1, isHandleJson(volSmileJson, volSmile1d) && hasJsonField(volSmileJson[1], "vol_smile_type")

@testing:case="getObjectCacheJson AssetYieldCurve -> [handle, json]"
assert 1, isHandleJson(assetYieldCurveJson, assetYieldCurve) &&
    hasJsonField(assetYieldCurveJson[1], "compounding_type")

// ============================================================================
// Negative / exception validation
// ============================================================================

@testing:case="createPricingModelSettings rejects invalid model type enum", exception=1
caplib::createPricingModelSettings("NOT_A_MODEL", "", 0, [0.0], "AN_BAD_MODEL", false)

@testing:case="createPricingModelSettings rejects STRING modelParams", exception=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, ["x"], "AN_BAD_MODEL_2", false)

@testing:case="createPricingModelSettings rejects missing argument", syntaxError=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON")



@testing:case="createPricingSettings rejects invalid pricing method enum", exception=1
caplib::createPricingSettings("CNY", "NOT_A_METHOD", 0, 0, bsmModel, pdeSettings, mcSettings, "AN_BAD_PRICING", false)


@testing:case="createVolatilitySmile rejects strikes/vols length mismatch", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0/365.0, emptyDoubles, emptyDoubles, 90.0, 110.0, "AN_BAD_SMILE_1", false)


@testing:case="createVolatilitySurface rejects termDates/volSmileHandles length mismatch", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition[0], asOfDate, [volSmile1d], curveDates, "AN_UNDERLYING", "AN_BAD_SURF_1", false)

@testing:case="createVolatilitySurface rejects wrong smile handle", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition[0], asOfDate, [irCurve], curveDates, "AN_UNDERLYING", "AN_BAD_SURF_2", false)

@testing:case="createAssetYieldCurve rejects dates/values length mismatch", exception=1
caplib::createAssetYieldCurve(asOfDate, curveDates, [0.02], "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1D", "3Y"], "AN_BAD_AYC_1", "AN_BAD_AYC_1", false)

@testing:case="createVolatilityCurve rejects STRING pillarDates", exception=1
caplib::createVolatilityCurve(asOfDate, ["2022-03-10", "2025-03-10"], [0.20, 0.21], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "AN_UNDERLYING", "AN_BAD_VC", false)

@testing:case="createPricingSettings rejects missing argument", syntaxError=1
caplib::createPricingSettings("CNY", "ANALYTICAL")

@testing:case="createFlatVolCurve keyword arguments unsupported", syntaxError=1
caplib::createFlatVolCurve(referenceDate=asOfDate, volatility=0.20, underlying="AN_UNDERLYING", handle="AN_BAD_KW")


// ============================================================================
