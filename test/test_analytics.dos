caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "NOT_A_DCC", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "X", "AN_BAD_IR_DCC", false)

@testing:case="createIrYieldCurve rejects invalid compounding enum", exception=1
caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "NOT_A_COMPOUNDING", "CNY", "X", "AN_BAD_IR_CMP", false)

@testing:case="createIrYieldCurve rejects invalid extrap enum", exception=1
caplib::createIrYieldCurve(asOfDate, curveDates, curveValues, "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "NOT_AN_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "X", "AN_BAD_IR_XTR", false)

@testing:case="createCreditCurve rejects scalar spreads", exception=1
