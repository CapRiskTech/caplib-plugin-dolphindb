caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [0.0], "AN_EXTRA_MODEL", false, 1)

@testing:case="createPricingSettings rejects extra argument", syntaxError=1
caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, bsmModel, pdeSettings, mcSettings, "AN_EXTRA_PRICING", false, 1)


