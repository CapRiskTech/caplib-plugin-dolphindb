@testing:case="createScnAnalysisSettings rejects STRING method", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", 1, 2, "1", "AN_BAD_SCN_METHOD", false)


// --- Scalar/vector form validation ---
@testing:case="createDividendCurve rejects scalar pillarValues", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.02], 0.01, 2024.01.01, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "AN_BAD_DIV_F", "AN_BAD_DIV_F", false)

@testing:case="createVolatilityCurve rejects scalar vols", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.02], 0.20, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "AN_UNDERLYING", "AN_BAD_VC_F", false)

@testing:case="createAssetYieldCurve rejects scalar pillarValues", exception=1
caplib::createAssetYieldCurve(2024.01.01, [2024.01.02], 0.02, "LINEAR_INTERP", "FLAT_EXTRAP", "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", ["1Y"], "AN_BAD_AYC_F", "AN_BAD_AYC_F", false)

@testing:case="createVolatilitySmile rejects scalar strikes", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", 2024.01.01, 100.0, [0.20], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, emptyDoubles, emptyDoubles, 90.0, 110.0, "AN_BAD_SMILE_F", false)

@testing:case="createIrYieldCurve rejects vector referenceDate", exception=1
caplib::createIrYieldCurve([2024.01.01, 2024.01.02], [2024.01.03], [0.02], "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "AN_BAD_IR_F", "AN_BAD_IR_F", false)

@testing:case="createPricingSettings rejects vector currency", exception=1
caplib::createPricingSettings(["CNY", "USD"], "ANALYTICAL", 1, 1, "", "", "", "AN_BAD_PRC_F", false)

@testing:case="createScnSettings rejects vector lower", exception=1
caplib::createScnSettings([-0.1, -0.2], 0.1, 5, 0, "AN_BAD_SCN_F", false)
