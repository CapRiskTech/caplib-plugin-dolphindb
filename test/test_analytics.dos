@testing:case="createScnAnalysisSettings rejects missing priceScn argument", syntaxError=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", volScn, 1)

@testing:case="createPdeSettings rejects missing argument", syntaxError=1
