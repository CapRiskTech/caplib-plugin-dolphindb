caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], quoteTermDates, matrix(STRING, 0, 2), matrix(DOUBLE, 0, 2), matrix(DOUBLE, 0, 2), "AN_UNDERLYING", "AN_BAD_QQ_2", false)


