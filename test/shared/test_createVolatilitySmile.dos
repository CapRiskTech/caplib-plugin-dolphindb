// ============================================================================
// test_createVolatilitySmile.dos
// Per-function test suite for caplib::createVolatilitySmile (shared).
// Signature: caplib::createVolatilitySmile(volSmileType STRING, referenceDate DATE, strikes DOUBLE[], vols DOUBLE[], smileMethod STRING, extrapMethod STRING, term DOUBLE, modelParams DOUBLE[], auxiliaryParams DOUBLE[], lower DOUBLE, upper DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySmile.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolatilitySmile -> handle"
result = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)
assert 1, result == "TF_SMILE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySmile rejects missing argument", syntaxError=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02)

@testing:case="createVolatilitySmile rejects extra argument", syntaxError=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false, 1)

@testing:case="createVolatilitySmile rejects wrong type for volSmileType", exception=1
caplib::createVolatilitySmile(1, 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects wrong type for referenceDate", exception=1
caplib::createVolatilitySmile("X", "bad", [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects wrong type for smileMethod", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], 1, "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects null volSmileType", exception=1
caplib::createVolatilitySmile(string(), 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects null referenceDate", exception=1
caplib::createVolatilitySmile("X", date(), [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects vector for scalar volSmileType", exception=1
caplib::createVolatilitySmile(["X"], 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects scalar for vector strikes", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects partially-null vector strikes", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02, double()], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects empty vector strikes", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, take(double, 0), [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

@testing:case="createVolatilitySmile rejects keyword arguments", syntaxError=1
caplib::createVolatilitySmile(volSmileType="X", referenceDate=2024.01.01, strikes=[0.02], vols=[0.02], smileMethod="X", extrapMethod="X", term=0.02, modelParams=[0.02], auxiliaryParams=[0.02], lower=0.02, upper=0.02, handle="TF_createVolatilitySmile_H", returnJson=false)



// ----------------------------------------------------------------------------
// Review wave-1 additions (wiki test-case review)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySmile accepts all-null vector strikes (lenient validation, does not raise)"
result = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [double(), double(), double()], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)
assert 1, typestr(result) != "VOID"


@testing:case="createVolatilitySmile rejects invalid enum for extrapMethod", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "NOT_A_VALID_ENUM_LABEL", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)

