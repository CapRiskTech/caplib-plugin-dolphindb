// ============================================================================
// test_createVolatilitySmile.dos
// Per-function test suite for caplib::createVolatilitySmile (shared).
// Signature: caplib::createVolatilitySmile(volSmileType STRING, asOfDate DATE, strikes DOUBLE[], vols DOUBLE[], smileMethod STRING, extrapMethod STRING, term DOUBLE, modelParams DOUBLE[], auxiliaryParams DOUBLE[], lower DOUBLE, upper DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySmile.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2022.03.09;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createVolatilitySmile -> handle"
result = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)
assert 1, result == "TF_SMILE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createVolatilitySmile rejects missing argument", syntaxError=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createVolatilitySmile rejects extra argument", syntaxError=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false, 1)

// 用例目的：参数 volSmileType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects wrong type for volSmileType", exception=1
caplib::createVolatilitySmile(1, 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects wrong type for asOfDate", exception=1
caplib::createVolatilitySmile("X", "bad", [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：参数 smileMethod 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects wrong type for smileMethod", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02], [0.02], 1, "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：参数 volSmileType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects null volSmileType", exception=1
caplib::createVolatilitySmile(string(), 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects null asOfDate", exception=1
caplib::createVolatilitySmile("X", date(), [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：标量参数 volSmileType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects vector for scalar volSmileType", exception=1
caplib::createVolatilitySmile(["X"], 2024.01.01, [0.02], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：向量参数 strikes 传入标量，验证数据形式校验（预期：抛异常）。
// 其余参数沿用正例调用的合法值，实测异常命中 [PLUGIN::CAPLIB] Parameter strikes must be a vector。
@testing:case="createVolatilitySmile rejects scalar for vector strikes", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, 0.02, [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)

// 用例目的：向量参数 strikes 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects partially-null vector strikes", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, [0.02, double()], [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：向量参数 strikes 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects empty vector strikes", exception=1
caplib::createVolatilitySmile("X", 2024.01.01, take(double, 0), [0.02], "X", "X", 0.02, [0.02], [0.02], 0.02, 0.02, "TF_createVolatilitySmile_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createVolatilitySmile rejects keyword arguments", syntaxError=1
caplib::createVolatilitySmile(volSmileType="X", asOfDate=2024.01.01, strikes=[0.02], vols=[0.02], smileMethod="X", extrapMethod="X", term=0.02, modelParams=[0.02], auxiliaryParams=[0.02], lower=0.02, upper=0.02, handle="TF_createVolatilitySmile_H", returnJson=false)
// 用例目的：向量参数 strikes 传入全部空值的向量，实测插件抛异常（预期：抛异常）
@testing:case="createVolatilitySmile rejects all-null vector strikes", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [double(), double(), double()], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)

// 用例目的：枚举参数 extrapMethod 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects invalid enum for extrapMethod", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "NOT_A_VALID_ENUM_LABEL", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createVolatilitySmile optional returnJson null uses default"
result = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入非 BOOL 标量，验证类型校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects non-BOOL returnJson", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", 1)
// 用例目的：遍历参数 volSmileType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createVolatilitySmile supports all volSmileType enums"
labelEnum = ["STRIKE", "STRIKE_VOL_SMILE", "DELTA", "DELTA_VOL_SMILE", "LOG_STRIKE", "LOG_STRIKE_VOL_SMILE"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createVolatilitySmile(labelEnum[i], asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum

// 用例目的：参数 term 传入 0，验证正数边界校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects zero term", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 0.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)

// 用例目的：参数 term 传入负值，验证正数边界校验（预期：抛异常）
@testing:case="createVolatilitySmile rejects negative term", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", -1.0, array(DOUBLE,0), array(DOUBLE,0), 90.0, 110.0, "TF_SMILE", false)

