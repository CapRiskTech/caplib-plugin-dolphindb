// ============================================================================
// test_createVolatilitySmile.dos
// Per-function test suite for caplib::createVolatilitySmile (shared).
// Signature: caplib::createVolatilitySmile(volSmileType STRING, referenceDate DATE, strikes DOUBLE[], vols DOUBLE[], smileMethod STRING, extrapMethod STRING, term DOUBLE, modelParams DOUBLE[], auxiliaryParams DOUBLE[], lower DOUBLE, upper DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySmile.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolatilitySmile valid call"
result = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_VOL_SMILE", false)
assert 1, result == "TF_VOL_SMILE"

@testing:case="createVolatilitySmile rejects lower > upper", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 110.0], [0.2, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 110.0, 90.0, "TF_SMILE_BAD")

@testing:case="createVolatilitySmile rejects strikes/vols length mismatch", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 110.0], [0.2], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_SMILE_BAD")

@testing:case="createVolatilitySmile supports boundary strike lengths"
for (n in [1, 1024, 65536]) {
    if (n == 1) { strikesN = [100.0]; }
    else { strikesN = 90.0 + 0..(n - 1) * (20.0 / (n - 1)); }
    volsN = take(0.20, n);
    handleN = "TF_SMILE_SIZE_" + string(n);
    resultN = caplib::createVolatilitySmile(
        "STRIKE_VOL_SMILE", asOfDate, strikesN, volsN,
        "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0,
        array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0,
        handleN, false);
    assert 1, resultN == handleN
}

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySmile rejects missing argument", syntaxError=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0)

@testing:case="createVolatilitySmile rejects extra argument", syntaxError=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_VOL_SMILE", false, 1)

@testing:case="createVolatilitySmile rejects wrong type for volSmileType", exception=1
caplib::createVolatilitySmile(1, asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_VOL_SMILE", false)

@testing:case="createVolatilitySmile rejects wrong type for referenceDate", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", "bad", [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_VOL_SMILE", false)

@testing:case="createVolatilitySmile rejects wrong type for smileMethod", exception=1
caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], 1, "FLAT_EXTRAP", 1.0, array(DOUBLE, 0), array(DOUBLE, 0), 90.0, 110.0, "TF_VOL_SMILE", false)
