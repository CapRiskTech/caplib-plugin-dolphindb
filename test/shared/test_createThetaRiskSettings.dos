// ============================================================================
// test_createThetaRiskSettings.dos
// Per-function test suite for caplib::createThetaRiskSettings (shared).
// Signature: caplib::createThetaRiskSettings(theta BOOL, shift INT, scaling DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createThetaRiskSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================


// ============================================================================
// Tests
// ============================================================================

@testing:case="createThetaRiskSettings valid call"
result = caplib::createThetaRiskSettings(false, 1, 0.02, "TF_createThetaRiskSettings_H", false)
assert 1, result == "TF_createThetaRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createThetaRiskSettings rejects missing argument", syntaxError=1
caplib::createThetaRiskSettings(false, 1, 0.02)

@testing:case="createThetaRiskSettings rejects extra argument", syntaxError=1
caplib::createThetaRiskSettings(false, 1, 0.02, "TF_createThetaRiskSettings_H", false, 1)

@testing:case="createThetaRiskSettings rejects wrong type for shift", exception=1
caplib::createThetaRiskSettings(false, "1", 0.02, "TF_createThetaRiskSettings_H", false)

@testing:case="createThetaRiskSettings rejects wrong type for scaling", exception=1
caplib::createThetaRiskSettings(false, 1, "bad", "TF_createThetaRiskSettings_H", false)

@testing:case="createThetaRiskSettings rejects null shift", exception=1
caplib::createThetaRiskSettings(false, int(), 0.02, "TF_createThetaRiskSettings_H", false)

@testing:case="createThetaRiskSettings rejects vector for scalar shift", exception=1
caplib::createThetaRiskSettings(false, [1], 0.02, "TF_createThetaRiskSettings_H", false)

@testing:case="createThetaRiskSettings rejects keyword arguments", syntaxError=1
caplib::createThetaRiskSettings(theta=false, shift=1, scaling=0.02, handle="TF_createThetaRiskSettings_H", returnJson=false)
@testing:case="createThetaRiskSettings optional returnJson null uses default"
result = caplib::createThetaRiskSettings(false, 1, 0.02, "TF_createThetaRiskSettings_H", bool())
assert 1, typestr(result) != "VOID"
@testing:case="createThetaRiskSettings rejects zero scaling (lenient validation, does not raise)"
result = caplib::createThetaRiskSettings(false, 1, 0.0, "TF_createThetaRiskSettings_H", false)
assert 1, typestr(result) != "VOID"


@testing:case="createThetaRiskSettings rejects negative scaling (lenient validation, does not raise)"
result = caplib::createThetaRiskSettings(false, 1, -1.0, "TF_createThetaRiskSettings_H", false)
assert 1, typestr(result) != "VOID"

