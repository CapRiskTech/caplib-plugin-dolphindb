// ============================================================================
// test_createThetaRiskSettings.dos
// Per-function test suite for caplib::createThetaRiskSettings (shared).
// Signature: caplib::createThetaRiskSettings(theta BOOL, shift INT, scaling DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createThetaRiskSettings.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createThetaRiskSettings valid call"
result = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_THETA_RISK", false)
assert 1, result == "TF_THETA_RISK"

@testing:case="createThetaRiskSettings rejects STRING shift", exception=1
caplib::createThetaRiskSettings(1, "1", 1.0 / 365.0, "TF_THETA_BAD")

@testing:case="createThetaRiskSettings permits negative shift"
r = caplib::createThetaRiskSettings(true, -1, 1.0 / 365.0, "TF_THETA_NEG");
assert 1, r == "TF_THETA_NEG"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createThetaRiskSettings rejects missing argument", syntaxError=1
caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0)

@testing:case="createThetaRiskSettings rejects extra argument", syntaxError=1
caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "TF_THETA_RISK", false, 1)

@testing:case="createThetaRiskSettings rejects wrong type for shift", exception=1
caplib::createThetaRiskSettings(1, "1", 1.0 / 365.0, "TF_THETA_RISK", false)

@testing:case="createThetaRiskSettings rejects wrong type for scaling", exception=1
caplib::createThetaRiskSettings(1, 1, "bad", "TF_THETA_RISK", false)

@testing:case="createThetaRiskSettings rejects null shift", exception=1
caplib::createThetaRiskSettings(1, int(), 1.0 / 365.0, "TF_THETA_RISK", false)

@testing:case="createThetaRiskSettings rejects vector for scalar shift", exception=1
caplib::createThetaRiskSettings(1, [1], 1.0 / 365.0, "TF_THETA_RISK", false)
