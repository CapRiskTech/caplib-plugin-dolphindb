// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createMonteCarloSettings valid call"
result = caplib::createMonteCarloSettings(3000, 1, -1, 2, 1, 1, 101, "TF_MC_SETTINGS", false)
assert 1, result == "TF_MC_SETTINGS"

@testing:case="createMonteCarloSettings rejects STRING numSimulations", exception=1
caplib::createMonteCarloSettings("3000", 1, -1, 2, 1, 1, 101, "TF_MC_BAD")

@testing:case="createMonteCarloSettings rejects zero numSimulations", exception=1
caplib::createMonteCarloSettings(0, 1, -1, 2, 1, 1, 101, "TF_MC_BAD")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createMonteCarloSettings rejects missing argument", syntaxError=1
caplib::createMonteCarloSettings(3000, 1, -1, 2, 1, 1, 101)

@testing:case="createMonteCarloSettings rejects extra argument", syntaxError=1
caplib::createMonteCarloSettings(3000, 1, -1, 2, 1, 1, 101, "TF_MC_SETTINGS", false, 1)

@testing:case="createMonteCarloSettings rejects wrong type for numSimulations", exception=1
caplib::createMonteCarloSettings("1", 1, -1, 2, 1, 1, 101, "TF_MC_SETTINGS", false)
