// test_createMonteCarloSettings.dos
// Per-function test suite for caplib::createMonteCarloSettings (shared).
// Signature: caplib::createMonteCarloSettings(numSimulations INT, uniformNumberType INT, seed INT, wienerBuildMethod INT, gaussianMethod INT, useAntithetic BOOL, numSteps INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createMonteCarloSettings.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
