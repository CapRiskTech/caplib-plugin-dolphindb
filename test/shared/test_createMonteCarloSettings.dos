// ============================================================================
// test_createMonteCarloSettings.dos
// Per-function test suite for caplib::createMonteCarloSettings (shared).
// Signature: caplib::createMonteCarloSettings(numSimulations INT, uniformNumberType INT, seed INT, wienerBuildMethod INT, gaussianMethod INT, useAntithetic BOOL, numSteps INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createMonteCarloSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createMonteCarloSettings valid call"
result = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)
assert 1, result == "TF_createMonteCarloSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createMonteCarloSettings rejects missing argument", syntaxError=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createMonteCarloSettings rejects extra argument", syntaxError=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false, 1)

// 用例目的：参数 numSimulations 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for numSimulations", exception=1
caplib::createMonteCarloSettings("1", 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 uniformNumberType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, "1", 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 seed 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for seed", exception=1
caplib::createMonteCarloSettings(1, 1, "1", 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 numSimulations 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects null numSimulations", exception=1
caplib::createMonteCarloSettings(int(), 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 uniformNumberType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects null uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, int(), 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：标量参数 numSimulations 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects vector for scalar numSimulations", exception=1
caplib::createMonteCarloSettings([1], 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createMonteCarloSettings rejects keyword arguments", syntaxError=1
caplib::createMonteCarloSettings(numSimulations=1, uniformNumberType=1, seed=1, wienerBuildMethod=1, gaussianMethod=1, useAntithetic=false, numSteps=1, handle="TF_createMonteCarloSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createMonteCarloSettings optional returnJson null uses default"
result = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 seed 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects negative seed", exception=1
caplib::createMonteCarloSettings(1, 1, -1.0, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

