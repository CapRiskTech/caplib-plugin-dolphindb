// ============================================================================
// test_createMonteCarloSettings.dos
// Per-function test suite for caplib::createMonteCarloSettings (shared).
// Signature: caplib::createMonteCarloSettings(numSimulations INT, uniformNumberType INT, seed INT, wienerBuildMethod INT, gaussianMethod INT, useAntithetic BOOL, numSteps INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createMonteCarloSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createMonteCarloSettings valid call"
result = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)
assert 1, result == "TF_createMonteCarloSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createMonteCarloSettings rejects missing argument", syntaxError=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createMonteCarloSettings rejects extra argument", syntaxError=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false, 1)

// 用例目的：参数 numSimulations 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for numSimulations", exception=1
caplib::createMonteCarloSettings("1", 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 uniformNumberType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, "1", 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 seed 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects wrong type for seed", exception=1
caplib::createMonteCarloSettings(1, 1, "1", 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 numSimulations 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects null numSimulations", exception=1
caplib::createMonteCarloSettings(int(), 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 uniformNumberType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects null uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, int(), 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：标量参数 numSimulations 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects vector for scalar numSimulations", exception=1
caplib::createMonteCarloSettings([1], 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createMonteCarloSettings rejects keyword arguments", syntaxError=1
caplib::createMonteCarloSettings(numSimulations=1, uniformNumberType=1, seed=1, wienerBuildMethod=1, gaussianMethod=1, useAntithetic=false, numSteps=1, handle="TF_createMonteCarloSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createMonteCarloSettings optional returnJson null uses default"
result = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入非 BOOL 标量，验证类型校验（预期：抛异常）
@testing:case="createMonteCarloSettings rejects non-BOOL returnJson", exception=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", 1)
// 用例目的：seed 传入负 INT，实测包装器不校验非负范围，记录接受行为
@testing:case="createMonteCarloSettings accepts negative seed (no range validation)"
negativeSeedResult = caplib::createMonteCarloSettings(1, 1, -1, 1, 1, false, 1, "TF_MC_NEG_SEED", false)
assert 1, negativeSeedResult == "TF_MC_NEG_SEED"

// 用例目的：参数 uniformNumberType 传入越界枚举值 999，验证枚举范围校验（预期：抛异常，防 enum 强转 UB）
@testing:case="createMonteCarloSettings rejects out-of-range uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, 999, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 wienerBuildMethod 传入越界枚举值 999，验证枚举范围校验（预期：抛异常，防 enum 强转 UB）
@testing:case="createMonteCarloSettings rejects out-of-range wienerBuildMethod", exception=1
caplib::createMonteCarloSettings(1, 1, 1, 999, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 gaussianMethod 传入越界枚举值 999，验证枚举范围校验（预期：抛异常，防 enum 强转 UB）
@testing:case="createMonteCarloSettings rejects out-of-range gaussianMethod", exception=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 999, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：参数 handle 传入整数 123 —— 实测插件未对该参数做 STRING 判型，宽松接受不抛异常，记录实际行为
@testing:case="createMonteCarloSettings accepts INT handle (no strict type check)"
rMCS_h = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, 123, false)
assert 1, typestr(rMCS_h) != "VOID"

// 用例目的：numSimulations 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL numSimulations", exception=1
caplib::createMonteCarloSettings(true, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：uniformNumberType 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL uniformNumberType", exception=1
caplib::createMonteCarloSettings(1, true, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：seed 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL seed", exception=1
caplib::createMonteCarloSettings(1, 1, true, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：wienerBuildMethod 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL wienerBuildMethod", exception=1
caplib::createMonteCarloSettings(1, 1, 1, true, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：gaussianMethod 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL gaussianMethod", exception=1
caplib::createMonteCarloSettings(1, 1, 1, 1, true, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：numSteps 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createMonteCarloSettings rejects BOOL numSteps", exception=1
caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, true, "TF_createMonteCarloSettings_H", false)

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: numSimulations / numSteps zero & negative boundary behavior
// ----------------------------------------------------------------------------

// 用例目的：numSimulations 传 0 —— 文档要求严格为正，实测插件抛异常（预期：抛异常）
@testing:case="createMonteCarloSettings rejects zero numSimulations", exception=1
caplib::createMonteCarloSettings(0, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：numSimulations 传负值 -1 —— 文档要求严格为正，实测插件抛异常（预期：抛异常）
@testing:case="createMonteCarloSettings rejects negative numSimulations", exception=1
caplib::createMonteCarloSettings(-1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", false)

// 用例目的：numSteps 传 0 —— 文档要求严格为正但包装器通常仅检查类型，实测宽松接受，记录实际行为
@testing:case="createMonteCarloSettings accepts zero numSteps (no range validation)"
rMCS_zs = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 0, "TF_createMonteCarloSettings_H", false)
assert 1, typestr(rMCS_zs) != "VOID"

// 用例目的：numSteps 传负值 -1 —— 文档要求严格为正但包装器通常仅检查类型，实测宽松接受，记录实际行为
@testing:case="createMonteCarloSettings accepts negative numSteps (no range validation)"
rMCS_ns = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, -1, "TF_createMonteCarloSettings_H", false)
assert 1, typestr(rMCS_ns) != "VOID"

