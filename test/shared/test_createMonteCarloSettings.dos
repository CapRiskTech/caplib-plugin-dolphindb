@testing:case="createMonteCarloSettings optional returnJson null uses default"
result = caplib::createMonteCarloSettings(1, 1, 1, 1, 1, false, 1, "TF_createMonteCarloSettings_H", bool())
assert 1, typestr(result) != "VOID"
