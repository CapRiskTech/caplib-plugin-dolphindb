// ============================================================================
// test_createVolRiskSettings.dos
// Per-function test suite for caplib::createVolRiskSettings (shared).
// Signature: caplib::createVolRiskSettings(vega BOOL, volga BOOL, shift DOUBLE, method INT, granularity INT, scaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolRiskSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================


// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolRiskSettings valid call"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)
assert 1, result == "TF_createVolRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolRiskSettings rejects missing argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1)

@testing:case="createVolRiskSettings rejects extra argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false, 1)

@testing:case="createVolRiskSettings rejects wrong type for shift", exception=1
caplib::createVolRiskSettings(false, false, "bad", 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects wrong type for method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, "1", 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects wrong type for granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, "1", 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects null method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, int(), 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects null granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, int(), 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects keyword arguments", syntaxError=1
caplib::createVolRiskSettings(vega=false, volga=false, shift=0.02, method=1, granularity=1, scaling=0.02, threading=1, handle="TF_createVolRiskSettings_H", returnJson=false)
@testing:case="createVolRiskSettings optional returnJson null uses default"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", bool())
assert 1, typestr(result) != "VOID"
@testing:case="createVolRiskSettings rejects zero scaling (lenient validation, does not raise)"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.0, 1, "TF_createVolRiskSettings_H", false)
assert 1, typestr(result) != "VOID"


@testing:case="createVolRiskSettings rejects negative scaling (lenient validation, does not raise)"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, -1.0, 1, "TF_createVolRiskSettings_H", false)
assert 1, typestr(result) != "VOID"

