// ============================================================================
// test_createVolRiskSettings.dos
// Per-function test suite for caplib::createVolRiskSettings (shared).
// Signature: caplib::createVolRiskSettings(vega BOOL, volga BOOL, shift DOUBLE, method INT, granularity INT, scaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolRiskSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createVolRiskSettings valid call"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)
assert 1, result == "TF_createVolRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createVolRiskSettings rejects missing argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createVolRiskSettings rejects extra argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false, 1)

// 用例目的：参数 shift 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects wrong type for shift", exception=1
caplib::createVolRiskSettings(false, false, "bad", 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 method 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects wrong type for method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, "1", 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 granularity 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects wrong type for granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, "1", 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 method 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects null method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, int(), 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 granularity 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects null granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, int(), 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createVolRiskSettings rejects keyword arguments", syntaxError=1
caplib::createVolRiskSettings(vega=false, volga=false, shift=0.02, method=1, granularity=1, scaling=0.02, threading=1, handle="TF_createVolRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createVolRiskSettings optional returnJson null uses default"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入非 BOOL 标量，验证类型校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects non-BOOL returnJson", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", 1)
// 用例目的：参数 scaling 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects zero scaling", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.0, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 scaling 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects negative scaling", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, -1.0, 1, "TF_createVolRiskSettings_H", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 vega 传入单元素向量，实测插件宽松接受——记录实际行为
@testing:case="createVolRiskSettings vector for scalar vega", exception=1
caplib::createVolRiskSettings([true], false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false);

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle / BOOL / flags coverage
// ----------------------------------------------------------------------------

// 用例目的：参数 handle 传入整数 123 —— 实测插件未对该参数做 STRING 判型，宽松接受并把 123 当作句柄 "123" 返回，记录实际行为
@testing:case="createVolRiskSettings accepts INT handle (no strict type check)"
rVR_h = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, 123, false)
assert 1, typestr(rVR_h) != "VOID" && rVR_h == "123"

// 用例目的：method 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createVolRiskSettings rejects BOOL method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, true, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：granularity 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createVolRiskSettings rejects BOOL granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, true, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：threading 传 BOOL 值 —— 实测插件未对该参数做 INT 判型，true 被当作 1（多线程）宽松接受，记录实际行为
@testing:case="createVolRiskSettings accepts BOOL threading (no strict type check)"
rVR_t = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, true, "TF_createVolRiskSettings_H", false)
assert 1, typestr(rVR_t) != "VOID"

// 用例目的：method/granularity/threading 全取 0，验证零值合法且返回句柄
@testing:case="createVolRiskSettings accepts zero flags returns handle"
resZero = caplib::createVolRiskSettings(false, false, 0.02, 0, 0, 0.02, 0, "TF_VOL_RISK_ZERO", false)
assert 1, typestr(resZero) != "VOID" && resZero == "TF_VOL_RISK_ZERO"

// 用例目的：三个选择器传非零 INT 2（文档映射 ONE_SIDE_UP/TERM_STRIKE/多线程），验证不抛异常并返回句柄
@testing:case="createVolRiskSettings accepts nonzero INT flags"
resTwo = caplib::createVolRiskSettings(false, false, 0.02, 2, 2, 0.02, 2, "TF_VOL_RISK_TWO", false)
assert 1, typestr(resTwo) != "VOID" && resTwo == "TF_VOL_RISK_TWO"

// 用例目的：三个选择器传负非零 INT -1，验证不抛异常并返回句柄
@testing:case="createVolRiskSettings accepts negative nonzero INT flags"
resNeg = caplib::createVolRiskSettings(false, false, 0.02, -1, -1, 0.02, -1, "TF_VOL_RISK_NEG", false)
assert 1, typestr(resNeg) != "VOID" && resNeg == "TF_VOL_RISK_NEG"

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: volga independent negative validation
// ----------------------------------------------------------------------------

// 用例目的：参数 volga 传入错误类型（字符串），验证类型校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects wrong type for volga", exception=1
caplib::createVolRiskSettings(false, "bad", 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：参数 volga 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects null volga", exception=1
caplib::createVolRiskSettings(false, bool(), 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

// 用例目的：标量参数 volga 传入单元素向量，验证数据形式校验（预期：抛异常）
@testing:case="createVolRiskSettings rejects vector for scalar volga", exception=1
caplib::createVolRiskSettings(false, [true], 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)
