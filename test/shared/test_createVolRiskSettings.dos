// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolRiskSettings valid call"
result = caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)
assert 1, result == "TF_createVolRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolRiskSettings rejects missing argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1)

@testing:case="createVolRiskSettings rejects extra argument", syntaxError=1
caplib::createVolRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false, 1)

@testing:case="createVolRiskSettings rejects wrong type for shift", exception=1
caplib::createVolRiskSettings(false, false, "bad", 1, 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects wrong type for method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, "1", 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects wrong type for granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, "1", 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects null method", exception=1
caplib::createVolRiskSettings(false, false, 0.02, int(), 1, 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects null granularity", exception=1
caplib::createVolRiskSettings(false, false, 0.02, 1, int(), 0.02, 1, "TF_createVolRiskSettings_H", false)

@testing:case="createVolRiskSettings rejects keyword arguments", syntaxError=1
