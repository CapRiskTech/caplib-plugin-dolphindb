// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];


asOfDate = 2022.03.09;
flatVolSurface = caplib::createFlatVolatilitySurface(asOfDate, 0.20, "TF_UNDERLYING", "TF_FVS", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="createProxyOptionQuoteMatrix -> handle"
result = caplib::createProxyOptionQuoteMatrix("TF_UNDERLYING", flatVolSurface, 100.0, 101.0, "TF_POQ", false)
assert 1, result == "TF_POQ"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createProxyOptionQuoteMatrix rejects missing argument", syntaxError=1
caplib::createProxyOptionQuoteMatrix("X", "X", 0.02, 0.02)

@testing:case="createProxyOptionQuoteMatrix rejects extra argument", syntaxError=1
caplib::createProxyOptionQuoteMatrix("X", "X", 0.02, 0.02, "TF_createProxyOptionQuoteMatrix_H", false, 1)

@testing:case="createProxyOptionQuoteMatrix rejects wrong type for underlyingName", exception=1
caplib::createProxyOptionQuoteMatrix(1, "X", 0.02, 0.02, "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects wrong type for refUnderlyingPrice", exception=1
caplib::createProxyOptionQuoteMatrix("X", "X", "bad", 0.02, "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects wrong type for underlyingPrice", exception=1
caplib::createProxyOptionQuoteMatrix("X", "X", 0.02, "bad", "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects null underlyingName", exception=1
caplib::createProxyOptionQuoteMatrix(string(), "X", 0.02, 0.02, "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects null refUnderlyingPrice", exception=1
caplib::createProxyOptionQuoteMatrix("X", "X", double(), 0.02, "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects vector for scalar underlyingName", exception=1
caplib::createProxyOptionQuoteMatrix(["X"], "X", 0.02, 0.02, "TF_createProxyOptionQuoteMatrix_H", false)

@testing:case="createProxyOptionQuoteMatrix rejects nonexistent handle refVolSurfaceHandle", exception=1
caplib::createProxyOptionQuoteMatrix("X", "TF_NO_SUCH_HANDLE_createProxyOptionQuoteMatrix", 0.02, 0.02, "TF_createProxyOptionQuoteMatrix_H", false)
@testing:case="createProxyOptionQuoteMatrix rejects keyword arguments", syntaxError=1
caplib::createProxyOptionQuoteMatrix(underlyingName="X", refVolSurfaceHandle="X", refUnderlyingPrice=0.02, underlyingPrice=0.02, handle="TF_createProxyOptionQuoteMatrix_H", returnJson=false)


// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createProxyOptionQuoteMatrix optional returnJson null uses default"
result = caplib::createProxyOptionQuoteMatrix("TF_UNDERLYING", flatVolSurface, 100.0, 101.0, "TF_POQ", bool())
assert 1, typestr(result) != "VOID"
