// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];


caplib::createCalendar("CAL_CFETS");
irCurve = caplib::createIrYieldCurve(2022.03.09, [2022.03.10, 2025.03.10], [0.02, 0.025], "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "TF_IR", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getObjectCacheJson -> handle"
result = caplib::getObjectCacheJson("IrYieldCurve", "TF_IR")[0]
assert 1, result == "TF_IR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getObjectCacheJson rejects missing argument", syntaxError=1
caplib::getObjectCacheJson("X")

@testing:case="getObjectCacheJson rejects extra argument", syntaxError=1
caplib::getObjectCacheJson("X", "TF_getObjectCacheJson_H", 1)

@testing:case="getObjectCacheJson rejects wrong type for protobufType", exception=1
caplib::getObjectCacheJson(1, "TF_getObjectCacheJson_H")

@testing:case="getObjectCacheJson rejects null protobufType", exception=1
caplib::getObjectCacheJson(string(), "TF_getObjectCacheJson_H")

@testing:case="getObjectCacheJson rejects vector for scalar protobufType", exception=1
caplib::getObjectCacheJson(["X"], "TF_getObjectCacheJson_H")

@testing:case="getObjectCacheJson rejects keyword arguments", syntaxError=1
caplib::getObjectCacheJson(protobufType="X", handle="TF_getObjectCacheJson_H")
