// ============================================================================
// test_getObjectCacheJson.dos
// Per-function test suite for caplib::getObjectCacheJson (shared).
// Signature: caplib::getObjectCacheJson(protobufType STRING, handle STRING)
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_getObjectCacheJson.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

caplib::createCalendar("CAL_CFETS");

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="getObjectCacheJson -> handle"
result = caplib::getObjectCacheJson("IrYieldCurve", "TF_IR")[0]
assert 1, result == "TF_IR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="getObjectCacheJson rejects missing argument", syntaxError=1
caplib::getObjectCacheJson("X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="getObjectCacheJson rejects extra argument", syntaxError=1
caplib::getObjectCacheJson("X", "TF_getObjectCacheJson_H", 1)

// 用例目的：参数 protobufType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="getObjectCacheJson rejects wrong type for protobufType", exception=1
caplib::getObjectCacheJson(1, "TF_getObjectCacheJson_H")

// 用例目的：参数 protobufType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="getObjectCacheJson rejects null protobufType", exception=1
caplib::getObjectCacheJson(string(), "TF_getObjectCacheJson_H")

// 用例目的：标量参数 protobufType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="getObjectCacheJson rejects vector for scalar protobufType", exception=1
caplib::getObjectCacheJson(["X"], "TF_getObjectCacheJson_H")

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="getObjectCacheJson rejects keyword arguments", syntaxError=1
caplib::getObjectCacheJson(protobufType="X", handle="TF_getObjectCacheJson_H")
