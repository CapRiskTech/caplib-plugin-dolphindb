// ============================================================================
// test_createPriceVolRiskSettings.dos
// Per-function test suite for caplib::createPriceVolRiskSettings (shared).
// Signature: caplib::createPriceVolRiskSettings(vanna BOOL, priceShift DOUBLE, volShift DOUBLE, method INT, granularity INT, priceScaling DOUBLE, volScaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createPriceVolRiskSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================


// ============================================================================
// Tests
// ============================================================================

@testing:case="createPriceVolRiskSettings valid call"
result = caplib::createPriceVolRiskSettings(false, 0.02, 0.02, 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)
assert 1, result == "TF_createPriceVolRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createPriceVolRiskSettings rejects missing argument", syntaxError=1
caplib::createPriceVolRiskSettings(false, 0.02, 0.02, 1, 1, 0.02, 0.02, 1)

@testing:case="createPriceVolRiskSettings rejects extra argument", syntaxError=1
caplib::createPriceVolRiskSettings(false, 0.02, 0.02, 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false, 1)

@testing:case="createPriceVolRiskSettings rejects wrong type for priceShift", exception=1
caplib::createPriceVolRiskSettings(false, "bad", 0.02, 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)

@testing:case="createPriceVolRiskSettings rejects wrong type for volShift", exception=1
caplib::createPriceVolRiskSettings(false, 0.02, "bad", 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)

@testing:case="createPriceVolRiskSettings rejects wrong type for method", exception=1
caplib::createPriceVolRiskSettings(false, 0.02, 0.02, "1", 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)

@testing:case="createPriceVolRiskSettings rejects null method", exception=1
caplib::createPriceVolRiskSettings(false, 0.02, 0.02, int(), 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)

@testing:case="createPriceVolRiskSettings rejects null granularity", exception=1
caplib::createPriceVolRiskSettings(false, 0.02, 0.02, 1, int(), 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)

@testing:case="createPriceVolRiskSettings rejects keyword arguments", syntaxError=1
caplib::createPriceVolRiskSettings(vanna=false, priceShift=0.02, volShift=0.02, method=1, granularity=1, priceScaling=0.02, volScaling=0.02, threading=1, handle="TF_createPriceVolRiskSettings_H", returnJson=false)
@testing:case="createPriceVolRiskSettings optional returnJson null uses default"
result = caplib::createPriceVolRiskSettings(false, 0.02, 0.02, 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", bool())
assert 1, typestr(result) != "VOID"
@testing:case="createPriceVolRiskSettings rejects negative volShift (lenient validation, does not raise)"
result = caplib::createPriceVolRiskSettings(false, 0.02, -1.0, 1, 1, 0.02, 0.02, 1, "TF_createPriceVolRiskSettings_H", false)
assert 1, typestr(result) != "VOID"

