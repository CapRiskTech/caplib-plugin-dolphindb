// ============================================================================
// test_getVolatility.dos
// Per-function test suite for caplib::getVolatility (shared).
// Signature: caplib::getVolatility(volSurfaceHandle STRING, termDates DATE[], strikes DOUBLE[])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_getVolatility.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

flatVolSurface = caplib::createFlatVolatilitySurface(
    asOfDate, 0.20, "TF_UNDERLYING", "TF_FLAT_VOL_SURFACE", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getVolatility -> flat surface returns constant vol matrix"
volatilities = caplib::getVolatility(flatVolSurface, curveDates, [95.0, 105.0]);
assert 1, isMatrix(volatilities) &&
    abs(volatilities[0, 0] - 0.2) < 1.0e-9 && abs(volatilities[0, 1] - 0.2) < 1.0e-9 &&
    abs(volatilities[1, 0] - 0.2) < 1.0e-9 && abs(volatilities[1, 1] - 0.2) < 1.0e-9

@testing:case="getVolatility rejects unknown handle", exception=1
caplib::getVolatility("TF_HANDLE_DOES_NOT_EXIST", curveDates, [95.0, 105.0])

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getVolatility rejects missing argument", syntaxError=1
caplib::getVolatility(flatVolSurface, curveDates)

@testing:case="getVolatility rejects extra argument", syntaxError=1
caplib::getVolatility(flatVolSurface, curveDates, [95.0, 105.0], 1)

@testing:case="getVolatility rejects partially-null vector termDates", exception=1
caplib::getVolatility(flatVolSurface, [2024.01.01, date()], [95.0, 105.0])

@testing:case="getVolatility rejects empty vector termDates", exception=1
caplib::getVolatility(flatVolSurface, take(date, 0), [95.0, 105.0])

@testing:case="getVolatility rejects nonexistent handle volSurfaceHandle", exception=1
caplib::getVolatility("TF_HANDLE_DOES_NOT_EXIST", curveDates, [95.0, 105.0])

@testing:case="getVolatility rejects keyword arguments", syntaxError=1
caplib::getVolatility(volSurfaceHandle=flatVolSurface, termDates=curveDates, strikes=[95.0, 105.0])
