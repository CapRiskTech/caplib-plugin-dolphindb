caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "NOT_A_REAL_ENUM", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", false)

// 用例目的：枚举参数 interp 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createDividendCurve rejects invalid enum for interp", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "NOT_A_REAL_ENUM", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", false)

// 用例目的：枚举参数 extrap 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createDividendCurve rejects invalid enum for extrap", exception=1
