// ============================================================================
// test_createDividendCurve.dos
// Per-function test suite for caplib::createDividendCurve (shared).
// Signature: caplib::createDividendCurve(referenceDate DATE, pillarDates DATE[], pillarValues DOUBLE[], yieldStartDate DATE, dividendType STRING, dcc STRING, interp STRING, extrap STRING, compounding STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createDividendCurve.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createDividendCurve -> handle"
result = caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", false)
assert 1, result == "TF_DIV"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createDividendCurve rejects missing argument", syntaxError=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createDividendCurve rejects extra argument", syntaxError=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurve rejects wrong type for referenceDate", exception=1
caplib::createDividendCurve("bad", [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：参数 yieldStartDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurve rejects wrong type for yieldStartDate", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], "bad", "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：参数 dividendType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurve rejects wrong type for dividendType", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], 2024.01.01, 1, "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDividendCurve rejects null referenceDate", exception=1
caplib::createDividendCurve(date(), [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：参数 yieldStartDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDividendCurve rejects null yieldStartDate", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], date(), "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createDividendCurve rejects vector for scalar referenceDate", exception=1
caplib::createDividendCurve([2024.01.01], [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：向量参数 pillarDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createDividendCurve rejects scalar for vector pillarDates", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.01], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：向量参数 pillarDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createDividendCurve rejects partially-null vector pillarDates", exception=1
caplib::createDividendCurve(2024.01.01, [2024.01.01, date()], [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：向量参数 pillarDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createDividendCurve rejects empty vector pillarDates", exception=1
caplib::createDividendCurve(2024.01.01, take(date, 0), [0.02], 2024.01.01, "X", "X", "X", "X", "X", "TF_createDividendCurve_H", "TF_createDividendCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createDividendCurve rejects keyword arguments", syntaxError=1
caplib::createDividendCurve(referenceDate=2024.01.01, pillarDates=[2024.01.01], pillarValues=[0.02], yieldStartDate=2024.01.01, dividendType="X", dcc="X", interp="X", extrap="X", compounding="X", name="TF_createDividendCurve_H", handle="TF_createDividendCurve_H", returnJson=false)
// 用例目的：向量参数 pillarDates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createDividendCurve rejects all-null vector pillarDates", exception=1
caplib::createDividendCurve(asOfDate, [date(), date(), date()], [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createDividendCurve optional returnJson null uses default"
result = caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（pillarValues 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createDividendCurve rejects pillarValues length mismatch", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01, 0.03], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV", false);
