// 用例目的：枚举参数 compounding 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createDividendCurve rejects invalid enum for compounding", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "NOT_A_REAL_ENUM", "TF_DIV", "TF_DIV", false)

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: date-relationship behavior (wrapper does not validate)
// ----------------------------------------------------------------------------

// 用例目的：yieldStartDate 晚于 asOfDate —— 文档声明包装器不检查先后关系，实测宽松接受，记录实际行为
@testing:case="createDividendCurve accepts yieldStartDate after asOfDate (no validation)"
rDC_ysd = caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], 2025.03.10, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV_R3_YSD", false)
assert 1, typestr(rDC_ysd) != "VOID"

// 用例目的：yieldStartDate 晚于最后一个 pillarDates —— 文档声明包装器不检查先后关系，实测宽松接受，记录实际行为
@testing:case="createDividendCurve accepts yieldStartDate after pillarDates (no validation)"
rDC_ysp = caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], 2026.01.01, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV_R3_YSP", false)
assert 1, typestr(rDC_ysp) != "VOID"

// 用例目的：asOfDate 晚于全部 pillarDates —— 文档声明包装器不检查先后关系，实测宽松接受，记录实际行为
@testing:case="createDividendCurve accepts asOfDate after pillarDates (no validation)"
rDC_aop = caplib::createDividendCurve(2026.01.01, curveDates, [0.01, 0.01], 2026.01.01, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV_R3_AOP", false)
assert 1, typestr(rDC_aop) != "VOID"

// 用例目的：pillarDates 非递增（倒序）—— 实测插件严格校验递增性并抛异常（预期：抛异常）
@testing:case="createDividendCurve rejects non-increasing pillarDates", exception=1
caplib::createDividendCurve(asOfDate, [2025.03.10, 2022.03.10], [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV_R3_NI", false)

// 用例目的：pillarDates 含重复日期 —— 实测插件严格校验递增性并抛异常（预期：抛异常）
@testing:case="createDividendCurve rejects duplicate pillarDates", exception=1
caplib::createDividendCurve(asOfDate, [2022.03.10, 2022.03.10], [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIV", "TF_DIV_R3_DUP", false)

