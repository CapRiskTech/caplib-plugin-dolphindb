// ============================================================================
// test_createDividendCurve.dos
// Per-function test suite for caplib::createDividendCurve (shared).
// Signature: caplib::createDividendCurve(referenceDate DATE, pillarDates DATE[], pillarValues DOUBLE[], yieldStartDate DATE, dividendType STRING, dcc STRING, interp STRING, extrap STRING, compounding STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createDividendCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createDividendCurve valid call"
result = caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)
assert 1, result == "TF_DIVIDEND_CURVE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createDividendCurve rejects missing argument", syntaxError=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE")

@testing:case="createDividendCurve rejects extra argument", syntaxError=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false, 1)

@testing:case="createDividendCurve rejects wrong type for referenceDate", exception=1
caplib::createDividendCurve("bad", curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects wrong type for yieldStartDate", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], "bad", "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects wrong type for dividendType", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], asOfDate, 1, "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects null referenceDate", exception=1
caplib::createDividendCurve(date(), curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects null yieldStartDate", exception=1
caplib::createDividendCurve(asOfDate, curveDates, [0.01, 0.01], date(), "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects vector for scalar referenceDate", exception=1
caplib::createDividendCurve([2024.01.01], curveDates, [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects scalar for vector pillarDates", exception=1
caplib::createDividendCurve(asOfDate, [2024.01.01], [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects partially-null vector pillarDates", exception=1
caplib::createDividendCurve(asOfDate, [2024.01.01, date()], [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)

@testing:case="createDividendCurve rejects empty vector pillarDates", exception=1
caplib::createDividendCurve(asOfDate, take(date, 0), [0.01, 0.01], asOfDate, "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "CONTINUOUS_COMPOUNDING", "TF_DIVIDEND_CURVE", "TF_DIVIDEND_CURVE", false)
