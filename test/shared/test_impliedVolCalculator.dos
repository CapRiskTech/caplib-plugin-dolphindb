// ============================================================================
// test_impliedVolCalculator.dos
// Per-function test suite for caplib::impliedVolCalculator (shared).
// Signature: caplib::impliedVolCalculator(calculationDate DATE, underlyingPrice DOUBLE, discountCurveHandle STRING, assetCurveHandle STRING, pricingSettingsHandle STRING, optionPrice DOUBLE, payoffType STRING, exerciseType STRING, expiryDate DATE, strike DOUBLE)
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_impliedVolCalculator.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];
flatIr = caplib::createFlatIrYieldCurve(asOfDate, "CNY", 0.02, "TF_FIR", false);
flatDiv = caplib::createFlatDividendCurve(asOfDate, 0.01, "TF_FDIV", "TF_FDIV", false);
bm = caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_BM", false);
ps = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, bm, "", "", "TF_PS", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="impliedVolCalculator -> positive vol"
v = caplib::impliedVolCalculator(asOfDate, 100.0, flatIr, flatDiv, ps, 5.0, "CALL", "EUROPEAN", 2022.09.09, 100.0)
assert 1, v > 0.0

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="impliedVolCalculator rejects missing argument", syntaxError=1
caplib::impliedVolCalculator(2024.01.01, 0.02, "X", "X", "X", 0.02, "X", "X", 2024.01.01)

@testing:case="impliedVolCalculator rejects extra argument", syntaxError=1
caplib::impliedVolCalculator(2024.01.01, 0.02, "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02, 1)

@testing:case="impliedVolCalculator rejects wrong type for calculationDate", exception=1
caplib::impliedVolCalculator("bad", 0.02, "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects wrong type for underlyingPrice", exception=1
caplib::impliedVolCalculator(2024.01.01, "bad", "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects wrong type for optionPrice", exception=1
caplib::impliedVolCalculator(2024.01.01, 0.02, "X", "X", "X", "bad", "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects null calculationDate", exception=1
caplib::impliedVolCalculator(date(), 0.02, "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects null underlyingPrice", exception=1
caplib::impliedVolCalculator(2024.01.01, double(), "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects vector for scalar calculationDate", exception=1
caplib::impliedVolCalculator([2024.01.01], 0.02, "X", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects nonexistent handle discountCurveHandle", exception=1
caplib::impliedVolCalculator(2024.01.01, 0.02, "TF_HANDLE_DOES_NOT_EXIST", "X", "X", 0.02, "X", "X", 2024.01.01, 0.02)

@testing:case="impliedVolCalculator rejects keyword arguments", syntaxError=1
caplib::impliedVolCalculator(calculationDate=2024.01.01, underlyingPrice=0.02, discountCurveHandle="X", assetCurveHandle="X", pricingSettingsHandle="X", optionPrice=0.02, payoffType="X", exerciseType="X", expiryDate=2024.01.01, strike=0.02)



// ----------------------------------------------------------------------------
// Review wave-1 additions (wiki test-case review)
// ----------------------------------------------------------------------------

@testing:case="impliedVolCalculator rejects invalid enum for exerciseType", exception=1
caplib::impliedVolCalculator(asOfDate, 100.0, flatIr, flatDiv, ps, 5.0, "CALL", "NOT_A_VALID_ENUM_LABEL", 2022.09.09, 100.0)

// ----------------------------------------------------------------------------
// Review wave-3 additions (independent numeric references)
// ----------------------------------------------------------------------------

@testing:case="impliedVolCalculator -> round-trip against independent BSM price"
// The option price is computed here with an independent Black-Scholes formula
// (cdfNormal); the plugin must invert it back to the 20% input volatility.
Tref = 0.5041095890410959;
d1 = (log(100.0/100.0) + (0.02 - 0.01 + 0.5*0.04)*Tref) / (0.20*sqrt(Tref));
d2 = d1 - 0.20*sqrt(Tref);
priceRef = 100.0*exp(-0.01*Tref)*cdfNormal(0, 1, d1) - 100.0*exp(-0.02*Tref)*cdfNormal(0, 1, d2);
ivr = caplib::impliedVolCalculator(asOfDate, 100.0, flatIr, flatDiv, ps, priceRef, "CALL", "EUROPEAN", 2022.09.09, 100.0);
assert 1, abs(ivr - 0.20) < 1.0e-9



// ----------------------------------------------------------------------------
// Review wave-5 additions (wrong-type handles, enum sweeps, boundary values)
// ----------------------------------------------------------------------------

@testing:case="impliedVolCalculator rejects wrong object type for assetCurveHandle", exception=1
caplib::impliedVolCalculator(asOfDate, 100.0, flatIr, flatIr, ps, 5.0, "CALL", "EUROPEAN", 2022.09.09, 100.0)


@testing:case="impliedVolCalculator supports all payoffType enums"
labelEnum = ["CALL", "PUT"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::impliedVolCalculator(asOfDate, 100.0, flatIr, flatDiv, ps, 5.0, labelEnum[i], "EUROPEAN", 2022.09.09, 100.0); } catch(ex) { okEnum = false; }
}
assert 1, okEnum


@testing:case="impliedVolCalculator accepts zero underlyingPrice (lenient validation, does not raise)"
result = caplib::impliedVolCalculator(asOfDate, 0.0, flatIr, flatDiv, ps, 5.0, "CALL", "EUROPEAN", 2022.09.09, 100.0)
assert 1, typestr(result) != "VOID"


@testing:case="impliedVolCalculator rejects negative underlyingPrice", exception=1
caplib::impliedVolCalculator(asOfDate, -1.0, flatIr, flatDiv, ps, 5.0, "CALL", "EUROPEAN", 2022.09.09, 100.0)

