// ============================================================================
// test_createScnAnalysisSettings.dos
// Per-function test suite for caplib::createScnAnalysisSettings (shared).
// Signature: caplib::createScnAnalysisSettings(scnType STRING, priceHandle STRING, volHandle STRING, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createScnAnalysisSettings.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];


priceScn = caplib::createScnSettings(-0.1, 0.1, 5, 0, "TF_PRICE_SCN", false);
volScn = caplib::createScnSettings(-0.2, 0.2, 5, 0, "TF_VOL_SCN", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="createScnAnalysisSettings -> handle"
result = caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, "TF_SCNA", false)
assert 1, result == "TF_SCNA"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createScnAnalysisSettings rejects missing argument", syntaxError=1
caplib::createScnAnalysisSettings("X", "X", "X", 1)

@testing:case="createScnAnalysisSettings rejects extra argument", syntaxError=1
caplib::createScnAnalysisSettings("X", "X", "X", 1, "TF_createScnAnalysisSettings_H", false, 1)

@testing:case="createScnAnalysisSettings rejects wrong type for scnType", exception=1
caplib::createScnAnalysisSettings(1, "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects wrong type for threading", exception=1
caplib::createScnAnalysisSettings("X", "X", "X", "1", "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects null scnType", exception=1
caplib::createScnAnalysisSettings(string(), "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects null threading", exception=1
caplib::createScnAnalysisSettings("X", "X", "X", int(), "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects vector for scalar scnType", exception=1
caplib::createScnAnalysisSettings(["X"], "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects nonexistent handle priceHandle", exception=1
caplib::createScnAnalysisSettings("X", "TF_NO_SUCH_HANDLE_createScnAnalysisSettings", "X", 1, "TF_createScnAnalysisSettings_H", false)

@testing:case="createScnAnalysisSettings rejects keyword arguments", syntaxError=1
caplib::createScnAnalysisSettings(scnType="X", priceHandle="X", volHandle="X", threading=1, handle="TF_createScnAnalysisSettings_H", returnJson=false)


// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createScnAnalysisSettings optional returnJson null uses default"
result = caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, "TF_SCNA", bool())
assert 1, typestr(result) != "VOID"
