// ============================================================================
// test_createScnAnalysisSettings.dos
// Per-function test suite for caplib::createScnAnalysisSettings (shared).
// Signature: caplib::createScnAnalysisSettings(scnType STRING, priceHandle STRING, volHandle STRING, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createScnAnalysisSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

priceScn = caplib::createScnSettings(-0.1, 0.1, 5, 0, "TF_PRICE_SCN", false);
volScn = caplib::createScnSettings(-0.2, 0.2, 5, 0, "TF_VOL_SCN", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createScnAnalysisSettings -> handle"
result = caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, "TF_SCNA", false)
assert 1, result == "TF_SCNA"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createScnAnalysisSettings rejects missing argument", syntaxError=1
caplib::createScnAnalysisSettings("X", "X", "X", 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createScnAnalysisSettings rejects extra argument", syntaxError=1
caplib::createScnAnalysisSettings("X", "X", "X", 1, "TF_createScnAnalysisSettings_H", false, 1)

// 用例目的：参数 scnType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects wrong type for scnType", exception=1
caplib::createScnAnalysisSettings(1, "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

// 用例目的：参数 threading 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects wrong type for threading", exception=1
caplib::createScnAnalysisSettings("X", "X", "X", "1", "TF_createScnAnalysisSettings_H", false)

// 用例目的：参数 scnType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects null scnType", exception=1
caplib::createScnAnalysisSettings(string(), "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

// 用例目的：参数 threading 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects null threading", exception=1
caplib::createScnAnalysisSettings("X", "X", "X", int(), "TF_createScnAnalysisSettings_H", false)

// 用例目的：标量参数 scnType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects vector for scalar scnType", exception=1
caplib::createScnAnalysisSettings(["X"], "X", "X", 1, "TF_createScnAnalysisSettings_H", false)

// 用例目的：句柄参数 priceHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects nonexistent handle priceHandle", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", "TF_NO_SUCH_HANDLE_createScnAnalysisSettings", volScn, 1, "TF_createScnAnalysisSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createScnAnalysisSettings rejects keyword arguments", syntaxError=1
caplib::createScnAnalysisSettings(scnType="X", priceHandle="X", volHandle="X", threading=1, handle="TF_createScnAnalysisSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createScnAnalysisSettings optional returnJson null uses default"
result = caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, "TF_SCNA", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入非 BOOL 标量，验证类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects non-BOOL returnJson", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, "TF_SCNA", 1)

// 用例目的：遍历参数 scnType 的全部文档枚举取值，逐一调用验证均被接受
@testing:case="createScnAnalysisSettings supports all scnType enums"
labelEnum = ["NONE", "NO_SCN_ANALYSIS", "PRICE", "PRICE_SCN_ANALYSIS", "VOL", "VOL_SCN_ANALYSIS", "PRICE_VOL", "PRICE_VOL_SCN_ANALYSIS", "THETA", "THETA_SCN_ANALYSIS"]
okEnum = true;
for (i in 0..(size(labelEnum)-1)) {
    try { caplib::createScnAnalysisSettings(labelEnum[i], priceScn, volScn, 1, "TF_SCNA", false); } catch(ex) { okEnum = false; }
}
assert 1, okEnum
// 用例目的：volHandle 传入类型不符的真实对象句柄（波动率平面而非 ScnSettings），验证对象类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects wrong object type for volHandle", exception=1
wrongObjV = caplib::createFlatVolatilitySurface(2022.03.09, 0.20, "TF_UNDERLYING", "TF_SCNA_WRONGTYPE_VOL", false)
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, wrongObjV, 1, "TF_SCNA", false)

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle / enum / BOOL coverage
// ----------------------------------------------------------------------------

// 用例目的：句柄参数 volHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects nonexistent handle volHandle", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, "TF_NO_SUCH_HANDLE_createScnAnalysisSettings_volHandle", 1, "TF_SCNA", false)

// 用例目的：句柄参数 priceHandle 传入类型不符的对象句柄（波动率平面），验证句柄类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects wrong object type for priceHandle", exception=1
wrongObjP = caplib::createFlatVolatilitySurface(2022.03.09, 0.20, "TF_UNDERLYING", "TF_SCNA_WRONGTYPE_PRICE", false)
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", wrongObjP, volScn, 1, "TF_SCNA", false)

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects wrong type for handle", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, 1, 123, false)

// 用例目的：枚举参数 scnType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects invalid enum for scnType", exception=1
caplib::createScnAnalysisSettings("NOT_A_REAL_ENUM", priceScn, volScn, 1, "TF_SCNA", false)

// 用例目的：threading 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createScnAnalysisSettings rejects BOOL threading", exception=1
caplib::createScnAnalysisSettings("PRICE_VOL_SCN_ANALYSIS", priceScn, volScn, true, "TF_SCNA", false)

