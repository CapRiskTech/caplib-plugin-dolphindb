// ============================================================================
// test_createScnSettings.dos
// Per-function test suite for caplib::createScnSettings (shared).
// Signature: caplib::createScnSettings(min DOUBLE, max DOUBLE, size INT, scnGenType INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createScnSettings.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createScnSettings valid call"
result = caplib::createScnSettings(0.02, 0.02, 1, 1, "TF_createScnSettings_H", false)
assert 1, result == "TF_createScnSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createScnSettings rejects missing argument", syntaxError=1
caplib::createScnSettings(0.02, 0.02, 1, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createScnSettings rejects extra argument", syntaxError=1
caplib::createScnSettings(0.02, 0.02, 1, 1, "TF_createScnSettings_H", false, 1)

// 用例目的：参数 min 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createScnSettings rejects wrong type for min", exception=1
caplib::createScnSettings("bad", 0.02, 1, 1, "TF_createScnSettings_H", false)

// 用例目的：参数 max 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createScnSettings rejects wrong type for max", exception=1
caplib::createScnSettings(0.02, "bad", 1, 1, "TF_createScnSettings_H", false)

// 用例目的：参数 size 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createScnSettings rejects wrong type for size", exception=1
caplib::createScnSettings(0.02, 0.02, "1", 1, "TF_createScnSettings_H", false)

// 用例目的：参数 min 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createScnSettings rejects null min", exception=1
caplib::createScnSettings(double(), 0.02, 1, 1, "TF_createScnSettings_H", false)

// 用例目的：参数 max 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createScnSettings rejects null max", exception=1
caplib::createScnSettings(0.02, double(), 1, 1, "TF_createScnSettings_H", false)

// 用例目的：标量参数 min 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createScnSettings rejects vector for scalar min", exception=1
caplib::createScnSettings([0.02], 0.02, 1, 1, "TF_createScnSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createScnSettings rejects keyword arguments", syntaxError=1
caplib::createScnSettings(min=0.02, max=0.02, size=1, scnGenType=1, handle="TF_createScnSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createScnSettings optional returnJson null uses default"
result = caplib::createScnSettings(0.02, 0.02, 1, 1, "TF_createScnSettings_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 size 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createScnSettings rejects zero size", exception=1
caplib::createScnSettings(0.02, 0.02, 0.0, 1, "TF_createScnSettings_H", false)

// 用例目的：参数 size 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createScnSettings rejects negative size", exception=1
caplib::createScnSettings(0.02, 0.02, -1.0, 1, "TF_createScnSettings_H", false)

