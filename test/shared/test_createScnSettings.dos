// ============================================================================
// test_createScnSettings.dos
// Per-function test suite for caplib::createScnSettings (shared).
// Signature: caplib::createScnSettings(min DOUBLE, max DOUBLE, size INT, scnGenType INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createScnSettings.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createScnSettings valid call"
result = caplib::createScnSettings(-0.1, 0.1, 5, 0, "TF_PRICE_SCN", false)
assert 1, result == "TF_PRICE_SCN"

@testing:case="createScnSettings rejects inverted interval", exception=1
caplib::createScnSettings(0.1, -0.1, 5, 0, "TF_SCN_BAD", false)

@testing:case="createScnSettings rejects null size", exception=1
caplib::createScnSettings(-0.1, 0.1, int(), 0, "TF_SCN_BAD", false)

@testing:case="createScnSettings accepts equal endpoints"
r = caplib::createScnSettings(0.1, 0.1, 1, 0, "TF_SCN_EQUAL");
assert 1, r == "TF_SCN_EQUAL"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createScnSettings rejects missing argument", syntaxError=1
caplib::createScnSettings(-0.1, 0.1, 5, 0)

@testing:case="createScnSettings rejects extra argument", syntaxError=1
caplib::createScnSettings(-0.1, 0.1, 5, 0, "TF_PRICE_SCN", false, 1)

@testing:case="createScnSettings rejects wrong type for min", exception=1
caplib::createScnSettings("bad", 0.1, 5, 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects wrong type for max", exception=1
caplib::createScnSettings(-0.1, "bad", 5, 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects wrong type for size", exception=1
caplib::createScnSettings(-0.1, 0.1, "1", 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects null min", exception=1
caplib::createScnSettings(double(), 0.1, 5, 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects null max", exception=1
caplib::createScnSettings(-0.1, double(), 5, 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects vector for scalar min", exception=1
caplib::createScnSettings([0.02], 0.1, 5, 0, "TF_PRICE_SCN", false)

@testing:case="createScnSettings rejects keyword arguments", syntaxError=1
caplib::createScnSettings(min=-0.1, max=0.1, size=5, scnGenType=0, handle="TF_PRICE_SCN", returnJson=false)
