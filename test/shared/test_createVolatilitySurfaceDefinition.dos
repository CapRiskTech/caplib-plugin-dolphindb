// ============================================================================
// test_createVolatilitySurfaceDefinition.dos
// Per-function test suite for caplib::createVolatilitySurfaceDefinition (shared).
// Signature: caplib::createVolatilitySurfaceDefinition(volSmileType STRING, smileMethod STRING, smileExtrapMethod STRING, timeInterpMethod STRING, timeExtrapMethod STRING, dayCountConvention STRING, volType STRING, wingStrikeType STRING, lower DOUBLE, upper DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySurfaceDefinition.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolatilitySurfaceDefinition -> handle"
result = caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY", "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE", 90.0, 110.0, "TF_VSDEF", false)
assert 1, result == "TF_VSDEF"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySurfaceDefinition rejects missing argument", syntaxError=1
caplib::createVolatilitySurfaceDefinition("X", "X", "X", "X", "X", "X", "X", "X", 0.02, 0.02)

@testing:case="createVolatilitySurfaceDefinition rejects extra argument", syntaxError=1
caplib::createVolatilitySurfaceDefinition("X", "X", "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false, 1)

@testing:case="createVolatilitySurfaceDefinition rejects wrong type for volSmileType", exception=1
caplib::createVolatilitySurfaceDefinition(1, "X", "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects wrong type for smileMethod", exception=1
caplib::createVolatilitySurfaceDefinition("X", 1, "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects wrong type for smileExtrapMethod", exception=1
caplib::createVolatilitySurfaceDefinition("X", "X", 1, "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects null volSmileType", exception=1
caplib::createVolatilitySurfaceDefinition(string(), "X", "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects null smileMethod", exception=1
caplib::createVolatilitySurfaceDefinition("X", string(), "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects vector for scalar volSmileType", exception=1
caplib::createVolatilitySurfaceDefinition(["X"], "X", "X", "X", "X", "X", "X", "X", 0.02, 0.02, "TF_createVolatilitySurfaceDefinition_H", false)

@testing:case="createVolatilitySurfaceDefinition rejects keyword arguments", syntaxError=1
caplib::createVolatilitySurfaceDefinition(volSmileType="X", smileMethod="X", smileExtrapMethod="X", timeInterpMethod="X", timeExtrapMethod="X", dayCountConvention="X", volType="X", wingStrikeType="X", lower=0.02, upper=0.02, handle="TF_createVolatilitySurfaceDefinition_H", returnJson=false)



// ----------------------------------------------------------------------------
// Review wave-2 additions (parameter relationships / boundaries)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySurfaceDefinition rejects lower >= upper (equal)", exception=1
caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY", "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE", 0.0001, 0.0001, "TF_VSDEF", false)

@testing:case="createVolatilitySurfaceDefinition rejects lower >= upper (reversed)", exception=1
caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY", "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE", 0.001, -0.001, "TF_VSDEF", false)


