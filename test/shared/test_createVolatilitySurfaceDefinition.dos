@testing:case="createVolatilitySurfaceDefinition rejects wrong type for smileMethod", exception=1
caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE", 1, "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY", "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE", 90.0, 110.0, "TF_VOL_SURFACE_DEFINITION", false)

