caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABSOLUTE_TERM", "OQST_ABSOLUTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], quoteTermDates, quotePayoffTypes, matrix([10.5, 8.5], [11.0, 9.0], [12.0, 10.0]), quoteStrikes, "TF_UNDERLYING", "TF_OQ", false)

// 用例目的：strikes 行数与配对矩阵不一致（3 行 vs 2 行），验证形状校验（预期：抛异常）
