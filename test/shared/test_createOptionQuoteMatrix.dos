caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABSOLUTE_TERM", "OQST_ABSOLUTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], quoteTermDates, matrix(["CALL", "PUT"], ["CALL", "PUT"], ["CALL", "PUT"]), quoteValues, quoteStrikes, "TF_UNDERLYING", "TF_OQ", false)

// 用例目的：values/payoffTypes/strikes 均为 3 行且形状一致，仅 termDates 保持 2 项，隔离 values 与期限的行数校验（预期：抛异常）
@testing:case="createOptionQuoteMatrix rejects values row mismatch with termDates", exception=1
caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABSOLUTE_TERM", "OQST_ABSOLUTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], quoteTermDates, matrix(["CALL", "PUT", "CALL"], ["CALL", "PUT", "CALL"]), matrix([10.5, 8.5, 7.5], [11.0, 9.0, 8.0]), matrix([95.0, 95.0, 95.0], [105.0, 105.0, 105.0]), "TF_UNDERLYING", "TF_OQ", false)

