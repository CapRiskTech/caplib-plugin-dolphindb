// ----------------------------------------------------------------------------
// Review round-3 gap-fill: paired-parameter shape mismatch coverage
// ----------------------------------------------------------------------------

// 用例目的：termDates 比 2 列矩阵多一个元素（3 个日期），验证形状校验（预期：抛异常）
@testing:case="createOptionQuoteMatrix rejects termDates length mismatch", exception=1
caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABSOLUTE_TERM", "OQST_ABSOLUTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09, 2022.12.09], quotePayoffTypes, quoteValues, quoteStrikes, "TF_UNDERLYING", "TF_OQ", false)

// 用例目的：payoffTypes 行数与配对矩阵不一致（3 行 vs 2 行），验证形状校验（预期：抛异常）
@testing:case="createOptionQuoteMatrix rejects payoffTypes row mismatch", exception=1
caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABSOLUTE_TERM", "OQST_ABSOLUTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], quoteTermDates, matrix(["CALL", "PUT", "CALL"], ["CALL", "PUT", "CALL"]), quoteValues, quoteStrikes, "TF_UNDERLYING", "TF_OQ", false)

// 用例目的：payoffTypes 列数与配对矩阵不一致（3 列 vs 2 列），验证形状校验（预期：抛异常）
