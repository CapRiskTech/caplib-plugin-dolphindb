// ============================================================================
// test_createOptionQuoteMatrix.dos
// Per-function test suite for caplib::createOptionQuoteMatrix (shared).
// Signature: caplib::createOptionQuoteMatrix(quoteValueType STRING, quoteTermType STRING, quoteStrikeType STRING, exerciseType STRING, optionUnderlyingType STRING, asOfDate DATE, terms STRING[], termDates DATE[], payoffTypes STRING matrix/vector, values DOUBLE matrix/vector, strikes DOUBLE matrix/vector, assetName STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createOptionQuoteMatrix.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createOptionQuoteMatrix valid call"
result = caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09], matrix(["CALL", "PUT"], ["CALL", "PUT"]), matrix([10.5, 8.5], [11.0, 9.0]), matrix([95.0, 95.0], [105.0, 105.0]), "TF_UNDERLYING", "TF_OPTION_QUOTES", false)
assert 1, result == "TF_OPTION_QUOTES"

@testing:case="createOptionQuoteMatrix accepts flat vector form"
flat = caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09], ["CALL", "PUT"], [10.5, 8.5], [95.0, 105.0], "TF_UNDERLYING", "TF_OQ_FLAT", false);
assert 1, flat == "TF_OQ_FLAT"

@testing:case="createOptionQuoteMatrix accepts nested vector form"
nested = caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09], (["CALL"], ["PUT"]), ([10.5], [11.0]), ([95.0], [105.0]), "TF_UNDERLYING", "TF_OQ_NESTED", false);
assert 1, nested == "TF_OQ_NESTED"

@testing:case="createOptionQuoteMatrix rejects partially-null values matrix", exception=1
caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09], matrix(["CALL", "PUT"], ["CALL", "PUT"]), matrix([10.5, double()], [11.0, 9.0]), matrix([95.0, 95.0], [105.0, 105.0]), "TF_UNDERLYING", "TF_OQ_BAD", true)

@testing:case="createOptionQuoteMatrix rejects zero-row values matrix", exception=1
caplib::createOptionQuoteMatrix("OQVT_PRICE", "OQTT_ABOSULTE_TERM", "OQST_ABOSULTE_STRIKE", "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, [], [2022.06.09, 2022.09.09], matrix(["CALL", "PUT"], ["CALL", "PUT"]), matrix(DOUBLE, 0, 2), matrix([95.0, 95.0], [105.0, 105.0]), "TF_UNDERLYING", "TF_OQ_BAD", true)

