@testing:case="createPricingModelSettings accepts all-null vector constantParams (lenient validation, does not raise)"
result = caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [double(), double(), double()], "TF_BSM", false)
assert 1, typestr(result) != "VOID"


