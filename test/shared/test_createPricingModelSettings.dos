// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createPricingModelSettings valid call"
result = caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_BSM_MODEL", false)
assert 1, result == "TF_BSM_MODEL"

@testing:case="createPricingModelSettings rejects invalid model enum", exception=1
caplib::createPricingModelSettings("NOT_A_MODEL", "", 0, [0.0], "TF_MODEL_BAD", false)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createPricingModelSettings rejects missing argument", syntaxError=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [0.0])

@testing:case="createPricingModelSettings rejects extra argument", syntaxError=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, [0.0], "TF_BSM_MODEL", false, 1)

@testing:case="createPricingModelSettings rejects wrong type for modelName", exception=1
caplib::createPricingModelSettings(1, "", 0, [0.0], "TF_BSM_MODEL", false)

@testing:case="createPricingModelSettings rejects wrong type for asset", exception=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", 1, 0, [0.0], "TF_BSM_MODEL", false)

@testing:case="createPricingModelSettings rejects null modelName", exception=1
caplib::createPricingModelSettings(string(), "", 0, [0.0], "TF_BSM_MODEL", false)

@testing:case="createPricingModelSettings rejects vector for scalar modelName", exception=1
caplib::createPricingModelSettings(["X"], "", 0, [0.0], "TF_BSM_MODEL", false)

@testing:case="createPricingModelSettings rejects empty vector constantParams", exception=1
caplib::createPricingModelSettings("BLACK_SCHOLES_MERTON", "", 0, take(double, 0), "TF_BSM_MODEL", false)
