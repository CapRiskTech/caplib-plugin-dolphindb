// ============================================================================
// test_createPricingModelSettings.dos
// Per-function test suite for caplib::createPricingModelSettings (shared).
// Signature: caplib::createPricingModelSettings(modelName STRING, asset STRING, calibrated BOOL, constantParams DOUBLE[], handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createPricingModelSettings.dos   // single file
