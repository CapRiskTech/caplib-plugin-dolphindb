// ============================================================================
// test_createVolatilitySurface.dos
// Per-function test suite for caplib::createVolatilitySurface (shared).
// Signature: caplib::createVolatilitySurface(definitionHandle STRING, referenceDate DATE, volSmileHandles STRING[], termDates DATE[], underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySurface.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

volSurfaceDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE",
    90.0, 110.0, "TF_VOL_SURFACE_DEFINITION", false);

emptyDoubles = array(DOUBLE, 0);
volSmile1d = caplib::createVolatilitySmile(
    "STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21],
    "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0 / 365.0,
    emptyDoubles, emptyDoubles, 90.0, 110.0, "TF_VOL_SMILE_1D", false);

volSmile3y = caplib::createVolatilitySmile(
    "STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.23, 0.21, 0.22],
    "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 3.0,
    emptyDoubles, emptyDoubles, 90.0, 110.0, "TF_VOL_SMILE_3Y", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolatilitySurface valid call"
result = caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false)
assert 1, result == "TF_VOL_SURFACE"

@testing:case="createVolatilitySurface rejects wrong smile handle type", exception=1
caplib::createVolatilitySurface("TF_HANDLE_DOES_NOT_EXIST", asOfDate, [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE_BAD", false)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolatilitySurface rejects missing argument", syntaxError=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING")

@testing:case="createVolatilitySurface rejects extra argument", syntaxError=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false, 1)

@testing:case="createVolatilitySurface rejects wrong type for referenceDate", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, "bad", [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects wrong type for underlying", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], curveDates, 1, "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects null referenceDate", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, date(), [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects vector for scalar referenceDate", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, [2024.01.01], [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects scalar for vector termDates", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], [2024.01.01], "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects partially-null vector termDates", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], [2024.01.01, date()], "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects empty vector termDates", exception=1
caplib::createVolatilitySurface(volSurfaceDefinition, asOfDate, [volSmile1d, volSmile3y], take(date, 0), "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects nonexistent handle definitionHandle", exception=1
caplib::createVolatilitySurface("TF_HANDLE_DOES_NOT_EXIST", asOfDate, [volSmile1d, volSmile3y], curveDates, "TF_UNDERLYING", "TF_VOL_SURFACE", false)

@testing:case="createVolatilitySurface rejects keyword arguments", syntaxError=1
caplib::createVolatilitySurface(definitionHandle=volSurfaceDefinition, referenceDate=asOfDate, volSmileHandles=[volSmile1d, volSmile3y], termDates=curveDates, underlying="TF_UNDERLYING", handle="TF_VOL_SURFACE", returnJson=false)
