// ============================================================================
// test_createVolatilitySurface.dos
// Per-function test suite for caplib::createVolatilitySurface (shared).
// Signature: caplib::createVolatilitySurface(definitionHandle STRING, referenceDate DATE, volSmileHandles STRING[], termDates DATE[], underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilitySurface.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2022.03.09;

asOfDate = 2022.03.09;
emptyD = array(DOUBLE, 0);
smile1 = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.22, 0.20, 0.21], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 1.0/365.0, emptyD, emptyD, 90.0, 110.0, "TF_S1", false);
smile3 = caplib::createVolatilitySmile("STRIKE_VOL_SMILE", asOfDate, [90.0, 100.0, 110.0], [0.23, 0.21, 0.22], "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", 3.0, emptyD, emptyD, 90.0, 110.0, "TF_S3", false);
vdef = caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE", "LINEAR_SMILE_METHOD", "FLAT_EXTRAP", "LINEAR_IN_VOLATILITY", "FLAT_IN_VOLATILITY", "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "ABOSULTE_STRIKE", 90.0, 110.0, "TF_VD", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createVolatilitySurface -> handle"
result = caplib::createVolatilitySurface(vdef, asOfDate, [smile1, smile3], [2022.03.10, 2025.03.10], "TF_UNDERLYING", "TF_VS", false)
assert 1, result == "TF_VS"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createVolatilitySurface rejects missing argument", syntaxError=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01], "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createVolatilitySurface rejects extra argument", syntaxError=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects wrong type for referenceDate", exception=1
caplib::createVolatilitySurface("X", "bad", ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：参数 underlying 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects wrong type for underlying", exception=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01], 1, "TF_createVolatilitySurface_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects null referenceDate", exception=1
caplib::createVolatilitySurface("X", date(), ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：参数 underlying 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects null underlying", exception=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01], string(), "TF_createVolatilitySurface_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects vector for scalar referenceDate", exception=1
caplib::createVolatilitySurface("X", [2024.01.01], ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects scalar for vector termDates", exception=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects partially-null vector termDates", exception=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], [2024.01.01, date()], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：向量参数 termDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects empty vector termDates", exception=1
caplib::createVolatilitySurface("X", 2024.01.01, ["X"], take(date, 0), "X", "TF_createVolatilitySurface_H", false)

// 用例目的：句柄参数 definitionHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects nonexistent handle definitionHandle", exception=1
caplib::createVolatilitySurface("TF_NO_SUCH_HANDLE_createVolatilitySurface", 2024.01.01, ["X"], [2024.01.01], "X", "TF_createVolatilitySurface_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createVolatilitySurface rejects keyword arguments", syntaxError=1
caplib::createVolatilitySurface(definitionHandle="X", referenceDate=2024.01.01, volSmileHandles=["X"], termDates=[2024.01.01], underlying="X", handle="TF_createVolatilitySurface_H", returnJson=false)
// 用例目的：向量参数 volSmileHandles 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects all-null vector volSmileHandles", exception=1
caplib::createVolatilitySurface(vdef, asOfDate, [string(), string(), string()], [2022.03.10, 2025.03.10], "TF_UNDERLYING", "TF_VS", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createVolatilitySurface optional returnJson null uses default"
result = caplib::createVolatilitySurface(vdef, asOfDate, [smile1, smile3], [2022.03.10, 2025.03.10], "TF_UNDERLYING", "TF_VS", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 volSmileHandles 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects wrong object type for volSmileHandles", exception=1
caplib::createVolatilitySurface(vdef, asOfDate, vdef, [2022.03.10, 2025.03.10], "TF_UNDERLYING", "TF_VS", false)

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（volSmileHandles 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createVolatilitySurface rejects volSmileHandles length mismatch", exception=1
caplib::createVolatilitySurface(vdef, asOfDate, [smile1, smile3, "EXTRA"], [2022.03.10, 2025.03.10], "TF_UNDERLYING", "TF_VS", false);
