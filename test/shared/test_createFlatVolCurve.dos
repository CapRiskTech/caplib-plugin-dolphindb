// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createFlatVolCurve valid call"
result = caplib::createFlatVolCurve(2024.01.01, 0.02, "X", "TF_createFlatVolCurve_H", false)
assert 1, result == "TF_createFlatVolCurve_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createFlatVolCurve rejects missing argument", syntaxError=1
caplib::createFlatVolCurve(2024.01.01, 0.02, "X")

@testing:case="createFlatVolCurve rejects extra argument", syntaxError=1
caplib::createFlatVolCurve(2024.01.01, 0.02, "X", "TF_createFlatVolCurve_H", false, 1)

@testing:case="createFlatVolCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatVolCurve("bad", 0.02, "X", "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects wrong type for volatility", exception=1
caplib::createFlatVolCurve(2024.01.01, "bad", "X", "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects wrong type for underlying", exception=1
caplib::createFlatVolCurve(2024.01.01, 0.02, 1, "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects null referenceDate", exception=1
caplib::createFlatVolCurve(date(), 0.02, "X", "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects null volatility", exception=1
caplib::createFlatVolCurve(2024.01.01, double(), "X", "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatVolCurve([2024.01.01], 0.02, "X", "TF_createFlatVolCurve_H", false)

@testing:case="createFlatVolCurve rejects keyword arguments", syntaxError=1
caplib::createFlatVolCurve(referenceDate=2024.01.01, volatility=0.02, underlying="X", handle="TF_createFlatVolCurve_H", returnJson=false)
