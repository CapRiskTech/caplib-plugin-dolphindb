// ============================================================================
// test_createPricingSettings.dos
// Per-function test suite for caplib::createPricingSettings (shared).
// Signature: caplib::createPricingSettings(currency STRING, pricingMethod STRING, incCurrent BOOL, cashFlows BOOL, modelHandle STRING, pdeHandle STRING, mcHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createPricingSettings.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createPricingSettings -> handle"
result = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, "", "", "", "TF_PRICING", false)
assert 1, result == "TF_PRICING"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createPricingSettings rejects missing argument", syntaxError=1
caplib::createPricingSettings("X", "X", false, false, "X", "X", "X")

@testing:case="createPricingSettings rejects extra argument", syntaxError=1
caplib::createPricingSettings("X", "X", false, false, "X", "X", "X", "TF_createPricingSettings_H", false, 1)

@testing:case="createPricingSettings rejects wrong type for currency", exception=1
caplib::createPricingSettings(1, "X", false, false, "X", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects wrong type for pricingMethod", exception=1
caplib::createPricingSettings("X", 1, false, false, "X", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects null currency", exception=1
caplib::createPricingSettings(string(), "X", false, false, "X", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects null pricingMethod", exception=1
caplib::createPricingSettings("X", string(), false, false, "X", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects vector for scalar currency", exception=1
caplib::createPricingSettings(["X"], "X", false, false, "X", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects nonexistent handle modelHandle", exception=1
caplib::createPricingSettings("X", "X", false, false, "TF_NO_SUCH_HANDLE_createPricingSettings", "X", "X", "TF_createPricingSettings_H", false)

@testing:case="createPricingSettings rejects keyword arguments", syntaxError=1
caplib::createPricingSettings(currency="X", pricingMethod="X", incCurrent=false, cashFlows=false, modelHandle="X", pdeHandle="X", mcHandle="X", handle="TF_createPricingSettings_H", returnJson=false)


// ----------------------------------------------------------------------------
// Review wave-4 additions (forms / optional param / scale / determinism)
// ----------------------------------------------------------------------------

@testing:case="createPricingSettings optional returnJson null uses default"
result = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, "", "", "", "TF_PRICING", bool())
assert 1, typestr(result) != "VOID"
