// ============================================================================
// test_createDividendCurveRiskSettings.dos
// Per-function test suite for caplib::createDividendCurveRiskSettings (shared).
// Signature: caplib::createDividendCurveRiskSettings(delta BOOL, gamma BOOL, shift DOUBLE, method INT, granularity INT, scaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createDividendCurveRiskSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createDividendCurveRiskSettings valid call"
result = caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)
assert 1, result == "TF_createDividendCurveRiskSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createDividendCurveRiskSettings rejects missing argument", syntaxError=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createDividendCurveRiskSettings rejects extra argument", syntaxError=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false, 1)

// 用例目的：参数 shift 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects wrong type for shift", exception=1
caplib::createDividendCurveRiskSettings(false, false, "bad", 1, 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：参数 method 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects wrong type for method", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, "1", 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：参数 granularity 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects wrong type for granularity", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, "1", 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：参数 method 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects null method", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, int(), 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：参数 granularity 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects null granularity", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, int(), 0.02, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createDividendCurveRiskSettings rejects keyword arguments", syntaxError=1
caplib::createDividendCurveRiskSettings(delta=false, gamma=false, shift=0.02, method=1, granularity=1, scaling=0.02, threading=1, handle="TF_createDividendCurveRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createDividendCurveRiskSettings optional returnJson null uses default"
result = caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 scaling 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects zero scaling", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, 0.0, 1, "TF_createDividendCurveRiskSettings_H", false)

// 用例目的：参数 scaling 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createDividendCurveRiskSettings rejects negative scaling", exception=1
caplib::createDividendCurveRiskSettings(false, false, 0.02, 1, 1, -1.0, 1, "TF_createDividendCurveRiskSettings_H", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 delta 传入单元素向量，实测插件宽松接受——记录实际行为
@testing:case="createDividendCurveRiskSettings vector for scalar delta", exception=1
caplib::createDividendCurveRiskSettings([true], false, 0.02, 1, 1, 0.02, 1, "TF_createDividendCurveRiskSettings_H", false);
