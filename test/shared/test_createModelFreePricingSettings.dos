// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createModelFreePricingSettings valid call"
result = caplib::createModelFreePricingSettings("CNY", 1, 0, "TF_MODEL_FREE_PRICING", false)
assert 1, result == "TF_MODEL_FREE_PRICING"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createModelFreePricingSettings rejects missing argument", syntaxError=1
caplib::createModelFreePricingSettings("CNY", 1, 0)

@testing:case="createModelFreePricingSettings rejects extra argument", syntaxError=1
caplib::createModelFreePricingSettings("CNY", 1, 0, "TF_MODEL_FREE_PRICING", false, 1)

@testing:case="createModelFreePricingSettings rejects wrong type for currency", exception=1
caplib::createModelFreePricingSettings(1, 1, 0, "TF_MODEL_FREE_PRICING", false)

@testing:case="createModelFreePricingSettings rejects wrong type for incCurrent", exception=1
caplib::createModelFreePricingSettings("CNY", "1", 0, "TF_MODEL_FREE_PRICING", false)

@testing:case="createModelFreePricingSettings rejects wrong type for cashFlows", exception=1
caplib::createModelFreePricingSettings("CNY", 1, "1", "TF_MODEL_FREE_PRICING", false)

@testing:case="createModelFreePricingSettings rejects null incCurrent", exception=1
caplib::createModelFreePricingSettings("CNY", int(), 0, "TF_MODEL_FREE_PRICING", false)

@testing:case="createModelFreePricingSettings rejects null cashFlows", exception=1
caplib::createModelFreePricingSettings("CNY", 1, int(), "TF_MODEL_FREE_PRICING", false)

@testing:case="createModelFreePricingSettings rejects vector for scalar currency", exception=1
caplib::createModelFreePricingSettings(["X"], 1, 0, "TF_MODEL_FREE_PRICING", false)
