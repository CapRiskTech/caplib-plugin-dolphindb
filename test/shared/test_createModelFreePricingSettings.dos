// ============================================================================
// Helper predicates
// ============================================================================


// ============================================================================
// Tests
// ============================================================================

@testing:case="createModelFreePricingSettings valid call"
result = caplib::createModelFreePricingSettings("X", 1, 1, "TF_createModelFreePricingSettings_H", false)
assert 1, result == "TF_createModelFreePricingSettings_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createModelFreePricingSettings rejects missing argument", syntaxError=1
caplib::createModelFreePricingSettings("X", 1, 1)

@testing:case="createModelFreePricingSettings rejects extra argument", syntaxError=1
caplib::createModelFreePricingSettings("X", 1, 1, "TF_createModelFreePricingSettings_H", false, 1)

@testing:case="createModelFreePricingSettings rejects wrong type for currency", exception=1
caplib::createModelFreePricingSettings(1, 1, 1, "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects wrong type for incCurrent", exception=1
caplib::createModelFreePricingSettings("X", "1", 1, "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects wrong type for cashFlows", exception=1
caplib::createModelFreePricingSettings("X", 1, "1", "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects null incCurrent", exception=1
caplib::createModelFreePricingSettings("X", int(), 1, "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects null cashFlows", exception=1
caplib::createModelFreePricingSettings("X", 1, int(), "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects vector for scalar currency", exception=1
caplib::createModelFreePricingSettings(["X"], 1, 1, "TF_createModelFreePricingSettings_H", false)

@testing:case="createModelFreePricingSettings rejects keyword arguments", syntaxError=1
caplib::createModelFreePricingSettings(currency="X", incCurrent=1, cashFlows=1, handle="TF_createModelFreePricingSettings_H", returnJson=false)
@testing:case="createModelFreePricingSettings optional returnJson null uses default"
result = caplib::createModelFreePricingSettings("X", 1, 1, "TF_createModelFreePricingSettings_H", bool())
assert 1, typestr(result) != "VOID"
