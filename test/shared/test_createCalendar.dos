// ============================================================================
// test_createCalendar.dos
// Per-function test suite for caplib::createCalendar (shared).
// Signature: caplib::createCalendar(calName STRING[, holidays DATE[]|INT[][, specialBusinessDays DATE[]|INT[]]])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createCalendar.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createCalendar valid call"
assert 1, caplib::createCalendar("TF_CAL", [2024.01.01], [2024.01.01])

@testing:case="createCalendar accepts DATE holidays and special days"
assert 1, caplib::createCalendar("TF_CAL_D", [2024.01.01, 2024.01.03], [2024.01.02])

@testing:case="createCalendar rejects zero-length holidays", exception=1
caplib::createCalendar("TF_CAL_BAD", take(int(), 0))

@testing:case="createCalendar rejects partially-null holidays", exception=1
caplib::createCalendar("TF_CAL_BAD2", [44654, int(), 44656])

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createCalendar rejects extra argument", syntaxError=1
caplib::createCalendar("TF_CAL", [2024.01.01], [2024.01.01], 1)

@testing:case="createCalendar rejects wrong type for calName", exception=1
caplib::createCalendar(1, [2024.01.01], [2024.01.01])

@testing:case="createCalendar rejects vector for scalar calName", exception=1
caplib::createCalendar(["X"], [2024.01.01], [2024.01.01])

@testing:case="createCalendar rejects keyword arguments", syntaxError=1
caplib::createCalendar(calName="TF_CAL", holidays=[2024.01.01], specialBusinessDays=[2024.01.01])
