// ============================================================================
// test_createFlatVolatilitySurface.dos
// Per-function test suite for caplib::createFlatVolatilitySurface (shared).
// Signature: caplib::createFlatVolatilitySurface(referenceDate DATE, volatility DOUBLE, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createFlatVolatilitySurface.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
