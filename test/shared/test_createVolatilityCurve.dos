// ----------------------------------------------------------------------------
// Review round-3 gap-fill: asOfDate / pillarDates date-relationship behavior
// ----------------------------------------------------------------------------

// 用例目的：asOfDate 晚于全部 pillarDates —— 文档声明包装器不检查先后关系，实测宽松接受，记录实际行为
@testing:case="createVolatilityCurve accepts asOfDate after pillarDates (no validation)"
rVC_aop = caplib::createVolatilityCurve(2026.01.01, curveDates, [0.20, 0.21], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_UNDERLYING", "TF_VOL_CURVE_R3_AOP", false)
assert 1, typestr(rVC_aop) != "VOID"

// 用例目的：pillarDates 非递增（倒序）—— 实测插件宽松接受、不抛异常，记录实际行为
@testing:case="createVolatilityCurve accepts non-increasing pillarDates (no validation)"
rVC_ni = caplib::createVolatilityCurve(asOfDate, [2025.03.10, 2022.03.10], [0.20, 0.21], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_UNDERLYING", "TF_VOL_CURVE_R3_NI", false)
assert 1, typestr(rVC_ni) != "VOID"

// 用例目的：pillarDates 含重复日期 —— 实测插件宽松接受、不抛异常，记录实际行为
@testing:case="createVolatilityCurve accepts duplicate pillarDates (no validation)"
rVC_dup = caplib::createVolatilityCurve(asOfDate, [2022.03.10, 2022.03.10], [0.20, 0.21], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_UNDERLYING", "TF_VOL_CURVE_R3_DUP", false)
assert 1, typestr(rVC_dup) != "VOID"

