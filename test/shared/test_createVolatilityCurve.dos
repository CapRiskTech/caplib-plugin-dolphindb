// ============================================================================
// test_createVolatilityCurve.dos
// Per-function test suite for caplib::createVolatilityCurve (shared).
// Signature: caplib::createVolatilityCurve(referenceDate DATE, pillarDates DATE[], vols DOUBLE[], dcc STRING, interp STRING, extrap STRING, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createVolatilityCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createVolatilityCurve -> handle"
result = caplib::createVolatilityCurve(asOfDate, curveDates, [0.20, 0.21], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_UNDERLYING", "TF_VOL_CURVE", false)
assert 1, result == "TF_VOL_CURVE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createVolatilityCurve rejects missing argument", syntaxError=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X")

@testing:case="createVolatilityCurve rejects extra argument", syntaxError=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false, 1)

@testing:case="createVolatilityCurve rejects wrong type for referenceDate", exception=1
caplib::createVolatilityCurve("bad", [2024.01.01], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects wrong type for dcc", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], 1, "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects wrong type for interp", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], "X", 1, "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects null referenceDate", exception=1
caplib::createVolatilityCurve(date(), [2024.01.01], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects null dcc", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], string(), "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects vector for scalar referenceDate", exception=1
caplib::createVolatilityCurve([2024.01.01], [2024.01.01], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects scalar for vector pillarDates", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects partially-null vector pillarDates", exception=1
caplib::createVolatilityCurve(2024.01.01, [2024.01.01, date()], [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects empty vector pillarDates", exception=1
caplib::createVolatilityCurve(2024.01.01, take(date, 0), [0.02], "X", "X", "X", "X", "TF_createVolatilityCurve_H", false)

@testing:case="createVolatilityCurve rejects keyword arguments", syntaxError=1
caplib::createVolatilityCurve(referenceDate=2024.01.01, pillarDates=[2024.01.01], vols=[0.02], dcc="X", interp="X", extrap="X", underlying="X", handle="TF_createVolatilityCurve_H", returnJson=false)



// ----------------------------------------------------------------------------
// Review wave-1 additions (wiki test-case review)
