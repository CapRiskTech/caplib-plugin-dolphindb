caplib::createVolatilityCurve(asOfDate, curveDates, [0.20, 0.21], "NOT_A_REAL_ENUM", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_UNDERLYING", "TF_VOL_CURVE", false)

// 用例目的：枚举参数 interp 传入非法值，验证枚举校验（预期：抛异常）
