// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createFlatDividendCurve valid call"
result = caplib::createFlatDividendCurve(asOfDate, 0.01, "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)
assert 1, result == "TF_FLAT_DIVIDEND_CURVE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createFlatDividendCurve rejects missing argument", syntaxError=1
caplib::createFlatDividendCurve(asOfDate, 0.01, "TF_FLAT_DIVIDEND_CURVE")

@testing:case="createFlatDividendCurve rejects extra argument", syntaxError=1
caplib::createFlatDividendCurve(asOfDate, 0.01, "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false, 1)

@testing:case="createFlatDividendCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatDividendCurve("bad", 0.01, "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)

@testing:case="createFlatDividendCurve rejects wrong type for dividend", exception=1
caplib::createFlatDividendCurve(asOfDate, "bad", "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)

@testing:case="createFlatDividendCurve rejects wrong type for curveName", exception=1
caplib::createFlatDividendCurve(asOfDate, 0.01, 1, "TF_FLAT_DIVIDEND_CURVE", false)

@testing:case="createFlatDividendCurve rejects null referenceDate", exception=1
caplib::createFlatDividendCurve(date(), 0.01, "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)

@testing:case="createFlatDividendCurve rejects null dividend", exception=1
caplib::createFlatDividendCurve(asOfDate, double(), "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)

@testing:case="createFlatDividendCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatDividendCurve([2024.01.01], 0.01, "TF_FLAT_DIVIDEND_CURVE", "TF_FLAT_DIVIDEND_CURVE", false)
