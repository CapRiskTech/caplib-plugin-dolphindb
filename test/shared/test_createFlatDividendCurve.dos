// ============================================================================
// test_createFlatDividendCurve.dos
// Per-function test suite for caplib::createFlatDividendCurve (shared).
// Signature: caplib::createFlatDividendCurve(referenceDate DATE, dividend DOUBLE, curveName STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createFlatDividendCurve.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// ============================================================================
// Tests

// 用例目的：valid call（预期：插件按文档行为执行）
@testing:case="createFlatDividendCurve valid call"
result = caplib::createFlatDividendCurve(2024.01.01, 0.02, "X", "TF_createFlatDividendCurve_H", false)
assert 1, result == "TF_createFlatDividendCurve_H"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFlatDividendCurve rejects missing argument", syntaxError=1
caplib::createFlatDividendCurve(2024.01.01, 0.02, "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFlatDividendCurve rejects extra argument", syntaxError=1
caplib::createFlatDividendCurve(2024.01.01, 0.02, "X", "TF_createFlatDividendCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatDividendCurve("bad", 0.02, "X", "TF_createFlatDividendCurve_H", false)

// 用例目的：参数 dividend 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects wrong type for dividend", exception=1
caplib::createFlatDividendCurve(2024.01.01, "bad", "X", "TF_createFlatDividendCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects wrong type for curveName", exception=1
caplib::createFlatDividendCurve(2024.01.01, 0.02, 1, "TF_createFlatDividendCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects null referenceDate", exception=1
caplib::createFlatDividendCurve(date(), 0.02, "X", "TF_createFlatDividendCurve_H", false)

// 用例目的：参数 dividend 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects null dividend", exception=1
caplib::createFlatDividendCurve(2024.01.01, double(), "X", "TF_createFlatDividendCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFlatDividendCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatDividendCurve([2024.01.01], 0.02, "X", "TF_createFlatDividendCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFlatDividendCurve rejects keyword arguments", syntaxError=1
caplib::createFlatDividendCurve(referenceDate=2024.01.01, dividend=0.02, curveName="X", handle="TF_createFlatDividendCurve_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFlatDividendCurve optional returnJson null uses default"
result = caplib::createFlatDividendCurve(2024.01.01, 0.02, "X", "TF_createFlatDividendCurve_H", bool())
assert 1, typestr(result) != "VOID"
