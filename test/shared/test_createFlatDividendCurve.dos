// ============================================================================
// test_createFlatDividendCurve.dos
// Per-function test suite for caplib::createFlatDividendCurve (shared).
// Signature: caplib::createFlatDividendCurve(referenceDate DATE, dividend DOUBLE, curveName STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/shared")            // whole domain directory
//     python run_tests.py --file shared/test_createFlatDividendCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
