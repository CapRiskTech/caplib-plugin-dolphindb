// ============================================================================
// Negative / exception validation
// ============================================================================

@testing:case="createEqRiskSettings rejects STRING method", exception=1
caplib::createEqRiskSettings("1", 1, 1, 1, "EQ_BAD_RISK", true)

@testing:case="createEuropeanOption rejects invalid payoff type enum", exception=1
caplib::createEuropeanOption("NOT_A_PAYOFF", 2.958, 2020.08.19, 2020.08.20, 1000000.0, "CNY", "SPOT", "CNY", underlying, "EQ_BAD_EO_1", false)


@testing:case="priceEqEuropeanOption rejects wrong mktData handle", exception=1
caplib::priceEqEuropeanOption(eo, asOfDate, irCurve, bsmAnalyticalSettings, eqNoRisk[0], "", "", true)


@testing:case="createEqRiskSettings rejects missing argument", syntaxError=1
caplib::createEqRiskSettings(1, 1, 1)


