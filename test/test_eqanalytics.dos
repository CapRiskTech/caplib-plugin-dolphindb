// Extended negative / exception validation
// ============================================================================

@testing:case="createEuropeanOption rejects INT underlying", exception=1
caplib::createEuropeanOption("CALL", 2.958, 2020.08.19, 2020.08.20, 1000000.0, "CNY", "SPOT", "CNY", 1, "EQ_BAD_EO_3", false)

@testing:case="createAsianOption rejects invalid averaging method enum", exception=1
caplib::createAsianOption("CALL", 2.958, 2020.08.19, 2020.08.20, "FIXED_STRIKE", "NOT_AN_AVG_METHOD", "DISCRETE_OBSERVATION_TYPE", 1000000.0, "CNY", "SPOT", "CNY", underlying, "EQ_BAD_AS_2", dailyObsDates, dailyObsValues, dailyObsWeights, false)

@testing:case="createDigitalOption rejects invalid payoff type enum", exception=1
caplib::createDigitalOption("NOT_A_PAYOFF", 2.958, 2020.08.19, 2020.08.20, 0.0, 1.0, 1000000.0, "CNY", "SPOT", "CNY", underlying, "EQ_BAD_DG_2", false)

@testing:case="createOneTouchOption rejects invalid barrier type enum", exception=1
caplib::createOneTouchOption(2020.08.19, 2020.08.20, "NOT_A_BARRIER", 3.106, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1000000.0, "CNY", "SPOT", "CNY", underlying, "EQ_BAD_OT_2", false)


@testing:case="priceEqEuropeanOption rejects wrong instrument handle", exception=1
caplib::priceEqEuropeanOption(am, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true)

// --- Pricing determinism ---
@testing:case="priceEqEuropeanOption repeated calls produce identical present_value"
pEo2 = caplib::priceEqEuropeanOption(eo, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true)
pEo3 = caplib::priceEqEuropeanOption(eo, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true)
assert 1, presentValue(pEo2) == presentValue(pEo3) &&
    abs(presentValue(pEo2) - 191723.60845871962) < 191723.60845871962 * 1.0e-9 + 1.0e-6


// --- Matrix null / shape validation (eq option quote matrix) ---
@testing:case="createEqOptionQuoteMatrix rejects zero-column strikes matrix", exception=1
caplib::createEqOptionQuoteMatrix("EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, quoteTermDates, quotePayoffTypes, quotePrices, matrix(DOUBLE, 4, 0), underlying, "EQ_BAD_QQ_1", true)

@testing:case="createEqOptionQuoteMatrix rejects zero-row payoff matrix", exception=1
caplib::createEqOptionQuoteMatrix("EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate, quoteTermDates, matrix(STRING, 0, 15), quotePrices, quoteStrikes, underlying, "EQ_BAD_QQ_2", true)


// --- INT scalar null (int()) validation ---
@testing:case="createEqRiskSettings rejects null INT method", exception=1
caplib::createEqRiskSettings(int(), 1, 1, 1, "EQ_NULL_METHOD", true)


// --- INT parameter type validation (fed STRING) ---
@testing:case="createVolSurfBuildSettings rejects STRING int parameter", exception=1
caplib::createVolSurfBuildSettings("1", 0.5, "EQ_BAD_VSB", true)
