// ============================================================================
// test_createCrMktDataSet.dos
// Per-function test suite for caplib::createCrMktDataSet (cr).
// Signature: caplib::createCrMktDataSet(asOfDate DATE, discountCurve STRING, creditCurve STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCrMktDataSet.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;
currency = "CNY";

discountDates = [2020.03.22, 2020.05.21, 2020.08.22, 2021.02.21, 2022.02.21,
                 2023.02.21, 2024.02.21, 2025.02.21, 2027.02.21, 2030.02.21];
discountRates = [0.0166, 0.0183, 0.0198, 0.0212, 0.0234,
                 0.0256, 0.0268, 0.0280, 0.0294, 0.0305];
discountCurve = caplib::createIrYieldCurve(
    asOfDate, discountDates, discountRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", currency, "CN_TREAS", "CR_DISCOUNT_CURVE", false);

creditParCurve = caplib::createCreditParCurve(
    asOfDate, currency, "BOND_CREDIT",
    ["CFETS-SHCH-GTJA", "CFETS-SHCH-GTJA", "CFETS-SHCH-GTJA"],
    ["CREDIT_DEFAULT_SWAP", "CREDIT_DEFAULT_SWAP", "CREDIT_DEFAULT_SWAP"],
    ["1Y", "3Y", "5Y"],
    [0.0080, 0.0100, 0.0120],
    ["SPOTSTART", "SPOTSTART", "SPOTSTART"],
    "CR_CREDIT_PAR_CURVE", true);

creditCurve = caplib::buildCreditCurve(
    asOfDate, creditParCurve[0], discountCurve, "BOND_CREDIT",
    "BOOTSTRAPPING_METHOD", "CR_CREDIT_CURVE", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCrMktDataSet -> handle"
result = caplib::createCrMktDataSet(asOfDate, discountCurve, creditCurve[0], "TF_CRMKT", "TF_CRMKT", false)
assert 1, result == "TF_CRMKT"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCrMktDataSet rejects missing argument", syntaxError=1
caplib::createCrMktDataSet(2024.01.01, "X", "X", "TF_createCrMktDataSet_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCrMktDataSet rejects extra argument", syntaxError=1
caplib::createCrMktDataSet(2024.01.01, "X", "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createCrMktDataSet("bad", "X", "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：参数 discountCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects wrong type for discountCurve", exception=1
caplib::createCrMktDataSet(2024.01.01, 1, "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：参数 creditCurve 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects wrong type for creditCurve", exception=1
caplib::createCrMktDataSet(2024.01.01, "X", 1, "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects null asOfDate", exception=1
caplib::createCrMktDataSet(date(), "X", "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：参数 discountCurve 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects null discountCurve", exception=1
caplib::createCrMktDataSet(2024.01.01, string(), "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCrMktDataSet rejects vector for scalar asOfDate", exception=1
caplib::createCrMktDataSet([2024.01.01], "X", "X", "TF_createCrMktDataSet_H", "TF_createCrMktDataSet_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCrMktDataSet rejects keyword arguments", syntaxError=1
caplib::createCrMktDataSet(asOfDate=2024.01.01, discountCurve="X", creditCurve="X", name="TF_createCrMktDataSet_H", tag="TF_createCrMktDataSet_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCrMktDataSet optional returnJson null uses default"
result = caplib::createCrMktDataSet(asOfDate, discountCurve, creditCurve[0], "TF_CRMKT", "TF_CRMKT", bool())
assert 1, typestr(result) != "VOID"
