// ============================================================================
// test_createCreditCurve.dos
// Per-function test suite for caplib::createCreditCurve (cr).
// Signature: caplib::createCreditCurve(referenceDate DATE, pillarDates DATE[], spreads DOUBLE[], dcc STRING, interp STRING, extrap STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCreditCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;

discountDates = [2020.03.22, 2020.05.21, 2020.08.22, 2021.02.21, 2022.02.21,
                 2023.02.21, 2024.02.21, 2025.02.21, 2027.02.21, 2030.02.21];

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCreditCurve -> handle"
result = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)
assert 1, result == "TF_CC"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurve rejects missing argument", syntaxError=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurve rejects extra argument", syntaxError=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for referenceDate", exception=1
caplib::createCreditCurve("bad", [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 dcc 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for dcc", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], 1, "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 interp 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for interp", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", 1, "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects null referenceDate", exception=1
caplib::createCreditCurve(date(), [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 dcc 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects null dcc", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], string(), "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCreditCurve rejects vector for scalar referenceDate", exception=1
caplib::createCreditCurve([2024.01.01], [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：向量参数 pillarDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createCreditCurve rejects scalar for vector pillarDates", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：向量参数 pillarDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects partially-null vector pillarDates", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01, date()], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：向量参数 pillarDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createCreditCurve rejects empty vector pillarDates", exception=1
caplib::createCreditCurve(2024.01.01, take(date, 0), [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCreditCurve rejects keyword arguments", syntaxError=1
caplib::createCreditCurve(referenceDate=2024.01.01, pillarDates=[2024.01.01], spreads=[0.02], dcc="X", interp="X", extrap="X", name="TF_createCreditCurve_H", handle="TF_createCreditCurve_H", returnJson=false)
// 用例目的：向量参数 pillarDates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects all-null vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, [date(), date(), date()], take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCreditCurve optional returnJson null uses default"
result = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（pillarDates 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditCurve rejects pillarDates length mismatch", exception=1
caplib::createCreditCurve(asOfDate, join(discountDates, discountDates[0]), take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false);
