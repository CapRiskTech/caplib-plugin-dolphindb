// ============================================================================
// test_createCreditCurve.dos
// Per-function test suite for caplib::createCreditCurve (cr).
// Signature: caplib::createCreditCurve(asOfDate DATE, pillarDates DATE[], spreads DOUBLE[], dayCountConvention STRING, interp STRING, extrap STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCreditCurve.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;

discountDates = [2020.03.22, 2020.05.21, 2020.08.22, 2021.02.21, 2022.02.21,
                 2023.02.21, 2024.02.21, 2025.02.21, 2027.02.21, 2030.02.21];

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCreditCurve -> handle"
result = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)
assert 1, result == "TF_CC"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurve rejects missing argument", syntaxError=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurve rejects extra argument", syntaxError=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for asOfDate", exception=1
caplib::createCreditCurve("bad", [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 dayCountConvention 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for dayCountConvention", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], 1, "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 interp 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for interp", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], "X", 1, "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects null asOfDate", exception=1
caplib::createCreditCurve(date(), [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：参数 dayCountConvention 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects null dayCountConvention", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01], [0.02], string(), "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCreditCurve rejects vector for scalar asOfDate", exception=1
caplib::createCreditCurve([2024.01.01], [2024.01.01], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：向量参数 pillarDates 传入标量，验证数据形式校验（预期：抛异常）。
// 其余参数沿用正例调用的合法值，实测异常命中 [PLUGIN::CAPLIB] Parameter pillarDates must be a vector。
@testing:case="createCreditCurve rejects scalar for vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, 2024.01.01, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：向量参数 pillarDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects partially-null vector pillarDates", exception=1
caplib::createCreditCurve(2024.01.01, [2024.01.01, date()], [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：向量参数 pillarDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createCreditCurve rejects empty vector pillarDates", exception=1
caplib::createCreditCurve(2024.01.01, take(date, 0), [0.02], "X", "X", "X", "TF_createCreditCurve_H", "TF_createCreditCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCreditCurve rejects keyword arguments", syntaxError=1
caplib::createCreditCurve(asOfDate=2024.01.01, pillarDates=[2024.01.01], spreads=[0.02], dayCountConvention="X", interp="X", extrap="X", name="TF_createCreditCurve_H", handle="TF_createCreditCurve_H", returnJson=false)
// 用例目的：向量参数 pillarDates 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects all-null vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, [date(), date(), date()], take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCreditCurve optional returnJson null uses default"
result = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入错误类型（该传布尔值的传字符串），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for returnJson", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", "bad")

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（pillarDates 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditCurve rejects pillarDates length mismatch", exception=1
caplib::createCreditCurve(asOfDate, join(discountDates, discountDates[0]), take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false);

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle 类型校验 / 枚举非法值
// ----------------------------------------------------------------------------

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for handle", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", 123, false)

// 用例目的：枚举参数 dayCountConvention 传入非法值 —— 文档：仅接受所列精确拼写，验证枚举校验（预期：抛异常）
@testing:case="createCreditCurve rejects invalid enum for dayCountConvention", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "NOT_A_REAL_ENUM", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：枚举参数 interp 传入非法值 —— 文档：仅接受所示精确拼写，验证枚举校验（预期：抛异常）
@testing:case="createCreditCurve rejects invalid enum for interp", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "NOT_A_REAL_ENUM", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：枚举参数 extrap 传入非法值 —— 文档：仅接受所示精确拼写，验证枚举校验（预期：抛异常）
@testing:case="createCreditCurve rejects invalid enum for extrap", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "NOT_A_REAL_ENUM", "TF_CC", "TF_CC", false)

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: spreads/name 校验 / 日期关系与排序 / 枚举逐值
// ----------------------------------------------------------------------------

// 用例目的：向量参数 spreads 传入错误类型的向量（STRING 向量），验证元素类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for spreads", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take("a", size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：向量参数 spreads 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createCreditCurve rejects partially-null vector spreads", exception=1
caplib::createCreditCurve(asOfDate, discountDates, join([0.002, double()], take(0.002, size(discountDates) - 2)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：参数 name 传入空值 —— 实测包装器宽松接受并返回句柄，记录实际行为
@testing:case="createCreditCurve accepts null name (no validation)"
rCcR3NmN = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", string(), "TF_CC_R3_NMN", false)
assert 1, typestr(rCcR3NmN) != "VOID"

// 用例目的：参数 name 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createCreditCurve rejects wrong type for name", exception=1
caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", 123, "TF_CC", false)

// 用例目的：asOfDate 晚于全部节点日期 —— 文档注明包装器不检查日期先后关系，实测宽松接受不抛异常，记录实际行为
@testing:case="createCreditCurve accepts asOfDate later than pillar dates (no date validation)"
rCcR3D1 = caplib::createCreditCurve(2031.01.01, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC_NAME", "TF_CC_R3_D1", false)
assert 1, typestr(rCcR3D1) != "VOID"

// 用例目的：pillarDates 非递增（倒序）—— 文档注明包装器不检查排序，当前共享构造器在包装层校验并抛异常，记录实际行为（预期：抛异常）
@testing:case="createCreditCurve rejects non-increasing pillarDates", exception=1
caplib::createCreditCurve(asOfDate, reverse(discountDates), take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：pillarDates 含重复节点（非严格递增）—— 当前共享构造器在包装层校验并抛异常，记录实际行为（预期：抛异常）
@testing:case="createCreditCurve rejects duplicate pillarDates", exception=1
caplib::createCreditCurve(asOfDate, [2020.03.22, 2020.03.22, 2020.05.21, 2020.08.22, 2021.02.21, 2022.02.21, 2023.02.21, 2024.02.21, 2025.02.21, 2027.02.21], take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC", "TF_CC", false)

// 用例目的：枚举参数 dayCountConvention 传入文档取值 ACT_360（正常用例已覆盖 ACT_365_FIXED），验证逐值接受（预期：不抛异常）
@testing:case="createCreditCurve accepts dayCountConvention ACT_360"
rCcR3Dcc1 = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_360", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC_NAME", "TF_CC_R3_DCC1", false)
assert 1, typestr(rCcR3Dcc1) != "VOID"

// 用例目的：枚举参数 dayCountConvention 传入文档取值 ACTUAL_360，验证逐值接受（预期：不抛异常）
@testing:case="createCreditCurve accepts dayCountConvention ACTUAL_360"
rCcR3Dcc2 = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACTUAL_360", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CC_NAME", "TF_CC_R3_DCC2", false)
assert 1, typestr(rCcR3Dcc2) != "VOID"

// 用例目的：枚举参数 dayCountConvention 传入文档取值 ACT/360，验证逐值接受（预期：不抛异常）
