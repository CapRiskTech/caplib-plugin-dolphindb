// ============================================================================
// test_createCreditCurve.dos
// Per-function test suite for caplib::createCreditCurve (cr).
// Signature: caplib::createCreditCurve(referenceDate DATE, pillarDates DATE[], spreads DOUBLE[], dcc STRING, interp STRING, extrap STRING, name STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCreditCurve.dos   // single file
// Generated by tools/gen_function_tests - edit metadata/templates, not this file.
// ============================================================================

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createCreditCurve valid call"
result = caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)
assert 1, result == "TF_CR_CURVE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createCreditCurve rejects missing argument", syntaxError=1
caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE")

@testing:case="createCreditCurve rejects extra argument", syntaxError=1
caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false, 1)

@testing:case="createCreditCurve rejects wrong type for referenceDate", exception=1
caplib::createCreditCurve("bad", curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects wrong type for dcc", exception=1
caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], 1, "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects wrong type for interp", exception=1
caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], "ACT_365_FIXED", 1, "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects null referenceDate", exception=1
caplib::createCreditCurve(date(), curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects null dcc", exception=1
caplib::createCreditCurve(asOfDate, curveDates, [0.002, 0.0025], string(), "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects vector for scalar referenceDate", exception=1
caplib::createCreditCurve([2024.01.01], curveDates, [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects scalar for vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, [2024.01.01], [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects partially-null vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, [2024.01.01, date()], [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)

@testing:case="createCreditCurve rejects empty vector pillarDates", exception=1
caplib::createCreditCurve(asOfDate, take(date, 0), [0.002, 0.0025], "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP", "TF_CR_CURVE", "TF_CR_CURVE", false)
