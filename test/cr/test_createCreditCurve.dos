assert 1, typestr(rCcR3Int3) != "VOID"

// 用例目的：枚举参数 extrap 传入文档取值 LINEAR_EXTRAP（正常用例已覆盖 FLAT_EXTRAP），验证逐值接受（预期：不抛异常）
@testing:case="createCreditCurve accepts extrap LINEAR_EXTRAP"
rCcR3Ext = caplib::createCreditCurve(asOfDate, discountDates, take(0.002, size(discountDates)), "ACT_365_FIXED", "LINEAR_INTERP", "LINEAR_EXTRAP", "TF_CC_NAME", "TF_CC_R3_EXT", false)
assert 1, typestr(rCcR3Ext) != "VOID"
