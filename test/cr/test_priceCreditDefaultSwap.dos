// ============================================================================
// test_priceCreditDefaultSwap.dos
// Per-function test suite for caplib::priceCreditDefaultSwap (cr).
// Signature: caplib::priceCreditDefaultSwap(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_priceCreditDefaultSwap.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;
currency = "CNY";
calCfets = "CAL_CFETS";
calCfetsCreated = caplib::createCalendar(calCfets);
cdsTpl = caplib::createCdsTemplate("CFETS-SHCH-GTJA", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true);


discountDates = [2020.03.22, 2020.05.21, 2020.08.22, 2021.02.21, 2022.02.21,
                 2023.02.21, 2024.02.21, 2025.02.21, 2027.02.21, 2030.02.21];
discountRates = [0.0166, 0.0183, 0.0198, 0.0212, 0.0234,
                 0.0256, 0.0268, 0.0280, 0.0294, 0.0305];
discountCurve = caplib::createIrYieldCurve(
    asOfDate, discountDates, discountRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", currency, "CN_TREAS", "CR_DISCOUNT_CURVE", false);

pricingSettings = caplib::createCdsPricingSettings(
    currency, 0, 1, 0, "TAYLOR", "HALFDAYBIAS", "PIECEWISE",
    "CR_PRICING_NAME", "CR_PRICING", true);

irRisk = caplib::createIrCurveRiskSettings(
    1, 0, 0, 1.0e-4, 5.0e-1, 0, 1, 1.0e-4, 0, "CR_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 0, 1.0e-4, 0, 1, 1.0e-4, 0, "CR_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "CR_THETA_RISK", false);
crRisk = caplib::createCrRiskSettings(
    irRisk, creditRisk, thetaRisk, "CR_RISK_NAME", "CR_RISK", true);

creditParCurve = caplib::createCreditParCurve(
    asOfDate, currency, "BOND_CREDIT",
    ["CFETS-SHCH-GTJA", "CFETS-SHCH-GTJA", "CFETS-SHCH-GTJA"],
    ["CREDIT_DEFAULT_SWAP", "CREDIT_DEFAULT_SWAP", "CREDIT_DEFAULT_SWAP"],
    ["1Y", "3Y", "5Y"],
    [0.0080, 0.0100, 0.0120],
    ["SPOTSTART", "SPOTSTART", "SPOTSTART"],
    "CR_CREDIT_PAR_CURVE", true);

creditCurve = caplib::buildCreditCurve(
    asOfDate, creditParCurve[0], discountCurve, "BOND_CREDIT",
    "BOOTSTRAPPING_METHOD", "CR_CREDIT_CURVE", true);

mktData = caplib::createCrMktDataSet(
    asOfDate, discountCurve, creditCurve[0], "CR_MKT_NAME", "CR_MKT", true);

cds = caplib::buildCreditDefaultSwap(
    1000000.0, currency, 2019.06.20, 2024.06.20,
    "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4,
    0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY",
    "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0,
    "CR_CDS_NAME", "CR_CDS", false);

// ============================================================================
// Tests

// 用例目的：-> [handle, present_value reference]（预期：插件按文档行为执行）
@testing:case="priceCreditDefaultSwap -> [handle, present_value reference]"
cdsPricingResult = caplib::priceCreditDefaultSwap(cds, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", true);
assert 1, isPricingResultsJson(cdsPricingResult, "CR_CDS_results")
assert 2, abs(presentValue(cdsPricingResult) - -4324.565959039959) < abs(-4324.565959039959) * 1.0e-9 + 1.0e-6

// 用例目的：rejects wrong mktData handle（预期：插件按文档行为执行）
@testing:case="priceCreditDefaultSwap rejects wrong mktData handle", exception=1
caplib::priceCreditDefaultSwap(cds, asOfDate, discountCurve, pricingSettings[0], crRisk[0], "", "", true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="priceCreditDefaultSwap rejects missing argument", syntaxError=1
caplib::priceCreditDefaultSwap("X", 2024.01.01, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="priceCreditDefaultSwap rejects extra argument", syntaxError=1
caplib::priceCreditDefaultSwap("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

// 用例目的：参数 pricingDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects wrong type for pricingDate", exception=1
caplib::priceCreditDefaultSwap("X", "bad", "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects wrong type for mode", exception=1
caplib::priceCreditDefaultSwap("X", 2024.01.01, "X", "X", "X", "X", 1, false)

// 用例目的：参数 pricingDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects null pricingDate", exception=1
caplib::priceCreditDefaultSwap("X", date(), "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects null mode", exception=1
caplib::priceCreditDefaultSwap("X", 2024.01.01, "X", "X", "X", "X", string(), false)

// 用例目的：标量参数 pricingDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects vector for scalar pricingDate", exception=1
caplib::priceCreditDefaultSwap("X", [2024.01.01], "X", "X", "X", "X", "X", false)

// 用例目的：句柄参数 instrumentHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects nonexistent handle instrumentHandle", exception=1
caplib::priceCreditDefaultSwap("TF_NO_SUCH_HANDLE_priceCreditDefaultSwap", 2024.01.01, "X", "X", "X", "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="priceCreditDefaultSwap rejects keyword arguments", syntaxError=1
caplib::priceCreditDefaultSwap(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="priceCreditDefaultSwap optional returnJson null uses default"
result = caplib::priceCreditDefaultSwap(cds, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 mktDataHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="priceCreditDefaultSwap rejects wrong object type for mktDataHandle", exception=1
caplib::priceCreditDefaultSwap(cds, asOfDate, cds, pricingSettings[0], crRisk[0], "", "", true)

// 用例目的：相同输入连续定价两次，验证两次现值完全一致（定价确定性）
@testing:case="priceCreditDefaultSwap deterministic repeat -> identical result"
r1 = caplib::priceCreditDefaultSwap(cds, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", true);
r2 = caplib::priceCreditDefaultSwap(cds, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", true);
print("FLAKE-DEBUG pv1=" + string(presentValue(r1)) + " pv2=" + string(presentValue(r2)) + " diff=" + string(abs(presentValue(r1) - presentValue(r2))));
assert 1, abs(presentValue(r1) - presentValue(r2)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)

// ----------------------------------------------------------------------------
// 用例目的：以 2 倍名义重建同一 CDS 并定价，验证现值随名义线性缩放（输入影响输出）
@testing:case="priceCreditDefaultSwap notional x2 -> 2x present value"
r1 = caplib::priceCreditDefaultSwap(cds, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", true);
cds2X = caplib::buildCreditDefaultSwap(
    2000000.0, currency, 2019.06.20, 2024.06.20,
    "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4,
    0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY",
    "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0,
    "CR_CDS_NAME", "CR_CDS", false);
r2 = caplib::priceCreditDefaultSwap(cds2X, asOfDate, mktData[0], pricingSettings[0], crRisk[0], "", "", true);
assert 1, abs(presentValue(r2) - 2.0 * presentValue(r1)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)
