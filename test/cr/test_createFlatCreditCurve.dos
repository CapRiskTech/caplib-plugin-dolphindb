// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

// ============================================================================
// Tests
// ============================================================================

@testing:case="createFlatCreditCurve valid call"
result = caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CR_CURVE", false)
assert 1, result == "TF_FLAT_CR_CURVE"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="createFlatCreditCurve rejects missing argument", syntaxError=1
caplib::createFlatCreditCurve(asOfDate, 0.002)

@testing:case="createFlatCreditCurve rejects extra argument", syntaxError=1
caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CR_CURVE", false, 1)

@testing:case="createFlatCreditCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatCreditCurve("bad", 0.002, "TF_FLAT_CR_CURVE", false)

@testing:case="createFlatCreditCurve rejects wrong type for hazardRate", exception=1
caplib::createFlatCreditCurve(asOfDate, "bad", "TF_FLAT_CR_CURVE", false)

@testing:case="createFlatCreditCurve rejects null referenceDate", exception=1
caplib::createFlatCreditCurve(date(), 0.002, "TF_FLAT_CR_CURVE", false)

@testing:case="createFlatCreditCurve rejects null hazardRate", exception=1
caplib::createFlatCreditCurve(asOfDate, double(), "TF_FLAT_CR_CURVE", false)

@testing:case="createFlatCreditCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatCreditCurve([2024.01.01], 0.002, "TF_FLAT_CR_CURVE", false)

@testing:case="createFlatCreditCurve rejects keyword arguments", syntaxError=1
caplib::createFlatCreditCurve(referenceDate=asOfDate, hazardRate=0.002, handle="TF_FLAT_CR_CURVE", returnJson=false)
