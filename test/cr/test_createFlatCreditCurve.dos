// ============================================================================
// test_createFlatCreditCurve.dos
// Per-function test suite for caplib::createFlatCreditCurve (cr).
// Signature: caplib::createFlatCreditCurve(referenceDate DATE, hazardRate DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createFlatCreditCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createFlatCreditCurve -> handle"
result = caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CR", false)
assert 1, result == "TF_FLAT_CR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createFlatCreditCurve rejects missing argument", syntaxError=1
caplib::createFlatCreditCurve(2024.01.01, 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createFlatCreditCurve rejects extra argument", syntaxError=1
caplib::createFlatCreditCurve(2024.01.01, 0.02, "TF_createFlatCreditCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects wrong type for referenceDate", exception=1
caplib::createFlatCreditCurve("bad", 0.02, "TF_createFlatCreditCurve_H", false)

// 用例目的：参数 hazardRate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects wrong type for hazardRate", exception=1
caplib::createFlatCreditCurve(2024.01.01, "bad", "TF_createFlatCreditCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects null referenceDate", exception=1
caplib::createFlatCreditCurve(date(), 0.02, "TF_createFlatCreditCurve_H", false)

// 用例目的：参数 hazardRate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects null hazardRate", exception=1
caplib::createFlatCreditCurve(2024.01.01, double(), "TF_createFlatCreditCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects vector for scalar referenceDate", exception=1
caplib::createFlatCreditCurve([2024.01.01], 0.02, "TF_createFlatCreditCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createFlatCreditCurve rejects keyword arguments", syntaxError=1
caplib::createFlatCreditCurve(referenceDate=2024.01.01, hazardRate=0.02, handle="TF_createFlatCreditCurve_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createFlatCreditCurve optional returnJson null uses default"
result = caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CR", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 hazardRate 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createFlatCreditCurve rejects negative hazardRate", exception=1
caplib::createFlatCreditCurve(asOfDate, -1.0, "TF_FLAT_CR", false)

