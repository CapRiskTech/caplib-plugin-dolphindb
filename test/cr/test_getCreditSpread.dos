// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

flatCreditCurve = caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CREDIT_CURVE", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getCreditSpread -> flat hazard reference values"
creditSpreads = caplib::getCreditSpread(flatCreditCurve, curveDates);
assert 1, isDoubleVector(creditSpreads) &&
    abs(creditSpreads[0] - 0.002) < 1.0e-9 && abs(creditSpreads[1] - 0.002) < 1.0e-9

@testing:case="getCreditSpread rejects unknown handle", exception=1
caplib::getCreditSpread("TF_HANDLE_DOES_NOT_EXIST", curveDates)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getCreditSpread rejects missing argument", syntaxError=1
caplib::getCreditSpread("X")

@testing:case="getCreditSpread rejects extra argument", syntaxError=1
caplib::getCreditSpread("X", [2024.01.01], 1)

@testing:case="getCreditSpread rejects scalar for vector dates", exception=1
caplib::getCreditSpread("X", [2024.01.01])

@testing:case="getCreditSpread rejects partially-null vector dates", exception=1
caplib::getCreditSpread("X", [2024.01.01, date()])

@testing:case="getCreditSpread rejects empty vector dates", exception=1
caplib::getCreditSpread("X", take(date, 0))

@testing:case="getCreditSpread rejects nonexistent handle creditCurveHandle", exception=1
caplib::getCreditSpread("TF_HANDLE_DOES_NOT_EXIST", [2024.01.01])
