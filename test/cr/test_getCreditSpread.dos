// ============================================================================
// test_getCreditSpread.dos
// Per-function test suite for caplib::getCreditSpread (cr).
// Signature: caplib::getCreditSpread(creditCurveHandle STRING, dates DATE[])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_getCreditSpread.dos   // single file
