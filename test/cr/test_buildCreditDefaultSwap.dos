// 用例目的：参数 protectionLegRecoveryRate 传入低于业务下界 0 的 -0.1 —— 文档业务范围为 [0,1] 但包装器仅检查类型，实测宽松接受，记录实际行为
@testing:case="buildCreditDefaultSwap accepts protectionLegRecoveryRate below 0 (no business range validation)"
rCdsR3RecLo = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", -0.1, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_R3_RECLO", false)
