// 用例目的：参数 couponRate 传入 0 —— 实测包装器宽松接受，记录实际行为
@testing:case="buildCreditDefaultSwap accepts zero couponRate (no validation)"
rCdsR3Cpn0 = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.0, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_R3_CPN0", false)
assert 1, typestr(rCdsR3Cpn0) != "VOID"

// 用例目的：参数 couponRate 传入负值 —— 实测包装器宽松接受，记录实际行为
@testing:case="buildCreditDefaultSwap accepts negative couponRate (no validation)"
rCdsR3CpnN = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, -0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_R3_CPNN", false)
assert 1, typestr(rCdsR3CpnN) != "VOID"

// 用例目的：参数 couponRate 传入错误类型（该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects wrong type for couponRate", exception=1
caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, "bad", "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS", false)

