// ============================================================================
// test_buildCreditDefaultSwap.dos
// Per-function test suite for caplib::buildCreditDefaultSwap (cr).
// Signature: caplib::buildCreditDefaultSwap(nominal DOUBLE, currency STRING, issueDate DATE, maturity DATE, protectionLegPayReceive STRING, protectionLegSettlementType STRING, protectionLegReferencePrice DOUBLE, protectionLegLeverage DOUBLE, creditProtectionType STRING, protectionLegRecoveryRate DOUBLE, couponRate DOUBLE, creditPremiumType STRING, dayCountConvention STRING, frequency STRING, businessDayConvention STRING, calendars STRING, upfrontRate DOUBLE, rebateAccrual INT, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_buildCreditDefaultSwap.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

currency = "CNY";

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="buildCreditDefaultSwap -> handle"
b = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS", false);
assert 1, b == "TF_CDS"

// 用例目的：参数 notional 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects negative notional (lenient validation, does not raise)", exception=1
caplib::buildCreditDefaultSwap(-1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_BAD", false)
// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildCreditDefaultSwap rejects missing argument", syntaxError=1
caplib::buildCreditDefaultSwap(0.02, "X", 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildCreditDefaultSwap rejects extra argument", syntaxError=1
caplib::buildCreditDefaultSwap(0.02, "X", 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false, 1)

// 用例目的：参数 nominal 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects wrong type for nominal", exception=1
caplib::buildCreditDefaultSwap("bad", "X", 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects wrong type for currency", exception=1
caplib::buildCreditDefaultSwap(0.02, 1, 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：参数 issueDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects wrong type for issueDate", exception=1
caplib::buildCreditDefaultSwap(0.02, "X", "bad", 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：参数 nominal 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects null nominal", exception=1
caplib::buildCreditDefaultSwap(double(), "X", 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：参数 currency 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects null currency", exception=1
caplib::buildCreditDefaultSwap(0.02, string(), 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：标量参数 nominal 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects vector for scalar nominal", exception=1
caplib::buildCreditDefaultSwap([0.02], "X", 2024.01.01, 2024.01.01, "X", "X", 0.02, 0.02, "X", 0.02, 0.02, "X", "X", "X", "X", "X", 0.02, false, "TF_buildCreditDefaultSwap_H", "TF_buildCreditDefaultSwap_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildCreditDefaultSwap rejects keyword arguments", syntaxError=1
caplib::buildCreditDefaultSwap(nominal=0.02, currency="X", issueDate=2024.01.01, maturity=2024.01.01, protectionLegPayReceive="X", protectionLegSettlementType="X", protectionLegReferencePrice=0.02, protectionLegLeverage=0.02, creditProtectionType="X", protectionLegRecoveryRate=0.02, couponRate=0.02, creditPremiumType="X", dayCountConvention="X", frequency="X", businessDayConvention="X", calendars="X", upfrontRate=0.02, rebateAccrual=false, name="TF_buildCreditDefaultSwap_H", tag="TF_buildCreditDefaultSwap_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildCreditDefaultSwap optional returnJson null uses default"
result = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 nominal 传入0，验证数值边界校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects zero nominal", exception=1
caplib::buildCreditDefaultSwap(0.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS", false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="buildCreditDefaultSwap rejects negative nominal", exception=1
caplib::buildCreditDefaultSwap(-1.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.4, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS", false)

