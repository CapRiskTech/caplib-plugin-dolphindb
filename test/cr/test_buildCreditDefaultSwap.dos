// 用例目的：参数 protectionLegRecoveryRate 传入上边界 1.0，验证边界值被接受（预期：不抛异常）
@testing:case="buildCreditDefaultSwap accepts protectionLegRecoveryRate boundary 1.0"
rCdsR3RecB1 = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 1.0, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_R3_RECB1", false)
