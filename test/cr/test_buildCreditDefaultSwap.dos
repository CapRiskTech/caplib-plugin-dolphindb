@testing:case="buildCreditDefaultSwap accepts protectionLegRecoveryRate boundary 0.0"
rCdsR3RecB0 = caplib::buildCreditDefaultSwap(1000000.0, currency, 2019.06.20, 2024.06.20, "PAY", "CASH", 1.0, 1.0, "SENIOR", 0.0, 0.01, "FLAT_SPREAD", "ACT_360", "QUARTERLY", "MODIFIED_FOLLOWING", "CAL_CFETS", 0.01, 0, "TF_CDS_NAME", "TF_CDS_R3_RECB0", false)
