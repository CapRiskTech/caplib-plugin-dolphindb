// ============================================================================
// test_createCreditParCurve.dos
// Per-function test suite for caplib::createCreditParCurve (cr).
// Signature: caplib::createCreditParCurve(asOfDate DATE, currency STRING, curveName STRING, instrumentNames STRING[], instrumentTypes STRING[], maturities STRING[], quotes DOUBLE[], startConventions STRING[], handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCreditParCurve.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2020.02.21;
currency = "CNY";

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCreditParCurve -> handle"
result = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)
assert 1, result == "TF_CPC"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCreditParCurve rejects missing argument", syntaxError=1
caplib::createCreditParCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], ["X"])

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCreditParCurve rejects extra argument", syntaxError=1
caplib::createCreditParCurve(2024.01.01, "X", "X", ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for asOfDate", exception=1
caplib::createCreditParCurve("bad", "X", "X", ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：参数 currency 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for currency", exception=1
caplib::createCreditParCurve(2024.01.01, 1, "X", ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for curveName", exception=1
caplib::createCreditParCurve(2024.01.01, "X", 1, ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditParCurve rejects null asOfDate", exception=1
caplib::createCreditParCurve(date(), "X", "X", ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCreditParCurve rejects vector for scalar asOfDate", exception=1
caplib::createCreditParCurve([2024.01.01], "X", "X", ["X"], ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：向量参数 instrumentNames 传入部分空值的向量（五组向量长度保持一致，隔离长度不匹配影响），验证向量空值校验（预期：抛异常）
@testing:case="createCreditParCurve rejects partially-null vector instrumentNames", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA", string(), "CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)

// 用例目的：向量参数 instrumentNames 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createCreditParCurve rejects empty vector instrumentNames", exception=1
caplib::createCreditParCurve(2024.01.01, "X", "X", take(string, 0), ["X"], ["X"], [0.02], ["X"], "TF_createCreditParCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCreditParCurve rejects keyword arguments", syntaxError=1
caplib::createCreditParCurve(asOfDate=2024.01.01, currency="X", curveName="X", instrumentNames=["X"], instrumentTypes=["X"], maturities=["X"], quotes=[0.02], startConventions=["X"], handle="TF_createCreditParCurve_H", returnJson=false)
// 用例目的：向量参数 instrumentNames 传入全部空值的向量（五组向量长度一致）—— 实测插件抛异常，记录实际行为（预期：抛异常）
@testing:case="createCreditParCurve rejects all-null vector instrumentNames", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", [string(), string(), string()], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCreditParCurve optional returnJson null uses default"
result = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入错误类型（该传布尔值的传字符串），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for returnJson", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", "bad")

// ----------------------------------------------------------------------------
// 用例目的：两个成对数组参数长度不一致（instrumentTypes 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditParCurve rejects instrumentTypes length mismatch", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP", "EXTRA"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false);

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle 类型校验 / 枚举非法值
// ----------------------------------------------------------------------------

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for handle", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], 123, false)

// 用例目的：枚举向量参数 instrumentTypes 某元素传入非法标签 —— 包装层将未知标签回退（源码解析回退、不报错），验证宽松接受（预期：不抛异常）
@testing:case="createCreditParCurve accepts invalid enum for instrumentTypes (falls back to default)"
rCpcIt = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["NOT_A_REAL_ENUM","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC_FB_IT", false)
assert 1, typestr(rCpcIt) != "VOID"

// 用例目的：枚举向量参数 startConventions 某元素传入非法标签 —— 包装层将未知标签回退（源码解析回退、不报错），验证宽松接受（预期：不抛异常）
@testing:case="createCreditParCurve accepts invalid enum for startConventions (falls back to default)"
rCpcSc = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","NOT_A_REAL_ENUM","SPOTSTART"], "TF_CPC_FB_SC", false)
assert 1, typestr(rCpcSc) != "VOID"

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: 各向量参数长度关联与独立校验 / 期限格式 / 枚举逐值
// ----------------------------------------------------------------------------

// 用例目的：两个成对数组参数长度不一致（maturities 少一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditParCurve rejects maturities length mismatch", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)

// 用例目的：两个成对数组参数长度不一致（quotes 多一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditParCurve rejects quotes length mismatch", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012,0.014], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)

// 用例目的：两个成对数组参数长度不一致（startConventions 少一个元素），验证参数间关系校验（预期：抛异常）
@testing:case="createCreditParCurve rejects startConventions length mismatch", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART"], "TF_CPC", false)

// 用例目的：向量参数 maturities 传入错误类型的向量（INT 向量），验证元素类型校验（预期：抛异常）
@testing:case="createCreditParCurve rejects wrong type for maturities", exception=1
caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], [1, 3, 5], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC", false)

// 用例目的：向量参数 maturities 传入部分空值的向量 —— 实测包装器宽松接受，记录实际行为
@testing:case="createCreditParCurve accepts partially-null vector maturities (no validation)"
rCpcR3MatN = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y", string(), "5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC_R3_MATN", false)
assert 1, typestr(rCpcR3MatN) != "VOID"

// 用例目的：向量参数 maturities 传入不符合文档格式的字符串（小数 1.5Y）—— 实测包装器宽松接受，记录实际行为
@testing:case="createCreditParCurve accepts maturities fractional format 1.5Y (no validation)"
rCpcR3MatF = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1.5Y","3Y","5Y"], [0.008,0.010,0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC_R3_MATF", false)
