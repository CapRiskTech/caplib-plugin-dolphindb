rCpcR3Qn = caplib::createCreditParCurve(asOfDate, currency, "BOND_CREDIT", ["CFETS-SHCH-GTJA","CFETS-SHCH-GTJA","CFETS-SHCH-GTJA"], ["CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP","CREDIT_DEFAULT_SWAP"], ["1Y","3Y","5Y"], [0.008, double(), 0.012], ["SPOTSTART","SPOTSTART","SPOTSTART"], "TF_CPC_R3_QN", false)
