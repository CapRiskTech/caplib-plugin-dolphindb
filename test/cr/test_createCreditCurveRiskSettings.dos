// ============================================================================
// test_createCreditCurveRiskSettings.dos
// Per-function test suite for caplib::createCreditCurveRiskSettings (cr).
// Signature: caplib::createCreditCurveRiskSettings(delta BOOL, gamma BOOL, shift DOUBLE, method INT, granularity INT, scaling DOUBLE, threading INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCreditCurveRiskSettings.dos   // single file

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCreditCurveRiskSettings -> handle"
result = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "TF_CCR", false)
assert 1, result == "TF_CCR"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurveRiskSettings rejects missing argument", syntaxError=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCreditCurveRiskSettings rejects extra argument", syntaxError=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, 1, 1, 0.02, 1, "TF_createCreditCurveRiskSettings_H", false, 1)

// 用例目的：参数 shift 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects wrong type for shift", exception=1
caplib::createCreditCurveRiskSettings(false, false, "bad", 1, 1, 0.02, 1, "TF_createCreditCurveRiskSettings_H", false)

// 用例目的：参数 method 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects wrong type for method", exception=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, "1", 1, 0.02, 1, "TF_createCreditCurveRiskSettings_H", false)

// 用例目的：参数 granularity 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects wrong type for granularity", exception=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, 1, "1", 0.02, 1, "TF_createCreditCurveRiskSettings_H", false)

// 用例目的：参数 method 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects null method", exception=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, int(), 1, 0.02, 1, "TF_createCreditCurveRiskSettings_H", false)

// 用例目的：参数 granularity 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects null granularity", exception=1
caplib::createCreditCurveRiskSettings(false, false, 0.02, 1, int(), 0.02, 1, "TF_createCreditCurveRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCreditCurveRiskSettings rejects keyword arguments", syntaxError=1
caplib::createCreditCurveRiskSettings(delta=false, gamma=false, shift=0.02, method=1, granularity=1, scaling=0.02, threading=1, handle="TF_createCreditCurveRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCreditCurveRiskSettings optional returnJson null uses default"
result = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "TF_CCR", bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入错误类型（该传布尔值的传字符串），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects wrong type for returnJson", exception=1
caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, "TF_CCR", "bad")
// 用例目的：参数 scaling 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects zero scaling", exception=1
caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 0.0, 0, "TF_CCR", false)

// 用例目的：参数 scaling 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects negative scaling", exception=1
caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, -1.0, 0, "TF_CCR", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 delta 传入单元素向量，实测插件宽松接受——记录实际行为
@testing:case="createCreditCurveRiskSettings vector for scalar delta", exception=1
caplib::createCreditCurveRiskSettings([true], 1, 1.0e-4, 0, 1, 1.0e-4, 0, "TF_CCR", false);

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: handle 类型校验 / BOOL 拒绝 / 标志取值
// ----------------------------------------------------------------------------

// 用例目的：参数 handle 传入整数 123 —— 实测插件未对该参数做 STRING 判型，宽松接受不抛异常，记录实际行为
@testing:case="createCreditCurveRiskSettings accepts INT handle (no strict type check)"
rCCR_h = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 1.0e-4, 0, 123, false)
assert 1, typestr(rCCR_h) != "VOID"

// 用例目的：INT 参数 method 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects BOOL method", exception=1
caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, true, 1, 1.0e-4, 0, "TF_CCR", false)

// 用例目的：INT 参数 granularity 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createCreditCurveRiskSettings rejects BOOL granularity", exception=1
caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, true, 1.0e-4, 0, "TF_CCR", false)

// 用例目的：INT 参数 threading 传 BOOL 值 —— 实测插件未对该参数做 INT 判型，true 被当作 1 宽松接受不抛异常，记录实际行为
@testing:case="createCreditCurveRiskSettings accepts BOOL threading (no strict type check)"
rCCR_t = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 1, 1.0e-4, true, "TF_CCR", false)
assert 1, typestr(rCCR_t) != "VOID"

// 用例目的：method/granularity/threading 全取 0（映射为默认模式），验证零值合法且返回句柄
@testing:case="createCreditCurveRiskSettings accepts zero flags returns handle"
resZero = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 0, 0, 1.0e-4, 0, "TF_CCR_ZERO", false)
assert 1, typestr(resZero) != "VOID" && resZero == "TF_CCR_ZERO"

// 用例目的：method/granularity/threading 传非零 INT 2（映射为对应模式），验证不抛异常并返回句柄
@testing:case="createCreditCurveRiskSettings accepts nonzero INT flags"
resTwo = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, 2, 2, 1.0e-4, 2, "TF_CCR_NZ_TWO", false)
assert 1, typestr(resTwo) != "VOID" && resTwo == "TF_CCR_NZ_TWO"

// 用例目的：method/granularity/threading 传负非零 INT -1（映射为对应模式），验证不抛异常并返回句柄
@testing:case="createCreditCurveRiskSettings accepts negative nonzero INT flags"
resNeg = caplib::createCreditCurveRiskSettings(1, 1, 1.0e-4, -1, -1, 1.0e-4, -1, "TF_CCR_NZ_NEG", false)
assert 1, typestr(resNeg) != "VOID" && resNeg == "TF_CCR_NZ_NEG"
