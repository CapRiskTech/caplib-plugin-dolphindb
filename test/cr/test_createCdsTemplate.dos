// ============================================================================
// test_createCdsTemplate.dos
// Per-function test suite for caplib::createCdsTemplate (cr).
// Signature: caplib::createCdsTemplate(instName STRING, startDelay STRING or INT, settlementType STRING, referencePrice DOUBLE, leverage DOUBLE, creditProtectionType STRING, recoveryRate DOUBLE, creditPremiumType STRING, dayCountConvention STRING, frequency STRING, businessDayConvention STRING, calendars STRING or STRING[], rebateAccrual BOOL or INT[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCdsTemplate.dos   // single file

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

calCfets = "CAL_CFETS";

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCdsTemplate -> [handle, json]"
r = caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true);
assert 1, isHandleJson(r, "TF_CDS_TPL")

// 用例目的：rejects INT instrumentName（预期：插件按文档行为执行）
@testing:case="createCdsTemplate rejects INT instrumentName", exception=1
caplib::createCdsTemplate(1, "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：rejects invalid settlementType（预期：插件按文档行为执行）
@testing:case="createCdsTemplate rejects invalid settlementType", exception=1
caplib::createCdsTemplate("TF_CDS_TPL2", "1d", "NOT_A_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCdsTemplate rejects missing argument", syntaxError=1
caplib::createCdsTemplate("X", "X", "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCdsTemplate rejects extra argument", syntaxError=1
caplib::createCdsTemplate("X", "X", "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false, 1)

// 用例目的：参数 instName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for instName", exception=1
caplib::createCdsTemplate(1, "X", "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：参数 startDelay 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for startDelay", exception=1
caplib::createCdsTemplate("X", 1, "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：参数 settlementType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for settlementType", exception=1
caplib::createCdsTemplate("X", "X", 1, 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：参数 instName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCdsTemplate rejects null instName", exception=1
caplib::createCdsTemplate(string(), "X", "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：参数 startDelay 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCdsTemplate rejects null startDelay", exception=1
caplib::createCdsTemplate("X", string(), "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：标量参数 instName 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCdsTemplate rejects vector for scalar instName", exception=1
caplib::createCdsTemplate(["X"], "X", "X", 0.02, 0.02, "X", 0.02, "X", "X", "X", "X", "X", false, false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCdsTemplate rejects keyword arguments", syntaxError=1
caplib::createCdsTemplate(instName="X", startDelay="X", settlementType="X", referencePrice=0.02, leverage=0.02, creditProtectionType="X", recoveryRate=0.02, creditPremiumType="X", dayCountConvention="X", frequency="X", businessDayConvention="X", calendars="X", rebateAccrual=false, returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCdsTemplate optional returnJson null uses default"
result = caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, bool())
assert 1, typestr(result) != "VOID"

// 用例目的：可选参数 returnJson 传入错误类型（该传布尔值的传字符串），验证 BOOL 类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for returnJson", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, "bad")
// 用例目的：参数 referencePrice 传入 0，实测允许零值、正常创建模板（预期：不抛异常）
@testing:case="createCdsTemplate accepts zero referencePrice"
result = caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(result) != "VOID"

// 用例目的：参数 referencePrice 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createCdsTemplate rejects negative referencePrice", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", -1.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：calendars 传入全部空值的向量，验证空元素校验（预期：抛异常）
@testing:case="createCdsTemplate rejects all-null vector calendars", exception=1
caplib::createCdsTemplate("CFETS-SHCH-GTJA", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", [string(), string(), string()], false, true)

// 用例目的：对照评审要求补齐的空值/边界/枚举/句柄类型用例，验证参数校验（预期：抛异常）
@testing:case="createCdsTemplate rejects empty vector calendars", exception=1
caplib::createCdsTemplate("CFETS-SHCH-GTJA", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", take(string, 0), false, true)

// 用例目的：calendars 传入部分空值的向量，验证空元素校验（预期：抛异常）
@testing:case="createCdsTemplate rejects partially-null vector calendars", exception=1
caplib::createCdsTemplate("CFETS-SHCH-GTJA", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", [calCfets, string()], false, true)

// ----------------------------------------------------------------------------
// Review round-2 gap-fill: 枚举非法值
// ----------------------------------------------------------------------------

// 用例目的：枚举参数 creditProtectionType 传入非法值 —— 文档：其他未知值报错，验证枚举校验（预期：抛异常）
@testing:case="createCdsTemplate rejects invalid enum for creditProtectionType", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "NOT_A_REAL_ENUM", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：枚举参数 creditPremiumType 传入非法值 —— 文档：其他未知值报错，验证枚举校验（预期：抛异常）
@testing:case="createCdsTemplate rejects invalid enum for creditPremiumType", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "NOT_A_REAL_ENUM", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：枚举参数 dayCountConvention 传入非法取值 —— 文档：任何其他字符串均回退到函数指定的默认日计数，验证回退行为（预期：不抛异常）
@testing:case="createCdsTemplate accepts invalid enum for dayCountConvention (falls back to default)"
rCdsTDc = caplib::createCdsTemplate("TF_CDS_TPL_FB_DC", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "NOT_A_REAL_ENUM", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTDc) != "VOID"

// 用例目的：枚举参数 frequency 传入非法取值 —— 文档：任何其他字符串均回退到函数指定的默认频率，验证回退行为（预期：不抛异常）
@testing:case="createCdsTemplate accepts invalid enum for frequency (falls back to default)"
rCdsTFreq = caplib::createCdsTemplate("TF_CDS_TPL_FB_FREQ", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "NOT_A_REAL_ENUM", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTFreq) != "VOID"

// 用例目的：枚举参数 businessDayConvention 传入非法取值 —— 文档：任何其他字符串均回退到函数指定的默认营业日约定，验证回退行为（预期：不抛异常）
@testing:case="createCdsTemplate accepts invalid enum for businessDayConvention (falls back to default)"
rCdsTBdc = caplib::createCdsTemplate("TF_CDS_TPL_FB_BDC", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "NOT_A_REAL_ENUM", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTBdc) != "VOID"

// ----------------------------------------------------------------------------
// Review round-3 gap-fill: leverage/recoveryRate/rebateAccrual 校验 / 枚举逐值
// ----------------------------------------------------------------------------

// 用例目的：参数 leverage 传入 0 —— 实测包装器宽松接受，记录实际行为
@testing:case="createCdsTemplate accepts zero leverage (no validation)"
rCdsTR3Lev0 = caplib::createCdsTemplate("TF_CDS_TPL_R3_LEV0", "1d", "CASH_SETTLEMENT", 0.0, 0.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3Lev0) != "VOID"

// 用例目的：参数 leverage 传入负值 —— 实测包装器宽松接受，记录实际行为
@testing:case="createCdsTemplate accepts negative leverage (no validation)"
rCdsTR3LevN = caplib::createCdsTemplate("TF_CDS_TPL_R3_LEVN", "1d", "CASH_SETTLEMENT", 0.0, -1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3LevN) != "VOID"

// 用例目的：参数 leverage 传入错误类型（该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for leverage", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, "bad", "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：参数 leverage 传入空值，验证空值校验（预期：抛异常）
@testing:case="createCdsTemplate rejects null leverage", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, double(), "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：参数 recoveryRate 传入低于业务下界 0 的 -0.1 —— 文档业务范围为 [0,1] 但包装器仅检查类型，实测宽松接受，记录实际行为
@testing:case="createCdsTemplate accepts recoveryRate below 0 (no business range validation)"
rCdsTR3RecLo = caplib::createCdsTemplate("TF_CDS_TPL_R3_RECLO", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", -0.1, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3RecLo) != "VOID"

// 用例目的：参数 recoveryRate 传入高于业务上界 1 的 1.5 —— 实测包装器宽松接受，记录实际行为
@testing:case="createCdsTemplate accepts recoveryRate above 1 (no business range validation)"
rCdsTR3RecHi = caplib::createCdsTemplate("TF_CDS_TPL_R3_RECHI", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 1.5, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3RecHi) != "VOID"

// 用例目的：参数 recoveryRate 传入下边界 0.0，验证边界值被接受（预期：不抛异常）
@testing:case="createCdsTemplate accepts recoveryRate boundary 0.0"
rCdsTR3RecB0 = caplib::createCdsTemplate("TF_CDS_TPL_R3_RECB0", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.0, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3RecB0) != "VOID"

// 用例目的：参数 recoveryRate 传入上边界 1.0，验证边界值被接受（预期：不抛异常）
@testing:case="createCdsTemplate accepts recoveryRate boundary 1.0"
rCdsTR3RecB1 = caplib::createCdsTemplate("TF_CDS_TPL_R3_RECB1", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 1.0, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)
assert 1, typestr(rCdsTR3RecB1) != "VOID"

// 用例目的：参数 recoveryRate 传入错误类型（该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects wrong type for recoveryRate", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", "bad", "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], false, true)

// 用例目的：参数 rebateAccrual 传入错误类型（该传 BOOL/INT 的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCdsTemplate rejects STRING rebateAccrual", exception=1
caplib::createCdsTemplate("TF_CDS_TPL", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], "bad", true)

// 用例目的：参数 rebateAccrual 传入 INT 1 —— 文档接受 BOOL 或 INT，验证 INT 形式被接受（预期：不抛异常）
@testing:case="createCdsTemplate accepts INT rebateAccrual"
rCdsTR3RebI = caplib::createCdsTemplate("TF_CDS_TPL_R3_REBI", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], 1, true)
assert 1, typestr(rCdsTR3RebI) != "VOID"

// 用例目的：参数 rebateAccrual 传入空值 —— 实测包装器宽松接受，记录实际行为
