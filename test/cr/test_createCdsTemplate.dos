rCdsTR3RebN = caplib::createCdsTemplate("TF_CDS_TPL_R3_REBN", "1d", "CASH_SETTLEMENT", 0.0, 1.0, "PAY_PROTECTION_AT_MATURITY", 0.4, "PAY_PREMIUM_UPTO_CURRENT_PERIOD", "ACTUAL_360", "QUARTERLY", "MODIFIED_FOLLOWING", ["CAL_CFETS"], bool(), true)
assert 1, typestr(rCdsTR3RebN) != "VOID"

