// ============================================================================
// test_createCrRiskSettings.dos
// Per-function test suite for caplib::createCrRiskSettings (cr).
// Signature: caplib::createCrRiskSettings(irCurveSettings STRING, csCurveSettings STRING, thetaSettings STRING, name STRING, tag STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_createCrRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

irRisk = caplib::createIrCurveRiskSettings(
    1, 0, 0, 1.0e-4, 5.0e-1, 0, 1, 1.0e-4, 0, "CR_IR_RISK", false);
creditRisk = caplib::createCreditCurveRiskSettings(
    1, 0, 1.0e-4, 0, 1, 1.0e-4, 0, "CR_CREDIT_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "CR_THETA_RISK", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCrRiskSettings -> handle"
result = caplib::createCrRiskSettings(irRisk, creditRisk, thetaRisk, "TF_CRRISK", "TF_CRRISK", false)
assert 1, result == "TF_CRRISK"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCrRiskSettings rejects missing argument", syntaxError=1
caplib::createCrRiskSettings("X", "X", "X", "TF_createCrRiskSettings_H")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCrRiskSettings rejects extra argument", syntaxError=1
caplib::createCrRiskSettings("X", "X", "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false, 1)

// 用例目的：参数 irCurveSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects wrong type for irCurveSettings", exception=1
caplib::createCrRiskSettings(1, "X", "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：参数 csCurveSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects wrong type for csCurveSettings", exception=1
caplib::createCrRiskSettings("X", 1, "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：参数 thetaSettings 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects wrong type for thetaSettings", exception=1
caplib::createCrRiskSettings("X", "X", 1, "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：参数 irCurveSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects null irCurveSettings", exception=1
caplib::createCrRiskSettings(string(), "X", "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：参数 csCurveSettings 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects null csCurveSettings", exception=1
caplib::createCrRiskSettings("X", string(), "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：标量参数 irCurveSettings 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCrRiskSettings rejects vector for scalar irCurveSettings", exception=1
caplib::createCrRiskSettings(["X"], "X", "X", "TF_createCrRiskSettings_H", "TF_createCrRiskSettings_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCrRiskSettings rejects keyword arguments", syntaxError=1
caplib::createCrRiskSettings(irCurveSettings="X", csCurveSettings="X", thetaSettings="X", name="TF_createCrRiskSettings_H", tag="TF_createCrRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCrRiskSettings optional returnJson null uses default"
result = caplib::createCrRiskSettings(irRisk, creditRisk, thetaRisk, "TF_CRRISK", "TF_CRRISK", bool())
assert 1, typestr(result) != "VOID"
