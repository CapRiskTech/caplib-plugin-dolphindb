// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

def isDoubleVector(value) {
    return strpos(typestr(value), "DOUBLE VECTOR") >= 0;
}

def isMatrix(value) {
    return strpos(typestr(value), "MATRIX") >= 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
curveDates = [2022.03.10, 2025.03.10];
curveValues = [0.02, 0.025];

flatCreditCurve = caplib::createFlatCreditCurve(asOfDate, 0.002, "TF_FLAT_CREDIT_CURVE", false);

// ============================================================================
// Tests
// ============================================================================

@testing:case="getSurvivalProbability -> flat hazard reference values"
survivalProbabilities = caplib::getSurvivalProbability(flatCreditCurve, curveDates);
assert 1, isDoubleVector(survivalProbabilities) &&
    abs(survivalProbabilities[0] - 0.9999945205629573) < 1.0e-9 &&
    abs(survivalProbabilities[1] - 0.9940070707660733) < 1.0e-9

@testing:case="getSurvivalProbability rejects unknown handle", exception=1
caplib::getSurvivalProbability("TF_HANDLE_DOES_NOT_EXIST", curveDates)

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

@testing:case="getSurvivalProbability rejects missing argument", syntaxError=1
caplib::getSurvivalProbability("X")

@testing:case="getSurvivalProbability rejects extra argument", syntaxError=1
caplib::getSurvivalProbability("X", [2024.01.01], 1)

@testing:case="getSurvivalProbability rejects scalar for vector dates", exception=1
caplib::getSurvivalProbability("X", [2024.01.01])

@testing:case="getSurvivalProbability rejects partially-null vector dates", exception=1
caplib::getSurvivalProbability("X", [2024.01.01, date()])

@testing:case="getSurvivalProbability rejects empty vector dates", exception=1
caplib::getSurvivalProbability("X", take(date, 0))

@testing:case="getSurvivalProbability rejects nonexistent handle creditCurveHandle", exception=1
caplib::getSurvivalProbability("TF_HANDLE_DOES_NOT_EXIST", [2024.01.01])
