// ============================================================================
// test_buildBondCreditSpreadCurve.dos
// Per-function test suite for caplib::buildBondCreditSpreadCurve (cr).
// Signature: caplib::buildBondCreditSpreadCurve(referenceDate DATE, curveName STRING, parCurveHandle STRING, discountCurveHandle STRING, forwardCurveHandle STRING, buildingMethod STRING, calcJacobian INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/cr")            // whole domain directory
//     python run_tests.py --file cr/test_buildBondCreditSpreadCurve.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

asOfDate = 2021.07.22;
currency = "CNY";

cnyTreasStdCfetsName = "cny_treas_std_cfets";
cnyTreasBondNames = [
    "CNY_TREAS_ZERO_1M",
    "CNY_TREAS_CPN_A_3M",
    "CNY_TREAS_CPN_A_6M",
    "CNY_TREAS_CPN_A_9M",
    "CNY_TREAS_CPN_A_1Y",
    "CNY_TREAS_CPN_A_2Y",
    "CNY_TREAS_CPN_A_3Y",
    "CNY_TREAS_CPN_A_5Y",
    "CNY_TREAS_CPN_SA_7Y",
    "CNY_TREAS_CPN_SA_10Y",
    "CNY_TREAS_CPN_SA_15Y",
    "CNY_TREAS_CPN_SA_20Y",
    "CNY_TREAS_CPN_SA_30Y"];
cnyTreasBondQuotes = [
    1.7112e-2, 1.8317e-2, 1.9413e-2, 1.9500e-2, 2.1563e-2,
    2.4985e-2, 2.5538e-2, 2.7550e-2, 2.9175e-2, 2.9263e-2,
    3.2984e-2, 3.3462e-2, 3.5023e-2];
parCnyTreasStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyTreasBondNames, cnyTreasBondQuotes,
    "YIELD_TO_MATURITY", cnyTreasStdCfetsName, true);
cnyTreasBuildSettings = caplib::createBondYieldCurveBuildSettings(
    cnyTreasStdCfetsName, "ZERO_RATE", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CNY_TREAS_STD_CFETS_BUILD_SETTINGS", true);

cnyMtnAaaSprdStdCfetsName = "cny_mtn_aaa_sprd_std_cfets";
cnyMtnBondNames = [
    "CNY_MTN_AAA_CPN_A_1M",
    "CNY_MTN_AAA_CPN_A_3M",
    "CNY_MTN_AAA_CPN_A_6M",
    "CNY_MTN_AAA_CPN_A_9M",
    "CNY_MTN_AAA_CPN_A_1Y",
    "CNY_MTN_AAA_CPN_A_2Y",
    "CNY_MTN_AAA_CPN_A_3Y",
    "CNY_MTN_AAA_CPN_A_4Y",
    "CNY_MTN_AAA_CPN_A_5Y",
    "CNY_MTN_AAA_CPN_A_7Y",
    "CNY_MTN_AAA_CPN_A_8Y",
    "CNY_MTN_AAA_CPN_A_9Y"];
cnyMtnBondQuotes = [
    0.022916, 0.024213, 0.025822, 0.026675, 0.027216, 0.028916,
    0.031112, 0.032824, 0.033816, 0.036816, 0.037026, 0.037311];
parCnyMtnAaaSprdStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyMtnBondNames, cnyMtnBondQuotes,
    "YIELD_TO_MATURITY", cnyMtnAaaSprdStdCfetsName, true);

cnyTreasStdCfets = caplib::buildBondYieldCurve(
    asOfDate, cnyTreasBuildSettings[0], cnyTreasStdCfetsName, parCnyTreasStdCfets[0],
    "ACT_365_FIXED", "CONTINUOUS_COMPOUNDING", "ANNUAL",
    "BOOTSTRAPPING_METHOD", 0, "", "CNY_TREAS_STD_CFETS", true);

cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="buildBondCreditSpreadCurve -> [handle, json]"
r = caplib::buildBondCreditSpreadCurve(asOfDate, "TF_FI_SPRD_NAME", parCnyMtnAaaSprdStdCfets[0], cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0, "TF_FI_SPRD", true);
assert 1, isHandleJson(r, "TF_FI_SPRD")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildBondCreditSpreadCurve rejects missing argument", syntaxError=1
caplib::buildBondCreditSpreadCurve(2024.01.01, "X", "X", "X", "X", "X", false)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildBondCreditSpreadCurve rejects extra argument", syntaxError=1
caplib::buildBondCreditSpreadCurve(2024.01.01, "X", "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects wrong type for referenceDate", exception=1
caplib::buildBondCreditSpreadCurve("bad", "X", "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：参数 curveName 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects wrong type for curveName", exception=1
caplib::buildBondCreditSpreadCurve(2024.01.01, 1, "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：参数 buildingMethod 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects wrong type for buildingMethod", exception=1
caplib::buildBondCreditSpreadCurve(2024.01.01, "X", "X", "X", "X", 1, false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects null referenceDate", exception=1
caplib::buildBondCreditSpreadCurve(date(), "X", "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：参数 curveName 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects null curveName", exception=1
caplib::buildBondCreditSpreadCurve(2024.01.01, string(), "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects vector for scalar referenceDate", exception=1
caplib::buildBondCreditSpreadCurve([2024.01.01], "X", "X", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：句柄参数 parCurveHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects nonexistent handle parCurveHandle", exception=1
caplib::buildBondCreditSpreadCurve(2024.01.01, "X", "TF_NO_SUCH_HANDLE_buildBondCreditSpreadCurve", "X", "X", "X", false, "TF_buildBondCreditSpreadCurve_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildBondCreditSpreadCurve rejects keyword arguments", syntaxError=1
caplib::buildBondCreditSpreadCurve(referenceDate=2024.01.01, curveName="X", parCurveHandle="X", discountCurveHandle="X", forwardCurveHandle="X", buildingMethod="X", calcJacobian=false, handle="TF_buildBondCreditSpreadCurve_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildBondCreditSpreadCurve optional returnJson null uses default"
result = caplib::buildBondCreditSpreadCurve(asOfDate, "TF_FI_SPRD_NAME", parCnyMtnAaaSprdStdCfets[0], cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0, "TF_FI_SPRD", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 discountCurveHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildBondCreditSpreadCurve rejects wrong object type for discountCurveHandle", exception=1
caplib::buildBondCreditSpreadCurve(asOfDate, "TF_FI_SPRD_NAME", parCnyMtnAaaSprdStdCfets[0], parCnyMtnAaaSprdStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0, "TF_FI_SPRD", true)
// 用例目的：正常调用，与独立来源的冻结参考值逐位对比，验证计算正确性
@testing:case="buildBondCreditSpreadCurve -> frozen curve reference"
csRef = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [2026.07.22]);
assert 1, abs(csRef[0] - 0.006076153038623) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：正常构建后经 getCreditSpread 在固定查询点取值，与冻结参考值对比，验证构建到查询的数值正确性
@testing:case="buildBondCreditSpreadCurve -> frozen getCreditSpread reference"
r = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [(asOfDate + 30)]);
assert 1, abs(r[0] - 0.005512316600411067) < 6.5123166004110675e-12

// ----------------------------------------------------------------------------
// 用例目的：相同输入连续构建两次，经 getCreditSpread 取值对比，验证构建结果确定性
@testing:case="buildBondCreditSpreadCurve deterministic repeat -> identical result"
cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);
r1 = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [(asOfDate + 30)]);
cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);
r2 = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [(asOfDate + 30)]);
assert 1, max(abs(r1 - r2)) < 1.0e-12

// ----------------------------------------------------------------------------
// 用例目的：将输入报价整体上浮 50% 后重建，验证 getCreditSpread 查询结果随输入变化
@testing:case="buildBondCreditSpreadCurve perturbed input -> getCreditSpread changes"
r1 = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [(asOfDate + 30)]);
cnyMtnBondQuotes = [
    0.034374, 0.0363195, 0.038733000000000004, 0.0400125, 0.040824, 0.043374,
    0.046668, 0.049236, 0.050724, 0.055224, 0.055539000000000005, 0.055966499999999995];
parCnyMtnAaaSprdStdCfets = caplib::createBondParCurve(
    asOfDate, currency, cnyMtnBondNames, cnyMtnBondQuotes,
    "YIELD_TO_MATURITY", cnyMtnAaaSprdStdCfetsName, true);
cnyMtnAaaSprdStdCfets = caplib::buildBondCreditSpreadCurve(
    asOfDate, cnyMtnAaaSprdStdCfetsName, parCnyMtnAaaSprdStdCfets[0],
    cnyTreasStdCfets[0], "", "BOOTSTRAPPING_METHOD", 0,
    "CNY_MTN_AAA_SPRD_STD_CFETS", true);
r2 = caplib::getCreditSpread(cnyMtnAaaSprdStdCfets[0], [(asOfDate + 30)]);
assert 1, max(abs(r1 - r2)) > 1.0e-12
