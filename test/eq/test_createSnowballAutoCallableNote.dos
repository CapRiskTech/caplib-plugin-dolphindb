// 用例目的：knockOutBarrierType 枚举逐值验证（文档 12 个合法值，预期接受）
@testing:case="createSnowballAutoCallableNote supports knockOutBarrierType value DOWN_IN"
r = caplib::createSnowballAutoCallableNote(0.12, 2020.02.21, couponDates, "ACT_365_FIXED", "DOWN_IN", underlyingPrice*0.95, "DOWN_IN", underlyingPrice*0.8, "SELL", "PUT", underlyingPrice, 1.0, underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SN_kobt_1", couponDates, couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"
@testing:case="createSnowballAutoCallableNote supports knockOutBarrierType value UAI"
r = caplib::createSnowballAutoCallableNote(0.12, 2020.02.21, couponDates, "ACT_365_FIXED", "UAI", underlyingPrice*1.05, "DOWN_IN", underlyingPrice*0.8, "SELL", "PUT", underlyingPrice, 1.0, underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SN_kobt_2", couponDates, couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"
