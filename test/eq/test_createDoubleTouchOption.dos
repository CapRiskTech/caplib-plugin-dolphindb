caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", 0.0, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT", false)

