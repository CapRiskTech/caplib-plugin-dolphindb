// ============================================================================
// test_createDoubleTouchOption.dos
// Per-function test suite for caplib::createDoubleTouchOption (eq).
// Signature: caplib::createDoubleTouchOption(expiry DATE, delivery DATE, lowerBarrierType STRING, lowerBarrierValue DOUBLE, upperBarrierType STRING, upperBarrierValue DOUBLE, barrierObsType STRING, paymentType STRING, cash DOUBLE, asset DOUBLE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createDoubleTouchOption.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createDoubleTouchOption -> handle"
result = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT", false)
assert 1, result == "f_DT"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createDoubleTouchOption rejects missing argument", syntaxError=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createDoubleTouchOption rejects extra argument", syntaxError=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects wrong type for expiry", exception=1
caplib::createDoubleTouchOption("bad", 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects wrong type for delivery", exception=1
caplib::createDoubleTouchOption(2024.01.01, "bad", "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 lowerBarrierType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects wrong type for lowerBarrierType", exception=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, 1, 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects null expiry", exception=1
caplib::createDoubleTouchOption(date(), 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects null delivery", exception=1
caplib::createDoubleTouchOption(2024.01.01, date(), "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 expiry 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects vector for scalar expiry", exception=1
caplib::createDoubleTouchOption([2024.01.01], 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects scalar for vector fixingDates", exception=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects partially-null vector fixingDates", exception=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects empty vector fixingDates", exception=1
caplib::createDoubleTouchOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createDoubleTouchOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createDoubleTouchOption rejects keyword arguments", syntaxError=1
caplib::createDoubleTouchOption(expiry=2024.01.01, delivery=2024.01.01, lowerBarrierType="X", lowerBarrierValue=0.02, upperBarrierType="X", upperBarrierValue=0.02, barrierObsType="X", paymentType="X", cash=0.02, asset=0.02, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createDoubleTouchOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createDoubleTouchOption optional returnJson null uses default"
result = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT", bool())
assert 1, typestr(result) != "VOID"

