@testing:case="createDoubleTouchOption rejects non-BOOL returnJson", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT_rb", "true")

// 用例目的：枚举参数 lowerBarrierType 传入非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects illegal lowerBarrierType", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "BAD", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT_badlt", false)

// 用例目的：枚举参数 upperBarrierType 传入非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects illegal upperBarrierType", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "BAD", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT_badut", false)

// 用例目的：枚举参数 barrierObsType 传入非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects illegal barrierObsType", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "BAD", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT_badobs", false)

// 用例目的：枚举参数 paymentType 传入非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects illegal paymentType", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "BAD", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_DT_badpay", false)

// 用例目的：枚举参数 underlyingType 传入非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createDoubleTouchOption rejects illegal underlyingType", exception=1
caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "BAD_TYPE", "CNY", "50ETF.SSE", "f_DT_badut2", false)

// 用例目的：遍历 lowerBarrierType 全部合法方向枚举值，验证均被接受
@testing:case="createDoubleTouchOption accepts all legal lowerBarrierType values"
barTypesArr = ["DOWN_IN", "UAI", "DOWN_AND_IN", "UP_IN", "DAO", "UP_AND_IN", "DOWN_OUT", "DAI", "DOWN_AND_OUT", "UP_OUT", "UAO", "UP_AND_OUT"]
for (btVal in barTypesArr) {
    tmpH = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, btVal, underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "FDT_l_" + btVal, false);
}
assert 1, true

// 用例目的：遍历 upperBarrierType 全部合法方向枚举值，验证均被接受
@testing:case="createDoubleTouchOption accepts all legal upperBarrierType values"
for (btVal in barTypesArr) {
    tmpH = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, btVal, underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "FDT_u_" + btVal, false);
}
assert 1, true

// 用例目的：遍历 paymentType 全部合法非空枚举值，验证均被接受
@testing:case="createDoubleTouchOption accepts all legal paymentType values"
payTypesArr = ["PAY_AT_HIT", "PAH", "PAY_AT_MATURITY", "PAM"]
for (ptVal in payTypesArr) {
    tmpH = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", ptVal, 1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "FDTpay_" + ptVal, false);
}
assert 1, true

// 用例目的：遍历 underlyingType 全部合法枚举值，验证均被接受
@testing:case="createDoubleTouchOption accepts all legal underlyingType values"
for (utVal in ["SPOT", "FUTURE", "FORWARD"]) {
    tmpH = caplib::createDoubleTouchOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 1.0, 0.0, 1, 1e6, "CNY", utVal, "CNY", "50ETF.SSE", "FDTut_" + utVal, false);
}
assert 1, true

