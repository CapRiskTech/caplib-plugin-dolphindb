// ============================================================================
// test_createPingPongOption.dos
// Per-function test suite for caplib::createPingPongOption (eq).
// Signature: caplib::createPingPongOption(expiry DATE, delivery DATE, lowerBarrierType STRING, lowerBarrierValue DOUBLE, upperBarrierType STRING, upperBarrierValue DOUBLE, barrierObsType STRING, paymentType STRING, cash DOUBLE, asset DOUBLE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createPingPongOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

dailyObsDates = 2020.02.22..2020.08.19;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createPingPongOption -> handle"
result = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, result == "f_PP"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createPingPongOption rejects missing argument", syntaxError=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createPingPongOption rejects extra argument", syntaxError=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createPingPongOption rejects wrong type for expiry", exception=1
caplib::createPingPongOption("bad", 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createPingPongOption rejects wrong type for delivery", exception=1
caplib::createPingPongOption(2024.01.01, "bad", "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 lowerBarrierType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createPingPongOption rejects wrong type for lowerBarrierType", exception=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, 1, 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createPingPongOption rejects null expiry", exception=1
caplib::createPingPongOption(date(), 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createPingPongOption rejects null delivery", exception=1
caplib::createPingPongOption(2024.01.01, date(), "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 expiry 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createPingPongOption rejects vector for scalar expiry", exception=1
caplib::createPingPongOption([2024.01.01], 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createPingPongOption rejects scalar for vector fixingDates", exception=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", 2024.01.01, [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createPingPongOption rejects partially-null vector fixingDates", exception=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createPingPongOption rejects empty vector fixingDates", exception=1
caplib::createPingPongOption(2024.01.01, 2024.01.01, "X", 0.02, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createPingPongOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createPingPongOption rejects keyword arguments", syntaxError=1
caplib::createPingPongOption(expiry=2024.01.01, delivery=2024.01.01, lowerBarrierType="X", lowerBarrierValue=0.02, upperBarrierType="X", upperBarrierValue=0.02, barrierObsType="X", paymentType="X", cash=0.02, asset=0.02, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createPingPongOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：向量 fixingDates 传入全空值，验证向量空值校验（预期：抛异常；第三轮 review 修正用例名与预期一致）
@testing:case="createPingPongOption rejects all-null vector fixingDates", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", [date(), date(), date()], dailyObsValues, dailyObsWeights, false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createPingPongOption optional returnJson null uses default"
result = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 asset 传入 0，实测允许零值、正常创建期权（预期：不抛异常）
@testing:case="createPingPongOption accepts zero asset"
result = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：参数 asset 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createPingPongOption rejects negative asset", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, -1, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：可选参数 returnJson 传入字符串 "true"，验证 BOOL 类型校验收紧（预期：抛异常）
@testing:case="createPingPongOption rejects non-BOOL returnJson", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_JB", dailyObsDates, dailyObsValues, dailyObsWeights, "true")

// 用例目的：lowerBarrierType 传入与文档不符的非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createPingPongOption rejects invalid lowerBarrierType", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN_BAD", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_E1", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：barrierObsType 传入与文档不符的非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createPingPongOption rejects invalid barrierObsType", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_BAD", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_E2", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：paymentType 传入与文档不符的非法拼写，验证枚举校验（预期：抛异常）
@testing:case="createPingPongOption rejects invalid paymentType", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_BAD", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_E3", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：underlyingType 传入与文档不符的非法拼写（非大写别名），验证枚举校验（预期：抛异常）
@testing:case="createPingPongOption rejects invalid underlyingType", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOTX", "CNY", "50ETF.SSE", "f_PP_E4", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：遍历 lowerBarrierType 文档列出的全部合法值，全部接受
@testing:case="createPingPongOption lowerBarrierType legal-value iteration"
i = 0
for (v in ["DOWN_IN", "UAI", "DOWN_AND_IN", "UP_IN", "DAO", "UP_AND_IN", "DOWN_OUT", "DAI", "DOWN_AND_OUT", "UP_OUT", "UAO", "UP_AND_OUT"]) {
    h = "f_PP_LB_" + i
    r = caplib::createPingPongOption(2020.08.19, 2020.08.20, v, underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", h, dailyObsDates, dailyObsValues, dailyObsWeights, false)
    i += 1
}
assert 1, r == h

// 用例目的：遍历 barrierObsType 文档列出的全部合法值，全部接受
@testing:case="createPingPongOption barrierObsType legal-value iteration"
i = 0
for (v in ["CONTINUOUS", "CONTINUOUS_OBSERVATION_TYPE", "DISCRETE", "DISCRETE_OBSERVATION_TYPE", ""]) {
    h = "f_PP_BO_" + i
    r = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, v, "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", h, dailyObsDates, dailyObsValues, dailyObsWeights, false)
    i += 1
}
assert 1, r == h

// 用例目的：遍历 paymentType 文档列出的全部合法值，全部接受
@testing:case="createPingPongOption paymentType legal-value iteration"
i = 0
for (v in ["PAY_AT_HIT", "PAH", "PAY_AT_MATURITY", "PAM", ""]) {
    h = "f_PP_PT_" + i
    r = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", v, 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", h, dailyObsDates, dailyObsValues, dailyObsWeights, false)
    i += 1
}
assert 1, r == h

// 用例目的：遍历 underlyingType 文档列出的全部合法值，全部接受
@testing:case="createPingPongOption underlyingType legal-value iteration"
i = 0
for (v in ["SPOT", "FUTURE", "FORWARD"]) {
    h = "f_PP_UT_" + i
    r = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", v, "CNY", "50ETF.SSE", h, dailyObsDates, dailyObsValues, dailyObsWeights, false)
    i += 1
}
assert 1, r == h

// 用例目的：参数 nominal 传入 0，验证边界校验（实测插件校验并抛 IllegalArgumentException）
@testing:case="createPingPongOption rejects zero nominal", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 0.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_N0", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：参数 nominal 传入负值，验证边界校验（实测插件校验并抛 IllegalArgumentException）
@testing:case="createPingPongOption rejects negative nominal", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, -1.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_NN", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：参数 lowerBarrierValue 传入 0，验证边界校验（实测插件校验并抛 IllegalArgumentException）
@testing:case="createPingPongOption rejects zero lowerBarrierValue", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", 0.0, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_LB0", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：参数 lowerBarrierValue 传入负值，验证边界校验（实测插件校验并抛 IllegalArgumentException）
@testing:case="createPingPongOption rejects negative lowerBarrierValue", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", -1.0, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_LBN", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：settlementDays 传入负值，实测插件宽松接受（记录实际行为）
@testing:case="createPingPongOption negative settlementDays (recording, does not raise)"
r = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, -1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_SD", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createPingPongOption rejects wrong type for handle", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", 123, dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 upperBarrierType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createPingPongOption rejects invalid enum for upperBarrierType", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "NOT_A_REAL_ENUM", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：INT 参数 settlementDays 传入 BOOL 值，验证类型校验（预期：抛异常）
@testing:case="createPingPongOption rejects BOOL settlementDays", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, true, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 第三轮 review gap-fill：日期先后关系 / 障碍价关联 / fixing 向量长度
// ----------------------------------------------------------------------------

// 用例目的：delivery（2020.08.18）早于 expiry（2020.08.19），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createPingPongOption delivery before expiry (no validation)"
result = caplib::createPingPongOption(2020.08.19, 2020.08.18, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_dbe", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：lowerBarrierValue 高于 upperBarrierValue，验证障碍价关联校验（实测记录行为）
@testing:case="createPingPongOption lowerBarrierValue above upperBarrierValue (no validation)"
result = caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*1.05, "UP_IN", underlyingPrice*0.95, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP_lb_gt_ub", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：单独改变 fixingDates 长度（比 fixingValues 多一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createPingPongOption rejects fixingDates length mismatch", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", join(dailyObsDates, 2020.08.20), dailyObsValues, dailyObsWeights, false)

// 用例目的：单独改变 fixingValues 长度（比 fixingDates 少一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createPingPongOption rejects fixingValues length mismatch", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues[0:(size(dailyObsValues)-1)], dailyObsWeights, false)

// 用例目的：单独改变 fixingWeights 长度（比 fixingDates 多一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createPingPongOption rejects fixingWeights length mismatch", exception=1
caplib::createPingPongOption(2020.08.19, 2020.08.20, "DOWN_IN", underlyingPrice*0.95, "UP_IN", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.015, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PP", dailyObsDates, dailyObsValues, join(dailyObsWeights, 1.0), false)

