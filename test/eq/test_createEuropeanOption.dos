// ============================================================================
// test_createEuropeanOption.dos
// Per-function test suite for caplib::createEuropeanOption (eq).
// Signature: caplib::createEuropeanOption(payoffType STRING, strike DOUBLE, expiry DATE, delivery DATE, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createEuropeanOption.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createEuropeanOption -> handle"
result = caplib::createEuropeanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_EO", false)
assert 1, result == "f_EO"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createEuropeanOption rejects missing argument", syntaxError=1
caplib::createEuropeanOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createEuropeanOption rejects extra argument", syntaxError=1
caplib::createEuropeanOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEuropeanOption rejects wrong type for payoffType", exception=1
caplib::createEuropeanOption(1, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：参数 strike 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEuropeanOption rejects wrong type for strike", exception=1
caplib::createEuropeanOption("X", "bad", 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEuropeanOption rejects wrong type for expiry", exception=1
caplib::createEuropeanOption("X", 0.02, "bad", 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEuropeanOption rejects null payoffType", exception=1
caplib::createEuropeanOption(string(), 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：参数 strike 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEuropeanOption rejects null strike", exception=1
caplib::createEuropeanOption("X", double(), 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEuropeanOption rejects vector for scalar payoffType", exception=1
caplib::createEuropeanOption(["X"], 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createEuropeanOption_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createEuropeanOption rejects keyword arguments", syntaxError=1
caplib::createEuropeanOption(payoffType="X", strike=0.02, expiry=2024.01.01, delivery=2024.01.01, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createEuropeanOption_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createEuropeanOption optional returnJson null uses default"
result = caplib::createEuropeanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_EO", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 nominal 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createEuropeanOption rejects zero nominal", exception=1
caplib::createEuropeanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 0.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_EO", false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createEuropeanOption rejects negative nominal", exception=1
caplib::createEuropeanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, -1.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_EO", false)

