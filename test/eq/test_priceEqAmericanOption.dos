// ============================================================================
// test_priceEqAmericanOption.dos
// Per-function test suite for caplib::priceEqAmericanOption (eq).
// Signature: caplib::priceEqAmericanOption(instrumentHandle STRING, pricingDate DATE, mktDataHandle STRING, pricingSettingsHandle STRING, riskSettingsHandle STRING, scnSettingsHandle STRING, mode STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_priceEqAmericanOption.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Helper predicates

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}

def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

currency = "CNY";
underlying = "50ETF.SSE";
asOfDate = 2020.02.21;
underlyingPrice = 2.958;

irDates = [2020.02.26, 2020.03.02, 2020.03.09, 2020.03.24, 2020.05.24,
           2020.08.24, 2020.11.24, 2021.02.24, 2022.02.24, 2023.02.24,
           2024.02.24, 2025.02.24, 2027.02.24, 2030.02.24];
irRates = [0.0135486283791684, 0.0197762034605164, 0.0197686053073393,
           0.0224838821372655, 0.0241740300538751, 0.0256822601972516,
           0.0265096948143765, 0.0271330931714993, 0.0274314991366822,
           0.0284834397783798, 0.0297276346662025, 0.0308410887945891,
           0.032692683803743, 0.034410206396147];
irCurve = caplib::createIrYieldCurve(
    asOfDate, irDates, irRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "IR_CURVE", false);

divDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
divValues = [0.05361055758784821, 0.01338941242891319,
             -0.001765240983827533, -0.002594662370949712];
divCurve = caplib::createDividendCurve(
    asOfDate, divDates, divValues, asOfDate,
    "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "DIVIDEND_CURVE_50ETF", "DIV_CURVE", false);

quoteTermDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
quoteStrikes = [
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4]
];
quotePrices = [
    [0.0002, 0.0002, 0.0002, 0.0002, 0.0004, 0.0008, 0.0015, 0.0023, 0.0065, 0.0184, 0.0053, 0.0012, 0.0005, 0.0001, 0.0001],
    [0.0027, 0.0033, 0.0040, 0.0054, 0.0081, 0.0113, 0.0172, 0.0270, 0.0400, 0.0608, 0.0498, 0.0216, 0.0110, 0.0066, 0.0046],
    [0.0201, 0.0230, 0.0281, 0.0345, 0.0433, 0.0541, 0.0668, 0.0818, 0.1004, 0.1229, 0.1325, 0.0935, 0.0659, 0.0470, 0.0330],
    [0.0365, 0.0434, 0.0516, 0.0612, 0.0724, 0.0862, 0.1015, 0.1184, 0.1381, 0.1595, 0.1930, 0.1483, 0.1298, 0.0897, 0.0702]
];
quotePayoffTypes = [
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"]
];

modelParams = [0.0];
bsmModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, modelParams, "BSM_MODEL", false);
bsmAnalyticalSettings = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, take(0, 0), bsmModel, "", "", "BSM_ANALYTICAL", false);

eqNoRisk = caplib::createEqRiskSettings(0, 0, 0, 0, "EQ_NO_RISK", true);

quantoIr = caplib::createIrYieldCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_FLAT_ZERO", "QUANTO_IR", false);
quantoFxVol = caplib::createVolatilityCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    underlying, "QUANTO_FX_VOL", false);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "VOL_SURF_DEF", true)
volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "VOL_SURF_BUILD_SETTINGS", true)
eqOptionQuotes = caplib::createEqOptionQuoteMatrix(
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    quoteTermDates, quotePayoffTypes, quotePrices, quoteStrikes,
    underlying, "EQ_OPTION_QUOTES", true)
volSurface = caplib::buildEqVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0],
    [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0],
    bsmAnalyticalSettings, "VOL_SURF", true)
mktData = caplib::createEqMktDataSet(
    asOfDate, underlying, underlyingPrice,
    irCurve, divCurve, volSurface[0],
    quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)

xinst = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "h2", false);

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回 PricingResults（含 present_value/cash_value/currency）
@testing:case="priceEqAmericanOption -> PricingResults"
result = caplib::priceEqAmericanOption(xinst, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true)
assert 1, isPricingResultsJson(result, "h2_results")

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="priceEqAmericanOption rejects missing argument", syntaxError=1
caplib::priceEqAmericanOption("X", 2024.01.01, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="priceEqAmericanOption rejects extra argument", syntaxError=1
caplib::priceEqAmericanOption("X", 2024.01.01, "X", "X", "X", "X", "X", false, 1)

// 用例目的：参数 pricingDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects wrong type for pricingDate", exception=1
caplib::priceEqAmericanOption("X", "bad", "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects wrong type for mode", exception=1
caplib::priceEqAmericanOption("X", 2024.01.01, "X", "X", "X", "X", 1, false)

// 用例目的：参数 pricingDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects null pricingDate", exception=1
caplib::priceEqAmericanOption("X", date(), "X", "X", "X", "X", "X", false)

// 用例目的：参数 mode 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects null mode", exception=1
caplib::priceEqAmericanOption("X", 2024.01.01, "X", "X", "X", "X", string(), false)

// 用例目的：标量参数 pricingDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects vector for scalar pricingDate", exception=1
caplib::priceEqAmericanOption("X", [2024.01.01], "X", "X", "X", "X", "X", false)

// 用例目的：句柄参数 instrumentHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects nonexistent handle instrumentHandle", exception=1
caplib::priceEqAmericanOption("TF_NO_SUCH_HANDLE_priceEqAmericanOption", 2024.01.01, "X", "X", "X", "X", "X", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="priceEqAmericanOption rejects keyword arguments", syntaxError=1
caplib::priceEqAmericanOption(instrumentHandle="X", pricingDate=2024.01.01, mktDataHandle="X", pricingSettingsHandle="X", riskSettingsHandle="X", scnSettingsHandle="X", mode="X", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="priceEqAmericanOption optional returnJson null uses default"
result = caplib::priceEqAmericanOption(xinst, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 mktDataHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="priceEqAmericanOption rejects wrong object type for mktDataHandle", exception=1
caplib::priceEqAmericanOption(xinst, asOfDate, xinst, bsmAnalyticalSettings, eqNoRisk[0], "", "", true)
// 用例目的：同一合约名义金额放大 2 倍，验证现值精确翻倍（现值对名义的线性性质）
@testing:case="priceEqAmericanOption notional scaling -> 2x notional, 2x present value"
xinst_2X = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, (1e6) * 2, "CNY", "SPOT", "CNY", "50ETF.SSE", "h2_2X", false);
p1 = caplib::priceEqAmericanOption(xinst, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true);
p2 = caplib::priceEqAmericanOption(xinst_2X, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true);
assert 1, abs(presentValue(p2) - 2.0 * presentValue(p1)) <= abs(presentValue(p1)) * 1.0e-9 + 1.0e-6

// 用例目的：相同输入连续定价两次，验证两次现值完全一致（定价确定性）
@testing:case="priceEqAmericanOption deterministic repeat -> identical result"
r1 = caplib::priceEqAmericanOption(xinst, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true);
r2 = caplib::priceEqAmericanOption(xinst, asOfDate, mktData[0], bsmAnalyticalSettings, eqNoRisk[0], "", "", true);
assert 1, abs(presentValue(r1) - presentValue(r2)) <= 1.0e-9 * (abs(presentValue(r1)) + 1.0)
