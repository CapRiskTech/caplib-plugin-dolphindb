// ============================================================================
// test_buildEqVolatilitySurface.dos
// Per-function test suite for caplib::buildEqVolatilitySurface (eq).
// Signature: caplib::buildEqVolatilitySurface(referenceDate DATE, underlying STRING, definitionHandle STRING, quoteMatrixHandle STRING, underlyingPrices DOUBLE[], discountCurveHandle STRING, dividendCurveHandle STRING, buildSettingsHandle STRING, pricingSettingsHandle STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_buildEqVolatilitySurface.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
asOfDate = 2020.02.21;
underlyingPrice = 2.958;

irDates = [2020.02.26, 2020.03.02, 2020.03.09, 2020.03.24, 2020.05.24,
           2020.08.24, 2020.11.24, 2021.02.24, 2022.02.24, 2023.02.24,
           2024.02.24, 2025.02.24, 2027.02.24, 2030.02.24];
irRates = [0.0135486283791684, 0.0197762034605164, 0.0197686053073393,
           0.0224838821372655, 0.0241740300538751, 0.0256822601972516,
           0.0265096948143765, 0.0271330931714993, 0.0274314991366822,
           0.0284834397783798, 0.0297276346662025, 0.0308410887945891,
           0.032692683803743, 0.034410206396147];
irCurve = caplib::createIrYieldCurve(
    asOfDate, irDates, irRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "IR_CURVE", false);

divDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
divValues = [0.05361055758784821, 0.01338941242891319,
             -0.001765240983827533, -0.002594662370949712];
divCurve = caplib::createDividendCurve(
    asOfDate, divDates, divValues, asOfDate,
    "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "DIVIDEND_CURVE_50ETF", "DIV_CURVE", false);

quoteTermDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
quoteStrikes = [
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4]
];
quotePrices = [
    [0.0002, 0.0002, 0.0002, 0.0002, 0.0004, 0.0008, 0.0015, 0.0023, 0.0065, 0.0184, 0.0053, 0.0012, 0.0005, 0.0001, 0.0001],
    [0.0027, 0.0033, 0.0040, 0.0054, 0.0081, 0.0113, 0.0172, 0.0270, 0.0400, 0.0608, 0.0498, 0.0216, 0.0110, 0.0066, 0.0046],
    [0.0201, 0.0230, 0.0281, 0.0345, 0.0433, 0.0541, 0.0668, 0.0818, 0.1004, 0.1229, 0.1325, 0.0935, 0.0659, 0.0470, 0.0330],
    [0.0365, 0.0434, 0.0516, 0.0612, 0.0724, 0.0862, 0.1015, 0.1184, 0.1381, 0.1595, 0.1930, 0.1483, 0.1298, 0.0897, 0.0702]
];
quotePayoffTypes = [
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"]
];

modelParams = [0.0];
bsmModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, modelParams, "BSM_MODEL", false);
bsmAnalyticalSettings = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, take(0, 0), bsmModel, "", "", "BSM_ANALYTICAL", false);

quantoIr = caplib::createIrYieldCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_FLAT_ZERO", "QUANTO_IR", false);
quantoFxVol = caplib::createVolatilityCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    underlying, "QUANTO_FX_VOL", false);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "VOL_SURF_DEF", true)
volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "VOL_SURF_BUILD_SETTINGS", true)
eqOptionQuotes = caplib::createEqOptionQuoteMatrix(
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    quoteTermDates, quotePayoffTypes, quotePrices, quoteStrikes,
    underlying, "EQ_OPTION_QUOTES", true)
volSurface = caplib::buildEqVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0],
    [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0],
    bsmAnalyticalSettings, "VOL_SURF", true)
mktData = caplib::createEqMktDataSet(
    asOfDate, underlying, underlyingPrice,
    irCurve, divCurve, volSurface[0],
    quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="buildEqVolatilitySurface -> handle"
result = caplib::buildEqVolatilitySurface(asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0], [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0], bsmAnalyticalSettings, "f_vol", false)
assert 1, result == "f_vol"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="buildEqVolatilitySurface rejects missing argument", syntaxError=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "X", "X", [0.02], "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="buildEqVolatilitySurface rejects extra argument", syntaxError=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false, 1)

// 用例目的：参数 referenceDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects wrong type for referenceDate", exception=1
caplib::buildEqVolatilitySurface("bad", "X", "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：参数 underlying 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects wrong type for underlying", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, 1, "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：参数 referenceDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects null referenceDate", exception=1
caplib::buildEqVolatilitySurface(date(), "X", "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：参数 underlying 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects null underlying", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, string(), "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：标量参数 referenceDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects vector for scalar referenceDate", exception=1
caplib::buildEqVolatilitySurface([2024.01.01], "X", "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：向量参数 underlyingPrices 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects scalar for vector underlyingPrices", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "X", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：向量参数 underlyingPrices 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects partially-null vector underlyingPrices", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "X", "X", [0.02, double()], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：向量参数 underlyingPrices 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects empty vector underlyingPrices", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "X", "X", take(double, 0), "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：句柄参数 definitionHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects nonexistent handle definitionHandle", exception=1
caplib::buildEqVolatilitySurface(2024.01.01, "X", "TF_NO_SUCH_HANDLE_buildEqVolatilitySurface", "X", [0.02], "X", "X", "X", "X", "TF_buildEqVolatilitySurface_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="buildEqVolatilitySurface rejects keyword arguments", syntaxError=1
caplib::buildEqVolatilitySurface(referenceDate=2024.01.01, underlying="X", definitionHandle="X", quoteMatrixHandle="X", underlyingPrices=[0.02], discountCurveHandle="X", dividendCurveHandle="X", buildSettingsHandle="X", pricingSettingsHandle="X", handle="TF_buildEqVolatilitySurface_H", returnJson=false)
// 用例目的：向量参数 underlyingPrices 传入全部空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects all-null vector underlyingPrices", exception=1
caplib::buildEqVolatilitySurface(asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0], [double(), double(), double()], irCurve, divCurve, volSurfBuildSettings[0], bsmAnalyticalSettings, "f_vol", false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="buildEqVolatilitySurface optional returnJson null uses default"
result = caplib::buildEqVolatilitySurface(asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0], [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0], bsmAnalyticalSettings, "f_vol", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 quoteMatrixHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="buildEqVolatilitySurface rejects wrong object type for quoteMatrixHandle", exception=1
caplib::buildEqVolatilitySurface(asOfDate, underlying, volSurfDefinition[0], volSurfDefinition[0], [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0], bsmAnalyticalSettings, "f_vol", false)

// ----------------------------------------------------------------------------
// 用例目的：正常构建后经 getVolatility 在固定查询点取值，与冻结参考值对比，验证构建到查询的数值正确性
@testing:case="buildEqVolatilitySurface -> frozen getVolatility reference"
r = caplib::getVolatility(volSurface[0], [2021.07.22], [100.0]);
assert 1, abs(r[0] - 0.260204641261014) < 2.61204641261014e-10

// ----------------------------------------------------------------------------
// 用例目的：相同输入连续构建两次，经 getVolatility 取值对比，验证构建结果确定性
@testing:case="buildEqVolatilitySurface deterministic repeat -> identical result"
volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "VOL_SURF_DEF", true)
volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "VOL_SURF_BUILD_SETTINGS", true)
eqOptionQuotes = caplib::createEqOptionQuoteMatrix(
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    quoteTermDates, quotePayoffTypes, quotePrices, quoteStrikes,
    underlying, "EQ_OPTION_QUOTES", true)
volSurface = caplib::buildEqVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0],
    [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0],
    bsmAnalyticalSettings, "VOL_SURF", true)
mktData = caplib::createEqMktDataSet(
    asOfDate, underlying, underlyingPrice,
    irCurve, divCurve, volSurface[0],
    quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）;
r1 = caplib::getVolatility(volSurface[0], [(asOfDate + 30)], [201.0]);
volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "VOL_SURF_DEF", true)
volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "VOL_SURF_BUILD_SETTINGS", true)
eqOptionQuotes = caplib::createEqOptionQuoteMatrix(
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    quoteTermDates, quotePayoffTypes, quotePrices, quoteStrikes,
    underlying, "EQ_OPTION_QUOTES", true)
volSurface = caplib::buildEqVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0],
    [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0],
    bsmAnalyticalSettings, "VOL_SURF", true)
mktData = caplib::createEqMktDataSet(
    asOfDate, underlying, underlyingPrice,
    irCurve, divCurve, volSurface[0],
    quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）;
r2 = caplib::getVolatility(volSurface[0], [(asOfDate + 30)], [201.0]);
assert 1, max(abs(r1 - r2)) < 1.0e-12
