// ============================================================================
// test_createEqRiskSettings.dos
// Per-function test suite for caplib::createEqRiskSettings (eq).
// Signature: caplib::createEqRiskSettings(irDelta INT, priceDelta INT, volVega INT, theta INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createEqRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createEqRiskSettings -> handle"
result = caplib::createEqRiskSettings(1, 1, 1, 1, "f_eqrisk", false)
assert 1, result == "f_eqrisk"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createEqRiskSettings rejects missing argument", syntaxError=1
caplib::createEqRiskSettings(false, false, false, false)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createEqRiskSettings rejects extra argument", syntaxError=1
caplib::createEqRiskSettings(false, false, false, false, "TF_createEqRiskSettings_H", false, 1)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createEqRiskSettings rejects keyword arguments", syntaxError=1
caplib::createEqRiskSettings(irDelta=false, priceDelta=false, volVega=false, theta=false, handle="TF_createEqRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createEqRiskSettings optional returnJson null uses default"
result = caplib::createEqRiskSettings(1, 1, 1, 1, "f_eqrisk", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for irDelta", exception=1
caplib::createEqRiskSettings("bad", 1, 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null irDelta", exception=1
caplib::createEqRiskSettings(int(), 1, 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for priceDelta", exception=1
caplib::createEqRiskSettings(1, "bad", 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null priceDelta", exception=1
caplib::createEqRiskSettings(1, int(), 1, 1, "f_eqrisk", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 irDelta 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects vector for scalar irDelta", exception=1
caplib::createEqRiskSettings([1], 1, 1, 1, "f_eqrisk", false);
