// ============================================================================
// test_createEqRiskSettings.dos
// Per-function test suite for caplib::createEqRiskSettings (eq).
// Signature: caplib::createEqRiskSettings(irDelta INT, priceDelta INT, volVega INT, theta INT, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createEqRiskSettings.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createEqRiskSettings -> handle"
result = caplib::createEqRiskSettings(1, 1, 1, 1, "f_eqrisk", false)
assert 1, result == "f_eqrisk"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createEqRiskSettings rejects missing argument", syntaxError=1
caplib::createEqRiskSettings(false, false, false, false)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createEqRiskSettings rejects extra argument", syntaxError=1
caplib::createEqRiskSettings(false, false, false, false, "TF_createEqRiskSettings_H", false, 1)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createEqRiskSettings rejects keyword arguments", syntaxError=1
caplib::createEqRiskSettings(irDelta=false, priceDelta=false, volVega=false, theta=false, handle="TF_createEqRiskSettings_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createEqRiskSettings optional returnJson null uses default"
result = caplib::createEqRiskSettings(1, 1, 1, 1, "f_eqrisk", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill-2: negative-case coverage (wrong type / null / arity / keyword)
// ----------------------------------------------------------------------------

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for irDelta", exception=1
caplib::createEqRiskSettings("bad", 1, 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null irDelta", exception=1
caplib::createEqRiskSettings(int(), 1, 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for priceDelta", exception=1
caplib::createEqRiskSettings(1, "bad", 1, 1, "f_eqrisk", false)

// 用例目的：参数传入错误类型/空值，验证类型与空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null priceDelta", exception=1
caplib::createEqRiskSettings(1, int(), 1, 1, "f_eqrisk", false)

// ----------------------------------------------------------------------------
// 用例目的：标量参数 irDelta 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects vector for scalar irDelta", exception=1
caplib::createEqRiskSettings([1], 1, 1, 1, "f_eqrisk", false);

// 用例目的：参数 volVega 传入错误类型（该传数值却传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for volVega", exception=1
caplib::createEqRiskSettings(1, 1, "bad", 1, "f_eqrisk", false)

// 用例目的：参数 volVega 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null volVega", exception=1
caplib::createEqRiskSettings(1, 1, int(), 1, "f_eqrisk", false)

// 用例目的：标量参数 volVega 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects vector for scalar volVega", exception=1
caplib::createEqRiskSettings(1, 1, [1], 1, "f_eqrisk", false)

// 用例目的：参数 theta 传入错误类型（该传数值却传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for theta", exception=1
caplib::createEqRiskSettings(1, 1, 1, "bad", "f_eqrisk", false)

// 用例目的：参数 theta 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects null theta", exception=1
caplib::createEqRiskSettings(1, 1, 1, int(), "f_eqrisk", false)

// 用例目的：标量参数 theta 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects vector for scalar theta", exception=1
caplib::createEqRiskSettings(1, 1, 1, [1], "f_eqrisk", false)

// 用例目的：参数 returnJson 传入非 BOOL 值（该传逻辑值却传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects non-bool returnJson", exception=1
caplib::createEqRiskSettings(1, 1, 1, 1, "f_eqrisk", "true")

// 用例目的：参数 irDelta 传入负值（INT 标量中非零即为 true），验证插件接受非零值记录实际行为
@testing:case="createEqRiskSettings accepts negative irDelta"
result = caplib::createEqRiskSettings(-1, 1, 1, 1, "f_eqrisk_neg", false)
assert 1, typestr(result) != "VOID"

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createEqRiskSettings rejects wrong type for handle", exception=1
caplib::createEqRiskSettings(1, 1, 1, 1, 123, false)

// 用例目的：irDelta 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createEqRiskSettings rejects BOOL irDelta", exception=1
caplib::createEqRiskSettings(true, 1, 1, 1, "TF_EQ_BOOL_IR", false)

// 用例目的：priceDelta 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createEqRiskSettings rejects BOOL priceDelta", exception=1
caplib::createEqRiskSettings(1, true, 1, 1, "TF_EQ_BOOL_PRICE", false)

// 用例目的：volVega 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createEqRiskSettings rejects BOOL volVega", exception=1
caplib::createEqRiskSettings(1, 1, true, 1, "TF_EQ_BOOL_VOL", false)

// 用例目的：theta 传 BOOL 值，验证文档所述「BOOL 被拒」（预期：抛异常）
@testing:case="createEqRiskSettings rejects BOOL theta", exception=1
caplib::createEqRiskSettings(1, 1, 1, true, "TF_EQ_BOOL_THETA", false)

// 用例目的：irDelta/priceDelta/volVega/theta 全取 0（视为 false），验证零值合法且返回句柄
@testing:case="createEqRiskSettings accepts zero flags returns handle"
resZero = caplib::createEqRiskSettings(0, 0, 0, 0, "EQ_RISK_ZERO", false)
assert 1, typestr(resZero) != "VOID" && resZero == "EQ_RISK_ZERO"

// 用例目的：四个标志传非零 INT 2（视为 true），验证不抛异常并返回句柄
@testing:case="createEqRiskSettings accepts nonzero INT flags"
resTwo = caplib::createEqRiskSettings(2, 2, 2, 2, "EQ_RISK_NZ_TWO", false)
assert 1, typestr(resTwo) != "VOID" && resTwo == "EQ_RISK_NZ_TWO"

// 用例目的：四个标志传负非零 INT -1（视为 true），验证不抛异常并返回句柄
@testing:case="createEqRiskSettings accepts negative nonzero INT flags"
resNeg = caplib::createEqRiskSettings(-1, -1, -1, -1, "EQ_RISK_NZ_NEG", false)
assert 1, typestr(resNeg) != "VOID" && resNeg == "EQ_RISK_NZ_NEG"
