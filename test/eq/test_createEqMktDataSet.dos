// ============================================================================
// test_createEqMktDataSet.dos
// Per-function test suite for caplib::createEqMktDataSet (eq).
// Signature: caplib::createEqMktDataSet(asOfDate DATE, underlying STRING, underlyingPrice DOUBLE, dcHandle STRING, divHandle STRING, volHandle STRING, quantoDcHandle STRING, quantoFxVolHandle STRING, quantoCorrelation DOUBLE, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createEqMktDataSet.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
asOfDate = 2020.02.21;
underlyingPrice = 2.958;

irDates = [2020.02.26, 2020.03.02, 2020.03.09, 2020.03.24, 2020.05.24,
           2020.08.24, 2020.11.24, 2021.02.24, 2022.02.24, 2023.02.24,
           2024.02.24, 2025.02.24, 2027.02.24, 2030.02.24];
irRates = [0.0135486283791684, 0.0197762034605164, 0.0197686053073393,
           0.0224838821372655, 0.0241740300538751, 0.0256822601972516,
           0.0265096948143765, 0.0271330931714993, 0.0274314991366822,
           0.0284834397783798, 0.0297276346662025, 0.0308410887945891,
           0.032692683803743, 0.034410206396147];
irCurve = caplib::createIrYieldCurve(
    asOfDate, irDates, irRates,
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "CNY", "CNY_SHIBOR_3M", "IR_CURVE", false);

divDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
divValues = [0.05361055758784821, 0.01338941242891319,
             -0.001765240983827533, -0.002594662370949712];
divCurve = caplib::createDividendCurve(
    asOfDate, divDates, divValues, asOfDate,
    "CONTINUOUS", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "DIVIDEND_CURVE_50ETF", "DIV_CURVE", false);

quoteTermDates = [2020.02.26, 2020.03.25, 2020.06.24, 2020.09.23];
quoteStrikes = [
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4],
    [2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.1, 3.2, 3.3, 3.4]
];
quotePrices = [
    [0.0002, 0.0002, 0.0002, 0.0002, 0.0004, 0.0008, 0.0015, 0.0023, 0.0065, 0.0184, 0.0053, 0.0012, 0.0005, 0.0001, 0.0001],
    [0.0027, 0.0033, 0.0040, 0.0054, 0.0081, 0.0113, 0.0172, 0.0270, 0.0400, 0.0608, 0.0498, 0.0216, 0.0110, 0.0066, 0.0046],
    [0.0201, 0.0230, 0.0281, 0.0345, 0.0433, 0.0541, 0.0668, 0.0818, 0.1004, 0.1229, 0.1325, 0.0935, 0.0659, 0.0470, 0.0330],
    [0.0365, 0.0434, 0.0516, 0.0612, 0.0724, 0.0862, 0.1015, 0.1184, 0.1381, 0.1595, 0.1930, 0.1483, 0.1298, 0.0897, 0.0702]
];
quotePayoffTypes = [
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"],
    ["PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "PUT", "CALL", "CALL", "CALL", "CALL", "CALL"]
];

modelParams = [0.0];
bsmModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, modelParams, "BSM_MODEL", false);
bsmAnalyticalSettings = caplib::createPricingSettings("CNY", "ANALYTICAL", 0, 0, take(0, 0), bsmModel, "", "", "BSM_ANALYTICAL", false);

quantoIr = caplib::createIrYieldCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", "USD", "USD_FLAT_ZERO", "QUANTO_IR", false);
quantoFxVol = caplib::createVolatilityCurve(
    asOfDate, [2020.02.22, 2030.02.24], [0.0, 0.0],
    "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    underlying, "QUANTO_FX_VOL", false);

volSurfDefinition = caplib::createVolatilitySurfaceDefinition(
    "STRIKE_VOL_SMILE", "SVI_SMILE_METHOD",
    "FLAT_EXTRAP", "LINEAR_IN_VARIANCE", "FLAT_IN_VOLATILITY",
    "ACT_365_FIXED", "LOG_NORMAL_VOL_TYPE", "DELTA",
    -1.0e-5, 1.0e-5, "VOL_SURF_DEF", true)
volSurfBuildSettings = caplib::createVolSurfBuildSettings(1, 0.5, "VOL_SURF_BUILD_SETTINGS", true)
eqOptionQuotes = caplib::createEqOptionQuoteMatrix(
    "EUROPEAN", "SPOT_UNDERLYING_TYPE", asOfDate,
    quoteTermDates, quotePayoffTypes, quotePrices, quoteStrikes,
    underlying, "EQ_OPTION_QUOTES", true)
volSurface = caplib::buildEqVolatilitySurface(
    asOfDate, underlying, volSurfDefinition[0], eqOptionQuotes[0],
    [underlyingPrice], irCurve, divCurve, volSurfBuildSettings[0],
    bsmAnalyticalSettings, "VOL_SURF", true)

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createEqMktDataSet -> handle"
result = caplib::createEqMktDataSet(asOfDate, underlying, underlyingPrice, irCurve, divCurve, volSurface[0], quantoIr, quantoFxVol, 0.0, "f_eqmkt", false)
assert 1, result == "f_eqmkt"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createEqMktDataSet rejects missing argument", syntaxError=1
caplib::createEqMktDataSet(2024.01.01, "X", 0.02, "X", "X", "X", "X", "X", 0.02)

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createEqMktDataSet rejects extra argument", syntaxError=1
caplib::createEqMktDataSet(2024.01.01, "X", 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false, 1)

// 用例目的：参数 asOfDate 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects wrong type for asOfDate", exception=1
caplib::createEqMktDataSet("bad", "X", 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：参数 underlying 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects wrong type for underlying", exception=1
caplib::createEqMktDataSet(2024.01.01, 1, 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：参数 underlyingPrice 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects wrong type for underlyingPrice", exception=1
caplib::createEqMktDataSet(2024.01.01, "X", "bad", "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：参数 asOfDate 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects null asOfDate", exception=1
caplib::createEqMktDataSet(date(), "X", 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：参数 underlying 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects null underlying", exception=1
caplib::createEqMktDataSet(2024.01.01, string(), 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：标量参数 asOfDate 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects vector for scalar asOfDate", exception=1
caplib::createEqMktDataSet([2024.01.01], "X", 0.02, "X", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：句柄参数 dcHandle 传入不存在的句柄字符串，验证句柄校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects nonexistent handle dcHandle", exception=1
caplib::createEqMktDataSet(2024.01.01, "X", 0.02, "TF_NO_SUCH_HANDLE_createEqMktDataSet", "X", "X", "X", "X", 0.02, "TF_createEqMktDataSet_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createEqMktDataSet rejects keyword arguments", syntaxError=1
caplib::createEqMktDataSet(asOfDate=2024.01.01, underlying="X", underlyingPrice=0.02, dcHandle="X", divHandle="X", volHandle="X", quantoDcHandle="X", quantoFxVolHandle="X", quantoCorrelation=0.02, handle="TF_createEqMktDataSet_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createEqMktDataSet optional returnJson null uses default"
result = caplib::createEqMktDataSet(asOfDate, underlying, underlyingPrice, irCurve, divCurve, volSurface[0], quantoIr, quantoFxVol, 0.0, "f_eqmkt", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：句柄参数 divHandle 传入类型不符的对象句柄，验证句柄类型校验（预期：抛异常）
@testing:case="createEqMktDataSet rejects wrong object type for divHandle", exception=1
caplib::createEqMktDataSet(asOfDate, underlying, underlyingPrice, irCurve, irCurve, volSurface[0], quantoIr, quantoFxVol, 0.0, "f_eqmkt", false)

