// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createEqMktDataSet rejects zero underlyingPrice", exception=1
caplib::createEqMktDataSet(asOfDate, underlying, 0.0, irCurve, divCurve, volSurface[0], quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createEqMktDataSet rejects negative underlyingPrice", exception=1
caplib::createEqMktDataSet(asOfDate, underlying, -1.0, irCurve, divCurve, volSurface[0], quantoIr, quantoFxVol, 0.0, "EQ_MKT", true)
