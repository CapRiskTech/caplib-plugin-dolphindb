// ============================================================================
// test_createRangeAccrualOption.dos
// Per-function test suite for caplib::createRangeAccrualOption (eq).
// Signature: caplib::createRangeAccrualOption(expiry DATE, delivery DATE, asset DOUBLE, cash DOUBLE, lowerBarrier DOUBLE, upperBarrier DOUBLE, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createRangeAccrualOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

dailyObsDates = 2020.02.22..2020.08.19;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createRangeAccrualOption -> handle"
result = caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, 0.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, result == "f_RA"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createRangeAccrualOption rejects missing argument", syntaxError=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createRangeAccrualOption rejects extra argument", syntaxError=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects wrong type for expiry", exception=1
caplib::createRangeAccrualOption("bad", 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects wrong type for delivery", exception=1
caplib::createRangeAccrualOption(2024.01.01, "bad", 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 asset 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects wrong type for asset", exception=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, "bad", 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects null expiry", exception=1
caplib::createRangeAccrualOption(date(), 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects null delivery", exception=1
caplib::createRangeAccrualOption(2024.01.01, date(), 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 expiry 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects vector for scalar expiry", exception=1
caplib::createRangeAccrualOption([2024.01.01], 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects scalar for vector fixingDates", exception=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects partially-null vector fixingDates", exception=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects empty vector fixingDates", exception=1
caplib::createRangeAccrualOption(2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", "X", "X", "X", "TF_createRangeAccrualOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createRangeAccrualOption rejects keyword arguments", syntaxError=1
caplib::createRangeAccrualOption(expiry=2024.01.01, delivery=2024.01.01, asset=0.02, cash=0.02, lowerBarrier=0.02, upperBarrier=0.02, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createRangeAccrualOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createRangeAccrualOption accepts all-null vector fixingDates", exception=1
caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, 0.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", [date(), date(), date()], dailyObsValues, dailyObsWeights, false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createRangeAccrualOption optional returnJson null uses default"
result = caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, 0.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", dailyObsDates, dailyObsValues, dailyObsWeights, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 asset 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects zero asset (lenient validation, does not raise)"
result = caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, 0.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：参数 asset 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createRangeAccrualOption rejects negative asset", exception=1
caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, -1.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 用例目的：两个数组参数长度不一致（fixingDates 多一个元素），实测插件宽松接受——记录实际行为
@testing:case="createRangeAccrualOption fixingDates length mismatch", exception=1
caplib::createRangeAccrualOption(2020.08.19, 2020.08.20, 0.0, 0.01, underlyingPrice*0.95, underlyingPrice*1.05, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_RA", join(dailyObsDates, dailyObsDates[0]), dailyObsValues, dailyObsWeights, false);
