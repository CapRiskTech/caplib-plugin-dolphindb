// ============================================================================
// test_createCollarOption.dos
// Per-function test suite for caplib::createCollarOption (eq).
// Signature: caplib::createCollarOption(payoffType STRING, lowerGearing DOUBLE, upperGearing DOUBLE, lowerStrike DOUBLE, upperStrike DOUBLE, expiry DATE, delivery DATE, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createCollarOption.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createCollarOption -> handle"
result = caplib::createCollarOption("CALL", 0.9, 1.1, underlyingPrice*0.9, underlyingPrice*1.1, 2020.08.19, 2020.08.20, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_CL", false)
assert 1, result == "f_CL"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createCollarOption rejects missing argument", syntaxError=1
caplib::createCollarOption("X", 0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createCollarOption rejects extra argument", syntaxError=1
caplib::createCollarOption("X", 0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCollarOption rejects wrong type for payoffType", exception=1
caplib::createCollarOption(1, 0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：参数 lowerGearing 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCollarOption rejects wrong type for lowerGearing", exception=1
caplib::createCollarOption("X", "bad", 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：参数 upperGearing 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createCollarOption rejects wrong type for upperGearing", exception=1
caplib::createCollarOption("X", 0.02, "bad", 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCollarOption rejects null payoffType", exception=1
caplib::createCollarOption(string(), 0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：参数 lowerGearing 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createCollarOption rejects null lowerGearing", exception=1
caplib::createCollarOption("X", double(), 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createCollarOption rejects vector for scalar payoffType", exception=1
caplib::createCollarOption(["X"], 0.02, 0.02, 0.02, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", "X", "X", "TF_createCollarOption_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createCollarOption rejects keyword arguments", syntaxError=1
caplib::createCollarOption(payoffType="X", lowerGearing=0.02, upperGearing=0.02, lowerStrike=0.02, upperStrike=0.02, expiry=2024.01.01, delivery=2024.01.01, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createCollarOption_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createCollarOption optional returnJson null uses default"
result = caplib::createCollarOption("CALL", 0.9, 1.1, underlyingPrice*0.9, underlyingPrice*1.1, 2020.08.19, 2020.08.20, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_CL", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 nominal 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createCollarOption rejects zero nominal", exception=1
caplib::createCollarOption("CALL", 0.9, 1.1, underlyingPrice*0.9, underlyingPrice*1.1, 2020.08.19, 2020.08.20, 0.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_CL", false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createCollarOption rejects negative nominal", exception=1
caplib::createCollarOption("CALL", 0.9, 1.1, underlyingPrice*0.9, underlyingPrice*1.1, 2020.08.19, 2020.08.20, -1.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_CL", false)

