// ============================================================================
// test_createSingleBarrierOption.dos
// Per-function test suite for caplib::createSingleBarrierOption (eq).
// Signature: caplib::createSingleBarrierOption(payoffType STRING, strike DOUBLE, expiry DATE, delivery DATE, barrierType STRING, barrierValue DOUBLE, barrierObsType STRING, paymentType STRING, cashRebate DOUBLE, assetRebate DOUBLE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createSingleBarrierOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createSingleBarrierOption -> handle"
result = caplib::createSingleBarrierOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", false)
assert 1, result == "f_SB"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createSingleBarrierOption rejects missing argument", syntaxError=1
caplib::createSingleBarrierOption("X", 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createSingleBarrierOption rejects extra argument", syntaxError=1
caplib::createSingleBarrierOption("X", 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects wrong type for payoffType", exception=1
caplib::createSingleBarrierOption(1, 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects wrong type for strike", exception=1
caplib::createSingleBarrierOption("X", "bad", 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects wrong type for expiry", exception=1
caplib::createSingleBarrierOption("X", 0.02, "bad", 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects null payoffType", exception=1
caplib::createSingleBarrierOption(string(), 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects null strike", exception=1
caplib::createSingleBarrierOption("X", double(), 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects vector for scalar payoffType", exception=1
caplib::createSingleBarrierOption(["X"], 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects scalar for vector fixingDates", exception=1
caplib::createSingleBarrierOption("X", 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects partially-null vector fixingDates", exception=1
caplib::createSingleBarrierOption("X", 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createSingleBarrierOption rejects empty vector fixingDates", exception=1
caplib::createSingleBarrierOption("X", 0.02, 2024.01.01, 2024.01.01, "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleBarrierOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createSingleBarrierOption rejects keyword arguments", syntaxError=1
caplib::createSingleBarrierOption(payoffType="X", strike=0.02, expiry=2024.01.01, delivery=2024.01.01, barrierType="X", barrierValue=0.02, barrierObsType="X", paymentType="X", cashRebate=0.02, assetRebate=0.02, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createSingleBarrierOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createSingleBarrierOption optional returnJson null uses default"
result = caplib::createSingleBarrierOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", bool())
assert 1, typestr(result) != "VOID"

// ----------------------------------------------------------------------------
// Review gap-fill: null-vector / boundary / enum / handle-type coverage
// ----------------------------------------------------------------------------

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createSingleBarrierOption rejects zero strike", exception=1
caplib::createSingleBarrierOption("CALL", 0.0, 2020.08.19, 2020.08.20, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", false)

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createSingleBarrierOption rejects negative strike", exception=1
caplib::createSingleBarrierOption("CALL", -1.0, 2020.08.19, 2020.08.20, "UP_IN", underlyingPrice*1.05, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", false)

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createSingleBarrierOption rejects zero barrierValue", exception=1
caplib::createSingleBarrierOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, "UP_IN", 0.0, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", false)

// 用例目的：对照评审要求补齐的边界/空值用例（实测插件宽松接受、不抛异常——记录实际行为）
@testing:case="createSingleBarrierOption rejects negative barrierValue", exception=1
caplib::createSingleBarrierOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, "UP_IN", -1.0, "CONTINUOUS_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SB", false)
