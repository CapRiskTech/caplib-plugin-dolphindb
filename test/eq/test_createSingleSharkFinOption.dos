// ============================================================================
// test_createSingleSharkFinOption.dos
// Per-function test suite for caplib::createSingleSharkFinOption (eq).
// Signature: caplib::createSingleSharkFinOption(payoffType STRING, strike DOUBLE, expiry DATE, delivery DATE, gearing DOUBLE, performanceType STRING, barrierType STRING, barrierValue DOUBLE, barrierObsType STRING, paymentType STRING, cashRebate DOUBLE, assetRebate DOUBLE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createSingleSharkFinOption.dos   // single file
// Hand-maintained suite; do not regenerate with tools/gen_function_tests.

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

dailyObsDates = 2020.02.22..2020.08.19;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createSingleSharkFinOption -> handle"
result = caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, result == "f_SF"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createSingleSharkFinOption rejects missing argument", syntaxError=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createSingleSharkFinOption rejects extra argument", syntaxError=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for payoffType", exception=1
caplib::createSingleSharkFinOption(1, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for strike", exception=1
caplib::createSingleSharkFinOption("X", "bad", 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for expiry", exception=1
caplib::createSingleSharkFinOption("X", 0.02, "bad", 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects null payoffType", exception=1
caplib::createSingleSharkFinOption(string(), 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects null strike", exception=1
caplib::createSingleSharkFinOption("X", double(), 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects vector for scalar payoffType", exception=1
caplib::createSingleSharkFinOption(["X"], 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects scalar for vector fixingDates", exception=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects partially-null vector fixingDates", exception=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects empty vector fixingDates", exception=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createSingleSharkFinOption rejects keyword arguments", syntaxError=1
caplib::createSingleSharkFinOption(payoffType="X", strike=0.02, expiry=2024.01.01, delivery=2024.01.01, gearing=0.02, performanceType="X", barrierType="X", barrierValue=0.02, barrierObsType="X", paymentType="X", cashRebate=0.02, assetRebate=0.02, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createSingleSharkFinOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：验证插件对此输入宽松接受、不抛异常（实测行为记录）
@testing:case="createSingleSharkFinOption accepts all-null vector fixingDates", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", [date(), date(), date()], dailyObsValues, dailyObsWeights, false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createSingleSharkFinOption optional returnJson null uses default"
result = caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 cashRebate 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects negative cashRebate", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", -1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 用例目的：两个数组参数长度不一致（fixingDates 多一个元素），实测插件宽松接受——记录实际行为
@testing:case="createSingleSharkFinOption fixingDates length mismatch", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", join(dailyObsDates, dailyObsDates[0]), dailyObsValues, dailyObsWeights, false);
