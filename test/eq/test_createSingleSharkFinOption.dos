// ============================================================================
// test_createSingleSharkFinOption.dos
// Per-function test suite for caplib::createSingleSharkFinOption (eq).
// Signature: caplib::createSingleSharkFinOption(payoffType STRING, strike DOUBLE, expiry DATE, delivery DATE, gearing DOUBLE, performanceType STRING, barrierType STRING, barrierValue DOUBLE, barrierObsType STRING, paymentType STRING, cashRebate DOUBLE, assetRebate DOUBLE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createSingleSharkFinOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

dailyObsDates = 2020.02.22..2020.08.19;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createSingleSharkFinOption -> handle"
result = caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, result == "f_SF"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createSingleSharkFinOption rejects missing argument", syntaxError=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createSingleSharkFinOption rejects extra argument", syntaxError=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for payoffType", exception=1
caplib::createSingleSharkFinOption(1, 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for strike", exception=1
caplib::createSingleSharkFinOption("X", "bad", 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for expiry", exception=1
caplib::createSingleSharkFinOption("X", 0.02, "bad", 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects null payoffType", exception=1
caplib::createSingleSharkFinOption(string(), 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 strike 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects null strike", exception=1
caplib::createSingleSharkFinOption("X", double(), 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects vector for scalar payoffType", exception=1
caplib::createSingleSharkFinOption(["X"], 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）。
// 其余参数沿用正例调用的合法值，实测异常命中 [PLUGIN::CAPLIB] Parameter fixingDates must be a vector。
@testing:case="createSingleSharkFinOption rejects scalar for vector fixingDates", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", 2024.01.01, dailyObsValues, dailyObsWeights, false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects partially-null vector fixingDates", exception=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects empty vector fixingDates", exception=1
caplib::createSingleSharkFinOption("X", 0.02, 2024.01.01, 2024.01.01, 0.02, "X", "X", 0.02, "X", "X", 0.02, 0.02, 1, 0.02, "X", "X", "X", "X", "TF_createSingleSharkFinOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createSingleSharkFinOption rejects keyword arguments", syntaxError=1
caplib::createSingleSharkFinOption(payoffType="X", strike=0.02, expiry=2024.01.01, delivery=2024.01.01, gearing=0.02, performanceType="X", barrierType="X", barrierValue=0.02, barrierObsType="X", paymentType="X", cashRebate=0.02, assetRebate=0.02, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createSingleSharkFinOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：向量 fixingDates 传入全空值，验证向量空值校验（预期：抛异常；第三轮 review 修正用例名与预期一致）
@testing:case="createSingleSharkFinOption rejects all-null vector fixingDates", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", [date(), date(), date()], dailyObsValues, dailyObsWeights, false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createSingleSharkFinOption optional returnJson null uses default"
result = caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 cashRebate 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects negative cashRebate", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", -1.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 用例目的：fixingDates 比配对数组多一个元素，验证长度关系校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects fixingDates length mismatch", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", join(dailyObsDates, dailyObsDates[0]), dailyObsValues, dailyObsWeights, false);

// 用例目的：枚举参数 payoffType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for payoffType", exception=1
caplib::createSingleSharkFinOption("OTM", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 barrierType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for barrierType", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "BAD_BARRIER", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 performanceType 传入非法取值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for performanceType", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "BAD_PERFORM", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：遍历枚举参数 underlyingType 的文档合法取值，逐一调用验证均被接受
@testing:case="createSingleSharkFinOption supports all underlyingType enums"
utEnum = ["SPOT", "FUTURE", "FORWARD"]
okType = true;
for (i in 0..(size(utEnum)-1)) {
    try { caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", utEnum[i], "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false); } catch(ex) { okType = false; }
}
assert 1, okType

// 用例目的：参数 returnJson 传入非 BOOL 值（该传逻辑值却传字符串），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects non-bool returnJson", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, "true")

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects wrong type for handle", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", 123, dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 barrierObsType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for barrierObsType", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "NOT_A_REAL_ENUM", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 paymentType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for paymentType", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "NOT_A_REAL_ENUM", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：枚举参数 underlyingType 传入非法值，验证枚举校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects invalid enum for underlyingType", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "NOT_A_REAL_ENUM", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：INT 参数 settlementDays 传入 BOOL 值，验证类型校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects BOOL settlementDays", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, true, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 第三轮 review gap-fill：日期先后关系 / fixing 向量长度 / 枚举逐值
// ----------------------------------------------------------------------------

// 用例目的：delivery（2020.08.18）早于 expiry（2020.08.19），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createSingleSharkFinOption delivery before expiry (no validation)"
result = caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.18, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF_dbe", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：单独改变 fixingValues 长度（比 fixingDates 少一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects fixingValues length mismatch", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues[0:(size(dailyObsValues)-1)], dailyObsWeights, false)

// 用例目的：单独改变 fixingWeights 长度（比 fixingDates 多一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createSingleSharkFinOption rejects fixingWeights length mismatch", exception=1
caplib::createSingleSharkFinOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF", dailyObsDates, dailyObsValues, join(dailyObsWeights, 1.0), false)

// 用例目的：payoffType 枚举取值 call 逐值验证（文档合法值，预期接受）
@testing:case="createSingleSharkFinOption supports payoffType value call"
r = caplib::createSingleSharkFinOption("call", underlyingPrice, 2020.08.19, 2020.08.20, 1.0, "RELATIVE_PERFORM_TYPE", "UP_OUT", underlyingPrice*1.05, "DISCRETE_OBSERVATION_TYPE", "PAY_AT_MATURITY", 0.0, 0.0, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_SF_pt_call", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"

