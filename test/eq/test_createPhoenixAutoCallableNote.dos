// ----------------------------------------------------------------------------
// 第三轮 review gap-fill：日期先后关系 / knockOut 与 knockIn 向量长度 / 枚举逐值
// ----------------------------------------------------------------------------

// 用例目的：startDate（2020.09.01）晚于 expiry（2020.08.19），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createPhoenixAutoCallableNote startDate after expiry (no validation)"
r = caplib::createPhoenixAutoCallableNote("CALL", underlyingPrice, 0.12, "ACT_365_FIXED", 2020.09.01, couponDates, "UP_OUT", underlyingPrice*1.1, "DOWN_IN", underlyingPrice*0.9, "SELL", "PUT", underlyingPrice*0.85, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PH_sdae", couponDates, couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"

// 用例目的：couponDates 晚于 expiry（2020.09.22 起的派息日），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createPhoenixAutoCallableNote couponDates after expiry (no validation)"
lateCouponDates = [2020.09.23, 2020.10.23, 2020.11.23, 2020.12.23, 2021.01.22, 2021.02.22]
r = caplib::createPhoenixAutoCallableNote("CALL", underlyingPrice, 0.12, "ACT_365_FIXED", 2020.02.22, lateCouponDates, "UP_OUT", underlyingPrice*1.1, "DOWN_IN", underlyingPrice*0.9, "SELL", "PUT", underlyingPrice*0.85, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PH_cdae", couponDates, couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"

// 用例目的：delivery（2020.08.18）早于 expiry（2020.08.19），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createPhoenixAutoCallableNote delivery before expiry (no validation)"
r = caplib::createPhoenixAutoCallableNote("CALL", underlyingPrice, 0.12, "ACT_365_FIXED", 2020.02.22, couponDates, "UP_OUT", underlyingPrice*1.1, "DOWN_IN", underlyingPrice*0.9, "SELL", "PUT", underlyingPrice*0.85, 2020.08.19, 2020.08.18, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_PH_dbe", couponDates, couponObsValues, couponObsWeights, dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(r) != "VOID"

// 用例目的：单独改变 knockOutDates 长度（与 knockOutValues/knockOutWeights 不一致），验证配对长度校验（预期：抛异常）
