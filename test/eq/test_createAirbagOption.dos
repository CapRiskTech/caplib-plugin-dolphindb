// ============================================================================
// test_createAirbagOption.dos
// Per-function test suite for caplib::createAirbagOption (eq).
// Signature: caplib::createAirbagOption(payoffType STRING, expiry DATE, delivery DATE, lowerStrike DOUBLE, upperStrike DOUBLE, lowerGearing DOUBLE, upperGearing DOUBLE, knockInStrike DOUBLE, barrierType STRING, barrierValue DOUBLE, barrierObsType STRING, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING, fixingDates DATE[], fixingValues DOUBLE[], fixingWeights DOUBLE[][, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createAirbagOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

dailyObsDates = 2020.02.22..2020.08.19;
dailyObsValues = take(0.0, size(dailyObsDates));
dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createAirbagOption -> handle"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, result == "f_AB"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createAirbagOption rejects missing argument", syntaxError=1
caplib::createAirbagOption("X", 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createAirbagOption rejects extra argument", syntaxError=1
caplib::createAirbagOption("X", 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAirbagOption rejects wrong type for payoffType", exception=1
caplib::createAirbagOption(1, 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAirbagOption rejects wrong type for expiry", exception=1
caplib::createAirbagOption("X", "bad", 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 delivery 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAirbagOption rejects wrong type for delivery", exception=1
caplib::createAirbagOption("X", 2024.01.01, "bad", 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createAirbagOption rejects null payoffType", exception=1
caplib::createAirbagOption(string(), 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：参数 expiry 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createAirbagOption rejects null expiry", exception=1
caplib::createAirbagOption("X", date(), 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createAirbagOption rejects vector for scalar payoffType", exception=1
caplib::createAirbagOption(["X"], 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入标量，验证数据形式校验（预期：抛异常）。
// 其余参数沿用正例调用的合法值，实测异常命中 [PLUGIN::CAPLIB] Parameter fixingDates must be a vector。
@testing:case="createAirbagOption rejects scalar for vector fixingDates", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", 2024.01.01, dailyObsValues, dailyObsWeights, false)

// 用例目的：向量参数 fixingDates 传入部分空值的向量，验证向量空值校验（预期：抛异常）
@testing:case="createAirbagOption rejects partially-null vector fixingDates", exception=1
caplib::createAirbagOption("X", 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", [2024.01.01, date()], [0.02], [0.02], false)

// 用例目的：向量参数 fixingDates 传入长度为 0 的空向量，验证空向量校验（预期：抛异常）
@testing:case="createAirbagOption rejects empty vector fixingDates", exception=1
caplib::createAirbagOption("X", 2024.01.01, 2024.01.01, 0.02, 0.02, 0.02, 0.02, 0.02, "X", 0.02, "X", 0.02, "X", "X", "X", "X", "TF_createAirbagOption_H", take(date, 0), [0.02], [0.02], false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createAirbagOption rejects keyword arguments", syntaxError=1
caplib::createAirbagOption(payoffType="X", expiry=2024.01.01, delivery=2024.01.01, lowerStrike=0.02, upperStrike=0.02, lowerGearing=0.02, upperGearing=0.02, knockInStrike=0.02, barrierType="X", barrierValue=0.02, barrierObsType="X", nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createAirbagOption_H", fixingDates=[2024.01.01], fixingValues=[0.02], fixingWeights=[0.02], returnJson=false)
// 用例目的：fixingDates 传入全空值向量，验证向量空值校验（预期：抛异常；第三轮 review 修正用例名与预期一致）
@testing:case="createAirbagOption rejects all-null vector fixingDates", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", [date(), date(), date()], dailyObsValues, dailyObsWeights, false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createAirbagOption optional returnJson null uses default"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues, dailyObsWeights, bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 nominal 传入0，验证数值边界校验（预期：抛异常）
@testing:case="createAirbagOption rejects zero nominal", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 0.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（预期：抛异常）
@testing:case="createAirbagOption rejects negative nominal", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", -1.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 用例目的：fixingDates 比配对数组多一个元素，验证长度关系校验（预期：抛异常）
@testing:case="createAirbagOption rejects fixingDates length mismatch", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", join(dailyObsDates, dailyObsDates[0]), dailyObsValues, dailyObsWeights, false);

// ----------------------------------------------------------------------------
// 第二轮 review 修正补充用例
// ----------------------------------------------------------------------------

// 用例目的：可选参数 returnJson 传入非 BOOL（字符串 "true"），验证类型校验（预期：抛异常）
@testing:case="createAirbagOption rejects non-BOOL returnJson", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_rj", dailyObsDates, dailyObsValues, dailyObsWeights, "true")

// 用例目的：payoffType 传入非法枚举拼写，验证仅接受精确拼写（预期：抛异常）
@testing:case="createAirbagOption rejects invalid payoffType enum", exception=1
caplib::createAirbagOption("VANILLA", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_e_pt", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：barrierType 传入非法枚举拼写，验证仅接受精确拼写（预期：抛异常）
@testing:case="createAirbagOption rejects invalid barrierType enum", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "BOGUS_BARRIER", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_e_bt", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：barrierObsType 传入非法枚举拼写，验证仅接受精确拼写（预期：抛异常）
@testing:case="createAirbagOption rejects invalid barrierObsType enum", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "BOGUS_OBS", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_e_bot", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：underlyingType 传入非法枚举拼写，验证仅接受精确拼写（预期：抛异常）
@testing:case="createAirbagOption rejects invalid underlyingType enum", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "BOGUS_TYPE", "CNY", "50ETF.SSE", "f_AB_e_ut", dailyObsDates, dailyObsValues, dailyObsWeights, false)

// 用例目的：遍历 payoffType 合法值列表，全部应被接受
@testing:case="createAirbagOption accepts all valid payoffType values"
for (pt in ["CALL", "call", "PUT", "put"]) {
    h = caplib::createAirbagOption(pt, 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_pay_" + pt, dailyObsDates, dailyObsValues, dailyObsWeights, false);
    assert 1, typestr(h) != "VOID"
}

// 用例目的：遍历 barrierType 合法值列表，全部应被接受
@testing:case="createAirbagOption accepts all valid barrierType values"
for (bt in ["DOWN_IN", "UAI", "DOWN_AND_IN", "UP_IN", "DAO", "UP_AND_IN", "DOWN_OUT", "DAI", "DOWN_AND_OUT", "UP_OUT", "UAO", "UP_AND_OUT"]) {
    h = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, bt, underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_bar_" + bt, dailyObsDates, dailyObsValues, dailyObsWeights, false);
    assert 1, typestr(h) != "VOID"
}

// 用例目的：遍历 barrierObsType 合法值列表（含空串），全部应被接受
@testing:case="createAirbagOption accepts all valid barrierObsType values"
for (ot in ["", "CONTINUOUS", "CONTINUOUS_OBSERVATION_TYPE", "DISCRETE", "DISCRETE_OBSERVATION_TYPE"]) {
    h = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, ot, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_bot_" + ot, dailyObsDates, dailyObsValues, dailyObsWeights, false);
    assert 1, typestr(h) != "VOID"
}

// 用例目的：遍历 underlyingType 合法值列表，全部应被接受
@testing:case="createAirbagOption accepts all valid underlyingType values"
for (ut in ["SPOT", "FUTURE", "FORWARD"]) {
    h = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", ut, "CNY", "50ETF.SSE", "f_AB_ut_" + ut, dailyObsDates, dailyObsValues, dailyObsWeights, false);
    assert 1, typestr(h) != "VOID"
}

// 用例目的：barrierValue 传入 0，记录实际行为（包装器通常仅检查类型，预期宽松接受）
@testing:case="createAirbagOption barrierValue zero behavior record"
h = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", 0.0, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_bv0", dailyObsDates, dailyObsValues, dailyObsWeights, false);
assert 1, typestr(h) != "VOID"

// 用例目的：参数 lowerStrike 传入 0，验证边界校验（实测插件校验并抛 IllegalArgumentException）
@testing:case="createAirbagOption rejects zero lowerStrike", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, 0.0, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_ls0", dailyObsDates, dailyObsValues, dailyObsWeights, false);

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createAirbagOption rejects wrong type for handle", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", 123, dailyObsDates, dailyObsValues, dailyObsWeights, false)

// ----------------------------------------------------------------------------
// 第三轮 review gap-fill：日期先后关系 / 行权价关联 / fixing 向量长度与权重行为
// ----------------------------------------------------------------------------

// 用例目的：delivery（2020.08.18）早于 expiry（2020.08.19），验证日期先后关系（文档注明包装器不检查，实测记录行为）
@testing:case="createAirbagOption delivery before expiry (no validation)"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.18, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_dbe", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：lowerStrike 高于 upperStrike，验证行权价关联校验（实测记录行为）
@testing:case="createAirbagOption lowerStrike above upperStrike (no validation)"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice*1.05, underlyingPrice, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_ls_gt_us", dailyObsDates, dailyObsValues, dailyObsWeights, false)
assert 1, typestr(result) != "VOID"

// 用例目的：单独改变 fixingValues 长度（比 fixingDates 少一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createAirbagOption rejects fixingValues length mismatch", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues[0:(size(dailyObsValues)-1)], dailyObsWeights, false)

// 用例目的：单独改变 fixingWeights 长度（比 fixingDates 多一个元素），验证配对长度校验（预期：抛异常）
@testing:case="createAirbagOption rejects fixingWeights length mismatch", exception=1
caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB", dailyObsDates, dailyObsValues, join(dailyObsWeights, 1.0), false)

// 用例目的：fixingWeights 全零，验证权重取值行为（实测记录行为）
@testing:case="createAirbagOption accepts all-zero fixingWeights (no validation)"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_w0", dailyObsDates, dailyObsValues, take(0.0, size(dailyObsDates)), false)
assert 1, typestr(result) != "VOID"

// 用例目的：fixingWeights 全负值，验证权重取值行为（实测记录行为）
@testing:case="createAirbagOption accepts negative fixingWeights (no validation)"
result = caplib::createAirbagOption("CALL", 2020.08.19, 2020.08.20, underlyingPrice, underlyingPrice*1.05, 1.0, 1.0, underlyingPrice, "DOWN_IN", underlyingPrice*0.8, "DISCRETE_OBSERVATION_TYPE", 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AB_wneg", dailyObsDates, dailyObsValues, take(-1.0, size(dailyObsDates)), false)
assert 1, typestr(result) != "VOID"
