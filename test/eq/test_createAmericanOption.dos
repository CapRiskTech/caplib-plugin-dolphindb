// ============================================================================
// test_createAmericanOption.dos
// Per-function test suite for caplib::createAmericanOption (eq).
// Signature: caplib::createAmericanOption(payoffType STRING, strike DOUBLE, expiry DATE, delivery DATE, settlementDays INT, nominal DOUBLE, payoffCurrency STRING, underlyingType STRING, underlyingCurrency STRING, underlying STRING, handle STRING[, returnJson BOOL])
// Uses the native DolphinDB testing framework:
//     test("test/eq")            // whole domain directory
//     python run_tests.py --file eq/test_createAmericanOption.dos   // single file

// ============================================================================
// Setup: fixtures (plain script, executed before the test cases)

underlying = "50ETF.SSE";
underlyingPrice = 2.958;

// ============================================================================
// Tests

// 用例目的：正常调用，验证返回句柄（returnJson=true 时连同 json 结构一起返回）
@testing:case="createAmericanOption -> handle"
result = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM", false)
assert 1, result == "f_AM"

// ----------------------------------------------------------------------------
// Negative / exception validation (auto-derived from the signature)
// ----------------------------------------------------------------------------

// 用例目的：少传参数调用，验证参数个数下限校验（预期：解析期报参数个数错误）
@testing:case="createAmericanOption rejects missing argument", syntaxError=1
caplib::createAmericanOption("X", 0.02, 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X")

// 用例目的：多传参数调用，验证参数个数上限校验（预期：解析期报参数个数错误）
@testing:case="createAmericanOption rejects extra argument", syntaxError=1
caplib::createAmericanOption("X", 0.02, 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false, 1)

// 用例目的：参数 payoffType 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAmericanOption rejects wrong type for payoffType", exception=1
caplib::createAmericanOption(1, 0.02, 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：参数 strike 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAmericanOption rejects wrong type for strike", exception=1
caplib::createAmericanOption("X", "bad", 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：参数 expiry 传入错误类型（如该传数值的传字符串），验证类型校验（预期：抛异常）
@testing:case="createAmericanOption rejects wrong type for expiry", exception=1
caplib::createAmericanOption("X", 0.02, "bad", 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：参数 payoffType 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createAmericanOption rejects null payoffType", exception=1
caplib::createAmericanOption(string(), 0.02, 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：参数 strike 传入对应类型的空值，验证空值校验（预期：抛异常）
@testing:case="createAmericanOption rejects null strike", exception=1
caplib::createAmericanOption("X", double(), 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：标量参数 payoffType 传入向量，验证数据形式校验（预期：抛异常）
@testing:case="createAmericanOption rejects vector for scalar payoffType", exception=1
caplib::createAmericanOption(["X"], 0.02, 2024.01.01, 2024.01.01, 1, 0.02, "X", "X", "X", "X", "TF_createAmericanOption_H", false)

// 用例目的：以关键字参数形式调用，验证插件不支持关键字传参（预期：解析期报错）
@testing:case="createAmericanOption rejects keyword arguments", syntaxError=1
caplib::createAmericanOption(payoffType="X", strike=0.02, expiry=2024.01.01, delivery=2024.01.01, settlementDays=1, nominal=0.02, payoffCurrency="X", underlyingType="X", underlyingCurrency="X", underlying="X", handle="TF_createAmericanOption_H", returnJson=false)
// 用例目的：可选参数 returnJson 传入空值，验证取默认值（不返回 json）
@testing:case="createAmericanOption optional returnJson null uses default"
result = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM", bool())
assert 1, typestr(result) != "VOID"
// 用例目的：参数 settlementDays 传入负值，记录实际行为（文档：settlementDays 非负但包装器通常仅检查类型）
@testing:case="createAmericanOption settlementDays negative boundary"
result = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, -1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_sd_neg", false)
assert 1, true

// 用例目的：参数 settlementDays 传入0，记录实际行为（文档：settlementDays 非负）
@testing:case="createAmericanOption settlementDays zero boundary"
result = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 0, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_sd0", false)
assert 1, true

// 用例目的：参数 nominal 传入0，验证数值边界校验（参照同组 createEuropeanOption 先例，预期：抛异常）
@testing:case="createAmericanOption rejects zero nominal", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 0.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM", false)

// 用例目的：参数 nominal 传入负值，验证数值边界校验（参照同组 createEuropeanOption 先例，预期：抛异常）
@testing:case="createAmericanOption rejects negative nominal", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, -1.0, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM", false)

// 用例目的：可选参数 returnJson 传入非 BOOL（如字符串 "true"），验证类型校验（预期：抛异常）
@testing:case="createAmericanOption rejects non-bool returnJson", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_rj", "true")

// 用例目的：枚举 payoffType 传入非法拼写 "OTM"，验证仅接受精确拼写的枚举校验（预期：抛异常）
@testing:case="createAmericanOption rejects illegal payoffType enum", exception=1
caplib::createAmericanOption("OTM", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_pt", false)

// 用例目的：遍历 payoffType 全部合法值（CALL/call/PUT/put），全部应构造成功
@testing:case="createAmericanOption accepts all legal payoffType values"
ok = true;
for (pt in ["CALL", "call", "PUT", "put"]) {
    h = caplib::createAmericanOption(pt, underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_pt_" + pt, false)
    if (typestr(h) == "VOID") { ok = false; }
}
assert 1, ok

// 用例目的：枚举 underlyingType 传入带尾随空格的 "SPOT "，验证仅接受精确大写拼写的枚举校验（预期：抛异常）
@testing:case="createAmericanOption rejects illegal underlyingType enum", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT ", "CNY", "50ETF.SSE", "f_AM_ut", false)

// 用例目的：遍历 underlyingType 全部合法值（SPOT/FUTURE/FORWARD），全部应构造成功
@testing:case="createAmericanOption accepts all legal underlyingType values"
ok = true;
for (ut in ["SPOT", "FUTURE", "FORWARD"]) {
    h = caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", ut, "CNY", "50ETF.SSE", "f_AM_ut_" + ut, false)
    if (typestr(h) == "VOID") { ok = false; }
}
assert 1, ok

// 用例目的：参数 strike 传入0，记录实际行为（文档：strike 非负；包装器通常仅检查类型）
@testing:case="createAmericanOption strike zero boundary"
result = caplib::createAmericanOption("CALL", 0.0, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_strike0", false)
assert 1, true

// 用例目的：参数 strike 传入负值，记录实际行为（文档未明确 wrapper 是否拒绝负值）
@testing:case="createAmericanOption strike negative boundary"
result = caplib::createAmericanOption("CALL", -1.0, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_strike_neg", false)
assert 1, true

// 用例目的：参数 handle 传入错误类型（该传字符串的传整数），验证类型校验（预期：抛异常）
@testing:case="createAmericanOption rejects wrong type for handle", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, 1, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", 123, false)

// 用例目的：参数 settlementDays 传 BOOL 值 true（该传 INT），验证类型严格校验（预期：抛异常）
@testing:case="createAmericanOption rejects BOOL settlementDays", exception=1
caplib::createAmericanOption("CALL", underlyingPrice, 2020.08.19, 2020.08.20, true, 1e6, "CNY", "SPOT", "CNY", "50ETF.SSE", "f_AM_bool_sd", false)

