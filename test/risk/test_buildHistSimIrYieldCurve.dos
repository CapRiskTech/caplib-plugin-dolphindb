// ============================================================================
// test_buildHistSimIrYieldCurve.dos
// Signature: buildHistSimIrYieldCurve(simDate DATE, referenceCurve H,
//            histStart H, histEnd H, curveDates DATE[], handle STRING) -> handle
// Run: test("test/risk")

simDate = 2020.02.21;
caplib::createCalendar("CAL_CFETS");

mkIr = def(d, rate, h) {
    return caplib::createIrYieldCurve(d, [d, d + 365], [rate, rate],
        "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
        "CONTINUOUS_COMPOUNDING", "CNY", h, h, false);
};
refCurve   = mkIr(simDate, 0.020, "MR_IR_REF");
startCurve = mkIr(simDate, 0.019, "MR_IR_START");
endCurve   = mkIr(simDate, 0.021, "MR_IR_END");

// 用例目的：正常调用，验证返回传入句柄
@testing:case="buildHistSimIrYieldCurve -> handle"
h = caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve,
                                     [simDate, simDate + 365], "MR_IR_RESULT")
assert 1, h == "MR_IR_RESULT"

// 用例目的：句柄指向的结果对象已入缓存且为 IrYieldCurve
@testing:case="buildHistSimIrYieldCurve result cached"
r = caplib::getObjectCacheJson("IrYieldCurve", "MR_IR_RESULT")
assert 1, size(r)==2 && r[0]=="MR_IR_RESULT"

// 用例目的：参考曲线传不存在的句柄，拒绝
@testing:case="buildHistSimIrYieldCurve rejects bad ref handle", exception=1
caplib::buildHistSimIrYieldCurve(simDate, "NO_SUCH_IR_REF", startCurve, endCurve,
                                 [simDate, simDate + 365], "MR_IR_RESULT_X")

// 用例目的：curveDates 传标量，拒绝
@testing:case="buildHistSimIrYieldCurve rejects scalar dates", exception=1
caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve,
                                 simDate, "MR_IR_RESULT_Y")

// 用例目的：少传参数，解析期报错
@testing:case="buildHistSimIrYieldCurve rejects missing args", syntaxError=1
caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve, [simDate])

// 用例目的：相同输入连续调用两次，两次都可读回（可重复性/确定性）
@testing:case="buildHistSimIrYieldCurve deterministic repeat -> both readable"
h1 = caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve, [simDate, simDate + 365], "MR_IR_DET")
r1 = caplib::getObjectCacheJson("IrYieldCurve", "MR_IR_DET")
h2 = caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve, [simDate, simDate + 365], "MR_IR_DET")
r2 = caplib::getObjectCacheJson("IrYieldCurve", "MR_IR_DET")
assert 1, h1 == "MR_IR_DET" && h2 == "MR_IR_DET" && size(r1)==2 && size(r2)==2 && r1[0]=="MR_IR_DET" && r2[0]=="MR_IR_DET"

// 用例目的：simDate 传字符串（需 DATE），拒绝
@testing:case="buildHistSimIrYieldCurve rejects wrong type simDate", exception=1
caplib::buildHistSimIrYieldCurve("2020.02.21", refCurve, startCurve, endCurve, [simDate, simDate+365], "PI_IR_X1")

// 用例目的：simDate 传空日期，拒绝
@testing:case="buildHistSimIrYieldCurve rejects null simDate", exception=1
caplib::buildHistSimIrYieldCurve(date(), refCurve, startCurve, endCurve, [simDate, simDate+365], "PI_IR_X2")

// 用例目的：curveDates 逆序（尾部 < 首部），拒绝
@testing:case="buildHistSimIrYieldCurve rejects reversed curveDates", exception=1
caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve, [simDate+365, simDate], "PI_IR_X3")

// 用例目的：referenceCurve 传空句柄，拒绝
@testing:case="buildHistSimIrYieldCurve rejects null ref handle", exception=1
caplib::buildHistSimIrYieldCurve(simDate, string(), startCurve, endCurve, [simDate], "PI_IR_X4")

// 用例目的：多传参数，解析期报错
@testing:case="buildHistSimIrYieldCurve rejects extra argument", syntaxError=1
caplib::buildHistSimIrYieldCurve(simDate, refCurve, startCurve, endCurve, [simDate, simDate+365], "PI_IR_X5", 1)
