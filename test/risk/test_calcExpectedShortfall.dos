// ============================================================================
// test_calcExpectedShortfall.dos
// Signature: calcExpectedShortfall(profitLossSamples DOUBLE[], probability
//            DOUBLE (0..1), antithetic BOOL) -> DOUBLE
// Run: test("test/risk")

samples = [-100.0, -50.0, 0.0, 50.0, 100.0];

// 用例目的：正常调用，返回有限 DOUBLE
@testing:case="calcExpectedShortfall -> finite scalar"
v = caplib::calcExpectedShortfall(samples, 0.95, false)
assert 1, typestr(v) == "DOUBLE" && !isNull(v)

// 用例目的：antithetic=true 也返回有限值
@testing:case="calcExpectedShortfall antithetic"
v = caplib::calcExpectedShortfall(samples, 0.95, true)
assert 1, !isNull(v)

// 用例目的：概率越界（=1），拒绝
@testing:case="calcES rejects probability = 1", exception=1
caplib::calcExpectedShortfall(samples, 1.0, false)

// 用例目的：概率传负数，拒绝
@testing:case="calcES rejects negative probability", exception=1
caplib::calcExpectedShortfall(samples, -0.5, false)

// 用例目的：样本含空值元素，拒绝
@testing:case="calcES rejects null sample element", exception=1
caplib::calcExpectedShortfall([1.0, double()], 0.95, false)

// 用例目的：样本传字符串向量，拒绝
@testing:case="calcES rejects non-double samples", exception=1
caplib::calcExpectedShortfall(["a","b"], 0.95, false)

// 用例目的：少传参数，解析期报错
@testing:case="calcES rejects missing args", syntaxError=1
caplib::calcExpectedShortfall(samples, 0.95)

// 用例目的：相同输入连续两次，结果一致
@testing:case="calcES deterministic repeat -> identical"
e1 = caplib::calcExpectedShortfall(samples, 0.95, false);
e2 = caplib::calcExpectedShortfall(samples, 0.95, false);
assert 1, e1 == e2

// 用例目的：ES 对负样本应非负有限
@testing:case="calcES known-sample -> non-negative finite"
v = caplib::calcExpectedShortfall(samples, 0.95, false);
assert 1, v >= 0.0 && !isNull(v)

// 用例目的：多传参数，解析期报错
@testing:case="calcES rejects extra argument", syntaxError=1
caplib::calcExpectedShortfall(samples, 0.95, false, 1)

// 用例目的：概率传向量（需标量），拒绝
@testing:case="calcES rejects vector probability", exception=1
caplib::calcExpectedShortfall(samples, [0.95], false)

// 用例目的：antithetic 传非 BOOL，拒绝
@testing:case="calcES rejects non-bool antithetic", exception=1
caplib::calcExpectedShortfall(samples, 0.95, 5)

// 用例目的：95% 置信、样本 [-100,-50,0,50,100]，ES 精确 = 0
@testing:case="calcES exact frozen reference (95%)"
v = caplib::calcExpectedShortfall([-100.0,-50.0,0.0,50.0,100.0], 0.95, false)
assert 1, abs(v - 0.0) < 1e-12

// 用例目的：5% 置信、同样本，ES 精确 = -100（最尾部损失均值）
@testing:case="calcES exact frozen reference (5%)"
v = caplib::calcExpectedShortfall([-100.0,-50.0,0.0,50.0,100.0], 0.05, false)
assert 1, abs(v - (-100.0)) < 1e-12

// 用例目的：50% 置信、同样本，ES 精确 = -50（下尾一半损失均值）
@testing:case="calcES exact frozen reference (50%)"
v = caplib::calcExpectedShortfall([-100.0,-50.0,0.0,50.0,100.0], 0.50, false)
assert 1, abs(v - (-50.0)) < 1e-12
