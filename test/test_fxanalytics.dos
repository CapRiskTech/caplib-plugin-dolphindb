testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

// Frozen references from the reviewed EUR/USD acceptance scenario.
ok = t("calcFxForwardRate -> reference 1.178397818198062",
    abs(calcFxForwardRateValue - 1.178397818198062) < 1.0e-12);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("calcFxSwapPoint -> reference 0.002297818198062185",
    abs(calcFxSwapPointValue - 0.002297818198062185) < 1.0e-12);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("calcFxAtmStrike -> reference 1.1818054618389189",
    abs(calcFxAtmStrikeValue - 1.1818054618389189) < 1.0e-12);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("calcFxAtmStrike multiple expiries -> reviewed references",
    abs(calcFxAtmStrikeShort - 1.178853830469094) < 1.0e-12 &&
    abs(calcFxAtmStrikeLong - 1.1853748453767678) < 1.0e-12);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("calcFxAtmStrike repeated calls are deterministic",
    calcFxAtmStrikeValue == calcFxAtmStrikeRepeat1 &&
    calcFxAtmStrikeRepeat1 == calcFxAtmStrikeRepeat2);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("calcFxDeltaToStrike -> reference 1.2185761274280187",
    abs(calcFxDeltaToStrikeValue - 1.2185761274280187) < 1.0e-12);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("createCalendar -> FX calendars", calEutaCreated && calGbloCreated && calHkhkCreated);
testNum = testNum + 1; passNum = passNum + iif(ok, 1, 0);

ok = t("createFxSpotTemplate -> [EURUSD_SPOT_TPL, json]",
