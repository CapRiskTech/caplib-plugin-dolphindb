// --- Concurrent submitJob calls ---
@testing:case="four concurrent calcFxAtmStrike jobs -> identical reference"
def fxAtmConcurrentJob() {
    return caplib::calcFxAtmStrike(
        "ATM_DNS_PIPS", 2021.09.26, "EURUSD_BUILT_VOL_SURF",
        "EURUSD_SPOT_RATE", "USD_DEPO", "EUR_EURUSD_FX");
}
jobSuffix = string(rand(1000000000, 1)[0]);
jobId1 = submitJob("caplib_fx_" + jobSuffix + "_1", "caplib FX concurrency 1", fxAtmConcurrentJob);
jobId2 = submitJob("caplib_fx_" + jobSuffix + "_2", "caplib FX concurrency 2", fxAtmConcurrentJob);
jobId3 = submitJob("caplib_fx_" + jobSuffix + "_3", "caplib FX concurrency 3", fxAtmConcurrentJob);
jobId4 = submitJob("caplib_fx_" + jobSuffix + "_4", "caplib FX concurrency 4", fxAtmConcurrentJob);
jobResult1 = getJobReturn(jobId1, true);
jobResult2 = getJobReturn(jobId2, true);
jobResult3 = getJobReturn(jobId3, true);
jobResult4 = getJobReturn(jobId4, true);
assert 1, abs(jobResult1 - 1.1818054618389189) < 1.0e-12 &&
    jobResult1 == jobResult2 && jobResult2 == jobResult3 && jobResult3 == jobResult4

