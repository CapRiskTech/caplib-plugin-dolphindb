fxSwapPricingResult = caplib::priceFxSwap(
    fxSwap, asOfDate, eurusdMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true)
assert 1, isPricingResultsJson(fxSwapPricingResult, "FX_SWAP_INST_results")
assert 2, abs(presentValue(fxSwapPricingResult) - -327785.54562939936) < abs(-327785.54562939936) * 1.0e-9 + 1.0e-6

