// --- Multi-input correctness (different expiry / spot dates) ---
@testing:case="calcFxForwardRate different expiry -> reference 1.1837639404632467"
assert 1, abs(caplib::calcFxForwardRate(asOfDate, "EUR", "USD", 2022.01.01, eurusdSpotRate[0], usdCurve, eurCurve) - 1.1837639404632467) < 1.0e-12

@testing:case="calcFxAtmStrike different spotDate -> reference 1.1799978331418322"
assert 1, abs(caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.08.01, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve) - 1.1799978331418322) < 1.0e-12

@testing:case="calcFxAtmStrike different spotDate -> reference 1.1831546875205545"
assert 1, abs(caplib::calcFxAtmStrike("ATM_DNS_PIPS", 2021.11.01, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve) - 1.1831546875205545) < 1.0e-12

@testing:case="calcFxDeltaToStrike different expiry -> reference 1.2099756099954906"
assert 1, abs(caplib::calcFxDeltaToStrike("PIPS_SPOT_DELTA", 0.25, 2021.08.01, builtVolSurface[0], eurusdSpotRate[0], usdCurve, eurCurve) - 1.2099756099954906) < 1.0e-12

// --- Determinism ---
@testing:case="calcFxForwardRate repeated calls are deterministic"
fwdR1 = caplib::calcFxForwardRate(asOfDate, "EUR", "USD", 2021.07.01, eurusdSpotRate[0], usdCurve, eurCurve)
fwdR2 = caplib::calcFxForwardRate(asOfDate, "EUR", "USD", 2021.07.01, eurusdSpotRate[0], usdCurve, eurCurve)
fwdR3 = caplib::calcFxForwardRate(asOfDate, "EUR", "USD", 2021.07.01, eurusdSpotRate[0], usdCurve, eurCurve)
assert 1, fwdR1 == fwdR2 && fwdR2 == fwdR3 && abs(fwdR1 - 1.178397818198062) < 1.0e-12

@testing:case="calcFxSwapPoint repeated calls are deterministic"
swpR1 = caplib::calcFxSwapPoint(asOfDate, "EUR", "USD", 2021.07.01, eurusdSpotRate[0], usdCurve, eurCurve)
swpR2 = caplib::calcFxSwapPoint(asOfDate, "EUR", "USD", 2021.07.01, eurusdSpotRate[0], usdCurve, eurCurve)
assert 1, swpR1 == swpR2 && abs(swpR1 - 0.002297818198062185) < 1.0e-12

// --- Concurrency ---
@testing:case="four concurrent calcFxForwardRate jobs -> identical reference"
def fxFwdConcurrentJob() {
    return caplib::calcFxForwardRate(2021.03.30, "EUR", "USD", 2021.07.01, "EURUSD_SPOT_RATE", "USD_DEPO", "EUR_EURUSD_FX");
}
jobSuffix2 = string(rand(1000000000, 1)[0]);
jobId5 = submitJob("caplib_fx_fwd_" + jobSuffix2 + "_1", "caplib FX fwd concurrency 1", fxFwdConcurrentJob);
jobId6 = submitJob("caplib_fx_fwd_" + jobSuffix2 + "_2", "caplib FX fwd concurrency 2", fxFwdConcurrentJob);
jobId7 = submitJob("caplib_fx_fwd_" + jobSuffix2 + "_3", "caplib FX fwd concurrency 3", fxFwdConcurrentJob);
jobId8 = submitJob("caplib_fx_fwd_" + jobSuffix2 + "_4", "caplib FX fwd concurrency 4", fxFwdConcurrentJob);
jobResult5 = getJobReturn(jobId5, true);
jobResult6 = getJobReturn(jobId6, true);
jobResult7 = getJobReturn(jobId7, true);
jobResult8 = getJobReturn(jobId8, true);
assert 1, abs(jobResult5 - 1.178397818198062) < 1.0e-12 &&
    jobResult5 == jobResult6 && jobResult6 == jobResult7 && jobResult7 == jobResult8


