dailyObsWeights = take(1.0, size(dailyObsDates));

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}
def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Tests
// ============================================================================

@testing:case="createFxSpotRate -> [EURUSD_SPOT_RATE, json]"
assert 1, isHandleJson(eurusdSpotRate, "EURUSD_SPOT_RATE") &&
    hasJsonField(eurusdSpotRate[1], "fx_rate")

@testing:case="createFxRiskSettings -> [FX_RISK, json]"
assert 1, isHandleJson(fxRisk, "FX_RISK")

@testing:case="createFxRiskSettings option subset -> [FX_OPTION_RISK, json]"
assert 1, isHandleJson(fxOptionRisk, "FX_OPTION_RISK")

@testing:case="createFxMktConventions -> [EURUSD_MKT_CONV, json]"
assert 1, isHandleJson(fxMktConventions, "EURUSD_MKT_CONV")

@testing:case="createFxOptionQuoteMatrix -> [EURUSD_OPTION_QUOTES, json]"
assert 1, isHandleJson(optionQuotes, "EURUSD_OPTION_QUOTES") &&
    hasJsonField(optionQuotes[1], "quote_smiles")

@testing:case="createFxVolatilitySurface -> [EURUSD_VOL_SURF, json]"
assert 1, isHandleJson(volSurface, "EURUSD_VOL_SURF")

@testing:case="createFxVolatilitySurface strikes vector / vols vector"
assert 1, volSurfaceVectorVector == "EURUSD_VOL_SURF_VV"

@testing:case="createFxVolatilitySurface strikes matrix / vols vector"
assert 1, volSurfaceMatrixVector == "EURUSD_VOL_SURF_MV"

@testing:case="createFxVolatilitySurface strikes vector / vols matrix"
assert 1, volSurfaceVectorMatrix == "EURUSD_VOL_SURF_VM"

@testing:case="createFxVolatilitySurface strikes matrix / vols matrix"
assert 1, volSurfaceMatrixMatrix == "EURUSD_VOL_SURF_MM"

@testing:case="createVolSurfBuildSettings -> [FX_VOL_BUILD_SETTINGS, json]"
assert 1, isHandleJson(volSurfBuildSettings, "FX_VOL_BUILD_SETTINGS") &&
    hasJsonField(volSurfBuildSettings[1], "ith_param_fixed")

@testing:case="buildFxVolatilitySurface -> [EURUSD_BUILT_VOL_SURF, json]"
assert 1, isHandleJson(builtVolSurface, "EURUSD_BUILT_VOL_SURF")

@testing:case="createFlatFxVolatilitySurface -> [USDCNH_FLAT_FX_VOL_SURF, json]"
assert 1, isHandleJson(flatFxVolSurface, "USDCNH_FLAT_FX_VOL_SURF") &&
    hasJsonField(flatFxVolSurface[1], "volatility_surface")

@testing:case="createFxMktDataSet -> [EURUSD_MKT, json]"
assert 1, isHandleJson(eurusdMktData, "EURUSD_MKT")

@testing:case="createFxMktDataSet -> [USDCNH_MKT, json]"
assert 1, isHandleJson(usdcnhMktData, "USDCNH_MKT")

@testing:case="createFxMktDataSet empty vol -> [USDCNH_FALLBACK_MKT, json]"
assert 1, isHandleJson(usdcnhFallbackMktData, "USDCNH_FALLBACK_MKT") &&
    hasJsonField(usdcnhFallbackMktData[1], "vol_surf")

// Frozen references from the reviewed EUR/USD acceptance scenario.
@testing:case="calcFxForwardRate -> reference 1.178397818198062"
assert 1, abs(calcFxForwardRateValue - 1.178397818198062) < 1.0e-12

@testing:case="calcFxSwapPoint -> reference 0.002297818198062185"
assert 1, abs(calcFxSwapPointValue - 0.002297818198062185) < 1.0e-12

@testing:case="calcFxAtmStrike -> reference 1.1818054618389189"
assert 1, abs(calcFxAtmStrikeValue - 1.1818054618389189) < 1.0e-12

@testing:case="calcFxAtmStrike multiple expiries -> reviewed references"
assert 1, abs(calcFxAtmStrikeShort - 1.178853830469094) < 1.0e-12 &&
    abs(calcFxAtmStrikeLong - 1.1853748453767678) < 1.0e-12

@testing:case="calcFxAtmStrike repeated calls are deterministic"
assert 1, calcFxAtmStrikeValue == calcFxAtmStrikeRepeat1 &&
    calcFxAtmStrikeRepeat1 == calcFxAtmStrikeRepeat2

@testing:case="calcFxDeltaToStrike -> reference 1.2185761274280187"
assert 1, abs(calcFxDeltaToStrikeValue - 1.2185761274280187) < 1.0e-12

@testing:case="createCalendar -> FX calendars"
assert 1, calEutaCreated && calGbloCreated && calHkhkCreated

@testing:case="createFxSpotTemplate -> [EURUSD_SPOT_TPL, json]"
assert 1, isHandleJson(fxSpotTemplate, "EURUSD_SPOT_TPL") &&
    hasJsonField(fxSpotTemplate[1], "spot_delay")

@testing:case="createFxForwardTemplate -> [EURUSD_FWD_TPL, json]"
assert 1, isHandleJson(fxForwardTemplate, "EURUSD_FWD_TPL") &&
    hasJsonField(fxForwardTemplate[1], "fixing_offset")

@testing:case="createFxSwapTemplate -> [EURUSD_SWP_TPL, json]"
assert 1, isHandleJson(fxSwapTemplate, "EURUSD_SWP_TPL") &&
    hasJsonField(fxSwapTemplate[1], "start_convention")

@testing:case="createFxNdfTemplate -> [USDCNH_NDF_TPL, json]"
assert 1, isHandleJson(fxNdfTemplate, "USDCNH_NDF_TPL") &&
    hasJsonField(fxNdfTemplate[1], "settlement_currency")

// --- Active pricing tests from test_fxanalytics.py ---
@testing:case="createFxForward -> FX_FWD_INST"
fxForward = caplib::createFxForward(
    "EUR", 1000000.0, "USD", 1176100.0,
    2021.07.01, 2021.06.30, "FX_FWD_INST", false)
assert 1, fxForward == "FX_FWD_INST"

@testing:case="priceFxForward -> [FX_FWD_INST_results, present_value reference]"
fxForwardPricingResult = caplib::priceFxForward(
    fxForward, asOfDate, eurusdMktData[0], cashAnalyticalSettings, fxRisk[0], "", "", true)
assert 1, isPricingResultsJson(fxForwardPricingResult, "FX_FWD_INST_results")
assert 2, abs(presentValue(fxForwardPricingResult) - -324155.1424098549) < abs(-324155.1424098549) * 1.0e-9 + 1.0e-6

@testing:case="createFxSwap -> FX_SWAP_INST"
fxSwap = caplib::createFxSwap(
    "EUR", 1000000.0, "USD", 1176100.0, 2021.04.01, 2021.03.31,
    "USD", 1000000.0, "EUR", 1176100.0, 2021.07.01, 2021.06.30,
    "FX_SWAP_INST", false)
assert 1, fxSwap == "FX_SWAP_INST"

