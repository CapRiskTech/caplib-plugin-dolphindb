// ============================================================================
// test_iranalytics.dos
// Native DolphinDB IR Analytics tests.
// Uses the native DolphinDB testing framework:
//     test("test_iranalytics.dos")
// ============================================================================

// ============================================================================
// Setup: IR fixtures (plain script, executed before the test cases)
// ============================================================================

asOfDate = 2022.03.09;
currency = "CNY";
curveName = "CNY_SHIBOR_3M";
indexName = "SHIBOR_3M";
calCfets = "CAL_CFETS";
calCfetsCreated = caplib::createCalendar(calCfets);

irCurve = caplib::createIrYieldCurve(
    asOfDate, [2022.03.10, 2025.03.10], [0.02, 0.025],
    "ZERO_RATE", "ACT_365_FIXED", "LINEAR_INTERP", "FLAT_EXTRAP",
    "CONTINUOUS_COMPOUNDING", currency, curveName, "IR_CURVE", false);

iborIndex = caplib::createIborIndex(
    indexName, "3M", currency, [calCfets], 1,
    "ACT_360", "MODIFIED_FOLLOWING",
    "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true);

fixedLeg = caplib::createFixedLegDefinition(
    currency, calCfets, "QUARTERLY", "ACT_365_FIXED",
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "IR_FIXED_LEG", true);
floatingLeg = caplib::createFloatingLegDefinition(
    currency, iborIndex[0], calCfets, [calCfets],
    "QUARTERLY", "QUARTERLY", "ACT_360",
    "NO_DISCOUNT", "STANDARD", false,
    "MODIFIED_FOLLOWING", "INITIAL", "LONG",
    0, "MODIFIED_FOLLOWING", "MODIFIED_PRECEDING",
    "IN_ADVANCE", -1, "INVALID_NOTIONAL_EXCHANGE", "IR_FLOATING_LEG", true);

swapTemplate = caplib::createIrVanillaSwapTemplate(
    curveName, 1, fixedLeg[0], floatingLeg[0], "SPOTSTART", true);

swap = caplib::buildIrVanillaInstrument(
    "PAY", 0.05, 0.0, 2022.03.07, 2023.03.07,
    swapTemplate[0], 1000000.0, "", "IR_SWAP", false);

pricingModel = caplib::createPricingModelSettings(
    "BLACK_SCHOLES_MERTON", "", 0, [0.0], "IR_MODEL", false);
pricingSettings = caplib::createPricingSettings(
    currency, "ANALYTICAL", 1, 1, pricingModel, "", "", "IR_PRICING", false);

irCurveRisk = caplib::createIrCurveRiskSettings(
    1, 1, 1, 1.0e-4, 5.0e-3, 0, 1, 1.0e-4, 0, "IR_CURVE_RISK", false);
priceRisk = caplib::createPriceRiskSettings(
    1, 1, 0, 1.0e-2, 5.0e-1, 0, 1.0, 0, "IR_PRICE_RISK", false);
thetaRisk = caplib::createThetaRiskSettings(1, 1, 1.0 / 365.0, "IR_THETA_RISK", false);
irRisk = caplib::createIrRiskSettings(irCurveRisk, thetaRisk, "IR_RISK", true);
xccyIrRisk = caplib::createXccyIrRiskSettings(irCurveRisk, priceRisk, thetaRisk, "IR_XCCY_RISK", true);

mktData = caplib::createIrMktDataSet(
    asOfDate, irCurve, [iborIndex[0]], [irCurve], "IR_MKT", true);

curveBuildSettings = caplib::createIrYieldCurveBuildSettings(
    curveName, 0, [currency], [curveName], [iborIndex[0]], [curveName], "IR_BUILD_SETTINGS", true);

parCurve = caplib::createIrParRateCurve(
    asOfDate, currency, curveName,
    [iborIndex[0], curveName, curveName],
    ["DEPOSIT", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"],
    ["3M", "6M", "1Y"],
    [100.0, 100.0, 100.0],
    [0.023, 0.024, 0.026],
    "IR_PAR_CURVE", true);

builderParCurve = caplib::createIrParRateCurve(
    asOfDate, currency, curveName,
    [curveName, curveName, curveName],
    ["IR_VANILLA_SWAP", "IR_VANILLA_SWAP", "IR_VANILLA_SWAP"],
    ["6M", "1Y", "3Y"],
    [100.0, 100.0, 100.0],
    [2.3, 2.4, 2.6],
    "IR_BUILDER_PAR_CURVE", true);

builtSingleCcyCurve = caplib::buildIrSingleCurrencyCurve(
    asOfDate,
    [curveName],
    [curveBuildSettings[0]],
    [builderParCurve[0]],
    "ACT_365_FIXED",
    "CONTINUOUS_COMPOUNDING",
    "ANNUAL",
    [],
    "BOOTSTRAPPING_METHOD",
    0,
    1.0e-4,
    "CENTRAL_DIFFERENCE_METHOD",
    "SINGLE_THREADING_MODE",
    ["IR_BUILT_CURVE"],
    "IR_SINGLE_CCY_BUILD_OUTPUT", true);

swapPricingResult = caplib::priceIrVanillaInstrument(
    swap, asOfDate, mktData[0], pricingSettings, irRisk[0], "", "", true);

// ============================================================================
// Helper predicates
// ============================================================================

def isHandleJson(result, expectedHandle) {
    return strpos(typestr(result), "STRING VECTOR") >= 0 &&
        size(result) == 2 && result[0] == expectedHandle && strlen(result[1]) > 0;
}

def hasJsonField(json, fieldName) {
    return strpos(json, "\"" + fieldName + "\"") >= 0;
}

def isPricingResultsJson(result, expectedHandle) {
    return isHandleJson(result, expectedHandle) &&
        hasJsonField(result[1], "present_value") &&
        hasJsonField(result[1], "cash_value") &&
        hasJsonField(result[1], "currency");
}
def presentValue(pricingResult) {
    json = pricingResult[1];
    marker = "\"present_value\":";
    start = strpos(json, marker);
    if (start < 0) { return double(NULL); }
    start += strlen(marker);
    rest = substr(json, start);
    end = strpos(rest, ",");
    if (end < 0) { end = strpos(rest, "}"); }
    return double(substr(rest, 0, end));
}

// ============================================================================
// Tests
// ============================================================================

// --- IR curve inputs/build settings ---
@testing:case="createCalendar -> CAL_CFETS"
assert 1, calCfetsCreated

@testing:case="createIborIndex -> [SHIBOR_3M, json]"
assert 1, isHandleJson(iborIndex, "SHIBOR_3M") &&
    hasJsonField(iborIndex[1], "name") &&
    hasJsonField(iborIndex[1], "tenor")

@testing:case="createFixedLegDefinition -> [IR_FIXED_LEG, json]"
assert 1, isHandleJson(fixedLeg, "IR_FIXED_LEG") &&
    hasJsonField(fixedLeg[1], "leg_type") &&
    hasJsonField(fixedLeg[1], "schedule_definition")

@testing:case="createFloatingLegDefinition -> [IR_FLOATING_LEG, json]"
assert 1, isHandleJson(floatingLeg, "IR_FLOATING_LEG") &&
    hasJsonField(floatingLeg[1], "leg_type") &&
    hasJsonField(floatingLeg[1], "ibor_index")

@testing:case="createIrVanillaSwapTemplate -> [CNY_SHIBOR_3M, json]"
assert 1, isHandleJson(swapTemplate, "CNY_SHIBOR_3M") &&
    hasJsonField(swapTemplate[1], "instrument_name") &&
    hasJsonField(swapTemplate[1], "leg_definition")

@testing:case="createIrYieldCurveBuildSettings -> [IR_BUILD_SETTINGS, json]"
assert 1, isHandleJson(curveBuildSettings, "IR_BUILD_SETTINGS")

@testing:case="createIrParRateCurve -> [IR_PAR_CURVE, json]"
assert 1, isHandleJson(parCurve, "IR_PAR_CURVE")

@testing:case="createIrParRateCurve builder fixture -> [IR_BUILDER_PAR_CURVE, json]"
assert 1, isHandleJson(builderParCurve, "IR_BUILDER_PAR_CURVE")

@testing:case="buildIrSingleCurrencyCurve -> scalar conventions, [IR_SINGLE_CCY_BUILD_OUTPUT, json]"
assert 1, isHandleJson(builtSingleCcyCurve, "IR_SINGLE_CCY_BUILD_OUTPUT") &&
    hasJsonField(builtSingleCcyCurve[1], "target_curves")

// --- IR market/risk factories ---
@testing:case="createIrMktDataSet -> [IR_MKT, json]"
assert 1, isHandleJson(mktData, "IR_MKT")

@testing:case="createIrRiskSettings -> [IR_RISK, json]"
assert 1, isHandleJson(irRisk, "IR_RISK")

@testing:case="createXccyIrRiskSettings -> Python arg order [IR_XCCY_RISK, json]"
assert 1, isHandleJson(xccyIrRisk, "IR_XCCY_RISK") &&
    hasJsonField(xccyIrRisk[1], "ir_curve_settings") &&
    hasJsonField(xccyIrRisk[1], "fx_settings") &&
    hasJsonField(xccyIrRisk[1], "theta_settings")

// --- IR vanilla instrument pricing ---
@testing:case="priceIrVanillaInstrument -> [IR_SWAP_results, present_value reference]"
assert 1, isPricingResultsJson(swapPricingResult, "IR_SWAP_results")
assert 2, abs(presentValue(swapPricingResult) - -33063.77790012206) < abs(-33063.77790012206) * 1.0e-9 + 1.0e-6

// ============================================================================
// Negative / exception validation
// ============================================================================

@testing:case="createIborIndex rejects INT tenor", exception=1
caplib::createIborIndex(indexName, 3, currency, [calCfets], 1, "ACT_360", "MODIFIED_FOLLOWING", "INVALID_DATE_ROLL_CONVENTION", "STANDARD_IBOR_INDEX", true)

@testing:case="createIrMktDataSet rejects wrong discount curve handle", exception=1
caplib::createIrMktDataSet(asOfDate, iborIndex[0], [iborIndex[0]], [irCurve], "IR_BAD_MKT", true)

@testing:case="buildIrVanillaInstrument rejects negative notional", exception=1
caplib::buildIrVanillaInstrument("PAY", 0.05, 0.0, 2022.03.07, 2023.03.07, swapTemplate[0], -1000000.0, "", "IR_BAD_SWAP", false)

@testing:case="createIrVanillaSwapTemplate rejects missing argument", syntaxError=1
caplib::createIrVanillaSwapTemplate(curveName, 1)


// ============================================================================
// Extended negative / exception validation
// ============================================================================

@testing:case="createFixedLegDefinition rejects INT calendar", exception=1
caplib::createFixedLegDefinition(currency, 1, "QUARTERLY", "ACT_365_FIXED", "MODIFIED_FOLLOWING", "INITIAL", "LONG", 0, "MODIFIED_FOLLOWING", "INVALID_NOTIONAL_EXCHANGE", "IR_BAD_FL_2", true)

@testing:case="createIrYieldCurveBuildSettings rejects currency/curve length mismatch", exception=1
caplib::createIrYieldCurveBuildSettings(curveName, 0, [currency, "USD"], [curveName], [iborIndex[0]], [curveName], "IR_BAD_BUILD_2", true)

@testing:case="createIrParRateCurve rejects lengths mismatch", exception=1
caplib::createIrParRateCurve(asOfDate, currency, curveName, [iborIndex[0], curveName], ["DEPOSIT"], ["3M"], [100.0], [0.023], "IR_BAD_PAR_2", true)

@testing:case="buildIrVanillaInstrument rejects wrong template handle", exception=1
caplib::buildIrVanillaInstrument("PAY", 0.05, 0.0, 2022.03.07, 2023.03.07, fixedLeg[0], 1000000.0, "", "IR_BAD_SWAP_2", false)
