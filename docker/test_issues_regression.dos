// specificPricingRequests exposure: the 9-arg form stores the
// BondSpecificPricingRequest list (proto field 6, repeated int32) that the
// bond pricers answer via PricingResults.specific_pricing_results.
issueAccept("createPricingSettings 9-arg with specificPricingRequests",
    "caplib::createPricingSettings(\"CNY\",\"ANALYTICAL\",0,0,[0,1,2,7],\"\",\"\",\"\",\"PS_SPR_R\") == \"PS_SPR_R\"");
issueReject("createPricingSettings rejects out-of-range request",
    "caplib::createPricingSettings(\"CNY\",\"ANALYTICAL\",0,0,[0,9],\"\",\"\",\"\",\"PS_SPR_BAD\")", "specificPricingRequests values must be");

// #30: buildPmVolatilitySurface. Root cause was a plugin bug in
// createPmMktConventions — every if/else wrote the SAME enum in both branches,
// so ATM_DNS_PIPS/PIPS_SPOT_DELTA became ATM_SPOT/SIMPLE_DELTA, which diverged
// the SVI fit (std::exception). Fixed the enum mapping; the canonical
// test_pmanalytics.py fixture (test_pm_vol_surface_builder) now builds.
// Use the preloaded CAL_CFETS calendar (createCalendar rejects empty [] vectors
// and a custom holiday-less calendar would need registering).
caplib::createPmCashTemplate("XAUUSD",2,"FOLLOWING",["CAL_CFETS"],"ACT_360");
caplib::createIrYieldCurve(2019.09.04,[2019.09.09,2020.09.08,2021.09.07],[0.021594,0.014216,0.012617],
    "ZERO_RATE","ACT_365_FIXED","LINEAR_INTERP","FLAT_EXTRAP","CONTINUOUS_COMPOUNDING","USD","USD_DEPO","DEPO_30",false);
caplib::createPmParRateCurve(2019.09.04,"USD","XAU_XAUUSD",
    table(["XAUUSD","XAUUSD","XAUUSD"] as instrument_name,["PM_SWAP","PM_SWAP","PM_SWAP"] as instrument_type,
          ["1M","6M","12M"] as instrument_term,[0.0248,0.0223,0.0192] as instrument_rate),"PAR_30");
caplib::buildPmYieldCurve(2019.09.04,"PAR_30","DEPO_30","XAUUSD",1544.06,0,"ACT_365_FIXED","LINEAR_INTERP","FLAT_EXTRAP","ZERO_RATE","XAU_XAUUSD",0.0001,"CENTRAL_DIFFERENCE_METHOD","SINGLE_THREADING_MODE","FWD_30",false);
caplib::createPmOptionQuoteMatrix("XAUUSD",2019.09.04,["1M","6M","1Y"],
    [["ATM_STRADDLE","RISK_REVERSAL","BUTTERFLY","RISK_REVERSAL","BUTTERFLY"],["ATM_STRADDLE","RISK_REVERSAL","BUTTERFLY","RISK_REVERSAL","BUTTERFLY"],["ATM_STRADDLE","RISK_REVERSAL","BUTTERFLY","RISK_REVERSAL","BUTTERFLY"]],
    [[0,0.25,0.25,0.10,0.10],[0,0.25,0.25,0.10,0.10],[0,0.25,0.25,0.10,0.10]],
    [[0.15340,0.03623,0.00578,0.06738,0.01753],[0.15153,0.04255,0.00808,0.08120,0.02148],[0.15383,0.04725,0.01070,0.09253,0.02838]],"Q_30");
caplib::createPmMktConventions("ATM_DNS_PIPS","PIPS_SPOT_DELTA","PIPS_FORWARD_DELTA","1Y","RR_CALL_PUT","BUTTERFLY_QUOTE","XAUUSD","MKT_30");
caplib::createVolatilitySurfaceDefinition("STRIKE_VOL_SMILE","SVI_SMILE_METHOD","FLAT_EXTRAP","LINEAR_IN_VARIANCE","FLAT_IN_VOLATILITY","ACT_365_FIXED","LOG_NORMAL_VOL_TYPE","DELTA",-0.0001,0.0001,"VDEF_30");
caplib::createVolSurfBuildSettings(1,0.5,"BS_30");
issueAccept("buildPmVolatilitySurface (market conventions fixed)",
    "strFind(caplib::buildPmVolatilitySurface(2019.09.04,\"XAUUSD\",\"VDEF_30\",\"Q_30\",1544.06,\"DEPO_30\",\"FWD_30\",\"BS_30\",\"MKT_30\",\"XAUUSD\",\"VS_30\",true)[1],\"SVI_SMILE_METHOD\")>=0");

