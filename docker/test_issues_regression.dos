caplib::createIborIndex("shibor_3m","3M","CNY",["CAL_CFETS"],1);
caplib::createFixedLegDefinition("CNY","CAL_CFETS","QUARTERLY","ACT_360","MODIFIED_FOLLOWING","INITIAL","LONG",0,"MODIFIED_FOLLOWING","INVALID_NOTIONAL_EXCHANGE","LEG_FIXED");
