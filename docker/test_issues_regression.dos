    "caplib::createOptionQuoteMatrix(\"OQVT_PRICE\",\"OQTT_ABOSULTE_TERM\",\"OQST_ABOSULTE_STRIKE\",\"EUROPEAN\",\"SPOT_UNDERLYING_TYPE\",2024.01.01,[],[2024.06.01,2024.09.01],([\"CALL\",\"PUT\"],[\"CALL\"]),([10.5,8.5],[11.0]),([95.0,105.0],[100.0]),\"ISS_UNDERLYING\",\"ISS_QUOTES\",true)");
issueReject("Quotes reject null nested vector",
    "caplib::createOptionQuoteMatrix(\"OQVT_PRICE\",\"OQTT_ABOSULTE_TERM\",\"OQST_ABOSULTE_STRIKE\",\"EUROPEAN\",\"SPOT_UNDERLYING_TYPE\",2024.01.01,[],[2024.06.01,2024.09.01],([\"CALL\",\"PUT\"],[\"CALL\"]),([10.5,8.5],[double()]),([95.0,105.0],[100.0]),\"ISS_UNDERLYING\",\"ISS_QUOTES\",true)", "Parameter values");

issueAccept("Quotes retain integer strikes",
    "caplib::createOptionQuoteMatrix(\"OQVT_PRICE\",\"OQTT_ABOSULTE_TERM\",\"OQST_ABOSULTE_STRIKE\",\"EUROPEAN\",\"SPOT_UNDERLYING_TYPE\",2024.01.01,[],[2024.06.01,2024.09.01],[\"CALL\",\"PUT\"],[10.5,8.5],[95,105],\"ISS_UNDERLYING\",\"ISS_INT_QUOTES\",true)");
issueReject("Quotes reject null integer strikes",
    "caplib::createOptionQuoteMatrix(\"OQVT_PRICE\",\"OQTT_ABOSULTE_TERM\",\"OQST_ABOSULTE_STRIKE\",\"EUROPEAN\",\"SPOT_UNDERLYING_TYPE\",2024.01.01,[],[2024.06.01,2024.09.01],[\"CALL\",\"PUT\"],[10.5,8.5],[95,int()],\"ISS_UNDERLYING\",\"ISS_INT_QUOTES\",true)", "Parameter strikes");

// A rejected update must not replace an existing cached object.
beforeRejectedUpdate = caplib::getObjectCacheJson("OptionQuoteMatrix", "ISS_QUOTES")[1];
issueReject("Reject overwrite with invalid quotes",
    "caplib::createOptionQuoteMatrix(\"OQVT_PRICE\",\"OQTT_ABOSULTE_TERM\",\"OQST_ABOSULTE_STRIKE\",\"EUROPEAN\",\"SPOT_UNDERLYING_TYPE\",2024.01.01,[],[2024.06.01,2024.09.01],matrix([\"CALL\",\"PUT\"],[\"CALL\",\"PUT\"]),matrix([10.5,8.5],[11.0,double()]),matrix([95.0,95.0],[105.0,105.0]),\"ISS_UNDERLYING\",\"ISS_QUOTES\",true)", "Parameter values");
issueResult("Invalid quotes leave cache unchanged",
    beforeRejectedUpdate == caplib::getObjectCacheJson("OptionQuoteMatrix", "ISS_QUOTES")[1]);

// Preserve the documented calendar scalar alternatives and date ordering.
issueAccept("IborIndex accepts scalar calendar",
    "caplib::createIborIndex(\"ISS_IBOR\",\"3M\",\"CNY\",\"CAL_CFETS\",1,\"ACT_360\",\"MODIFIED_FOLLOWING\",\"INVALID_DATE_ROLL_CONVENTION\",\"STANDARD_IBOR_INDEX\",true)");
issueAccept("FX SpotTemplate accepts scalar calendar",
    "caplib::createFxSpotTemplate(\"ISS_SPOT_TPL\",\"EURUSD\",\"FOLLOWING\",\"CAL_CFETS\",\"2d\",true)");
issueAccept("YearFraction accepts reversed dates",
    "caplib::calcYearFraction(2024.12.30,2024.01.01,\"ACTUAL_360\")");
issueAccept("IR curve retains permissive reference date ordering",
    "caplib::createIrYieldCurve(2025.01.01,[2024.01.01,2024.06.01],[0.02,0.03],\"ZERO_RATE\",\"ACT_365_FIXED\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"CONTINUOUS_COMPOUNDING\",\"CNY\",\"ISS_CURVE\",\"ISS_ORDER\",false)");

