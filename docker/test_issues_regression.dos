issueReject("European negative nominal",
    "caplib::createEuropeanOption(\"CALL\",100.0,2024.06.01,2024.06.03,-1.0,\"CNY\",\"SPOT\",\"CNY\",\"ISS_UNDERLYING\",\"ISS_BAD_EU\",true)", "Parameter nominal");
issueAccept("European positive nominal",
    "caplib::createEuropeanOption(\"CALL\",100.0,2024.06.01,2024.06.03,1000.0,\"CNY\",\"SPOT\",\"CNY\",\"ISS_UNDERLYING\",\"ISS_EU\",true)");
issueReject("FX Forward negative buyAmount",
    "caplib::createFxForward(\"USD\",-1.0,\"CNY\",7.0,2024.06.03,2024.06.01,\"ISS_FWD\")", "Parameter buyAmount");
issueReject("FX Forward negative sellAmount",
    "caplib::createFxForward(\"USD\",1.0,\"CNY\",-7.0,2024.06.03,2024.06.01,\"ISS_FWD\")", "Parameter sellAmount");
issueAccept("FX Forward positive amounts",
    "caplib::createFxForward(\"USD\",1.0,\"CNY\",7.0,2024.06.03,2024.06.01,\"ISS_FWD\",true)");
issueReject("FX Spot negative value",
    "caplib::createFxSpotRate(-7.0,\"USD\",\"CNY\",2024.06.01,2024.06.03,\"ISS_FX\")", "Parameter value");
issueAccept("FX Spot positive value",
    "caplib::createFxSpotRate(7.0,\"USD\",\"CNY\",2024.06.01,2024.06.03,\"ISS_FX\",true)");
issueAccept("Calendar omitted holidays",
    "caplib::createCalendar(\"CAL_CFETS\")");
issueReject("CDS negative nominal",
    "caplib::buildCreditDefaultSwap(-1000000.0,\"CNY\",2019.06.20,2024.06.20,\"PAY\",\"CASH\",1.0,1.0,\"SENIOR\",0.4,0.01,\"FLAT_SPREAD\",\"ACT_360\",\"QUARTERLY\",\"MODIFIED_FOLLOWING\",\"CAL_CFETS\",0.01,0,\"ISS_CDS_NAME\",\"ISS_CDS\")", "Parameter nominal");
issueAccept("CDS positive nominal",
    "caplib::buildCreditDefaultSwap(1000000.0,\"CNY\",2019.06.20,2024.06.20,\"PAY\",\"CASH\",1.0,1.0,\"SENIOR\",0.4,0.01,\"FLAT_SPREAD\",\"ACT_360\",\"QUARTERLY\",\"MODIFIED_FOLLOWING\",\"CAL_CFETS\",0.01,0,\"ISS_CDS_NAME\",\"ISS_CDS\")");

// #12: a smile requires strictly increasing bounds.
issueReject("Smile rejects 110.0 >= 90.0",
    "caplib::createVolatilitySmile(\"STRIKE\",2024.01.01,[90.0,110.0],[0.2,0.21],\"LINEAR\",\"FLAT_EXTRAP\",1.0,take(double(),0),take(double(),0),110.0,90.0,\"ISS_SMILE\")", "lower < upper");
issueReject("Smile rejects 90.0 >= 90.0",
    "caplib::createVolatilitySmile(\"STRIKE\",2024.01.01,[90.0,110.0],[0.2,0.21],\"LINEAR\",\"FLAT_EXTRAP\",1.0,take(double(),0),take(double(),0),90.0,90.0,\"ISS_SMILE\")", "lower < upper");
issueAccept("Smile valid bounds",
    "caplib::createVolatilitySmile(\"STRIKE\",2024.01.01,[90.0,110.0],[0.2,0.21],\"LINEAR\",\"FLAT_EXTRAP\",1.0,take(double(),0),take(double(),0),90.0,110.0,\"ISS_SMILE\")");

// #14, #19: both longer and shorter volatility arrays must be rejected.
issueReject("Vol curve short vols",
    "caplib::createVolatilityCurve(2024.01.01,[2024.06.01,2025.01.01],[0.2],\"ACT_365_FIXED\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"ISS_UNDERLYING\",\"ISS_VC\",true)", "pillarDates and vols");
issueReject("Vol curve long vols",
    "caplib::createVolatilityCurve(2024.01.01,[2024.06.01,2025.01.01],[0.2,0.21,0.22],\"ACT_365_FIXED\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"ISS_UNDERLYING\",\"ISS_VC\",true)", "pillarDates and vols");
issueAccept("Vol curve matching lengths",
    "caplib::createVolatilityCurve(2024.01.01,[2024.06.01,2025.01.01],[0.2,0.21],\"ACT_365_FIXED\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"ISS_UNDERLYING\",\"ISS_VC\",true)");

// #15: explicitly supplied holidays must be non-empty and contain no nulls.
issueReject("Calendar rejects take(int(),0)",
    "caplib::createCalendar(\"ISS_CAL\",take(int(),0))", "Parameter holidays");
issueReject("Calendar rejects [int(),int(),int()]",
    "caplib::createCalendar(\"ISS_CAL\",[int(),int(),int()])", "Parameter holidays");
issueReject("Calendar rejects [44654,int(),44656]",
    "caplib::createCalendar(\"ISS_CAL\",[44654,int(),44656])", "Parameter holidays");
issueReject("Calendar rejects take(date(),0)",
    "caplib::createCalendar(\"ISS_CAL\",take(date(),0))", "Parameter holidays");
issueReject("Calendar rejects [2024.01.01,date()]",
    "caplib::createCalendar(\"ISS_CAL\",[2024.01.01,date()])", "Parameter holidays");
issueAccept("Calendar INT serials",
    "caplib::createCalendar(\"ISS_CAL_INT\",[44654,44656],[44655])");
issueAccept("Calendar DATE values",
    "caplib::createCalendar(\"ISS_CAL_DATE\",[2024.01.01,2024.01.03],[2024.01.02])");
issueAccept("Calendar permits omitted special days",
    "caplib::createCalendar(\"ISS_CAL_OMITTED\",[44654])");
issueAccept("Calendar permits empty typed special days",
    "caplib::createCalendar(\"ISS_CAL_EMPTY_SPECIAL\",[44654],take(int(),0))");
issueAccept("Calendar permits empty untyped special days",
    "caplib::createCalendar(\"ISS_CAL_EMPTY_SPECIAL\",[44654],[])");
issueReject("Calendar special days reject null",
    "caplib::createCalendar(\"ISS_CAL_NULL_SPECIAL\",[44654],[int()])", "Parameter specialBusinessDays");

// #16: reject invalid labels and preserve each valid curve type in JSON.
issueReject("Bond curve invalid type",
    "caplib::createBondYieldCurveBuildSettings(\"ISS_BOND\",\"NOT_A_CURVE_TYPE\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"ISS_BOND_BUILD\")", "curveType");
for (curveType in ["ZERO_RATE", "LOG_DISCOUNT", "FORWARD_RATE"]) {
    curveResult = caplib::createBondYieldCurveBuildSettings(
        "ISS_BOND", curveType, "LINEAR_INTERP", "FLAT_EXTRAP", "ISS_BOND_BUILD", true);
    issueResult("Bond curve preserves " + curveType, strpos(curveResult[1], curveType) >= 0);
}

