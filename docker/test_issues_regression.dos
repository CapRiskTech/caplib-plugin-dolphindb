// #44 (recorded, not changed): createCalendar keeps returning BOOL true.
// The calendar is referenced by name; changing the return type would break
// downstream per-function tests that assert the Bool.

issuesSummary = select count(*) as total, sum(passed) as passed from CAPLIB_ISSUES_RESULTS;
print(issuesSummary);
if (issuesSummary.total[0] != issuesSummary.passed[0]) {
    throw "Caplib issues regression failures: " + string(issuesSummary.total[0] - issuesSummary.passed[0]);
}
