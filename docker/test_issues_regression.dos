// #10a (root cause of #29 "empty par rate curve"): pillarsTable is a
// heterogeneous 4-col TABLE (STRING/STRING/STRING/DOUBLE — impossible in a
// native matrix). The old code only matched DF_MATRIX, so add_pillars()
// never ran and an empty curve was cached silently; instrument_type was
// also hard-wired to DEPOSIT (both ternary branches).
def assertPmPillars(curveJson) {
    if (strFind(curveJson, "PM_SWAP") < 0) throw "PmParRateCurve pillars missing PM_SWAP";
    if (strFind(curveJson, "XAUUSD") < 0) throw "PmParRateCurve pillars missing instrument names";
    return true;
}
issueAccept("PmParRateCurve accepts 4-col table pillars",
    "assertPmPillars(caplib::createPmParRateCurve(2019.09.04,\"USD\",\"XAU_XAUUSD\",table([\"XAUUSD\",\"XAUUSD\"] as instrument_name,[\"PM_SWAP\",\"PM_SWAP\"] as instrument_type,[\"1W\",\"2W\"] as instrument_term,[0.025,0.025] as instrument_rate),\"PR_XAU_PAR\",true)[1])");
issueReject("PmParRateCurve rejects empty pillars",
    "caplib::createPmParRateCurve(2019.09.04,\"USD\",\"XAU_XAUUSD\",table([] as instrument_name,[] as instrument_type,[] as instrument_term,[] as instrument_rate),\"PR_XAU_EMPTY\")", "pillars");
issueReject("PmParRateCurve rejects unknown instrument type",
    "caplib::createPmParRateCurve(2019.09.04,\"USD\",\"XAU_XAUUSD\",table([\"XAUUSD\"] as instrument_name,[\"NOT_A_TYPE\"] as instrument_type,[\"1W\"] as instrument_term,[0.025] as instrument_rate),\"PR_XAU_BAD\")", "instrumentType");

// #29 (unblocked by #10a): buildPmYieldCurve was failing on the server with
// "empty par rate curve" because the pillars never reached the proto. With a
// non-empty table pillar set the full chain builds a curve (server accepts).
caplib::createIrYieldCurve(2020.02.21,[2020.02.22,2021.02.21,2022.02.21],[0.02,0.025,0.028],
    "ZERO_RATE","ACT_365_FIXED","LINEAR_INTERP","FLAT_EXTRAP","CONTINUOUS_COMPOUNDING","CNY","CNY_PM_DISC","DISC_PM",false);
caplib::createPmCashTemplate("PM_XAU_CASH",0,"FOLLOWING",["CAL_CFETS"],"ACT_360");
issueAccept("buildPmYieldCurve builds curve from table pillars",
    "strFind(caplib::buildPmYieldCurve(2019.09.04,\"PR_XAU_PAR\",\"DISC_PM\",\"PM_XAU_CASH\",1800.0,1,\"ACT_365_FIXED\",\"LINEAR_INTERP\",\"FLAT_EXTRAP\",\"ZERO_RATE\",\"XAU_CURVE\",0.0,\"CENTRAL_DIFFERENCE_METHOD\",\"SINGLE_THREADING_MODE\",\"PM_CURVE\",true)[1],\"XAU_CURVE\")>=0");

// #31/#32/#33 (A档): the issues.md failures were WRONG TEST FIXTURES, not lib or
// plugin bugs. Mirrors the Python reference client setUp + fixtures
// (D:\project\caplib\python\caplib\test\test_iranalytics.py) — registering the
// IR/FX instrument templates and using the all-swap par curve unlocks all three.
